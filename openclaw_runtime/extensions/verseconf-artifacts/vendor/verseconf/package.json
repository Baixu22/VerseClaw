{
  "name": "verseconf",
  "private": true,
  "version": "0.3.0-local.08ee33835a9d",
  "description": "VerseConf 的 JavaScript/WebAssembly 分发：宿主无需 Rust 工具链即可获得配置校验、安全审计与确定性最小改动编辑（未发布到 npm）",
  "license": "MIT OR Apache-2.0",
  "author": "VerseConf Contributors",
  "homepage": "https://github.com/Baixu22/Verse-conf",
  "repository": {
    "type": "git",
    "url": "https://github.com/Baixu22/Verse-conf",
    "directory": "integrations/verseconf-wasm/js-api"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./worker/index.d.mts",
      "import": "./worker/index.mjs"
    },
    "./web": "./pkg-web/verseconf_wasm.js",
    "./wasm": "./pkg/verseconf_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "bin": {
    "verseconf-mcp-wasm": "bin/verseconf-mcp-wasm.mjs"
  },
  "files": [
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "dist/index.mjs",
    "dist/index.cjs",
    "dist/index.d.ts",
    "pkg/package.json",
    "pkg/verseconf_wasm.js",
    "pkg/verseconf_wasm_bg.wasm",
    "pkg/verseconf_wasm.d.ts",
    "pkg/verseconf_wasm_bg.wasm.d.ts",
    "pkg-web/package.json",
    "pkg-web/verseconf_wasm.js",
    "pkg-web/verseconf_wasm_bg.wasm",
    "pkg-web/verseconf_wasm.d.ts",
    "pkg-web/verseconf_wasm_bg.wasm.d.ts",
    "bin/verseconf-mcp-wasm.mjs",
    "worker/index.mjs",
    "worker/index.d.ts",
    "worker/compute-worker.mjs",
    "worker/availability.mjs",
    "worker/limits.mjs",
    "worker/index.d.mts",
    "package.json",
    "README.md",
    "build-manifest.json",
    "delivery-manifest.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "config",
    "configuration",
    "parser",
    "wasm",
    "webassembly",
    "mcp",
    "agent",
    "verseconf"
  ],
  "verseconf": {
    "sourceVersion": "0.3.0",
    "sourceSha256": "08ee33835a9d2c0a64a4adabc4094b29c3eab24cd89cb3fe91373c98f9be9c0f",
    "deliveryTargets": [
      "nodejs",
      "web"
    ],
    "preservesMcp": true
  }
}
