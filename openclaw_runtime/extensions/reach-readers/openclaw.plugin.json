{
  "id": "reach-readers",
  "name": "Reach Readers",
  "description": "Readonly platform readers with guarded API, CLI, and browser fallback backends.",
  "enabledByDefault": true,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "web_read",
      "rss_read",
      "v2ex_read",
      "xueqiu_read",
      "bilibili_read",
      "youtube_read",
      "github_read",
      "twitter_read",
      "xiaohongshu_read"
    ]
  },
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "secretRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "enum": ["env", "file", "exec"] },
          "provider": { "type": "string" },
          "id": { "type": "string" }
        },
        "required": ["source", "provider", "id"]
      },
      "secretInput": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/secretRef" }
        ]
      }
    },
    "properties": {
      "browserFallback": {
        "type": "string",
        "enum": ["auto", "handoff", "off"],
        "default": "auto"
      },
      "browserProfile": { "type": "string", "default": "default" },
      "backends": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bilibili": { "type": "array", "items": { "type": "string" } },
          "twitter": { "type": "array", "items": { "type": "string" } },
          "xiaohongshu": { "type": "array", "items": { "type": "string" } }
        }
      },
      "credentials": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "xueqiuCookie": { "$ref": "#/$defs/secretInput" },
          "twitterAuthToken": { "$ref": "#/$defs/secretInput" },
          "twitterCt0": { "$ref": "#/$defs/secretInput" }
        }
      }
    }
  }
}
