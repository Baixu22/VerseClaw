{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "tsBuildInfoFile": ".artifacts/tsgo-cache/core.tsbuildinfo"
  },
  "include": ["src/**/*", "ui/**/*", "packages/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-support.ts",
    "**/*.test-harness.ts",
    "**/*.test-fixtures.ts",
    "**/*.e2e-harness.ts",
    "**/*.cases.ts",
    "**/test-helpers/**",
    "src/gateway/server.e2e-ws-harness.ts",
    "src/plugin-sdk/agent-runtime-test-contracts.ts",
    "src/gateway/server.auth.shared.ts",
    "src/plugin-sdk/channel-contract-testing.ts",
    "src/plugin-sdk/channel-target-testing.ts",
    "src/plugin-sdk/plugin-test-runtime.ts",
    "src/plugin-sdk/plugin-state-test-runtime.ts",
    "src/plugin-sdk/plugin-test-api.ts",
    "src/plugin-sdk/plugin-test-contracts.ts",
    "src/plugin-sdk/provider-test-contracts.ts",
    "src/plugin-sdk/reply-payload-testing.ts",
    "src/plugin-sdk/testing.ts",
    "src/plugins/contracts/tts-contract-suites.ts",
    "packages/plugin-sdk/src/testing.ts",
    "test/**"
  ]
}
