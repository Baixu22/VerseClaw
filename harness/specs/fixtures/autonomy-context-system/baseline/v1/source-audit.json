      "tests": [
        "compression-artifact.test.ts",
        "autonomy-context-baseline.test.ts"
      ],
      "finding": "Semantic atoms carry status/polarity/scope/evidence. Legacy facts derive from active atoms including unverified atoms; unverifiedClaims remains a separate list."
    },
