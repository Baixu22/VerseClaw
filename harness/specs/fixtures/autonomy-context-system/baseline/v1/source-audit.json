        "autonomy-context-baseline.test.ts"
      ],
      "finding": "Candidate authority/version/digest, stale-history and shared injection budget precede materialization. Task rehydration is a later provider-call hook. Wire capture belongs to transport finalization; offline previews do not produce it."
    },
    {
      "caller": "buildObservationMaskingProjection",
      "production": "registry/context-item-registry.ts: create/verifyContextArchiveHandle",
      "consumer": "masked tool result and context_archive_recall",
