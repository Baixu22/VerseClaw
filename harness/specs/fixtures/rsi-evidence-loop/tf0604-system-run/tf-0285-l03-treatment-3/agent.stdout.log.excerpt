alse);\r\n  });\r\n\r\n  it('loads guide and layer specs from the harness spec library', async () => {\r\n    const guides = await loadGuideSpecs();\r\n    const layers = await loadLayerSpecs();\r\n\r\n    expect(guides.map((spec: { data: { id: string } }) => spec.data.id)).toEqual(\r\n      expect.arrayContaining(['agent-harness-routing', 'spec-update']),\r\n    );\r\n    expect(layers.map((spec: { data: { id: string } }) => spec.data.id)).toEqual(\r\n      expect.arrayContaining(['electron-main', 'harness', 'openclaw-runtime', 'plugins', 'renderer']),\r\n    );\r\n  });\r\n\r\n  it('builds task context from scenario rules and touched-path layers', async () => {\r\n    const context = await buildContext('harness/specs/tasks/connect-clawx-to-openclaw-runtime.md');\r\n\r\n    expect(context.missingRules).toEqual([]);\r\n    expect(context.missingScenarios).toEqual([]);\r\n    expect(context.scenarios.map((spec: { data: { id: string } }) => spec.data.id)).toContain('gateway-backend-communication');\r\n    expect(context.rules.map((spec: { data: { id: string } }) => spec.data.id)).toEqual(\r\n      expect.arrayContaining(['renderer-main-boundary', 'backend-communication-boundary']),\r\n    );\r\n    expect(context.guides.map((spec: { data: { id: string } }) => spec.data.id)).toEqual(\r\n      expect.arrayContaining(['agent-harness-routing', 'spec-update']),\r\n    );\r\n    expect(context.layers.map((spec: { data: { id: string } }) => spec.data.id)).toEqual(\r\n      expect.arrayContaining(['electron-main', 'harness', 'openclaw-runtime']),\r\n    );\r\n    expect(context.layers.map((spec: { data: { id: string } }) => spec.data.id)).not.toContain('renderer');\r\n    expect(context.readOrder[0].path.replaceAll('\\\\', '/')).toBe(\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_312","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0285-l03-treatment-3\\\\agent; Get-Content scripts/check-spec-lifecycle.mjs -TotalCount 90\"","aggregated_output":"#!/usr/bin/env node\r\nimport { readdir, readFile } from 'node:fs/promises';\r\nimport path from 'node:path';\r\nimport { fileURLToPath } from 'node:url';\r\n\r\nimport { parseFrontmatter, ROOT } from '../harness/src/specs.mjs';\r\n\r\nexport const TASK_SPEC_ROOT = path.join(ROOT, 'harness', 'specs', 'tasks');\r\nexport const LIFECYCLE_STATUSES = Object.freeze(['active', 'completed', 'archived']);\r\n\r\nasync function listTaskSpecs(dir) {\r\n  const entries = await readdir(dir, { withFileTypes: true });\r\n  const files = [];\r\n  for (const entry of entries) {\r\n    const fullPath = path.join(dir, entry.name);\r\n    if (entry.isDirectory()) files.push(...await listTaskSpecs(fullPath));\r\n    else if (entry.isFile() && entry.name.endsWith('.md')) files.push(fullPath);\r\n  }\r\n  return files.sort();\r\n}\r\n\r\nexport function validateLifecycleStatus(data, specPath = 'spec') {\r\n  const status = data?.lifecycleStatus;\r\n  if (!status) return [`${specPath}: missing required field \"lifecycleStatus\"`];\r\n  if (!LIFECYCLE_STATUSES.includes(status)) {\r\n    return [`${specPath}: lifecycleStatus must be one of ${LIFECYCLE_STATUSES.join(', ')}`];\r\n  }\r\n  return [];\r\n}\r\n\r\nexport async function collectTaskSpecLifecycleErrors() {\r\n  const failures = [];\r\n  for (const file of await listTaskSpecs(TASK_SPEC_ROOT)) {\r\n    const relativePath = path.relative(ROOT, file).replaceAll('\\\\', '/');\r\n    try {\r\n      const spec = parseFrontmatter(await readFile(file, 'utf8'));\r\n      failures.push(...validateLifecycleStatus(spec.data, relativePath));\r\n    } catch (error) {\r\n      failures.push(`${relativePath}: ${error instanceof Error ? error.message : String(error)}`);\r\n    }\r\n  }\r\n  return failures;\r\n}\r\n\r\nasync function main() {\r\n  const failures = await collectTaskSpecLifecycleErrors();\r\n  if (failures.length > 0) {\r\n    for (const failure of failures) console.error(failure);\r\n    process.exitCode = 1;\r\n    return;\r\n  }\r\n  console.log(`[specs] lifecycle status present for ${(await listTaskSpecs(TASK_SPEC_ROOT)).length} task specs.`);\r\n}\r\n\r\nif (process.argv[1] === fileURLToPath(import.meta.url)) await main();\r\n","exit_code":0,"status":"completed"}}
