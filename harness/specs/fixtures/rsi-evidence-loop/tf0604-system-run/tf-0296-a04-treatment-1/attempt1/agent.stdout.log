{"type":"item.completed","item":{"id":"item_244","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Get-Content \\\"D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0296-a04-treatment-3\\\\grader\\\\tests\\\\unit\\\\a04-a4-gate-coverage.test.ts\\\"; echo \\\"=====LANDED A4 SPEC (a05 base)=====\\\"; Get-Content \\\"D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0297-a05-baseline-1\\\\base\\\\harness\\\\specs\\\\tasks\\\\a4-decision-quality-pilot.md\\\"\"","aggregated_output":"import { existsSync, readFileSync, readdirSync } from \"node:fs\";\r\nimport path from \"node:path\";\r\nimport { describe, expect, it } from \"vitest\";\r\n\r\nconst ROOT = path.resolve(__dirname, \"../..\");\r\nconst SPEC = \"harness/specs/tasks/a4-decision-quality-pilot.md\";\r\nconst REQUIRED_TESTS = [\r\n  \"tests/unit/decision-quality-auditor.test.ts\",\r\n  \"tests/unit/deprecation-counters.test.ts\",\r\n  \"tests/unit/performance-budgets.test.ts\",\r\n  \"tests/unit/deep/a4-deep.test.ts\",\r\n  \"tests/unit/trace-truncation.test.ts\",\r\n  \"tests/unit/a04-a4-gate-coverage.test.ts\",\r\n  \"tests/unit/a4-decision-quality-dev-tool.test.ts\",\r\n] as const;\r\n\r\nfunction walk(dir: string): string[] {\r\n  return readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {\r\n    const full = path.join(dir, entry.name);\r\n    if (entry.isDirectory()) return walk(full);\r\n    return entry.isFile() && entry.name.endsWith(\".ts\") ? [full] : [];\r\n  });\r\n}\r\n\r\ndescribe(\"A04 A4 gate coverage\", () => {\r\n  it(\"keeps every A4 required test path present and wired into the archived pilot spec\", () => {\r\n    const spec = readFileSync(path.join(ROOT, SPEC), \"utf8\");\r\n    for (const rel of REQUIRED_TESTS) {\r\n      expect(spec).toContain(`- ${rel}`);\r\n      expect(existsSync(path.join(ROOT, rel))).toBe(true);\r\n    }\r\n  });\r\n\r\n  it(\"pins the A4 counter action and A4-first degradation order evidence\", () => {\r\n    const counters = readFileSync(\r\n      path.join(ROOT, \"openclaw_runtime/src/observability/deprecation-counters.ts\"),\r\n      \"utf8\",\r\n    );\r\n    expect(counters).toContain('action: \"degrade_to_audit_only\"');\r\n\r\n    const traceRecorder = readFileSync(\r\n      path.join(ROOT, \"openclaw_runtime/src/observability/trace-recorder.ts\"),\r\n      \"utf8\",\r\n    );\r\n    expect(traceRecorder).toContain(\"a4 > a3 > a5 > a2 > a1 > a6 > core\");\r\n\r\n    const traceTest = readFileSync(path.join(ROOT, \"tests/unit/trace-truncation.test.ts\"), \"utf8\");\r\n    expect(traceTest).toContain(\"drops lowest-priority spans first\");\r\n    expect(traceTest).toContain(\"a4, a3, a5 should be dropped\");\r\n  });\r\n\r\n  it(\"pins A4 as offline-only with the sanctioned dev-tool consumer wired\", () => {\r\n    const manual = readFileSync(path.join(ROOT, \"docs/runtime-design/development-manual.md\"), \"utf8\");\r\n    expect(manual).toContain(\"A4 — Decision Quality (offline pure functions only)\");\r\n    expect(manual).toContain(\"A4 is called ONLY via explicit dev-tool invocation\");\r\n\r\n    // The only consumer of the auditor must be the explicit dev-tool CLI; the\r\n    // runtime tree must not import it on any production turn path.\r\n    const offenders = walk(path.join(ROOT, \"openclaw_runtime/src\"))\r\n      .filter((file) => !file.includes(\"decision-quality-auditor\"))\r\n      .filter((file) => readFileSync(file, \"utf8\").includes(\"DecisionQualityAuditor\"));\r\n    expect(offenders).toEqual([]);\r\n\r\n    expect(existsSync(path.join(ROOT, \"scripts/a4-decision-quality-audit.mts\"))).toBe(true);\r\n    const pkg = JSON.parse(readFileSync(path.join(ROOT, \"package.json\"), \"utf8\"));\r\n    expect(pkg.scripts[\"a4:decision-quality-audit\"]).toContain(\"a4-decision-quality-audit.mts\");\r\n  });\r\n});\r\n=====LANDED A4 SPEC (a05 base)=====\r\n---\r\nlifecycleStatus: archived\r\nid: a4-decision-quality-pilot\r\ntitle: A4 Decision Quality — Active Pilot Gate\r\nscenario: gateway-backend-communication\r\ntaskType: runtime-bridge\r\nintent: Promote the A4 decision quality audit from shadow to active pilot, gated by audit coverage and budget compliance.\r\ntouchedAreas:\r\n  - openclaw_runtime/src/observability/deprecation-counters.ts\r\nrequiredProfiles:\r\n  - fast\r\n  - comms\r\nrequiredRules:\r\n  - backend-communication-boundary\r\n  - comms-regression\r\nexpectedUserBehavior:\r\n  - With the A4 pilot gate enabled, decisions are audited and the low-quality counter stays at or under the 10% graduation budget.\r\n  - Every audited decision is covered in shadow mode (sampling rate 1.0) before the audit is treated as a gate.\r\n  - When the low-quality rate exceeds 10%, the pilot responds with `degrade_to_audit_only` instead of spending the rest of the turn budget.\r\n  - A4 degrades first in the documented order (A4→A3→A5→A1), so the per-turn cumulative latency budget is respected.\r\n  - With the pilot flag off, decision outcomes and the audit surface are unchanged.\r\nrequiredTests:\r\n  - tests/unit/decision-quality-auditor.test.ts\r\n  - tests/unit/deprecation-counters.test.ts\r\n  - tests/unit/performance-budgets.test.ts\r\n  - tests/unit/deep/a4-deep.test.ts\r\n  - tests/unit/trace-truncation.test.ts\r\n  - tests/unit/a04-a4-gate-coverage.test.ts\r\nacceptance:\r\n  - A4 deprecation counter `lowQualityDecisions` rate ≤ 10% over audited decisions\r\n  - A4 budget violation response `degrade_to_audit_only` triggers when low-quality rate > 10%\r\n  - Per-turn cumulative latency budget respected (A4 is part of degradation order: A4→A3→A5→A1)\r\ndocs:\r\n  required: true\r\n---\r\n\r\n## Graduation gate\r\n\r\nA4 graduates from shadow to active pilot when ALL of the following hold:\r\n\r\n1. **Low-quality decision rate** ≤ 10%: `lowQualityDecisions / auditedDecisions ≤ 0.10`.\r\n2. **Audit coverage**: every decision is audited in shadow mode (sampling rate = 1.0).\r\n3. **Budget violation response**: `degrade_to_audit_only` triggers when rate > 10% (criterion 4.14).\r\n4. **Per-turn cumulative budget**: A4 is the first to degrade (degradation order A4→A3→A5→A1).\r\n\r\n## Out of scope\r\n\r\n- Post-promotion sampling (OQ-004, Stage 5).\r\n- Decision quality scoring model (Stage 5 enhancement).\r\n","exit_code":0,"status":"completed"}}
