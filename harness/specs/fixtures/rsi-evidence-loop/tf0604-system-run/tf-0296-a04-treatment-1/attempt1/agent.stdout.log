{"type":"item.completed","item":{"id":"item_228","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Get-Content \\\"D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0296-a04-treatment-2\\\\agent\\\\tests\\\\unit\\\\a04-a4-gate-coverage.test.ts\\\"; echo \\\"=====BASELINE-2 GRADER=====\\\"; Get-Content \\\"D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0296-a04-baseline-2\\\\grader\\\\tests\\\\unit\\\\a04-a4-gate-coverage.test.ts\\\"\"","aggregated_output":"// @vitest-environment node\r\n// A04: the A4 decision-quality pilot gate must be verifiable from the current\r\n// candidate without redefining the original thresholds, and the two\r\n// production-only criteria that cannot be met must stay recorded as NO-GO\r\n// residuals instead of being reported as PASS.\r\nimport { existsSync, readFileSync } from \"node:fs\";\r\nimport { dirname, join, resolve } from \"node:path\";\r\nimport { fileURLToPath } from \"node:url\";\r\nimport { describe, expect, it } from \"vitest\";\r\n\r\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\r\nconst SPEC = \"harness/specs/tasks/a4-decision-quality-pilot.md\";\r\n\r\nfunction read(p: string) {\r\n  return readFileSync(join(ROOT, p), \"utf8\");\r\n}\r\nfunction requiredTests(spec: string): string[] {\r\n  const block = spec.match(/requiredTests:\\n((?:\\s+- .+\\n)+)/)?.[1] ?? \"\";\r\n  return [...block.matchAll(/^\\s+- (.+)$/gm)].map((m) => m[1].trim());\r\n}\r\n\r\ndescribe(\"A04 A4 decision-quality pilot gate coverage\", () => {\r\n  it(\"points every requiredTests entry at a real file and wires the auditor + a4-deep + degradation-order tests\", () => {\r\n    const spec = read(SPEC);\r\n    const tests = requiredTests(spec);\r\n    // The original two entries must remain (thresholds are not redefined).\r\n    expect(tests).toContain(\"tests/unit/deprecation-counters.test.ts\");\r\n    expect(tests).toContain(\"tests/unit/performance-budgets.test.ts\");\r\n    // The spec-drift fix adds the auditor, a4-deep and degradation-order tests.\r\n    expect(tests).toContain(\"tests/unit/decision-quality-auditor.test.ts\");\r\n    expect(tests).toContain(\"tests/unit/deep/a4-deep.test.ts\");\r\n    expect(tests).toContain(\"tests/unit/trace-truncation.test.ts\");\r\n    for (const test of tests) {\r\n      expect(existsSync(join(ROOT, test)), `missing required test: ${test}`).toBe(true);\r\n    }\r\n  });\r\n\r\n  it(\"keeps criteria 1 and 3 mapped to degrade_to_audit_only at the original strict >10% threshold\", () => {\r\n    // The original graduation budget text must survive verbatim.\r\n    const spec = read(SPEC);\r\n    expect(spec).toContain(\"lowQualityDecisions / auditedDecisions ≤ 0.10\");\r\n    expect(spec).toContain(\"degrade_to_audit_only\");\r\n    expect(spec).toContain(\"A4→A3→A5→A1\");\r\n\r\n    // Criterion 1/3 assertions: counter budget + the auditor + the deep counter tests.\r\n    const counters = read(\"tests/unit/deprecation-counters.test.ts\");\r\n    expect(counters).toContain(\"degrade_to_audit_only\");\r\n    expect(counters).toMatch(/A4: low-quality rate > 10%/);\r\n    const deep = read(\"tests/unit/deep/a4-deep.test.ts\");\r\n    expect(deep).toContain(\"degrade_to_audit_only\");\r\n    expect(deep).toContain(\"a4_low_quality_rate\");\r\n    const auditor = read(\"tests/unit/decision-quality-auditor.test.ts\");\r\n    expect(auditor).toContain(\"DecisionQualityAuditor\");\r\n    expect(auditor).toContain(\"isDecisionQualityAuditEnabled\");\r\n    expect(auditor).toContain(\"auditedDecisions\");\r\n    expect(auditor).toContain(\"lowQualityDecisions\");\r\n  });\r\n\r\n  it(\"keeps criterion 4 (degradation order) mapped to the trace-truncation drop order with A4 dropped first\", () => {\r\n    const truncation = read(\"tests/unit/trace-truncation.test.ts\");\r\n    expect(truncation).toContain(\"droppedAreas\");\r\n    expect(truncation).toContain(\"a4\");\r\n    // A4 is dropped before A3 and A5, and well before A1 (A4→A3→A5→A1).\r\n    const names = read(\"openclaw_runtime/src/observability/namespace-governance.ts\");\r\n    expect(names).toMatch(/a4:\\s*6/);\r\n  });\r\n\r\n  it(\"records criterion 2 (production audit coverage) as a NO-GO residual, not a pass\", () => {\r\n    const spec = read(SPEC);\r\n    // A4 is an offline/dev-tool-only module: production coverage does not exist.\r\n    expect(spec).toMatch(/offline/i);\r\n    expect(spec).toMatch(/dev-tool-only|test-fixture/i);\r\n    expect(spec).toMatch(/NO-GO/);\r\n    expect(spec).toMatch(/production (audit caller|coverage)/i);\r\n    // sampling-rate-1.0 coverage is asserted inside the module only.\r\n    expect(spec).toContain(\"sampling rate = 1.0\");\r\n  });\r\n\r\n  it(\"records criterion 4 cumulative latency as NOT-MEASURED / NO-GO (A4 is not on the production turn path)\", () => {\r\n    const spec = read(SPEC);\r\n    expect(spec).toMatch(/NOT-MEASURED/);\r\n    expect(spec).toMatch(/per-turn cumulative latency/i);\r\n    expect(spec).toMatch(/turn path/i);\r\n  });\r\n});\r\n=====BASELINE-2 GRADER=====\r\nimport { existsSync, readFileSync, readdirSync } from \"node:fs\";\r\nimport path from \"node:path\";\r\nimport { describe, expect, it } from \"vitest\";\r\n\r\nconst ROOT = path.resolve(__dirname, \"../..\");\r\nconst SPEC = \"harness/specs/tasks/a4-decision-quality-pilot.md\";\r\nconst REQUIRED_TESTS = [\r\n  \"tests/unit/decision-quality-auditor.test.ts\",\r\n  \"tests/unit/deprecation-counters.test.ts\",\r\n  \"tests/unit/performance-budgets.test.ts\",\r\n  \"tests/unit/deep/a4-deep.test.ts\",\r\n  \"tests/unit/trace-truncation.test.ts\",\r\n  \"tests/unit/a04-a4-gate-coverage.test.ts\",\r\n  \"tests/unit/a4-decision-quality-dev-tool.test.ts\",\r\n] as const;\r\n\r\nfunction walk(dir: string): string[] {\r\n  return readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {\r\n    const full = path.join(dir, entry.name);\r\n    if (entry.isDirectory()) return walk(full);\r\n    return entry.isFile() && entry.name.endsWith(\".ts\") ? [full] : [];\r\n  });\r\n}\r\n\r\ndescribe(\"A04 A4 gate coverage\", () => {\r\n  it(\"keeps every A4 required test path present and wired into the archived pilot spec\", () => {\r\n    const spec = readFileSync(path.join(ROOT, SPEC), \"utf8\");\r\n    for (const rel of REQUIRED_TESTS) {\r\n      expect(spec).toContain(`- ${rel}`);\r\n      expect(existsSync(path.join(ROOT, rel))).toBe(true);\r\n    }\r\n  });\r\n\r\n  it(\"pins the A4 counter action and A4-first degradation order evidence\", () => {\r\n    const counters = readFileSync(\r\n      path.join(ROOT, \"openclaw_runtime/src/observability/deprecation-counters.ts\"),\r\n      \"utf8\",\r\n    );\r\n    expect(counters).toContain('action: \"degrade_to_audit_only\"');\r\n\r\n    const traceRecorder = readFileSync(\r\n      path.join(ROOT, \"openclaw_runtime/src/observability/trace-recorder.ts\"),\r\n      \"utf8\",\r\n    );\r\n    expect(traceRecorder).toContain(\"a4 > a3 > a5 > a2 > a1 > a6 > core\");\r\n\r\n    const traceTest = readFileSync(path.join(ROOT, \"tests/unit/trace-truncation.test.ts\"), \"utf8\");\r\n    expect(traceTest).toContain(\"drops lowest-priority spans first\");\r\n    expect(traceTest).toContain(\"a4, a3, a5 should be dropped\");\r\n  });\r\n\r\n  it(\"pins A4 as offline-only with the sanctioned dev-tool consumer wired\", () => {\r\n    const manual = readFileSync(path.join(ROOT, \"docs/runtime-design/development-manual.md\"), \"utf8\");\r\n    expect(manual).toContain(\"A4 — Decision Quality (offline pure functions only)\");\r\n    expect(manual).toContain(\"A4 is called ONLY via explicit dev-tool invocation\");\r\n\r\n    // The only consumer of the auditor must be the explicit dev-tool CLI; the\r\n    // runtime tree must not import it on any production turn path.\r\n    const offenders = walk(path.join(ROOT, \"openclaw_runtime/src\"))\r\n      .filter((file) => !file.includes(\"decision-quality-auditor\"))\r\n      .filter((file) => readFileSync(file, \"utf8\").includes(\"DecisionQualityAuditor\"));\r\n    expect(offenders).toEqual([]);\r\n\r\n    expect(existsSync(path.join(ROOT, \"scripts/a4-decision-quality-audit.mts\"))).toBe(true);\r\n    const pkg = JSON.parse(readFileSync(path.join(ROOT, \"package.json\"), \"utf8\"));\r\n    expect(pkg.scripts[\"a4:decision-quality-audit\"]).toContain(\"a4-decision-quality-audit.mts\");\r\n  });\r\n});\r\n","exit_code":0,"status":"completed"}}
