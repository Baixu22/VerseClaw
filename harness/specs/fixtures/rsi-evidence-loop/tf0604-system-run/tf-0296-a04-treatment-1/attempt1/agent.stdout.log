ries: [{ path: 'source.txt', reason: 'historical drift' }],\r\n    }), 'utf8');\r\n    expect(verifyManifest(root, manifest).annotatedDrift).toEqual(['source.txt']);\r\n    expect(verifyManifest(root, manifest).drifted).toEqual([]);\r\n  });\r\n});\r\n","exit_code":0,"status":"completed"}}
