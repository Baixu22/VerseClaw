{"type":"item.started","item":{"id":"item_131","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Get-ChildItem D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0296-a04-treatment-1\\\\base | Select-Object -First 5 Name; echo \\\"=== diff base vs agent (files only counts) ===\\\"; node -e \\\"\nconst fs=require('fs'),path=require('path'),c=require('crypto');\nfunction walk(dir,base,out){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,e.name);const rel=path.relative(base,p).replaceAll('\\\\\\\\\\\\\\\\','/');if(e.isDirectory())walk(p,base,out);else out.push(rel);}return out;}\nconst A='D:/tmp/rsi-tf0604-run5/trials/tf-0296-a04-treatment-1/agent';\nconst B='D:/tmp/rsi-tf0604-run5/trials/tf-0296-a04-treatment-1/base';\nconst a=new Set(walk(A,A,[])); const b=new Set(walk(B,B,[]));\nconst added=[...a].filter(x=>\"'!b.has(x)).sort();\nconst removed=[...b].filter(x=>!a.has(x)).sort();\nconst changed=[...a].filter(x=>b.has(x)&&c.createHash('\"'sha256').update(fs.readFileSync(A+'/'+x)).digest('hex')\"'!==c.createHash('\"'sha256').update(fs.readFileSync(B+'/'+x)).digest('hex')).sort();\nconsole.log('ADDED',added.length);added.slice(0,50).forEach(x=>console.log(' +',x));\nconsole.log('REMOVED',removed.length);removed.slice(0,50).forEach(x=>console.log(' -',x));\nconsole.log('CHANGED',changed.length);changed.slice(0,50).forEach(x=>console.log(' ~',x));\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
