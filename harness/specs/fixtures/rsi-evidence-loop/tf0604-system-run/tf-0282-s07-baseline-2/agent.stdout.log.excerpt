{"type":"item.completed","item":{"id":"item_381","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0282-s07-baseline-2\\\\agent; Get-Content openclaw_runtime/src/runtime-core/verifier-completion-verdict.ts | Select-Object -First 20; Write-Output \\\"...\\\"; Get-Content openclaw_runtime/src/runtime-core/verifier-completion-verdict.ts | Select-Object -Skip 100 -First 60\"","aggregated_output":"/**\r\n * S07: a bounded, revocable completion-verdict entry for the evidence verifier.\r\n *\r\n * The verifier may decide whether *one named task* is complete, and nothing else:\r\n * - It reuses the existing evidence verifier (`evaluateEvidenceVerifier`) - no\r\n *   second authority layer.\r\n * - It is bounded: a task outside the granted scope gets no verdict and no\r\n *   transition.\r\n * - It is revocable: an approved completion records the prior status so it can be\r\n *   reverted.\r\n * - It grants NO publish / product-lock / release capability, and the record says\r\n *   so explicitly.\r\n * The record is digest-only (task id, decision, finding codes, evidence digest);\r\n * raw evidence content never enters it.\r\n */\r\nimport { createHash } from \"node:crypto\";\r\n\r\nimport {\r\n  evaluateEvidenceVerifier,\r\n  type EvidenceVerifierDecision,\r\n...\r\nexport function isVerifierCompletionTransition(\r\n  value: unknown,\r\n): value is Exclude<VerifierCompletionTransition, null> {\r\n  return (\r\n    isRecord(value) &&\r\n    isNonEmptyString(value.nodeId) &&\r\n    isNonEmptyString(value.from) &&\r\n    value.to === VERIFIER_COMPLETION_DONE_STATUS\r\n  );\r\n}\r\n\r\nexport function isVerifierCompletionRecord(\r\n  value: unknown,\r\n): value is VerifierCompletionRecord {\r\n  return (\r\n    isRecord(value) &&\r\n    isNonEmptyString(value.taskId) &&\r\n    isVerifierCompletionVerdict(value.verdict) &&\r\n    typeof value.evidenceDigest === \"string\" &&\r\n    Array.isArray(value.findingCodes) &&\r\n    value.findingCodes.every((code) => typeof code === \"string\") &&\r\n    isNonEmptyString(value.priorStatus) &&\r\n    value.grantsPublish === false &&\r\n    value.grantsProductLock === false\r\n  );\r\n}\r\n\r\nfunction sha256Text(value: string): string {\r\n  return createHash(\"sha256\").update(value).digest(\"hex\");\r\n}\r\n\r\nfunction decisionVerdict(decision: EvidenceVerifierDecision): VerifierCompletionVerdict {\r\n  if (decision === \"completed\") return \"approved\";\r\n  if (decision === \"insufficient_evidence\") return \"insufficient-evidence\";\r\n  return \"rejected\";\r\n}\r\n\r\n/**\r\n * Resolve a bounded completion verdict for one task. The verdict never reads or\r\n * stores raw evidence content - only the digest of the evidence identity.\r\n * Replaying the same evidence yields the same digest and the same verdict.\r\n */\r\nexport function resolveVerifierCompletionVerdict(\r\n  params: ResolveVerifierCompletionVerdictParams,\r\n): VerifierCompletionRecord {\r\n  const { input, policy, scope, priorStatus } = params;\r\n  const inScope = scope.taskIds.includes(input.taskId);\r\n  const report = inScope ? evaluateEvidenceVerifier(input, policy) : undefined;\r\n  const findingCodes = (report?.findings ?? [])\r\n    .map((finding) => finding.code)\r\n    .sort();\r\n  const evidenceDigest = sha256Text(\r\n    JSON.stringify({\r\n      decision: report?.decision ?? \"out-of-scope\",\r\n      evidenceRefs: (report?.evidenceRefs ?? [])\r\n        .map((ref) => `${ref.type}:${ref.ref}`)\r\n        .sort(),\r\n      findingCodes,\r\n    }),\r\n  );\r\n","exit_code":0,"status":"completed"}}
