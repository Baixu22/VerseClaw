{"type":"item.started","item":{"id":"item_100","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command '$patch = @'\"'\n*** Begin Patch\n*** Add File: scripts/lib/reliability-aggregation.mjs\n+/**\n+ * Deterministic reliability aggregation for the Agent Dev benefit report (E01).\n+ *\n+ * This module is a pure, dependency-free aggregator. It turns recorded trials\n+ * into the reliability columns E01 requires and never touches product\n+ * behavior, product locks or frozen defaults.\n+ *\n+ * Two numbers that must never be confused:\n+ *   - pass\"'^k  : share of complete cases whose k trials all passed.\n+ *   - pass@k  : share of complete cases with at least one passing trial.\n+ *\n+ * Missing / timeout / crash / skip trials make a case incomplete. Incomplete\n+ * cases are excluded from the denominator and stay visible in the report with\n+ * their explicit reason instead of being silently dropped.\n+ */\n+\n+export const INCOMPLETE_OUTCOMES = Object.freeze(['\"'missing', 'timeout', 'crash', 'skip']);\n+\n+export const GATE_PASS = 'pass';\n+export const GATE_FAIL = 'fail';\n+export const GATE_INSUFFICIENT_SAMPLE = 'insufficient-sample';\n+\n+/**\n+ * Pre-registered design gate. The conformance fixture in\n+ * \"'`shared/agent-dev/reliability-fixture.json` restates these values so they are\n+ * fixed before a run instead of being chosen after seeing the result.\n+ */\n+export const DEFAULT_THRESHOLDS = Object.freeze({\n+  k: 3,\n+  minCases: 20,\n+  flakeThreshold: 0.01,\n+  safetySkipBudget: 0,\n+  safetyFlakeBudget: 0,\n+});\n+\n+const CASE_KINDS = Object.freeze(['\"'positive', 'negative', 'coverage']);\n+\n+function isPositiveInteger(value) {\n+  return typeof value === 'number' && Number.isInteger(value) && value > 0;\n+}\n+\n+function unique(values) {\n+  return [...new Set(values)];\n+}\n+\n+function caseIds(cases) {\n+  return cases.map((entry) => entry.id).filter((id) => typeof id === 'string' && id.length > 0);\n+}\n+\n+function ratio(numerator, denominator) {\n+  return denominator === 0 ? null : Number((numerator / denominator).toFixed(6));\n+}\n+\n+/**\n+ * Validate and freeze the aggregate thresholds. Invalid pre-registration is an\n+ * error, not something to paper over with defaults at report time.\n+ */\n+export function normalizeThresholds(thresholds = {}, fallback = DEFAULT_THRESHOLDS) {\n+  const source = thresholds && typeof thresholds === 'object' ? thresholds : {};\n+  const k = source.k ?? fallback.k;\n+  const minCases = source.minCases ?? fallback.minCases;\n+  const flakeThreshold = source.flakeThreshold ?? fallback.flakeThreshold;\n+  const safetySkipBudget = source.safetySkipBudget ?? fallback.safetySkipBudget ?? 0;\n+  const safetyFlakeBudget = source.safetyFlakeBudget ?? fallback.safetyFlakeBudget ?? 0;\n+\n+  if (\"'!isPositiveInteger(k)) {\n+    throw new TypeError(`reliability thresholds: k must be a positive integer, received ${JSON.stringify(source.k)}`);\n+  }\n+  if (!isPositiveInteger(minCases)) {\n+    throw new TypeError(`reliability thresholds: minCases must be a positive integer, received ${JSON.stringify(source.minCases)}`);\n+  }\n+  if (typeof flakeThreshold !== '\"'number' || \"'!Number.isFinite(flakeThreshold) || flakeThreshold < 0 || flakeThreshold > 1) {\n+    throw new TypeError(`reliability thresholds: flakeThreshold must be a ratio within [0, 1], received ${JSON.stringify(source.flakeThreshold)}`);\n+  }\n+  if (!Number.isInteger(safetySkipBudget) || safetySkipBudget < 0) {\n+    throw new TypeError(`reliability thresholds: safetySkipBudget must be a non-negative integer, received ${JSON.stringify(source.safetySkipBudget)}`);\n+  }\n+  if (!Number.isInteger(safetyFlakeBudget) || safetyFlakeBudget < 0) {\n+    throw new TypeError(`reliability thresholds: safetyFlakeBudget must be a non-negative integer, received ${JSON.stringify(source.safetyFlakeBudget)}`);\n+  }\n+\n+  return { k, minCases, flakeThreshold, safetySkipBudget, safetyFlakeBudget };\n+}\n+\n+/** Accept both plain outcome strings and `{ outcome }` records. */\n+export function outcomeOf(trial) {\n+  if (typeof trial === '\"'string') return trial;\n+  if (trial && typeof trial === 'object' && typeof trial.outcome === 'string') return trial.outcome;\n+  return 'missing';\n+}\n+\n+export function isIncompleteOutcome(outcome) {\n+  return INCOMPLETE_OUTCOMES.includes(outcome);\n+}\n+\n+/** \"'`pass` when the observed outcome matches the case expectation. */\n+export function trialResult(trial, expect = '\"'accept') {\n+  const outcome = outcomeOf(trial);\n+  if (isIncompleteOutcome(outcome)) return 'incomplete';\n+  return outcome === expect ? 'pass' : 'fail';\n+}\n+\n+/**\n+ * Classify a single case. The first k trials are the gate trials; any later\n+ * trial is a fixed rerun kept as flake evidence, never a way to erase the\n+ * original gate failure.\n+ */\n+export function classifyCase(entry = {}, k = DEFAULT_THRESHOLDS.k) {\n+  const id = typeof entry.id === 'string' && entry.id.length > 0 ? entry.id : null;\n+  const kind = CASE_KINDS.includes(entry.kind) ? entry.kind : 'coverage';\n+  const expect = entry.expect === 'reject' ? 'reject' : 'accept';\n+  const safety = entry.safety === true;\n+  const scenario = typeof entry.scenario === 'string' && entry.scenario.length > 0 ? entry.scenario : null;\n+  const trials = Array.isArray(entry.trials) ? entry.trials : [];\n+  const outcomes = trials.map(outcomeOf);\n+  const results = outcomes.map((outcome) => trialResult(outcome, expect));\n+\n+  const incompleteReasons = [];\n+  if (trials.length < k) incompleteReasons.push('missing');\n+  for (const outcome of outcomes) {\n+    if (isIncompleteOutcome(outcome) && \"'!incompleteReasons.includes(outcome)) incompleteReasons.push(outcome);\n+  }\n+\n+  const complete = incompleteReasons.length === 0 && results.length >= k;\n+  const gateResults = results.slice(0, k);\n+  const allPass = complete && gateResults.every((result) => result === '\"'pass');\n+  const anyPass = complete && gateResults.some((result) => result === 'pass');\n+  const firstTrialFailed = complete && results[0] === 'fail';\n+  const flake = firstTrialFailed && results.slice(1).some((result) => result === 'pass');\n+\n+  return {\n+    id,\n+    kind,\n+    expect,\n+    safety,\n+    scenario,\n+    complete,\n+    incompleteReasons,\n+    outcomes,\n+    results,\n+    gateResults,\n+    allPass,\n+    anyPass,\n+    firstTrialFailed,\n+    flake,\n+  };\n+}\n+\n+/**\n+ * Aggregate one sample of recorded cases into the E01 report columns.\n+ */\n+export function aggregateReliability(input = {}) {\n+  const thresholds = normalizeThresholds(input.thresholds);\n+  const { k } = thresholds;\n+  const entries = Array.isArray(input.cases) ? input.cases : [];\n+  const cases = entries.map((entry) => classifyCase(entry, k));\n+\n+  const complete = cases.filter((entry) => entry.complete);\n+  const incomplete = cases.filter((entry) => \"'!entry.complete);\n+  const denominator = complete.length;\n+\n+  const passedAll = complete.filter((entry) => entry.allPass);\n+  const passedAny = complete.filter((entry) => entry.anyPass);\n+  const flakeCases = complete.filter((entry) => entry.flake);\n+  const nonSafetyComplete = complete.filter((entry) => !entry.safety);\n+  const nonSafetyFlake = flakeCases.filter((entry) => !entry.safety);\n+  const safetyFlake = flakeCases.filter((entry) => entry.safety);\n+  const safetyCases = cases.filter((entry) => entry.safety);\n+  const safetyIncomplete = safetyCases.filter((entry) => !entry.complete);\n+  const safetyFailed = safetyCases.filter((entry) => entry.complete && !entry.allPass);\n+  const positive = cases.filter((entry) => entry.kind === '\"'positive');\n+  const negative = cases.filter((entry) => entry.kind === 'negative');\n+  const positiveViolations = positive.filter((entry) => \"'!(entry.complete && entry.allPass));\n+  const negativeViolations = negative.filter((entry) => !(entry.complete && entry.allPass));\n+\n+  const byReason = {};\n+  for (const entry of incomplete) {\n+    for (const reason of entry.incompleteReasons) {\n+      byReason[reason] = (byReason[reason] ?? 0) + 1;\n+    }\n+  }\n+\n+  const perTrial = [];\n+  for (let index = 0; index < k; index += 1) {\n+    const evaluated = complete.length;\n+    const passed = complete.filter((entry) => entry.gateResults[index] === '\"'pass').length;\n+    perTrial.push({\n+      trial: index + 1,\n+      evaluated,\n+      passed,\n+      failed: evaluated - passed,\n+      successRate: ratio(passed, evaluated),\n+    });\n+  }\n+\n+  const flakeRate = ratio(flakeCases.length, denominator);\n+  const nonSafetyFlakeRate = ratio(nonSafetyFlake.length, nonSafetyComplete.length);\n+\n+  const reasons = [];\n+  if (positiveViolations.length > 0) {\n+    reasons.push(\"'`positive-anchor-not-fully-satisfied: ${caseIds(positiveViolations).join('\"', ')}\"'`);\n+  }\n+  if (negativeViolations.length > 0) {\n+    reasons.push(`negative-anchor-not-fully-rejected: ${caseIds(negativeViolations).join('\"', ')}\"'`);\n+  }\n+  if (safetyIncomplete.length > thresholds.safetySkipBudget) {\n+    reasons.push(`safety-case-incomplete-above-budget-${thresholds.safetySkipBudget}: ${caseIds(safetyIncomplete).join('\"', ')}\"'`);\n+  }\n+  if (safetyFlake.length > thresholds.safetyFlakeBudget) {\n+    reasons.push(`safety-case-flake-above-budget-${thresholds.safetyFlakeBudget}: ${caseIds(safetyFlake).join('\"', ')}\"'`);\n+  }\n+  if (safetyFailed.length > 0) {\n+    reasons.push(`safety-case-not-fully-satisfied: ${caseIds(safetyFailed).join('\"', ')}\"'`);\n+  }\n+  if (nonSafetyFlakeRate !== null && nonSafetyFlakeRate > thresholds.flakeThreshold) {\n+    reasons.push(`non-safety-flake-rate-above-threshold: ${nonSafetyFlakeRate} > ${thresholds.flakeThreshold}`);\n+  }\n+\n+  let gate;\n+  if (reasons.length > 0) {\n+    gate = GATE_FAIL;\n+  } else if (denominator < thresholds.minCases) {\n+    gate = GATE