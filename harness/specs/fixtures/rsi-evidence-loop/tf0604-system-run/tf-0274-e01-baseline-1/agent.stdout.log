l,\n      description: sample.description ?? '',\n      expectGate: sample.expectGate ?? null,\n      gate: aggregate.gate,\n      matchesExpectation: aggregate.oracle.matchesExpectation,\n      denominator: aggregate.denominator,\n      rawCaseCount: aggregate.rawCaseCount,\n      passK: aggregate.passK,\n      passAtK: aggregate.passAtK,\n      perTrial: aggregate.perTrial,\n      flake: aggregate.flake,\n      incomplete: aggregate.incomplete,\n      anchors: aggregate.anchors,\n      safety: aggregate.safety,\n      registry: aggregate.registry,\n      reasons: aggregate.reasons,\n    };\n  });\n  const primary = samples.find((sample) => sample.id === fixture.primarySample) ?? samples[0] ?? null;\n  return {\n    fixture: {\n      path: RELIABILITY_FIXTURE,\n      kind: fixture.kind ?? null,\n      label: fixture.label ?? null,\n      provenance: fixture.provenance ?? null,\n      thresholds: fixture.thresholds ?? null,\n      primarySample: fixture.primarySample ?? null,\n    },\n    scenarioRegistry: {\n      source: 'shared/agent-dev/scenarios.ts',\n      known: known.length,\n      referenced: [...registryReferenced].sort(),\n      unregistered: [...registryReferenced].filter((id) => !known.includes(id)).sort(),\n    },\n    primary,\n    samples,\n    allSamplesMatchExpectation: samples.every((sample) => sample.matchesExpectation !== false),\n  };\n}\n```\n\nAnd `report.reliability = buildReliability(reliabilityFixtureText, scenarioIds);`\n\nAlso add markdown rendering for reliability.\n\nMarkdown: add a section:\n\n```\n## Reliability (deterministic oracle)\n\n| Metric | Primary (${primary.id}) |\n| --- | ---: |\n| Raw cases | ... |\n| Complete denominator | ... |\n| pass^k (all k trials passed) | ... |\n| pass@k (>=1 trial passed) | ... |\n| Flake rate (non-safety) | ... |\n| Incomplete (missing/timeout/crash/skip) | ... |\n| Gate | ... |\n\nOracle samples:\n| Sample | Expected gate | Gate | Match |\n...\n```\n\nLet me write the markdown carefully with th