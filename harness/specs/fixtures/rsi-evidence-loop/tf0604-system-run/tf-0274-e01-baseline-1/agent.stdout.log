r\n  });\r\n});\r\n\r\ndescribe('scenario registry is reused, not duplicated', () => {\r\n  it('reports unregistered scenario references instead of inventing a registry', () => {\r\n    const report = aggregateReliability({\r\n      cases: [coverage('known'), { ...coverage('unknown'), scenario: 'not-a-scenario' }],\r\n      knownScenarioIds: registeredScenarioIds,\r\n    });\r\n    expect(report.registry).toMatchObject({ known: registeredScenarioIds.length, referenced: 2, unregistered: ['not-a-scenario'] });\r\n  });\r\n});\r\n\r\ndescribe('pre-registered fixture is a deterministic oracle', () => {\r\n  const samples = fixture.samples as Array<{\r\n    id: string;\r\n    expectGate: string;\r\n    cases: ReliabilityCaseInput[];\r\n  }>;\r\n\r\n  it('labels provenance honestly and pre-registers the design gate', () => {\r\n    expect(fixture.kind).toBe('agent-dev-reliability-fixture');\r\n    expect(fixture.thresholds).toMatchObject({ k: 3, minCases: 20, flakeThreshold: 0.01, safetySkipBudget: 0, safetyFlakeBudget: 0 });\r\n    expect(fixture.provenance).toMatchObject({\r\n      driven_by: 'agent',\r\n      realProvider: false,\r\n      realHuman: false,\r\n      generalizationClaim: false,\r\n    });\r\n  });\r\n\r\n  it('resolves every recorded gate expectation against the aggregator', () => {\r\n    expect(samples.length).toBeGreaterThan(0);\r\n    for (const sample of samples) {\r\n      const report = aggregateReliability({\r\n        sampleId: sample.id,\r\n        cases: sample.cases,\r\n        thresholds: fixture.thresholds,\r\n        knownScenarioIds: registeredScenarioIds,\r\n        expectGate: sample.expectGate,\r\n      });\r\n      expect({ id: sample.id, gate: report.gate }).toEqual({ id: sample.id, gate: sample.expectGate });\r\n      expect(report.oracle.matchesExpectation).toBe(true);\r\n    }\r\n  });\r\n\r\n  it('keeps the primary sample green and every scenario reference registered', () => {\r\n    const primary = samples.find((sample) => sample.id === fixture.primarySample);\r\n    expect(primary).toBeDefined();\r\n    const report = aggregateReliability({\r\n      sampleId: fixture.primarySample,\r\n      cases: primary?.cases ?? [],\r\n      thresholds: fixture.thresholds,\r\n      knownScenarioIds: registeredScenarioIds,\r\n    });\r\n    expect(report.gate).toBe(GATE_PASS);\r\n    expect(report.registry?.unregistered).toEqual([]);\r\n    expect(report.anchors.positive.satisfied).toBe(report.anchors.positive.total);\r\n    expect(report.anchors.negative.satisfied).toBe(report.anchors.negative.total);\r\n    expect(report.safety).toMatchObject({ zeroSkip: true, zeroFlake: true });\r\n  });\r\n\r\n  it('exercises all four incomplete reasons without calling them healthy', () => {\r\n    const reasons = new Set(\r\n      samples.flatMap((sample) => sample.cases.flatMap((entry) => {\r\n        const classified = classifyCase(entry, fixture.thresholds.k);\r\n        return classified.complete ? [] : classified.incompleteReasons;\r\n      })),\r\n    );\r\n    expect([...reasons].sort()).toEqual([...INCOMPLETE_OUTCOMES].sort());\r\n  });\r\n});\r\n\r\ndescribe('benefit report reuses the aggregation and the registry', () => {\r\n  it('wires the shared fixture and aggregator into the existing report', () => {\r\n    expect(benefitEvalSource).toContain(\"from './lib/reliability-aggregation.mjs'\");\r\n    expect(benefitEvalSource).toContain('shared/agent-dev/reliability-fixture.json');\r\n    expect(benefitEvalSource).toContain('report.reliability = buildReliability(');\r\n  });\r\n});\r\n","exit_code":0,"status":"completed"}}
