+\n+/**\n+ * Validate and freeze the aggregate thresholds. Invalid pre-registration is an\n+ * error, not something to paper over with defaults at report time.\n+ */\n+export function normalizeThresholds(thresholds = {}, fallback = DEFAULT_THRESHOLDS) {\n+  const source = thresholds && typeof thresholds === 'object' ? thresholds : {};\n+  const k = source.k ?? fallback.k;\n+  const minCases = source.minCases ?? fallback.minCases;\n+  const flakeThreshold = source.flakeThreshold ?? fallback.flakeThreshold;\n+  const safetySkipBudget = source.safetySkipBudget ?? fallback.safetySkipBudget ?? 0;\n+  const safetyFlakeBudget = source.safetyFlakeBudget ?? fallback.safetyFlakeBudget ?? 0;\n+\n+  if (\"'!isPositiveInteger(k)) {\n+    throw new TypeError(`reliability thresholds: k must be a positive integer, received ${JSON.stringify(source.k)}`);\n+  }\n+  if (!isPositiveInteger(minCases)) {\n+    throw new TypeError(`reliability thresholds: minCases must be a positive integer, received ${JSON.stringify(source.minCases)}`);\n+  }\n+  if (typeof flakeThreshold !== '\"'number' || \"'!Number.isFinite(flakeThreshold) || flakeThreshold < 0 || flakeThreshold > 1) {\n+    throw new TypeError(`reliability thresholds: flakeThreshold must be a ratio within [0, 1], received ${JSON.stringify(source.flakeThreshold)}`);\n+  }\n+  if (!Number.isInteger(safetySkipBudget) || safetySkipBudget < 0) {\n+    throw new TypeError(`reliability thresholds: safetySkipBudget must be a non-negative integer, received ${JSON.stringify(source.safetySkipBudget)}`);\n+  }\n+  if (!Number.isInteger(safetyFlakeBudget) || safetyFlakeBudget < 0) {\n+    throw new TypeError(`reliability thresholds: safetyFlakeBudget must be a non-negative integer, received ${JSON.stringify(source.safetyFlakeBudget)}`);\n+  }\n+\n+  return { k, minCases, flakeThreshold, safetySkipBudget, safetyFlakeBudget };\n+}\n+\n+/** Accept both plain outcome strings and `{ outcome }` records. */\n+export function outcomeOf(trial) {\n+  if (typeof trial === '\"'string') return trial;\n+  if (trial && typeof trial === 'object' && typeof trial.outcome === 'string') return trial.outcome;\n+  return 'missing';\n+}\n+\n+export function isIncompleteOutcome(outcome) {\n+  return INCOMPLETE_OUTCOMES.includes(outcome);\n+}\n+\n+/** \"'`pass` when the observed outcome matches the case expectation. */\n+export function trialResult(trial, expect = '\"'accept') {\n+  const outcome = outcomeOf(trial);\n+  if (isIncompleteOutcome(outcome)) return 'incomplete';\n+  return outcome === expect ? 'pass' : 'fail';\n+}\n+\n+/**\n+ * Classify a single case. The first k trials are the gate trials; any later\n+ * trial is a fixed rerun kept for flake evidence, never as a way to erase the\n+ * original gate failure.\n+ */\n+export function classifyCase(entry = {}, k = DEFAULT_THRESHOLDS.k) {\n+  const id = typeof entry.id === 'string' && entry.id.length > 0 ? entry.id : null;\n+  const kind = CASE_KINDS.includes(entry.kind) ? entry.kind : 'coverage';\n+  const expect = entry.expect === 'reject' ? 'reject' : 'accept';\n+  const safety = entry.safety === true;\n+  const scenario = typeof entry.scenario === 'string' && entry.scenario.length > 0 ? entry.scenario : null;\n+  const trials = Array.isArray(entry.trials) ? entry.trials : [];\n+  const outcomes = trials.map(outcomeOf);\n+  const results = outcomes.map((outcome) => trialResult(outcome, expect));\n+\n+  const incompleteReasons = [];\n+  if (trials.length < k) incompleteReasons.push('missing');\n+  for (const outcome of outcomes) {\n+    if (isIncompleteOutcome(outcome) && \"'!incompleteReasons.includes(outcome)) incompleteReasons.push(outcome);\n+  }\n+\n+  const complete = incompleteReasons.length === 0 && results.length >= k;\n+  const gateResults = results.slice(0, k);\n+  const allPass = complete && gateResults.every((result) => result === '\"'pass');\n+  const anyPass = complete && gateResults.some((result) => result === 'pass');\n+  const firstTrialFailed = complete &