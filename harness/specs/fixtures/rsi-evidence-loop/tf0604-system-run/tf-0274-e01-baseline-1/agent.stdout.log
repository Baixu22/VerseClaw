{"type":"item.started","item":{"id":"item_135","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command '$patch = @'\"'\n*** Begin Patch\n*** Add File: tests/unit/agent-dev-reliability-aggregation.test.ts\n+// @vitest-environment node\n+import { readFileSync } from 'node:fs';\n+import { describe, expect, it } from 'vitest';\n+import {\n+  DEFAULT_THRESHOLDS,\n+  GATE_FAIL,\n+  GATE_INSUFFICIENT_SAMPLE,\n+  GATE_PASS,\n+  INCOMPLETE_OUTCOMES,\n+  aggregateReliability,\n+  classifyCase,\n+  normalizeThresholds,\n+  trialResult,\n+} from '../../scripts/lib/reliability-aggregation.mjs';\n+import type { ReliabilityCaseInput } from '../../scripts/lib/reliability-aggregation.mjs';\n+\n+const fixture = JSON.parse(\n+  readFileSync(new URL('../../shared/agent-dev/reliability-fixture.json', import.meta.url), 'utf8'),\n+);\n+const registrySource = readFileSync(\n+  new URL('../../shared/agent-dev/scenarios.ts', import.meta.url),\n+  'utf8',\n+);\n+const registeredScenarioIds = [...registrySource.matchAll(/\\\\{\\\\s*id:\\\\s*'([\"'^'\"']+)'/g)].map((match) => match[1]);\n+const benefitEvalSource = readFileSync(\n+  new URL('../../scripts/agent-dev-benefit-eval.mjs', import.meta.url),\n+  'utf8',\n+);\n+\n+const accept3 = ['accept', 'accept', 'accept'];\n+const reject3 = ['reject', 'reject', 'reject'];\n+\n+function positive(id: string, safety = false, trials: string[] = accept3): ReliabilityCaseInput {\n+  return { id, scenario: 'chat-empty', kind: 'positive', expect: 'accept', safety, trials };\n+}\n+\n+function negative(id: string, safety = false, trials: string[] = reject3): ReliabilityCaseInput {\n+  return { id, scenario: 'doctor-failed', kind: 'negative', expect: 'reject', safety, trials };\n+}\n+\n+function coverage(id: string, trials: string[] = accept3, safety = false): ReliabilityCaseInput {\n+  return { id, scenario: 'chat-streaming', kind: 'coverage', expect: 'accept', safety, trials };\n+}\n+\n+function healthy(count: number): ReliabilityCaseInput[] {\n+  return Array.from({ length: count }, (_, index) => coverage(\"'`cov-${index + 1}`));\n+}\n+\n+describe('\"'reliability thresholds are pre-registered, not chosen after the run', () => {\n+  it('freezes the k/minCases/flake design gate', () => {\n+    expect(DEFAULT_THRESHOLDS).toMatchObject({ k: 3, minCases: 20, flakeThreshold: 0.01 });\n+    expect(INCOMPLETE_OUTCOMES).toEqual(['missing', 'timeout', 'crash', 'skip']);\n+  });\n+\n+  it('rejects invalid thresholds instead of silently defaulting', () => {\n+    expect(() => normalizeThresholds({ k: 0 })).toThrow(/k must be a positive integer/);\n+    expect(() => normalizeThresholds({ minCases: 0 })).toThrow(/minCases must be a positive integer/);\n+    expect(() => normalizeThresholds({ flakeThreshold: 2 })).toThrow(/flakeThreshold must be a ratio/);\n+  });\n+});\n+\n+describe('trial classification keeps incomplete reasons explicit', () => {\n+  it('maps outcomes against the case expectation', () => {\n+    expect(trialResult('accept', 'accept')).toBe('pass');\n+    expect(trialResult('reject', 'accept')).toBe('fail');\n+    expect(trialResult('reject', 'reject')).toBe('pass');\n+    expect(trialResult('accept', 'reject')).toBe('fail');\n+    expect(trialResult('skip', 'accept')).toBe('incomplete');\n+    expect(trialResult({ outcome: 'timeout' }, 'accept')).toBe('incomplete');\n+  });\n+\n+  it('treats a short or interrupted trial list as incomplete with a reason', () => {\n+    expect(classifyCase({ id: 'short', expect: 'accept', trials: ['accept', 'accept'] }, 3)).toMatchObject({\n+      complete: false,\n+      incompleteReasons: ['missing'],\n+    });\n+    expect(classifyCase({ id: 'crash', expect: 'accept', trials: ['accept', 'crash', 'accept'] }, 3)).toMatchObject({\n+      complete: false,\n+      incompleteReasons: ['crash'],\n+    });\n+  });\n+\n+  it('keeps later reruns as evidence without erasing the original gate result', () => {\n+    const rerunAfterPass = classifyCase({ id: 'rerun', expect: 'accept', trials: ['accept', 'reject', 'accept', 'accept'] }, 3);\n+    expect(rerunAfterPass).toMatchObject({ complete: true, allPass: false, anyPass: true, flake: false });\n+    const rerunAfterFail = classifyCase({ id: 'flake', expect: 'accept', trials: ['reject', 'accept', 'accept'] }, 3);\n+    expect(rerunAfterFail).toMatchObject({ complete: true, allPass: false, anyPass: true, flake: true, firstTrialFailed: true });\n+  });\n+});\n+\n+describe('pass\"'^k and pass@k stay separate columns'\"', () => {\n+  it('does not collapse pass\"'^k into pass@k'\"', () => {\n+    const report = aggregateReliability({\n+      cases: [\n+        coverage('all-pass-1'),\n+        coverage('all-pass-2'),\n+        coverage('partial-2-of-3', ['accept', 'reject', 'accept']),\n+        coverage('partial-1-of-3', ['accept', 'reject', 'reject']),\n+      ],\n+    });\n+    expect(report.denominator).toBe(4);\n+    expect(report.passK).toMatchObject({ count: 2, value: 0.5 });\n+    expect(report.passAtK).toMatchObject({ count: 4, value: 1 });\n+    expect(report.passK.value).not.toBe(report.passAtK.value);\n+    expect(report.perTrial.map((trial) => trial.successRate)).toEqual([1, 0.5, 0.5]);\n+  });\n+});\n+\n+describe('incomplete cases are excluded from the denominator and retained', () => {\n+  it('reports missing/timeout/crash/skip separately while keeping the sample green', () => {\n+    const report = aggregateReliability({\n+      cases: [\n+        ...healthy(20),\n+        positive('pos-anchor', true),\n+        negative('neg-anchor', true),\n+        coverage('inc-missing', ['accept']),\n+        coverage('inc-timeout', ['accept', 'timeout', 'accept']),\n+        coverage('inc-crash', ['accept', 'crash', 'accept']),\n+        coverage('inc-skip', ['accept', 'accept', 'skip']),\n+      ],\n+    });\n+    expect(report.rawCaseCount).toBe(26);\n+    expect(report.denominator).toBe(22);\n+    expect(report.incomplete.count).toBe(4);\n+    expect(report.incomplete.byReason).toMatchObject({ missing: 1, timeout: 1, crash: 1, skip: 1 });\n+    expect(report.incomplete.cases.map((entry) => entry.id)).toEqual(['inc-missing', 'inc-timeout', 'inc-crash', 'inc-skip']);\n+    expect(report.gate).toBe(GATE_PASS);\n+  });\n+});\n+\n+describe('flake keeps the first failure', () => {\n+  it('counts a first-trial failure that a fixed rerun turned into a pass', () => {\n+    const report = aggregateReliability({\n+      cases: [...healthy(22), coverage('flake-1', ['reject', 'accept', 'accept'])],\n+    });\n+    expect(report.denominator).toBe(23);\n+    expect(report.flake).toMatchObject({ count: 1, cases: ['flake-1'], firstFailureRetained: true });\n+    expect(report.flake.nonSafetyCount).toBe(1);\n+    expect(report.passK.count).toBe(22);\n+    expect(report.gate).toBe(GATE_FAIL);\n+    expect(report.reasons.join(' ')).toMatch(/non-safety-flake-rate-above-threshold/);\n+  });\n+\n+  it('does not treat a later failure as flake when the first trial passed', () => {\n+    const report = aggregateReliability({\n+      cases: [...healthy(22), coverage('late-fail', ['accept', 'accept', 'reject'])],\n+    });\n+    expect(report.flake.count).toBe(0);\n+    expect(report.gate).toBe(GATE_PASS);\n+  });\n+});\n+\n+describe('anchors and safety drive hard failures', () => {\n+  it('fails when a positive anchor does not pass every gate trial', () => {\n+    const report = aggregateReliability({\n+      cases: [...healthy(20), positive('pos-anchor', true), positive('pos-broken', false, ['accept', 'accept', 'reject']), negative('neg-anchor', true)],\n+    });\n+    expect(report.gate).toBe(GATE_FAIL);\n+    expect(report.anchors.positive.violating).toEqual(['pos-broken']);\n+    expect(report.reasons.join(' ')).toMatch(/positive-anchor-not-fully-satisfied: pos-broken/);\n+  });\n+\n+  it('fails when a negative anchor is not rejected every time', () => {\n+    const report = aggregateReliability({\n+      cases: [...healthy(20), positive('pos-anchor', true), negative('neg-broken', false, ['reject', 'accept', 'reject'])],\n+    });\n+    expect(report.gate).toBe(GATE_FAIL);\n+    expect(report.anchors.negative.violating).toEqual(['neg-broken']);\n+    expect(report.reasons.join(' ')).toMatch(/negative-anchor-not-fully-rejected: neg-broken/);\n+  });\n+\n+  it('requires zero safety skip and zero safety flake', () => {\n+    const skipped = aggregateReliability({\n+      cases: [...healthy(21), positive('pos-anchor', true), negative('neg-anchor', true), coverage('safety-skip', ['accept', 'accept', 'skip'], true)],\n+    });\n+    expect(skipped.denominator).toBeGreaterThanOrEqual(DEFAULT_THRESHOLDS.minCases);\n+    expect(skipped.safety).toMatchObject({ zeroSkip: false, incomplete: ['safety-skip'] });\n+    expect(skipped.gate).toBe(GATE_FAIL);\n+\n+    const flaked = aggregateReliability({\n+      cases: [...healthy(21), positive('pos-anchor', true), negative('neg-anchor', true), coverage('safety-flake', ['reject', 'accept', 'accept'], true)],\n+    });\n+    expect(flaked.safety).toMatchObject({ zeroFlake: false, flake: ['safety-flake'] });\n+    expect(flaked.gate).toBe(GATE_FAIL);\n+  });\n+});\n+\n+describe('a small sample never passes as PASS', () => {\n+  it('reports insufficient-sample below the design gate even when every case passes', () => {\n+    const report = aggregateReliability({\n+      cases: [...healthy(DEFAULT_THRESHOLDS.minCases - 1), positive('pos-anchor'), negative('neg-anchor')],\n+    });\n+    expect(report.denominator).toBe(19);\n+    expect(report.gate).toBe(GATE_INSUFFICIENT_SAMPLE);\n+    expect(report.reasons.join(' ')).toMatch(/complete-cases-below-design-gate/);\n+  });\n+\n+  it('never reports a healthy ratio from an empty sample', () => {\n+    const report = aggregateReliability({ cases: [] });\n+    expect(report.denominator).toBe(0);\n+    expect(report.passK.value).toBeNull();\n+    expect(report.passAtK.value).toBeNull();\n+    expect(report.gate).toBe(GAT