{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Write-Output \"=== tests/unit/harness-gap-trace-cost-sampling.test.ts (head) ===\"; Get-Content tests/unit/harness-gap-trace-cost-sampling.test.ts -TotalCount 60; Write-Output \"=== tests/unit/harness-gap-baseline.test.ts ===\"; Get-Content tests/unit/harness-gap-baseline.test.ts -Raw'","aggregated_output":"=== tests/unit/harness-gap-trace-cost-sampling.test.ts (head) ===\r\n// @vitest-environment node\r\nimport { afterEach, describe, expect, it } from 'vitest';\r\nimport { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';\r\nimport { tmpdir } from 'node:os';\r\nimport { join } from 'node:path';\r\nimport { wrapStreamFnWithDiagnosticModelCallEvents } from '../../openclaw_runtime/src/agents/embedded-agent-runner/run/attempt.model-diagnostic-events';\r\nimport { createDiagnosticTraceContext } from '../../openclaw_runtime/src/infra/diagnostic-trace-context';\r\nimport { onInternalDiagnosticEvent, setDiagnosticsEnabledForProcess, waitForDiagnosticEventsDrained } from '../../openclaw_runtime/src/infra/diagnostic-events';\r\nimport type { DiagnosticEventPayload } from '../../openclaw_runtime/src/infra/diagnostic-events';\r\nimport type { StreamFn } from '../../openclaw_runtime/src/agents/runtime';\r\nimport type { Model, AssistantMessageEvent, AssistantMessage } from '../../openclaw_runtime/packages/llm-core/src/types';\r\n\r\nconst model = { id: 'fixture', name: 'fixture', provider: 'fixture', api: 'openai-completions', baseUrl: 'http://127.0.0.1', reasoning: false, input: ['text'], cost: { input: 2, output: 8, cacheRead: .5, cacheWrite: 3 }, contextWindow: 4096, maxTokens: 1024 } as Model;\r\nconst usage = { input: 100, output: 20, cacheRead: 50, cacheWrite: 10, totalTokens: 180, cost: { input: 99, output: 99, cacheRead: 99, cacheWrite: 99, total: 999 } };\r\nconst finalMessage = (extra: Partial<AssistantMessage> = {}): AssistantMessage => ({ role: 'assistant', api: model.api, provider: model.provider, model: model.id, content: [{ type: 'text', text: 'PRIVATE response body' }, { type: 'toolCall', id: 'private-tool-call-1', name: 'write', arguments: { content: 'PRIVATE tool body' } }], usage, stopReason: 'toolUse', timestamp: 1, ...extra });\r\nconst done = (message = finalMessage()): AssistantMessageEvent => ({ type: 'done', reason: 'toolUse', message });\r\nconst roots: string[] = [];\r\nafterEach(async () => { for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true }); });\r\nasync function observe(chunks: AssistantMessageEvent[], options: { enabled?: boolean; model?: Model; signal?: AbortSignal; callId?: string; failure?: Error } = {}) {\r\n  setDiagnosticsEnabledForProcess(true);\r\n  const events: DiagnosticEventPayload[] = [];\r\n  const unsubscribe = onInternalDiagnosticEvent(event => { if (event.type.startsWith('model.call.')) events.push(event); });\r\n  const yielded: unknown[] = [];\r\n  const parent = createDiagnosticTraceContext({ traceId: '1234567890abcdef1234567890abcdef', spanId: '1234567890abcdef' });\r\n  let calls = 0;\r\n  const original = (() => (async function* () { calls++; for (const chunk of chunks) yield chunk; if (options.failure) throw options.failure; })()) as unknown as StreamFn;\r\n  const wrapped = wrapStreamFnWithDiagnosticModelCallEvents(original, { runId: 'PRIVATE run', sessionKey: 'agent:PRIVATE session', sessionId: 'PRIVATE session-id', provider: model.provider, model: model.id, trace: parent, nextCallId: () => options.callId ?? 'same-call-id', costDiagnosticsEnabled: options.enabled ?? true });\r\n  let error: unknown;\r\n  try { for await (const chunk of wrapped(options.model ?? model, { messages: [], systemPrompt: 'PRIVATE prompt' }, { signal: options.signal }) as AsyncIterable<unknown>) yielded.push(chunk); } catch (caught) { error = caught; }\r\n  await waitForDiagnosticEventsDrained(); unsubscribe();\r\n  return { events, yielded, error, calls, parent };\r\n}\r\nconst terminal = (events: DiagnosticEventPayload[]) => events.findLast(event => event.type === 'model.call.completed' || event.type === 'model.call.error')!;\r\n\r\ndescribe('O02 actual model-call stream producer', () => {\r\n  it('joins host request/attempt identity and estimates terminal usage without mutating upstream cost or stream', async () => {\r\n    const chunk = done(); const before = JSON.stringify(chunk);\r\n    const result = await observe([chunk]); const ended = terminal(result.events);\r\n    expect(result.yielded[0]).toBe(chunk); expect(JSON.stringify(chunk)).toBe(before); expect(result.calls).toBe(1);\r\n    expect(ended).toMatchObject({ requestId: expect.any(String), attemptId: result.parent.spanId, usageSnapshot: { terminal: 'done', usage: { input: 100, output: 20, cacheRead: 50, cacheWrite: 10, total: 180 }, costUsd: .000415, price: { state: 'known', currency: 'USD', unit: 'per-million-tokens', source: 'runtime-model-catalog', version: expect.stringMatching(/^[a-f0-9]{64}$/) }, toolCallIdHashes: [expect.stringMatching(/^[a-f0-9]{64}$/)] } });\r\n    const snapshot = JSON.stringify((ended as { usageSnapshot?: unknown }).usageSnapshot);\r\n    expect(snapshot).not.toContain('PRIVATE'); expect(snapshot).not.toContain('private-tool-call');\r\n  });\r\n  it('distinguishes retry requests even if the legacy callId repeats', async () => {\r\n    const first = terminal((await observe([done()])).events) as { requestId?: string };\r\n    const second = terminal((await observe([done()])).events) as { requestId?: string };\r\n    expect(first.requestId).toBeTruthy(); expect(second.requestId).not.toBe(first.requestId);\r\n  });\r\n  it('does not accumulate duplicate final snapshots or overwrite them with later partials', async () => {\r\n    const chunk = done(); const partial = { type: 'text_delta', contentIndex: 0, delta: '', partial: finalMessage({ usage: { ...usage, input: 900 } }) } as AssistantMessageEvent;\r\n    const result = await observe([chunk, partial, chunk]);\r\n    expect(terminal(result.events)).toMatchObject({ usageSnapshot: { terminal: 'done', usage: { input: 100 }, costUsd: .000415 } });\r\n    expect(result.yielded).toHaveLength(3);\r\n  });\r\n  it('marks conflicting terminal payloads unavailable instead of picking a billing winner', async () => {\r\n    const result = await observe([done(), done(finalMessage({ usage: { ...usage, input: 101 } }))]);\r\n    expect(terminal(result.events)).toMatchObject({ usageSnapshot: { terminal: 'conflicting', usage: null, costUsd: null } });\r\n  });\r\n  it.each([undefined, { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, { input: -1, output: 2, cacheRead: 0, cacheWrite: 0 }])('does not treat missing/zero/invalid price %j as free', async cost => {\r\n    const result = await observe([done()], { model: { ...model, cost } as Model });\r\n=== tests/unit/harness-gap-baseline.test.ts ===\r\n// @vitest-environment node\nimport { createHash } from 'node:crypto';\nimport { readFileSync } from 'node:fs';\nimport { afterEach, describe, expect, it } from 'vitest';\nimport { validateBaseline, verifyReferences } from '../../scripts/check-harness-gap-baseline.mjs';\nimport { codingObservability } from '../../openclaw_runtime/src/context-engine/coding-observability';\nimport { wrapToolWithDestructiveTier } from '../../openclaw_runtime/src/agents/write-destructive-tier';\n\nconst inventory = JSON.parse(readFileSync(new URL('../../docs/dev/harness-gap-closure/source-inventory.json', import.meta.url), 'utf8'));\n\ndescribe('B00 baseline structure, not current runtime acceptance', () => {\n  it('keeps 30 source slots, 29 packets and six separate original pilot contracts', () => {\n    expect(validateBaseline(inventory)).toMatchObject({ ok: true, level: 'structure', counts: { slots: 30, packets: 29 } });\n  });\n\n  const mutations: [string, (data: typeof inventory) => void, string][] = [\n    ['malformed packet', (d) => { d.packets[0] = null; }, 'invalid inventory shape'],\n    ['malformed slot', (d) => { d.slots[0] = null; }, 'invalid inventory shape'],\n    ['missing slot', (d) => d.slots.pop(), 'exactly HG01-HG30'],\n    ['duplicate slot', (d) => { d.slots[0].id = 'HG02'; }, 'exactly HG01-HG30'],\n    ['unknown owner', (d) => { d.slots[0].owner = 'Z99'; }, 'unknown owner'],\n    ['wrong existing owner', (d) => { d.slots[0].owner = 'O01'; }, 'slot owner mismatch'],\n    ['invented missing text', (d) => { d.slots.find((s: { id: string }) => s.id === 'HG22').originalText = 'invented'; }, 'missing source invented'],\n    ['constraint as bug', (d) => { d.slots.find((s: { id: string }) => s.id === 'HG26').assessment = 'partial'; }, 'HG26 is a constraint'],\n    ['missing packet', (d) => d.packets.pop(), '29 unique packet'],\n    ['duplicate packet', (d) => { d.packets[0].code = d.packets[1].code; }, '29 unique packet'],\n    ['duplicate task identity', (d) => { d.packets[0].taskId = d.packets[1].taskId; }, 'unique task ownership'],\n    ['directory-wide scope', (d) => { d.packets[0].candidateFiles[0].path = 'electron/services/**'; }, 'exact candidate files'],\n    ['path traversal', (d) => { d.packets[0].candidateFiles[0].path = '../outside.ts'; }, 'exact candidate files'],\n    ['missing entry', (d) => { d.packets[0].entryRefs = []; }, 'explicit entry'],\n    ['invalid spec', (d) => { d.packets[0].spec.path = 'harness/specs/tasks/'; }, 'invalid task spec'],\n    ['missing test target', (d) => { d.packets[0].testTargets = []; }, 'test targets'],\n    ['missing non-goals', (d) => { d.packets[0].nonGoals = []; }, 'non-goals'],\n    ['unknown reference', (d) => { d.slots[0].sourceRefs = ['not-present']; }, 'missing slot source'],\n    ['unfrozen product lock', (d) => { d.productLocks.values.default_on = true; }, 'product locks'],\n    ['fixture as default', (d) => { d.experimentParameters.scope = 'production'; }, 'experiment/default separation'],\n    ['human attribution', (d) => { d.driven_by = 'real-human'; }, 'agent attribution'],\n    ['reused pilot pass', (d) => { d.packets.find((p: { pilotContract?: unknown }) => p.pilotContract).pilotContract.acceptanceReused = true; }, 'pilot acceptance cannot be reused'],\n    ['reused old report', (d) => { d.historicalEvidence[0].reusableForCurrentAcceptance = true; }, 'historical evidence'],\n    ['missing candidate', (d) => { d.sourceBaseline.commit = null; }, 'source candidate identity'],\n  ];\n  it.each(mutations)('rejects %s', (_name, mutate, expected) => {\n    const changed = structuredClone(inventory);\n    mutate(changed);\n    const result = validateBaseline(changed);\n    expect(result.ok).toBe(false);\n    expect(result.errors.join('\\n')).toContain(expected);\n  });\n\n  it('fails closed for malformed input', () => {\n    for (const value of [null, [], {}, { slots: [] }]) expect(validateBaseline(value).ok).toBe(false);\n  });\n});\n\ndescribe('current-source verifier uses immutable tiny fixtures', () => {\n  const text = 'fixture\\nexport function owned() {}\\n';\n  const refs = { fixture: { path: 'fixture.ts', line: 2, anchor: 'export function owned() {}',\n    sha256: createHash('sha256').update(text).digest('hex') } };\n  it('accepts the exact source and CRLF-equivalent text', () => {\n    expect(verifyReferences(refs, () => text)).toEqual([]);\n    expect(verifyReferences(refs, () => text.replace(/\\n/g, '\\r\\n'))).toEqual([]);\n  });\n  it('rejects changed source bytes and a wrong symbol anchor', () => {\n    expect(verifyReferences(refs, () => text.replace('owned', 'other')).join('\\n')).toContain('source digest drift');\n    expect(verifyReferences(refs, () => text.replace('owned', 'other')).join('\\n')).toContain('source anchor drift');\n  });\n  it('rejects missing input and succeeds after the source is restored', () => {\n    expect(verifyReferences(refs, () => { throw new Error('missing'); }).join('\\n')).toContain('source missing');\n    expect(verifyReferences(refs, () => text)).toEqual([]);\n  });\n  it('does not read an unsafe path', () => {\n    let reads = 0;\n    const bad = { fixture: { ...refs.fixture, path: '../fixture.ts' } };\n    expect(verifyReferences(bad, () => { reads++; return text; }).join('\\n')).toContain('unsafe source path');\n    expect(reads).toBe(0);\n  });\n});\n\ndescribe('approval-rate measurement boundary counterexamples', () => {\n  afterEach(() => codingObservability.reset());\n  it('zero decisions and zero measured prompts share rate=0, so sample metadata is required', () => {\n    codingObservability.reset();\n    expect(codingObservability.rates().approvalPromptRate).toBe(0);\n    expect(codingObservability.snapshot().approvalPrompts + codingObservability.snapshot().approvalSkips).toBe(0);\n    codingObservability.recordApprovalSkip();\n    expect(codingObservability.rates().approvalPromptRate).toBe(0);\n    expect(codingObservability.snapshot().approvalSkips).toBe(1);\n  });\n  it('the real tier wrapper counts a classification even without an approval UI', async () => {\n    codingObservability.reset();\n    let effects = 0;\n    const tool = { name: 'write', label: 'fixture', description: 'synthetic tool effect',\n      parameters: { type: 'object', properties: {} } as never,\n      execute: async () => { effects++; return { content: [{ type: 'text' as const, text: 'fixture' }], details: {} }; } };\n    const wrapped = wrapToolWithDestructiveTier(tool, { journalEnabled: false });\n    await wrapped.execute('fixture-call', { path: 'fixture.txt', content: 'fixture' });\n    expect(effects).toBe(1);\n    expect(codingObservability.snapshot().approvalPrompts).toBe(1);\n    expect(codingObservability.rates().approvalPromptRate).toBe(1);\n  });\n});\n\n// This reader is synthetic, so future runtime edits do not silently mutate an old baseline.\ndescribe('full verifier source/spec checks', () => {\n  function fixture() {\n    const data = structuredClone(inventory);\n    const files = new Map<string, string>();\n    for (const [id, ref] of Object.entries(data.references) as [string, { path: string; line: number; anchor: string; sha256: string }][]) {\n      const text = id === 'plan'\n        ? ['fixture', ...data.slots.map((s: { id: string; owner: string }) => `| ${s.id} | topic | ${s.owner} | source |`),\n          `| E | packets | ${data.packets.map((p: { code: string }) => p.code).join('、')} | purpose |`].join('\\n')\n        : 'fixture';\n      Object.assign(ref, { path: 'fixtures/' + id.replaceAll(':', '-') + '.md', line: 1, anchor: 'fixture',\n        sha256: createHash('sha256').update(text).digest('hex') });\n      files.set(ref.path, text);\n    }\n    for (const packet of data.packets) {\n      for (const spec of [...packet.reuseSpecs, ...(packet.spec.state === 'existing' ? [packet.spec.path] : [])])\n        files.set(spec, '---\\nid: fixture\\n---');\n      for (const file of packet.candidateFiles.filter((f: { state: string }) => f.state === 'existing')) files.set(file.path, 'fixture');\n      for (const test of packet.testTargets.filter((t: { state: string }) => t.state === 'existing')) files.set(test.target, 'fixture');\n    }\n    for (const packet of data.packets.filter((p: { pilotContract?: unknown }) => p.pilotContract))\n      files.set(packet.spec.path, '---\\nid: ' + packet.code + '\\n' + ['acceptance', 'requiredTests', 'requiredProfiles'].map(key => key + ':\\n' + packet.pilotContract[key].map((value: string) => '  - ' + value).join('\\n')).join('\\n') + '\\n---');\n    const read = (path: string) => { if (!files.has(path)) throw new Error('missing: ' + path); return files.get(path)!; };\n    return { data, files, read };\n  }\n  it('accepts the complete reader-backed contract', () => {\n    const { data, read } = fixture();\n    expect(validateBaseline(data, read).errors).toEqual([]);\n    expect(validateBaseline(data, read)).toMatchObject({ ok: true, level: 'current-sources' });\n  });\n  it('rejects a nonexistent existing spec, then accepts its restoration', () => {\n    const { data, files, read } = fixture();\n    const path = data.packets[0].reuseSpecs[0];\n    const text = files.get(path)!; files.delete(path);\n    expect(validateBaseline(data, read).errors.join('\\n')).toContain('source/spec read failed');\n    files.set(path, text); expect(validateBaseline(data, read).ok).toBe(true);\n  });\n  it('rejects an existing spec without an id', () => {\n    const { data, files, read } = fixture();\n    files.set(data.packets[0].reuseSpecs[0], '---\\ntitle: no id\\n---');\n    expect(validateBaseline(data, read).errors.join('\\n')).toContain('invalid existing spec');\n  });\n  it('rejects changed pilot thresholds rather than trusting copied declarations', () => {\n    const { data, read } = fixture();\n    data.packets.find((p: { pilotContract?: unknown }) => p.pilotContract).pilotContract.acceptance.push('weakened threshold');\n    expect(validateBaseline(data, read).errors.join('\\n')).toContain('original pilot gate changed');\n  });\n  it('rejects a missing existing candidate file', () => {\n    const { data, files, read } = fixture();\n    files.delete(data.packets[0].candidateFiles.find((f: { state: string }) => f.state === 'existing').path);\n    expect(validateBaseline(data, read).errors.join('\\n')).toContain('source/spec read failed');\n  });\n});\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Write-Output \"=== harness/src/specs.mjs ===\"; Get-Content harness/src/specs.mjs -Raw'","aggregated_output":"=== harness/src/specs.mjs ===\r\nimport { readFile, readdir } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nexport const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..');\nexport const SPEC_ROOT = path.join(ROOT, 'harness', 'specs');\n\nfunction parseScalar(value) {\n  const trimmed = value.trim();\n  if (trimmed === 'true') return true;\n  if (trimmed === 'false') return false;\n  if (trimmed === 'null') return null;\n  if ((trimmed.startsWith('\"') && trimmed.endsWith('\"')) || (trimmed.startsWith(\"'\") && trimmed.endsWith(\"'\"))) {\n    return trimmed.slice(1, -1);\n  }\n  return trimmed;\n}\n\nexport function parseFrontmatter(markdown) {\n  const match = markdown.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n  if (!match) {\n    throw new Error('Spec must start with Markdown frontmatter');\n  }\n\n  const data = {};\n  let currentKey = null;\n  let nestedKey = null;\n\n  for (const rawLine of match[1].split('\\n')) {\n    if (!rawLine.trim() || rawLine.trimStart().startsWith('#')) continue;\n    const indent = rawLine.match(/^ */)?.[0].length ?? 0;\n    const line = rawLine.trim();\n\n    if (indent === 0) {\n      const keyMatch = line.match(/^([A-Za-z0-9_-]+):(.*)$/);\n      if (!keyMatch) continue;\n      const [, key, rawValue] = keyMatch;\n      currentKey = key;\n      nestedKey = null;\n      data[key] = rawValue.trim() ? parseScalar(rawValue) : [];\n      continue;\n    }\n\n    if (indent === 2 && line.startsWith('- ')) {\n      if (!currentKey) continue;\n      if (!Array.isArray(data[currentKey])) data[currentKey] = [];\n      data[currentKey].push(parseScalar(line.slice(2)));\n      continue;\n    }\n\n    if (indent === 2) {\n      const keyMatch = line.match(/^([A-Za-z0-9_-]+):(.*)$/);\n      if (!keyMatch || !currentKey) continue;\n      const [, key, rawValue] = keyMatch;\n      if (!data[currentKey] || Array.isArray(data[currentKey])) data[currentKey] = {};\n      nestedKey = key;\n      data[currentKey][key] = rawValue.trim() ? parseScalar(rawValue) : [];\n      continue;\n    }\n\n    if (indent === 4 && line.startsWith('- ') && currentKey && nestedKey) {\n      if (!data[currentKey] || Array.isArray(data[currentKey])) data[currentKey] = {};\n      if (!Array.isArray(data[currentKey][nestedKey])) data[currentKey][nestedKey] = [];\n      data[currentKey][nestedKey].push(parseScalar(line.slice(2)));\n    }\n  }\n\n  return {\n    data,\n    body: markdown.slice(match[0].length).trim(),\n  };\n}\n\nexport async function loadSpec(specPath) {\n  const fullPath = path.resolve(ROOT, specPath);\n  const markdown = await readFile(fullPath, 'utf8');\n  return {\n    path: path.relative(ROOT, fullPath),\n    ...parseFrontmatter(markdown),\n  };\n}\n\nasync function listMarkdownFiles(dir) {\n  try {\n    const entries = await readdir(dir, { withFileTypes: true });\n    return entries\n      .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n      .map((entry) => path.join(dir, entry.name))\n      .sort();\n  } catch {\n    return [];\n  }\n}\n\nasync function listMarkdownFilesRecursive(dir) {\n  try {\n    const entries = (await readdir(dir, { withFileTypes: true }))\n      .sort((a, b) => a.name.localeCompare(b.name));\n    const files = [];\n    for (const entry of entries) {\n      const fullPath = path.join(dir, entry.name);\n      if (entry.isDirectory()) {\n        files.push(...await listMarkdownFilesRecursive(fullPath));\n      } else if (entry.isFile() && entry.name.endsWith('.md')) {\n        files.push(fullPath);\n      }\n    }\n    return files.sort();\n  } catch {\n    return [];\n  }\n}\n\nexport async function loadScenarioSpecs() {\n  const files = await listMarkdownFiles(path.join(SPEC_ROOT, 'scenarios'));\n  const specs = [];\n  for (const file of files) {\n    const spec = await loadSpec(path.relative(ROOT, file));\n    specs.push(spec);\n  }\n  return specs;\n}\n\nexport async function loadRuleSpecs() {\n  const files = await listMarkdownFiles(path.join(SPEC_ROOT, 'rules'));\n  const specs = [];\n  for (const file of files) {\n    const spec = await loadSpec(path.relative(ROOT, file));\n    specs.push(spec);\n  }\n  return specs;\n}\n\nexport async function loadGuideSpecs() {\n  const files = await listMarkdownFilesRecursive(path.join(SPEC_ROOT, 'guides'));\n  const specs = [];\n  for (const file of files) {\n    const spec = await loadSpec(path.relative(ROOT, file));\n    specs.push(spec);\n  }\n  return specs;\n}\n\nexport async function loadLayerSpecs() {\n  const files = await listMarkdownFilesRecursive(path.join(SPEC_ROOT, 'layers'));\n  const specs = [];\n  for (const file of files) {\n    const spec = await loadSpec(path.relative(ROOT, file));\n    specs.push(spec);\n  }\n  return specs;\n}\n\nexport function toArray(value) {\n  if (Array.isArray(value)) return value;\n  if (value == null || value === '') return [];\n  return [value];\n}\n\n// Task identity comes from the spec's location, not from a `scenario:` key.\n// Rule, guide and layer specs may carry `scenario:`/`scenarios:` to declare\n// which registered scenario they apply to. That metadata is not a task\n// declaration, so only specs under `harness/specs/tasks/` are treated as\n// tasks. Pathless unit fixtures keep the legacy behaviour unless they\n// declare a non-task spec type. Classifying the\n// dcs-stage5-sekb-closure-boundary rule spec as a task made the CLI demand\n// task-only fields from it and fail every validate (issue #153).\nconst TASK_SPEC_PREFIX = 'harness/specs/tasks/';\nconst NON_TASK_SPEC_TYPES = new Set(['ai-coding-rule', 'rule', 'guide', 'layer-spec', 'scenario']);\n\nexport function isTaskSpec(spec) {\n  const normalized = String(spec?.path ?? '').replaceAll('\\\\', '/');\n  if (normalized) return normalized.startsWith(TASK_SPEC_PREFIX);\n  return !NON_TASK_SPEC_TYPES.has(spec?.data?.type);\n}\n\nexport function isGatewayBackendCommunicationTask(spec) {\n  if (!isTaskSpec(spec)) return false;\n  return spec.data?.scenario === 'gateway-backend-communication'\n    || toArray(spec.data?.scenarios).includes('gateway-backend-communication');\n}\n\nexport function isPluginLifecycleTask(spec) {\n  if (!isTaskSpec(spec)) return false;\n  return spec.data?.scenario === 'plugin-lifecycle-management'\n    || toArray(spec.data?.scenarios).includes('plugin-lifecycle-management');\n}\n\nexport function globToRegExp(glob) {\n  const escaped = glob\n    .replace(/[.+^${}()|[\\]\\\\]/g, '\\\\$&')\n    .replace(/\\*\\*/g, '::DOUBLE_STAR::')\n    .replace(/\\*/g, '[^/]*')\n    .replace(/::DOUBLE_STAR::/g, '.*');\n  return new RegExp(`^${escaped}$`);\n}\n\nexport function pathMatchesAny(filePath, patterns) {\n  return patterns.some((pattern) => globToRegExp(pattern).test(filePath));\n}\n\r\n","exit_code":0,"status":"completed"}}
