\n+export function outcomeOf(trial: string | ReliabilityTrialInput | null | undefined): string;\n+export function isIncompleteOutcome(outcome: unknown): boolean;\n+export function trialResult(trial: string | ReliabilityTrialInput | null | undefined, expect?: ReliabilityExpectation): ReliabilityTrialResult;\n+export function classifyCase(entry?: ReliabilityCaseInput, k?: number): ReliabilityClassifiedCase;\n+export function aggregateReliability(input?: ReliabilityAggregateInput): ReliabilityAggregate;\n+\n+export default aggregateReliability;\n*** End Patch\n'@\n\"'$patch | & \"C:'\"\\\\Users\\\\27933\\\\.local\\\\bin\\\\apply_patch.ps1\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
