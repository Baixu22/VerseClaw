{"type":"item.started","item":{"id":"item_139","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command '$verify = @'\"'\nimport { readFileSync } from 'node:fs';\nimport { resolve } from 'node:path';\nimport { pathToFileURL } from 'node:url';\n\nconst ROOT = process.argv[2];\nconst mod = await import(pathToFileURL(resolve(ROOT, 'scripts/lib/reliability-aggregation.mjs')).href);\nconst { aggregateReliability, classifyCase, DEFAULT_THRESHOLDS, INCOMPLETE_OUTCOMES, GATE_PASS, GATE_FAIL, GATE_INSUFFICIENT_SAMPLE, normalizeThresholds } = mod;\n\nconst fixture = JSON.parse(readFileSync(resolve(ROOT, 'shared/agent-dev/reliability-fixture.json'), 'utf8'));\nconst registrySource = readFileSync(resolve(ROOT, 'shared/agent-dev/scenarios.ts'), 'utf8');\nconst registeredScenarioIds = [...registrySource.matchAll(/\\\\{\\\\s*id:\\\\s*'([\"'^'\"']+)'/g)].map((m) => m[1]);\n\nconst accept3 = ['accept', 'accept', 'accept'];\nconst reject3 = ['reject', 'reject', 'reject'];\nconst positive = (id, safety = false, trials = accept3) => ({ id, scenario: 'chat-empty', kind: 'positive', expect: 'accept', safety, trials });\nconst negative = (id, safety = false, trials = reject3) => ({ id, scenario: 'doctor-failed', kind: 'negative', expect: 'reject', safety, trials });\nconst coverage = (id, trials = accept3, safety = false) => ({ id, scenario: 'chat-streaming', kind: 'coverage', expect: 'accept', safety, trials });\nconst healthy = (n) => Array.from({ length: n }, (_, i) => coverage(\"'`cov-${i + 1}`));\n\nlet failed = 0;\nfunction check(label, condition, extra = '\"'') {\n  if (\"'!condition) { failed += 1; console.log('\"'FAIL', label, extra); }\n  else console.log('ok  ', label);\n}\nconst eq = (a, b) => JSON.stringify(a) === JSON.stringify(b);\n\ncheck('defaults', eq([DEFAULT_THRESHOLDS.k, DEFAULT_THRESHOLDS.minCases, DEFAULT_THRESHOLDS.flakeThreshold], [3, 20, 0.01]));\ncheck('incomplete vocab', eq(INCOMPLETE_OUTCOMES, ['missing', 'timeout', 'crash', 'skip']));\nlet threw = false; try { normalizeThresholds({ k: 0 }); } catch { threw = true; }\ncheck('throws k=0', threw);\n\nconst p = aggregateReliability({ cases: [coverage('all-pass-1'), coverage('all-pass-2'), coverage('partial-2-of-3', ['accept', 'reject', 'accept']), coverage('partial-1-of-3', ['accept', 'reject', 'reject'])] });\ncheck('passK count', p.passK.count === 2 && p.passK.value === 0.5, JSON.stringify(p.passK));\ncheck('passAtK', p.passAtK.count === 4 && p.passAtK.value === 1, JSON.stringify(p.passAtK));\ncheck('perTrial', eq(p.perTrial.map((t) => t.successRate), [1, 0.5, 0.75]), JSON.stringify(p.perTrial.map((t) => t.successRate)));\n\nconst inc = aggregateReliability({ cases: [...healthy(20), positive('pos-anchor', true), negative('neg-anchor', true), coverage('inc-missing', ['accept']), coverage('inc-timeout', ['accept', 'timeout', 'accept']), coverage('inc-crash', ['accept', 'crash', 'accept']), coverage('inc-skip', ['accept', 'accept', 'skip'])] });\ncheck('inc raw', inc.rawCaseCount === 26 && inc.denominator === 22, \"'`${inc.rawCaseCount}/${inc.denominator}`);\ncheck('\"'inc byReason', eq(inc.incomplete.byReason, { missing: 1, timeout: 1, crash: 1, skip: 1 }), JSON.stringify(inc.incomplete.byReason));\ncheck('inc ids', eq(inc.incomplete.cases.map((c) => c.id), ['inc-missing', 'inc-timeout', 'inc-crash', 'inc-skip']));\ncheck('inc gate pass', inc.gate === GATE_PASS, inc.gate);\n\nconst flake = aggregateReliability({ cases: [...healthy(22), coverage('flake-1', ['reject', 'accept', 'accept'])] });\ncheck('flake', flake.denominator === 23 && flake.flake.count === 1 && eq(flake.flake.cases, ['flake-1']) && flake.passK.count === 22, JSON.stringify({ d: flake.denominator, f: flake.flake.count, p: flake.passK.count }));\ncheck('flake fail', flake.gate === GATE_FAIL && /non-safety-flake-rate-above-threshold/.test(flake.reasons.join(' ')), flake.reasons.join(' | '));\n\nconst late = aggregateReliability({ cases: [...healthy(22), coverage('late-fail', ['accept', 'accept', 'reject'])] });\ncheck('late fail not flake', late.flake.count === 0 && late.gate === GATE_PASS, \"'`${late.flake.count}/${late.gate}`);\n\nconst posBad = aggregateReliability({ cases: [...healthy(20), positive('\"'pos-anchor', true), positive('pos-broken', false, ['accept', 'accept', 'reject']), negative('neg-anchor', true)] });\ncheck('pos violation', posBad.gate === GATE_FAIL && eq(posBad.anchors.positive.violating, ['pos-broken']), JSON.stringify(posBad.anchors.positive));\n\nconst negBad = aggregateReliability({ cases: [...healthy(20), positive('pos-anchor', true), negative('neg-broken', false, ['reject', 'accept', 'reject'])] });\ncheck('neg violation', negBad.gate === GATE_FAIL && eq(negBad.anchors.negative.violating, ['neg-broken']));\n\nconst skipCase = aggregateReliability({ cases: [...healthy(21), positive('pos-anchor', true), negative('neg-anchor', true), coverage('safety-skip', ['accept', 'accept', 'skip'], true)] });\ncheck('safety skip', skipCase.denominator >= 20 && skipCase.safety.zeroSkip === false && eq(skipCase.safety.incomplete, ['safety-skip']) && skipCase.gate === GATE_FAIL, JSON.stringify(skipCase.safety));\n\nconst flakeCase = aggregateReliability({ cases: [...healthy(21), positive('pos-anchor', true), negative('neg-anchor', true), coverage('safety-flake', ['reject', 'accept', 'accept'], true)] });\ncheck('safety flake', flakeCase.safety.zeroFlake === false && eq(flakeCase.safety.flake, ['safety-flake']) && flakeCase.gate === GATE_FAIL, JSON.stringify(flakeCase.safety));\n\nconst small = aggregateReliability({ cases: [...healthy(DEFAULT_THRESHOLDS.minCases - 3), positive('pos-anchor'), negative('neg-anchor')] });\ncheck('insufficient', small.denominator === 19 && small.gate === GATE_INSUFFICIENT_SAMPLE, \"'`${small.denominator}/${small.gate}`);\n\nconst empty = aggregateReliability({ cases: [] });\ncheck('\"'empty', empty.denominator === 0 && empty.passK.value === null && empty.gate === GATE_INSUFFICIENT_SAMPLE);\n\nconst reg = aggregateReliability({ cases: [coverage('known'), { ...coverage('unknown'), scenario: 'not-a-scenario' }], knownScenarioIds: registeredScenarioIds });\ncheck('registry', reg.registry.unregistered.length === 1 && reg.registry.referenced === 2, JSON.stringify(reg.registry));\n\nfor (const sample of fixture.samples) {\n  const r = aggregateReliability({ sampleId: sample.id, cases: sample.cases, thresholds: fixture.thresholds, knownScenarioIds: registeredScenarioIds, expectGate: sample.expectGate });\n  check(\"'`oracle ${sample.id}`, r.gate === sample.expectGate && r.oracle.matchesExpectation === true, `${r.gate} != ${sample.expectGate}`);\n}\n\nconst primary = fixture.samples.find((s) => s.id === fixture.primarySample);\nconst pr = aggregateReliability({ sampleId: primary.id, cases: primary.cases, thresholds: fixture.thresholds, knownScenarioIds: registeredScenarioIds });\ncheck('\"'primary green', pr.gate === GATE_PASS && eq(pr.registry.unregistered, []) && pr.anchors.positive.satisfied === pr.anchors.positive.total && pr.anchors.negative.satisfied === pr.anchors.negative.total && pr.safety.zeroSkip && pr.safety.zeroFlake, JSON.stringify({ gate: pr.gate, unreg: pr.registry.unregistered }));\n\nconst reasons = new Set(fixture.samples.flatMap((s) => s.cases.flatMap((c) => { const cl = classifyCase(c, fixture.thresholds.k); return cl.complete ? [] : cl.incompleteReasons; })));\ncheck('all incomplete reasons present', eq([...reasons].sort(), [...INCOMPLETE_OUTCOMES].sort()), JSON.stringify([...reasons]));\n\nconsole.log(failed === 0 ? 'ALL TEST EXPECTATIONS HOLD' : \"'`FAILURES: ${failed}`);\nprocess.exitCode = failed === 0 ? 0 : 1;\n'\"'@\n\"'$tmp = Join-Path $env:TEMP '\"'e01-verify-tests.mjs'\nSet-Content -LiteralPath \"'$tmp -Value $verify -Encoding utf8\nnode $tmp (Get-Location).Path 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
