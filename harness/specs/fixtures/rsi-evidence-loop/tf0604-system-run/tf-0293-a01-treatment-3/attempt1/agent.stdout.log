{"type":"item.completed","item":{"id":"item_94","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'cat scripts/check-test-coverage-baseline.mjs | Select-Object -First 80; echo \"=====VALIDATE-TEST-GATES=====\"; cat scripts/validate-test-gates.mjs | Select-Object -First 60'","aggregated_output":"#!/usr/bin/env node\r\nimport { readdir, readFile } from 'node:fs/promises';\r\nimport path from 'node:path';\r\nimport { fileURLToPath } from 'node:url';\r\n\r\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\r\nconst TEST_ROOTS = ['tests', 'openclaw_runtime/src', 'openclaw_runtime/test'];\r\nconst SOURCE_ROOTS = ['electron/gateway', 'electron/services'];\r\nconst BASELINE = { 'electron/gateway': 27, 'electron/services': 75 };\r\n\r\nasync function listFiles(dir, predicate) {\r\n  const out = [];\r\n  async function walk(current) {\r\n    let entries;\r\n    try {\r\n      entries = await readdir(current, { withFileTypes: true });\r\n    } catch {\r\n      return;\r\n    }\r\n    for (const entry of entries) {\r\n      const full = path.join(current, entry.name);\r\n      if (entry.isDirectory()) {\r\n        if (['node_modules', 'dist', 'coverage', '.git'].includes(entry.name)) continue;\r\n        await walk(full);\r\n      } else if (entry.isFile() && predicate(full, entry.name)) {\r\n        out.push(full);\r\n      }\r\n    }\r\n  }\r\n  await walk(path.join(ROOT, dir));\r\n  return out;\r\n}\r\n\r\nfunction sourceName(file) {\r\n  return path.basename(file).replace(/\\.(ts|tsx)$/, '');\r\n}\r\n\r\nexport async function collectCoverageBaselineErrors() {\r\n  const testFiles = [];\r\n  for (const root of TEST_ROOTS) {\r\n    testFiles.push(...await listFiles(root, (_full, name) => /\\.(test|spec)\\.(ts|tsx|mts|mjs)$/.test(name)));\r\n  }\r\n  const testText = (await Promise.all(testFiles.map((file) => readFile(file, 'utf8')))).join('\\n');\r\n  const failures = [];\r\n  const actual = {};\r\n  for (const dir of SOURCE_ROOTS) {\r\n    const sources = await listFiles(dir, (_full, name) => /\\.(ts|tsx)$/.test(name) && !/\\.(test|spec|d)\\.ts$/.test(name));\r\n    const referenced = sources.filter((file) => testText.includes(sourceName(file)));\r\n    actual[dir] = referenced.length;\r\n    const minimum = BASELINE[dir];\r\n    if (referenced.length < minimum) {\r\n      failures.push(`${dir}: ${referenced.length} referenced source files, baseline is ${minimum}`);\r\n    }\r\n  }\r\n  return { failures, actual };\r\n}\r\n\r\nasync function main() {\r\n  const { failures, actual } = await collectCoverageBaselineErrors();\r\n  if (failures.length > 0) {\r\n    for (const failure of failures) console.error(failure);\r\n    process.exitCode = 1;\r\n    return;\r\n  }\r\n  console.log(`[test-coverage] gateway=${actual['electron/gateway']} services=${actual['electron/services']} meet baseline`);\r\n}\r\n\r\nif (process.argv[1] === fileURLToPath(import.meta.url)) await main();\r\n=====VALIDATE-TEST-GATES=====\r\n/**\r\n * P0-003 test gate validator.\r\n * - Enforces passWithNoTests:false in vitest configs\r\n * - Ensures empty test shards fail\r\n * - Ensures daily/cached/smoke cannot be classified as release evidence\r\n * - Emits machine-executable release gate list\r\n */\r\nimport fs from 'fs';\r\nimport path from 'path';\r\nimport { spawnSync } from 'child_process';\r\nimport { fileURLToPath } from 'url';\r\n\r\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\r\nconst root = path.resolve(__dirname, '..');\r\nconst args = process.argv.slice(2);\r\nconst listOnly = args.includes('--list');\r\nconst loopArg = (() => {\r\n  const i = args.indexOf('--loop');\r\n  return i >= 0 ? args[i + 1] : null;\r\n})();\r\nconst skipEmptyShard = args.includes('--skip-empty-shard');\r\n\r\nconst FAIL = [];\r\nconst WARN = [];\r\nconst INFO = [];\r\nconst fail = (m) => FAIL.push(m);\r\nconst warn = (m) => WARN.push(m);\r\nconst info = (m) => INFO.push(m);\r\n\r\nfunction readJson(rel) {\r\n  return JSON.parse(fs.readFileSync(path.join(root, rel), 'utf8'));\r\n}\r\n\r\nconst gates = readJson('plans/system-maturity/gates.json');\r\n\r\n// Policy checks\r\nconst daily = gates.loops.dailyFast;\r\nconst pr = gates.loops.prFull;\r\nconst release = gates.loops.release;\r\n\r\nif (daily.substitutesForRelease !== false) fail('dailyFast.substitutesForRelease must be false');\r\nif (daily.substitutesForPrFull !== false) fail('dailyFast.substitutesForPrFull must be false');\r\nif (pr.substitutesForRelease !== false) fail('prFull.substitutesForRelease must be false');\r\ninfo('A2 daily/pr loops cannot substitute release');\r\n\r\nfor (const bad of release.forbiddenAsReleaseEvidence || []) {\r\n  const releaseCmds = (release.commands || []).map((c) => c.id);\r\n  if (releaseCmds.includes(bad)) fail(`release commands include forbidden evidence id ${bad}`);\r\n}\r\ninfo('A2 forbidden release evidence ids not present in release.commands');\r\n\r\n// vitest passWithNoTests\r\nfor (const cfg of gates.vitestPolicy.configs || []) {\r\n  const abs = path.join(root, cfg);\r\n  if (!fs.existsSync(abs)) {\r\n    warn(`vitest config missing: ${cfg}`);\r\n    continue;\r\n  }\r\n  const text = fs.readFileSync(abs, 'utf8');\r\n  if (/passWithNoTests\\s*:\\s*true/.test(text)) {\r\n","exit_code":0,"status":"completed"}}
