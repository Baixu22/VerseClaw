{"type":"item.completed","item":{"id":"item_308","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Get-Content D:\\\\ClawX\\\\tests\\\\unit\\\\performance-budgets.test.ts -TotalCount 200\"","aggregated_output":"import { mkdirSync, writeFileSync } from \"node:fs\";\r\nimport path from \"node:path\";\r\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\r\nimport {\r\n  planCriticalFirstBudget,\r\n  selectCompressionPlan,\r\n} from \"../../openclaw_runtime/packages/agent-core/src/harness/compaction/compression-planner.js\";\r\nimport type { CompactionSettings } from \"../../openclaw_runtime/packages/agent-core/src/harness/compaction/compaction.js\";\r\nimport { deprecationCounters } from \"../../openclaw_runtime/src/observability/deprecation-counters.js\";\r\nimport {\r\n  ContextBudgetPlanner,\r\n  FingerprintLeaseCoordinator,\r\n  ResumeContractVerifier,\r\n} from \"../../openclaw_runtime/src/agents/cross-area/cross-area-facades.js\";\r\nimport type { OrchestrationTaskGraph } from \"../../openclaw_runtime/src/agents/orchestration-protocol.js\";\r\n\r\nconst SETTINGS: CompactionSettings = {\r\n  enabled: true,\r\n  reserveTokens: 16_384,\r\n  keepRecentTokens: 20_000,\r\n  contextWindow: 1_000,\r\n};\r\n\r\nfunction percentile99(values: number[]): number {\r\n  const sorted = [...values].sort((a, b) => a - b);\r\n  return sorted[Math.max(0, Math.ceil(sorted.length * 0.99) - 1)] ?? 0;\r\n}\r\n\r\nfunction makeGraph(nodeCount: number): OrchestrationTaskGraph {\r\n  const nodes = Array.from({ length: nodeCount }, (_, i) => ({\r\n    taskNodeId: `task-${i + 1}`,\r\n    roleName: \"worker\",\r\n    task: `Task ${i + 1}`,\r\n    phase: \"worker\" as const,\r\n    dependsOn: [] as string[],\r\n    scope: \"default\",\r\n    requiredCapabilities: [],\r\n    attemptPolicy: { maxRepairAttempts: 0, maxRedoAttempts: 0 },\r\n    status: \"planned\" as const,\r\n  }));\r\n  return { graphRunId: \"perf-run\", mode: \"auto\", status: \"planned\", nodes, edges: [] };\r\n}\r\n\r\ndescribe(\"A5 performance budgets\", () => {\r\n  beforeEach(() => deprecationCounters.reset());\r\n  afterEach(() => deprecationCounters.reset());\r\n\r\n  it(\"planner 100-call p99 stays <= 30ms\", () => {\r\n    const durations: number[] = [];\r\n    for (let index = 0; index < 100; index += 1) {\r\n      const started = performance.now();\r\n      selectCompressionPlan({\r\n        tokensBefore: 700 + index,\r\n        settings: SETTINGS,\r\n        thresholds: { tier1: 0.55 },\r\n      });\r\n      durations.push(performance.now() - started);\r\n    }\r\n    const p99 = percentile99(durations);\r\n    expect(p99).toBeLessThanOrEqual(30);\r\n\r\n    const outDir = path.resolve(\"artifacts/context-compression-p5\");\r\n    mkdirSync(outDir, { recursive: true });\r\n    const evidence = {\r\n      schema: \"p5-planner-p99/v1\",\r\n      generatedAt: new Date().toISOString(),\r\n      samples: durations.length,\r\n      p99Ms: p99,\r\n      maxMs: Math.max(...durations),\r\n      budgetMs: 30,\r\n    };\r\n    writeFileSync(path.join(outDir, \"planner-p99.json\"), `${JSON.stringify(evidence, null, 2)}\r\n`);\r\n  });\r\n\r\n  it(\"A5+A1+A3 cumulative per-turn smoke p99 stays <= 300ms and writes bounded evidence\", () => {\r\n    const durations: number[] = [];\r\n    for (let index = 0; index < 100; index += 1) {\r\n      const started = performance.now();\r\n      planCriticalFirstBudget({\r\n        criticalLedger: [],\r\n        latestUserAsk: `fix auth ${index}`,\r\n        unfinishedActions: [\"update tests\"],\r\n        failureChainValidation: [\"failed: auth timeout\"],\r\n        exactIdentifiers: [\"AUTH_PROFILE_ID\"],\r\n        importantFacts: [\"provider timeout is 30s\"],\r\n        niceToHaveProse: [\"background notes\"],\r\n        budgetTokens: 120,\r\n      });\r\n      deprecationCounters.incrementA1ShadowSuccess(1);\r\n      deprecationCounters.incrementA3MissionTicks(1);\r\n      deprecationCounters.checkBudgetViolation(\"a1\");\r\n      deprecationCounters.checkBudgetViolation(\"a3\");\r\n      deprecationCounters.checkBudgetViolation(\"a5\");\r\n      durations.push(performance.now() - started);\r\n    }\r\n    const p99 = percentile99(durations);\r\n    expect(p99).toBeLessThanOrEqual(300);\r\n\r\n    const outDir = path.resolve(\"artifacts/context-compression-p5\");\r\n    mkdirSync(outDir, { recursive: true });\r\n    const evidence = {\r\n      schema: \"p5-performance-smoke/v1\",\r\n      generatedAt: new Date().toISOString(),\r\n      samples: durations.length,\r\n      p99Ms: p99,\r\n      maxMs: Math.max(...durations),\r\n      budgetMs: 300,\r\n      counters: deprecationCounters.snapshot(),\r\n    };\r\n    writeFileSync(path.join(outDir, \"perf-smoke.json\"), `${JSON.stringify(evidence, null, 2)}\\n`);\r\n    expect(JSON.parse(JSON.stringify(evidence))).toEqual(evidence);\r\n  });\r\n});\r\n\r\ndescribe(\"A6 performance budgets\", () => {\r\n  beforeEach(() => deprecationCounters.reset());\r\n  afterEach(() => deprecationCounters.reset());\r\n\r\n  it(\"10 pause/resume cycles p99 stays <= 300ms and writes bounded evidence\", () => {\r\n    const planner = new ContextBudgetPlanner(makeGraph(8), 4);\r\n    planner.plan();\r\n    const verifier = new ResumeContractVerifier();\r\n    const coordinator = new FingerprintLeaseCoordinator();\r\n\r\n    const durations: number[] = [];\r\n    for (let cycle = 0; cycle < 10; cycle += 1) {\r\n      const started = performance.now();\r\n      // Pause: A1 commits its lease before A6 writes the checkpoint.\r\n      const pause = coordinator.coordinatePause(`lease-${cycle}`, `checkpoint-${cycle}`);\r\n      expect(pause.leaseBeforeCheckpoint).toBe(true);\r\n      // Resume: A5 re-runs the budget planner and A6 re-checks the contract.\r\n      planner.replanOnResume(3 - (cycle % 3));\r\n      const contract = verifier.verify({ config: undefined }, cycle % 2 === 0);\r\n      expect(contract.requiresReverification).toBe(false);\r\n      durations.push(performance.now() - started);\r\n    }\r\n\r\n    expect(planner.resumeReexecutions).toBe(10);\r\n    const p99 = percentile99(durations);\r\n    expect(p99).toBeLessThanOrEqual(300);\r\n\r\n    const outDir = path.resolve(\"artifacts/context-compression-p5\");\r\n    mkdirSync(outDir, { recursive: true });\r\n    const evidence = {\r\n      schema: \"a6-pause-resume-p99/v1\",\r\n      generatedAt: new Date().toISOString(),\r\n      samples: durations.length,\r\n      cycles: durations.length,\r\n      p99Ms: p99,\r\n      maxMs: Math.max(...durations),\r\n      budgetMs: 300,\r\n    };\r\n    writeFileSync(path.join(outDir, \"a6-pause-resume-p99.json\"), `${JSON.stringify(evidence, null, 2)}\\n`);\r\n    expect(JSON.parse(JSON.stringify(evidence))).toEqual(evidence);\r\n  });\r\n});\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_309","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Get-Content D:\\\\ClawX\\\\tests\\\\unit\\\\a01-a1-gate-coverage.test.ts\"","aggregated_output":"// @vitest-environment node\r\n// A01: the A1 graduation gate must be verifiable from the current candidate.\r\nimport { readFileSync } from \"node:fs\";\r\nimport { dirname, join, resolve } from \"node:path\";\r\nimport { fileURLToPath } from \"node:url\";\r\nimport { describe, expect, it } from \"vitest\";\r\n\r\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\r\n\r\nfunction read(p: string) {\r\n  return readFileSync(join(ROOT, p), \"utf8\");\r\n}\r\n\r\ndescribe(\"A01 A1 isolation pilot gate coverage\", () => {\r\n  it(\"keeps the A1 spec's requiredTests wired to the criterion-1/3/4 counter tests\", () => {\r\n    const spec = read(\"harness/specs/tasks/a1-layered-isolation-pilot.md\");\r\n    expect(spec).toContain(\"tests/unit/deprecation-counters.test.ts\");\r\n    expect(spec).toContain(\"openclaw_runtime/src/observability/deprecation-counters.test.ts\");\r\n    // The original graduation thresholds must not be redefined.\r\n    expect(spec).toContain(\"legacyFallbackCount / (legacyFallbackCount + shadowSuccessCount) < 0.05\");\r\n    expect(spec).toContain(\"degrade_to_legacy\");\r\n    expect(spec).toContain(\"p99 ≤ 200ms\");\r\n  });\r\n\r\n  it(\"keeps the counter test asserting the 5% budget and the degrade_to_legacy response\", () => {\r\n    const counterTest = read(\"tests/unit/deprecation-counters.test.ts\");\r\n    expect(counterTest).toContain(\"degrade_to_legacy\");\r\n    expect(counterTest).toContain(\"legacyFallbackCount\");\r\n    expect(counterTest).toContain(\"declaredPathViolationCount\");\r\n    // Strictly greater than 5% trips; <= 5% does not.\r\n    expect(counterTest).toMatch(/rate\\s*>?\\s*5%/i);\r\n  });\r\n\r\n  it(\"keeps the write-risk and namespace criteria covered by their tests\", () => {\r\n    const toolReg = read(\"tests/unit/tool-registration.test.ts\");\r\n    expect(toolReg).toContain(\"writeRiskProfile\");\r\n    const namespace = read(\"tests/unit/trace-namespace-enforcement.test.ts\");\r\n    expect(namespace).toContain(\"claw.a4.tool.choice\");\r\n    const perf = read(\"tests/unit/performance-budgets.test.ts\");\r\n    expect(perf).toContain(\"p99\");\r\n  });\r\n});\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_310","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Get-Content D:\\\\ClawX\\\\openclaw_runtime\\\\src\\\\agents\\\\cross-area\\\\cross-area-facades.ts\"","aggregated_output":"// ---------------------------------------------------------------------------\r\n// Stage 3 (criteria 3.2-3.8): Cross-Area Composition Facades\r\n//\r\n// Thin facades that compose existing A1-A6 infrastructure to verify the\r\n// composition semantics defined in `area-composition-spec.md`. These are\r\n// NOT production wiring — they exist to make cross-area interactions testable\r\n// at the unit level while the areas remain in shadow/pilot mode.\r\n//\r\n// See: net use/designs/area-composition-spec.md\r\n// See: net use/designs/development-manual.md §1.1, Stage 3\r\n// ---------------------------------------------------------------------------\r\n\r\nimport type { RuntimeResumeShadowResult } from \"../../runtime-core/resume-shadow.js\";\r\nimport { runRuntimeResumeShadow } from \"../../runtime-core/resume-shadow.js\";\r\nimport type { RuntimeResumeShadowInput } from \"../../runtime-core/resume-shadow.js\";\r\nimport {\r\n  ResourceAwareWaveScheduler,\r\n  type RePlanRequest,\r\n  type RePlanResult,\r\n  type WavePlan,\r\n} from \"../resource-aware-wave-scheduler.js\";\r\nimport type { OrchestrationTaskGraph } from \"../orchestration-protocol.js\";\r\n\r\n// ---------------------------------------------------------------------------\r\n// A3+A6: ResumeContractVerifier\r\n// ---------------------------------------------------------------------------\r\n\r\n/**\r\n * Result of verifying a resume contract. When a rollback has occurred (A3\r\n * anomaly → repair with `replay_rollback` strategy), the verifier marks\r\n * `requiresReverification: true` so downstream consumers know the resumed\r\n * state is not trusted without re-verification.\r\n */\r\nexport type ResumeContractVerification = {\r\n  /** Whether the resume shadow was enabled and ran. */\r\n  enabled: boolean;\r\n  /** Whether a rollback was detected prior to resume. */\r\n  rollbackOccurred: boolean;\r\n  /**\r\n   * Stage 3 (criterion 3.3): when true, the resumed state must be\r\n   * re-verified before use. Set when A3 rollback happened before A6 resume.\r\n   */\r\n  requiresReverification: boolean;\r\n  /** The underlying resume shadow result (null when disabled). */\r\n  resumeShadow: RuntimeResumeShadowResult | null;\r\n};\r\n\r\n/**\r\n * A6 resume contract verifier. Composes `runRuntimeResumeShadow` with A3\r\n * rollback detection. When a rollback has occurred, the resumed state is\r\n * marked `requiresReverification` per the A3+A6 composition contract.\r\n *\r\n * See: area-composition-spec.md §1 Blocker 4 (A1+A6 mid-turn pause)\r\n */\r\nexport class ResumeContractVerifier {\r\n  /**\r\n   * Verify a resume contract.\r\n   *\r\n   * @param input Resume shadow input (event log, legacy state).\r\n   * @param rollbackOccurred Whether an A3 rollback occurred before resume.\r\n   */\r\n  verify(input: RuntimeResumeShadowInput, rollbackOccurred: boolean): ResumeContractVerification {\r\n    const resumeShadow = runRuntimeResumeShadow(input);\r\n    return {\r\n      enabled: resumeShadow.enabled,\r\n      rollbackOccurred,\r\n      // Criterion 3.3: rollback before resume → requires_reverification.\r\n      requiresReverification: rollbackOccurred && resumeShadow.enabled,\r\n      resumeShadow: resumeShadow.enabled ? resumeShadow : null,\r\n    };\r\n  }\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// A5+A6: ContextBudgetPlanner\r\n// ---------------------------------------------------------------------------\r\n\r\n/**\r\n * A5 context budget planner. Composes `ResourceAwareWaveScheduler` with\r\n * resume semantics: on resume (A6), the planner re-executes with the current\r\n * budget rather than reusing a stale plan.\r\n *\r\n * See: area-composition-spec.md (A5+A6 composition: resume re-runs budget planner)\r\n */\r\nexport class ContextBudgetPlanner {\r\n  private scheduler: ResourceAwareWaveScheduler;\r\n  private lastPlan: WavePlan[] | null = null;\r\n  private resumeCount = 0;\r\n  private readonly initialMaxWorkers: number;\r\n\r\n  constructor(graph: OrchestrationTaskGraph, maxWorkers: number) {\r\n    this.scheduler = new ResourceAwareWaveScheduler(graph, { maxWorkers });\r\n    this.initialMaxWorkers = maxWorkers;\r\n  }\r\n\r\n  /** Initial plan. */\r\n  plan(): WavePlan[] {\r\n    this.lastPlan = this.scheduler.plan();\r\n    return this.getPlan();\r\n  }\r\n\r\n  /**\r\n   * Stage 3 (criterion 3.6): on resume, re-run the budget planner with the\r\n   * current budget. The plan is NOT reused from before pause — the planner\r\n   * re-executes to avoid stale budget decisions.\r\n   *\r\n   * @param resumedMaxWorkers The budget at resume time (may differ from initial).\r\n   * @returns The re-planned waves.\r\n   */\r\n  replanOnResume(resumedMaxWorkers: number): WavePlan[] {\r\n    // P1 fix: only increment resumeCount when rePlan was actually accepted.\r\n    // Previously resumeCount was incremented unconditionally, causing\r\n    // hasReexecuted=true even when rePlan was rejected (wave_started),\r\n    // making it impossible for callers to distinguish a successful re-plan\r\n    // from a no-op rejection.\r\n    const firstPlanned = this.scheduler.getWaves().find((w) => w.status === \"planned\");\r\n    const appliesToWave = firstPlanned?.wave ?? 1;\r\n    const result = this.scheduler.rePlan({\r\n      appliesToWave,\r\n      maxWorkers: resumedMaxWorkers,\r\n    });\r\n    if (result.accepted) {\r\n      this.resumeCount++;\r\n      this.lastPlan = this.scheduler.getWaves();\r\n    }\r\n    return this.getPlan();\r\n  }\r\n\r\n  /** Whether the planner has re-executed since the last plan (not stale). */\r\n  get hasReexecuted(): boolean {\r\n    return this.resumeCount > 0;\r\n  }\r\n\r\n  /** Number of times the planner has re-executed on resume. */\r\n  get resumeReexecutions(): number {\r\n    return this.resumeCount;\r\n  }\r\n\r\n  /** The initial maxWorkers (before any resume). */\r\n  get initialBudget(): number {\r\n    return this.initialMaxWorkers;\r\n  }\r\n\r\n  /** Current wave plan. */\r\n  getPlan(): WavePlan[] {\r\n    return this.scheduler.getWaves();\r\n  }\r\n\r\n  /** Start a wave (delegates to scheduler). */\r\n  startWave(waveNumber: number): void {\r\n    this.scheduler.startWave(waveNumber);\r\n  }\r\n\r\n  /** Re-plan with a new worker cap (delegates to scheduler). */\r\n  rePlan(request: RePlanRequest): RePlanResult {\r\n    return this.scheduler.rePlan(request);\r\n  }\r\n\r\n  /** Get the underlying scheduler (for direct testing). */\r\n  getScheduler(): ResourceAwareWaveScheduler {\r\n    return this.scheduler;\r\n  }\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// A1+A6: FingerprintLeaseCoordinator\r\n//\r\n// Coordinates A1 lease commit with A6 checkpoint writes to prevent I/O races\r\n// during mid-turn pause (criterion 3.8). The lease commits BEFORE the\r\n// checkpoint is written, per Blocker 4 resolution.\r\n// ---------------------------------------------------------------------------\r\n\r\nexport type LeaseCommitResult = {\r\n  committed: true;\r\n  leaseId: string;\r\n  committedAt: number;\r\n};\r\n\r\nexport type CheckpointWriteResult = {\r\n  written: true;\r\n  checkpointId: string;\r\n  writtenAt: number;\r\n  leaseId: string;\r\n};\r\n\r\nexport type PauseCoordinationResult = {\r\n  lease: LeaseCommitResult;\r\n  checkpoint: CheckpointWriteResult;\r\n  /** True when the lease was committed BEFORE the checkpoint (no race). */\r\n  leaseBeforeCheckpoint: boolean;\r\n};\r\n\r\n/**\r\n * Coordinate A1 lease commit with A6 checkpoint write during mid-turn pause.\r\n *\r\n * Per Blocker 4: A1 lease commits before A6 writes checkpoint. This prevents\r\n * I/O races where A6 reads partial state from an uncommitted A1 lease.\r\n */\r\nexport class FingerprintLeaseCoordinator {\r\n  private lastLease: LeaseCommitResult | null = null;\r\n\r\n  /** Commit the A1 lease. Must be called BEFORE writeCheckpoint. */\r\n  commitLease(leaseId: string, now: number = Date.now()): LeaseCommitResult {\r\n    const result: LeaseCommitResult = { committed: true, leaseId, committedAt: now };\r\n    this.lastLease = result;\r\n    return result;\r\n  }\r\n\r\n  /**\r\n   * Write the A6 checkpoint. Requires a committed lease (throws if no lease\r\n   * has been committed, preventing I/O races).\r\n   */\r\n  writeCheckpoint(checkpointId: string, now: number = Date.now()): CheckpointWriteResult {\r\n    if (!this.lastLease) {\r\n      throw new Error(\"Cannot write checkpoint before lease is committed (Blocker 4 race guard)\");\r\n    }\r\n    return {\r\n      written: true,\r\n      checkpointId,\r\n      writtenAt: now,\r\n      leaseId: this.lastLease.leaseId,\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Coordinate a full mid-turn pause: commit lease, then write checkpoint.\r\n   * Returns a result confirming the lease was committed before the checkpoint.\r\n   */\r\n  coordinatePause(leaseId: string, checkpointId: string, now: number = Date.now()): PauseCoordinationResult {\r\n    const lease = this.commitLease(leaseId, now);\r\n    const checkpoint = this.writeCheckpoint(checkpointId, now);\r\n    return {\r\n      lease,\r\n      checkpoint,\r\n      leaseBeforeCheckpoint: lease.committedAt <= checkpoint.writtenAt,\r\n    };\r\n  }\r\n}\r\n","exit_code":0,"status":"completed"}}
