{"type":"item.completed","item":{"id":"item_312","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Get-Content D:\\\\ClawX\\\\tests\\\\unit\\\\tool-registration.test.ts\"","aggregated_output":"import { describe, expect, it } from 'vitest';\r\n\r\nimport {\r\n  type WriteRiskProfile,\r\n  MissingWriteRiskProfileError,\r\n  assertWriteRiskProfileForTool,\r\n  requiresApproval,\r\n  requiresFullFsDiff,\r\n  validateWriteRiskProfile,\r\n} from '../../openclaw_runtime/src/shared/tool-registration';\r\n\r\n/**\r\n * Stage 2 acceptance 2.2 — Tool registration rejects undeclared write tools.\r\n *\r\n * The `assertWriteRiskProfileForTool` function is the enforcement seam called\r\n * by `registerTool` in loader.ts. When a write/destructive tool lacks a valid\r\n * `writeRiskProfile`, it must throw `MissingWriteRiskProfileError` with a named\r\n * field (`field='writeRiskProfile'`).\r\n *\r\n * Run: pnpm test tool-registration\r\n */\r\ndescribe('assertWriteRiskProfileForTool (A1 Stage 2 acceptance 2.2)', () => {\r\n  // -------------------------------------------------------------------------\r\n  // readonly tools: profile optional\r\n  // -------------------------------------------------------------------------\r\n\r\n  describe('readonly tools', () => {\r\n    it('passes with no profile (omitted)', () => {\r\n      expect(() => assertWriteRiskProfileForTool('readonly', undefined)).not.toThrow();\r\n    });\r\n\r\n    it('passes with no_writes profile', () => {\r\n      const profile: WriteRiskProfile = { kind: 'no_writes' };\r\n      expect(() => assertWriteRiskProfileForTool('readonly', profile)).not.toThrow();\r\n    });\r\n\r\n    it('passes even with a declared_paths profile (harmless override)', () => {\r\n      const profile: WriteRiskProfile = { kind: 'declared_paths', writePaths: ['x.txt'] };\r\n      expect(() => assertWriteRiskProfileForTool('readonly', profile)).not.toThrow();\r\n    });\r\n  });\r\n\r\n  // -------------------------------------------------------------------------\r\n  // write tools: profile REQUIRED\r\n  // -------------------------------------------------------------------------\r\n\r\n  describe('write tools (profile required)', () => {\r\n    it('throws MissingWriteRiskProfileError when profile is undefined', () => {\r\n      try {\r\n        assertWriteRiskProfileForTool('write', undefined);\r\n        throw new Error('expected throw');\r\n      } catch (err) {\r\n        expect(err).toBeInstanceOf(MissingWriteRiskProfileError);\r\n        expect((err as MissingWriteRiskProfileError).field).toBe('writeRiskProfile');\r\n        expect((err as MissingWriteRiskProfileError).message).toContain('required');\r\n      }\r\n    });\r\n\r\n    it('throws when profile is null', () => {\r\n      try {\r\n        assertWriteRiskProfileForTool('write', null);\r\n        throw new Error('expected throw');\r\n      } catch (err) {\r\n        expect(err).toBeInstanceOf(MissingWriteRiskProfileError);\r\n        expect((err as MissingWriteRiskProfileError).field).toBe('writeRiskProfile');\r\n      }\r\n    });\r\n\r\n    it('passes with declared_paths profile', () => {\r\n      const profile: WriteRiskProfile = { kind: 'declared_paths', writePaths: ['out.txt'] };\r\n      expect(() => assertWriteRiskProfileForTool('write', profile)).not.toThrow();\r\n    });\r\n\r\n    it('passes with pattern_writes profile', () => {\r\n      const profile: WriteRiskProfile = { kind: 'pattern_writes', writePattern: '*.log' };\r\n      expect(() => assertWriteRiskProfileForTool('write', profile)).not.toThrow();\r\n    });\r\n\r\n    it('passes with dynamic_writes profile', () => {\r\n      const profile: WriteRiskProfile = { kind: 'dynamic_writes', requiresApproval: true };\r\n      expect(() => assertWriteRiskProfileForTool('write', profile)).not.toThrow();\r\n    });\r\n\r\n    it('passes with a durable_state profile', () => {\r\n      const profile: WriteRiskProfile = {\r\n        kind: 'durable_state',\r\n        ownerStore: 'task-ledger',\r\n        requiresApproval: false,\r\n      };\r\n      expect(() => assertWriteRiskProfileForTool('write', profile)).not.toThrow();\r\n    });\r\n\r\n    it('throws when durable_state has no ownerStore', () => {\r\n      const invalid = { kind: 'durable_state', ownerStore: '   ', requiresApproval: false };\r\n      expect(() => assertWriteRiskProfileForTool('write', invalid)).toThrow(\r\n        MissingWriteRiskProfileError,\r\n      );\r\n    });\r\n\r\n    it('throws when declared_paths has empty writePaths array', () => {\r\n      const invalid = { kind: 'declared_paths', writePaths: [] };\r\n      try {\r\n        assertWriteRiskProfileForTool('write', invalid);\r\n        throw new Error('expected throw');\r\n      } catch (err) {\r\n        expect(err).toBeInstanceOf(MissingWriteRiskProfileError);\r\n        expect((err as MissingWriteRiskProfileError).field).toBe('writeRiskProfile');\r\n      }\r\n    });\r\n\r\n    it('throws when pattern_writes has empty writePattern', () => {\r\n      const invalid = { kind: 'pattern_writes', writePattern: '' };\r\n      expect(() => assertWriteRiskProfileForTool('write', invalid)).toThrow(\r\n        MissingWriteRiskProfileError,\r\n      );\r\n    });\r\n\r\n    it('throws when dynamic_writes lacks requiresApproval=true', () => {\r\n      const invalid = { kind: 'dynamic_writes', requiresApproval: false };\r\n      expect(() => assertWriteRiskProfileForTool('write', invalid)).toThrow(\r\n        MissingWriteRiskProfileError,\r\n      );\r\n    });\r\n\r\n    it('throws when kind is invalid', () => {\r\n      const invalid = { kind: 'unknown_kind' };\r\n      expect(() => assertWriteRiskProfileForTool('write', invalid)).toThrow(\r\n        MissingWriteRiskProfileError,\r\n      );\r\n    });\r\n  });\r\n\r\n  // -------------------------------------------------------------------------\r\n  // destructive tools: profile REQUIRED + must be dynamic_writes\r\n  // -------------------------------------------------------------------------\r\n\r\n  describe('destructive tools (must be dynamic_writes)', () => {\r\n    it('throws when profile is undefined', () => {\r\n      try {\r\n        assertWriteRiskProfileForTool('destructive', undefined);\r\n        throw new Error('expected throw');\r\n      } catch (err) {\r\n        expect(err).toBeInstanceOf(MissingWriteRiskProfileError);\r\n        expect((err as MissingWriteRiskProfileError).field).toBe('writeRiskProfile');\r\n      }\r\n    });\r\n\r\n    it('passes with dynamic_writes profile', () => {\r\n      const profile: WriteRiskProfile = { kind: 'dynamic_writes', requiresApproval: true };\r\n      expect(() => assertWriteRiskProfileForTool('destructive', profile)).not.toThrow();\r\n    });\r\n\r\n    it('throws when profile is declared_paths (not dynamic_writes)', () => {\r\n      const profile: WriteRiskProfile = {\r\n        kind: 'declared_paths',\r\n        writePaths: ['x.txt'],\r\n      };\r\n      try {\r\n        assertWriteRiskProfileForTool('destructive', profile);\r\n        throw new Error('expected throw');\r\n      } catch (err) {\r\n        expect(err).toBeInstanceOf(MissingWriteRiskProfileError);\r\n        expect((err as MissingWriteRiskProfileError).field).toBe('writeRiskProfile');\r\n        expect((err as MissingWriteRiskProfileError).message).toContain('dynamic_writes');\r\n      }\r\n    });\r\n\r\n    it('throws when profile is pattern_writes (not dynamic_writes)', () => {\r\n      const profile: WriteRiskProfile = { kind: 'pattern_writes', writePattern: '*.log' };\r\n      expect(() => assertWriteRiskProfileForTool('destructive', profile)).toThrow(\r\n        MissingWriteRiskProfileError,\r\n      );\r\n    });\r\n\r\n    it('throws when profile is durable_state (not dynamic_writes)', () => {\r\n      const profile: WriteRiskProfile = {\r\n        kind: 'durable_state',\r\n        ownerStore: 'runtime-receipts',\r\n        requiresApproval: true,\r\n      };\r\n      expect(() => assertWriteRiskProfileForTool('destructive', profile)).toThrow(\r\n        MissingWriteRiskProfileError,\r\n      );\r\n    });\r\n\r\n    it('throws when profile is no_writes (not dynamic_writes)', () => {\r\n      const profile: WriteRiskProfile = { kind: 'no_writes' };\r\n      expect(() => assertWriteRiskProfileForTool('destructive', profile)).toThrow(\r\n        MissingWriteRiskProfileError,\r\n      );\r\n    });\r\n  });\r\n\r\n  // -------------------------------------------------------------------------\r\n  // Named field error (acceptance 0.4)\r\n  // -------------------------------------------------------------------------\r\n\r\n  describe('named field error', () => {\r\n    it('MissingWriteRiskProfileError has field=\"writeRiskProfile\"', () => {\r\n      try {\r\n        assertWriteRiskProfileForTool('write', undefined);\r\n        throw new Error('expected throw');\r\n      } catch (err) {\r\n        const e = err as MissingWriteRiskProfileError;\r\n        expect(e.field).toBe('writeRiskProfile');\r\n        expect(e.name).toBe('MissingWriteRiskProfileError');\r\n      }\r\n    });\r\n  });\r\n\r\n  // -------------------------------------------------------------------------\r\n  // Helper functions\r\n  // -------------------------------------------------------------------------\r\n\r\n  describe('helper functions', () => {\r\n    it('requiresFullFsDiff returns true only for dynamic_writes', () => {\r\n      expect(requiresFullFsDiff({ kind: 'dynamic_writes', requiresApproval: true })).toBe(true);\r\n      expect(requiresFullFsDiff({ kind: 'no_writes' })).toBe(false);\r\n      expect(requiresFullFsDiff({ kind: 'declared_paths', writePaths: ['x'] })).toBe(false);\r\n      expect(requiresFullFsDiff({ kind: 'pattern_writes', writePattern: '*.log' })).toBe(false);\r\n      expect(\r\n        requiresFullFsDiff({ kind: 'durable_state', ownerStore: 'task-ledger', requiresApproval: true }),\r\n      ).toBe(false);\r\n    });\r\n\r\n    it('requiresApproval covers dynamic_writes and durable_state', () => {\r\n      expect(requiresApproval({ kind: 'dynamic_writes', requiresApproval: true })).toBe(true);\r\n      expect(requiresApproval({ kind: 'no_writes' })).toBe(false);\r\n      expect(requiresApproval({ kind: 'declared_paths', writePaths: ['x'] })).toBe(false);\r\n      expect(\r\n        requiresApproval({ kind: 'durable_state', ownerStore: 'task-ledger', requiresApproval: true }),\r\n      ).toBe(true);\r\n      expect(\r\n        requiresApproval({ kind: 'durable_state', ownerStore: 'task-ledger', requiresApproval: false }),\r\n      ).toBe(false);\r\n    });\r\n\r\n    it('a readonly risk level still validates a declared durable_state profile', () => {\r\n      expect(() =>\r\n        assertWriteRiskProfileForTool('readonly', {\r\n          kind: 'durable_state',\r\n          ownerStore: 'approval-ledger',\r\n          requiresApproval: true,\r\n        }),\r\n      ).not.toThrow();\r\n      expect(() =>\r\n        assertWriteRiskProfileForTool('readonly', {\r\n          kind: 'durable_state',\r\n          ownerStore: '',\r\n          requiresApproval: true,\r\n        }),\r\n      ).toThrow(/ownerStore/);\r\n    });\r\n\r\n    it('validateWriteRiskProfile returns null for valid profiles', () => {\r\n      expect(validateWriteRiskProfile({ kind: 'no_writes' })).toBeNull();\r\n      expect(\r\n        validateWriteRiskProfile({ kind: 'declared_paths', writePaths: ['x.txt'] }),\r\n      ).toBeNull();\r\n      expect(validateWriteRiskProfile({ kind: 'pattern_writes', writePattern: '*.log' })).toBeNull();\r\n      expect(\r\n        validateWriteRiskProfile({ kind: 'dynamic_writes', requiresApproval: true }),\r\n      ).toBeNull();\r\n      expect(\r\n        validateWriteRiskProfile({\r\n          kind: 'durable_state',\r\n          ownerStore: 'task-ledger',\r\n          requiresApproval: true,\r\n        }),\r\n      ).toBeNull();\r\n    });\r\n\r\n    it('validateWriteRiskProfile returns error message for invalid profiles', () => {\r\n      expect(validateWriteRiskProfile(undefined)).toContain('required');\r\n      expect(validateWriteRiskProfile(null)).toContain('required');\r\n      expect(validateWriteRiskProfile({ kind: 'declared_paths', writePaths: [] })).toContain(\r\n        'writePaths',\r\n      );\r\n      expect(validateWriteRiskProfile({ kind: 'pattern_writes', writePattern: '' })).toContain(\r\n        'writePattern',\r\n      );\r\n      expect(validateWriteRiskProfile({ kind: 'dynamic_writes' })).toContain('requiresApproval');\r\n      expect(validateWriteRiskProfile({ kind: 'durable_state', ownerStore: 'x' })).toContain(\r\n        'requiresApproval',\r\n      );\r\n      expect(validateWriteRiskProfile({ kind: 'durable_state', requiresApproval: true })).toContain(\r\n        'ownerStore',\r\n      );\r\n      expect(validateWriteRiskProfile({ kind: 'unknown' })).toContain('must be one of');\r\n    });\r\n  });\r\n});\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_313","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Get-Content openclaw_runtime\\\\src\\\\shared\\\\tool-registration.ts\"","aggregated_output":"/**\r\n * Static write-risk declaration for tool registration — runtime-local.\r\n *\r\n * Context: Round 2 design (A1 Layered Execution Isolation). Replaces the\r\n * unenforceable runtime `recordPathTouch` hook with a static declaration\r\n * enforced at tool registration time. The snapshotter trusts\r\n * `declaredWritePaths ∩ actual_fs_diff` instead of runtime path tracking.\r\n *\r\n * See: docs/runtime-design/area-1-layered-execution-isolation.md §9.2\r\n *      docs/runtime-design/development-manual.md §1.1, Stage 2\r\n */\r\n\r\nexport type WriteRiskProfile =\r\n  | { kind: 'no_writes' }\r\n  | { kind: 'declared_paths'; writePaths: string[] }\r\n  | { kind: 'pattern_writes'; writePattern: string }\r\n  | { kind: 'dynamic_writes'; requiresApproval: true };\r\n\r\nexport const DEFAULT_WRITE_RISK_PROFILE: WriteRiskProfile = {\r\n  kind: 'dynamic_writes',\r\n  requiresApproval: true,\r\n};\r\n\r\nexport function requiresFullFsDiff(profile: WriteRiskProfile): boolean {\r\n  return profile.kind === 'dynamic_writes';\r\n}\r\n\r\nexport function requiresApproval(profile: WriteRiskProfile): boolean {\r\n  return profile.kind === 'dynamic_writes' && profile.requiresApproval;\r\n}\r\n\r\nexport function validateWriteRiskProfile(profile: unknown): string | null {\r\n  if (typeof profile !== 'object' || profile === null) {\r\n    return 'writeRiskProfile is required for write-capable tools';\r\n  }\r\n  const p = profile as Record<string, unknown>;\r\n  if (p.kind === 'no_writes') return null;\r\n  if (p.kind === 'declared_paths') {\r\n    if (!Array.isArray(p.writePaths) || p.writePaths.length === 0) {\r\n      return 'writeRiskProfile.kind=\"declared_paths\" requires non-empty writePaths array';\r\n    }\r\n    return null;\r\n  }\r\n  if (p.kind === 'pattern_writes') {\r\n    if (typeof p.writePattern !== 'string' || p.writePattern.length === 0) {\r\n      return 'writeRiskProfile.kind=\"pattern_writes\" requires non-empty writePattern string';\r\n    }\r\n    // P1 fix: A pattern that matches everything is semantically equivalent to\r\n    // `dynamic_writes` but bypasses `requiresApproval`. Reject catch-all patterns\r\n    // so callers must use `dynamic_writes` (which requires approval) instead.\r\n    const pattern = (p.writePattern as string).trim();\r\n    if (pattern === '*' || pattern === '**' || pattern === '**/*' || pattern === '*/*') {\r\n      return `writeRiskProfile.kind=\"pattern_writes\" with writePattern=\"${pattern}\" matches all paths; use kind=\"dynamic_writes\" (with requiresApproval=true) instead`;\r\n    }\r\n    return null;\r\n  }\r\n  if (p.kind === 'dynamic_writes') {\r\n    if (p.requiresApproval !== true) {\r\n      return 'writeRiskProfile.kind=\"dynamic_writes\" requires requiresApproval=true';\r\n    }\r\n    return null;\r\n  }\r\n  return `writeRiskProfile.kind must be one of: no_writes, declared_paths, pattern_writes, dynamic_writes (got: ${String(p.kind)})`;\r\n}\r\n\r\n/**\r\n * Tool risk level. Used by `assertWriteRiskProfileForTool` to decide whether\r\n * a `writeRiskProfile` is required at registration time.\r\n *\r\n * This is a filesystem-risk classification. `readonly` does not prove that a\r\n * tool performs no durable state transition in an existing owner store; those\r\n * transitions require an owning API contract and focused behavioral tests.\r\n *\r\n * - `readonly`: tool does not write to the filesystem; profile optional.\r\n * - `write`: tool writes to the filesystem; `writeRiskProfile` is REQUIRED.\r\n * - `destructive`: tool performs irreversible operations; `writeRiskProfile`\r\n *   is REQUIRED and must be `dynamic_writes` (full fs-diff) for safety.\r\n */\r\nexport type ToolRiskLevel = 'readonly' | 'write' | 'destructive';\r\n\r\n/**\r\n * Error thrown by `assertWriteRiskProfileForTool` when a write-capable tool is\r\n * registered without a valid `writeRiskProfile`. The `field` property lets the\r\n * tool registry surface a named-field error to the caller (acceptance 0.4).\r\n */\r\nexport class MissingWriteRiskProfileError extends Error {\r\n  readonly field = 'writeRiskProfile';\r\n  constructor(message: string) {\r\n    super(message);\r\n    this.name = 'MissingWriteRiskProfileError';\r\n  }\r\n}\r\n\r\n/**\r\n * Stage 0 enforcement seam: assert that a tool with the given risk level has a\r\n * valid `writeRiskProfile`. This is the minimal enforcement required by\r\n * acceptance criterion 0.4. The full tool-registry integration happens in\r\n * Stage 2; this function is the pure validation core that the registry will\r\n * call.\r\n *\r\n * Rules:\r\n * - `readonly` tools: profile is optional (may be omitted or `no_writes`).\r\n * - `write` tools: profile is REQUIRED; must pass `validateWriteRiskProfile`.\r\n * - `destructive` tools: profile is REQUIRED and must be `dynamic_writes`\r\n *   (destructive operations cannot declare static paths — they need full\r\n *   fs-diff for safety review).\r\n *\r\n * Throws `MissingWriteRiskProfileError` (with `field: 'writeRiskProfile'`)\r\n * when the rule is violated.\r\n */\r\nexport function assertWriteRiskProfileForTool(\r\n  riskLevel: ToolRiskLevel,\r\n  profile: unknown,\r\n): void {\r\n  if (riskLevel === 'readonly') {\r\n    return; // profile optional\r\n  }\r\n\r\n  // write or destructive: profile required\r\n  const validationError = validateWriteRiskProfile(profile);\r\n  if (validationError) {\r\n    throw new MissingWriteRiskProfileError(validationError);\r\n  }\r\n\r\n  const p = profile as WriteRiskProfile;\r\n\r\n  // S2 fix (P0): semantic consistency — a write-capable tool declaring\r\n  // `no_writes` is contradictory and would bypass all write detection.\r\n  // Reject this combination at registration time.\r\n  if (riskLevel === 'write' || riskLevel === 'destructive') {\r\n    if (p.kind === 'no_writes') {\r\n      throw new MissingWriteRiskProfileError(\r\n        `risk=\"${riskLevel}\" is semantically incompatible with writeRiskProfile.kind=\"no_writes\"; ` +\r\n          `write-capable tools must declare declared_paths, pattern_writes, or dynamic_writes`,\r\n      );\r\n    }\r\n  }\r\n\r\n  // For destructive tools, require dynamic_writes (full fs-diff).\r\n  if (riskLevel === 'destructive') {\r\n    if (p.kind !== 'dynamic_writes') {\r\n      throw new MissingWriteRiskProfileError(\r\n        `risk=\"destructive\" requires writeRiskProfile.kind=\"dynamic_writes\" (got \"${p.kind}\"); ` +\r\n          `destructive operations must go through full fs-diff for safety review`,\r\n      );\r\n    }\r\n  }\r\n}\r\n","exit_code":0,"status":"completed"}}
