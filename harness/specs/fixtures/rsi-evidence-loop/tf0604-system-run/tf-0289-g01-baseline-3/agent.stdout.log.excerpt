{"type":"item.completed","item":{"id":"item_440","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\system32\\\\bash.exe\" -lc \"sed -n '36,80p' src/lib/error-model.ts\"","aggregated_output":"] as const satisfies readonly AppErrorCode[];\n\n/**\n * G01: the only recovery verbs an error may advertise.\n *\n * Kept as a runtime list so the vocabulary can be audited exhaustively. A\n * nextAction is a bounded, permission-scoped affordance for the existing error\n * exit to offer: it is never a shell command, raw script or argv, and it carries\n * no executable field for a caller to run.\n */\nexport const RECOVERY_VERBS = [\n  'retry',\n  'reauthenticate',\n  'reconfigure',\n  'open-settings',\n  'contact-support',\n] as const satisfies readonly string[];\nexport type ErrorRecoveryVerb = (typeof RECOVERY_VERBS)[number];\n\n/** Bounded targets a recovery action may name. Free-form text is not allowed. */\nexport const RECOVERY_TARGETS = [\n  'auth-profile',\n  'permissions',\n  'provider-config',\n  'model-selection',\n  'session',\n  'billing',\n] as const satisfies readonly string[];\nexport type ErrorRecoveryTarget = (typeof RECOVERY_TARGETS)[number];\n\n/**\n * A recovery action: a fixed verb plus, at most, one bounded target.\n *\n * kind and the optional target are the only permitted keys, so no payload can\n * smuggle command/script/shell/exec/argv.\n */\nexport type ErrorNextAction =\n  | { kind: 'retry' }\n  | { kind: 'reauthenticate'; target: ErrorRecoveryTarget }\n  | { kind: 'reconfigure'; target: ErrorRecoveryTarget }\n  | { kind: 'open-settings'; target: ErrorRecoveryTarget }\n  | { kind: 'contact-support' };\n\n/**\n * Whether the class recovers by repeating the same action with no other change\n","exit_code":0,"status":"completed"}}
