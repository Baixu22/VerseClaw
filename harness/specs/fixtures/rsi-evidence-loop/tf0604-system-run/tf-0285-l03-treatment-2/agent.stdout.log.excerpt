{"type":"item.completed","item":{"id":"item_189","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Get-Content openclaw_runtime/src/runtime-core/verifier-completion-verdict.test.ts | Select-Object -First 25; Write-Output \"=====agents example=====\"; Get-Content openclaw_runtime/src/agents/agent-browser-provenance-wiring.test.ts | Select-Object -First 25'","aggregated_output":"// @vitest-environment node\r\n// S07: bounded, revocable verifier completion-verdict entry.\r\nimport { describe, expect, it } from \"vitest\";\r\n\r\nimport { buildEvidenceVerifierInputFixture } from \"./evidence-verifier.js\";\r\nimport {\r\n  resolveVerifierCompletionVerdict,\r\n  revokeVerifierCompletionVerdict,\r\n  verifierCompletionTransition,\r\n  type VerifierCompletionScope,\r\n} from \"./verifier-completion-verdict.js\";\r\n\r\nconst scope: VerifierCompletionScope = { taskIds: [\"task_1\"] };\r\n\r\ndescribe(\"S07 verifier completion verdict\", () => {\r\n  it(\"approves a completed task with the canonical evidence and produces one node->done transition\", () => {\r\n    const record = resolveVerifierCompletionVerdict({\r\n      input: buildEvidenceVerifierInputFixture(),\r\n      scope,\r\n      priorStatus: \"doing\",\r\n    });\r\n    expect(record.verdict).toBe(\"approved\");\r\n    expect(record.taskId).toBe(\"task_1\");\r\n    expect(record.evidenceDigest).toMatch(/^[a-f0-9]{64}$/);\r\n    expect(verifierCompletionTransition(record)).toEqual({ nodeId: \"task_1\", from: \"doing\", to: \"done\" });\r\n=====agents example=====\r\nimport { describe, expect, it, vi } from \"vitest\";\r\n\r\nconst { createAgentBrowserTool } = vi.hoisted(() => ({\r\n  createAgentBrowserTool: vi.fn(() => null),\r\n}));\r\n\r\nvi.mock(\"./tools/agent-browser-tool.js\", () => ({ createAgentBrowserTool }));\r\n\r\nimport { createExternalProvenance } from \"../../../shared/security/content-provenance.js\";\r\nimport { createOpenClawTools } from \"./openclaw-tools.js\";\r\n\r\ndescribe(\"agent_browser provenance wiring\", () => {\r\n  it(\"passes the authoritative run sidecar into the external browser boundary\", () => {\r\n    const provenance = createExternalProvenance({\r\n      sourceKind: \"channel\",\r\n      sourceId: \"channel:telegram:message-1\",\r\n      receivedAt: \"2026-08-21T00:00:00.000Z\",\r\n    });\r\n    const invoke = vi.fn();\r\n\r\n    createOpenClawTools({\r\n      contentProvenanceContext: { provenance },\r\n      agentBrowserInvoker: invoke,\r\n      disablePluginTools: true,\r\n      wrapBeforeToolCallHook: false,\r\n","exit_code":0,"status":"completed"}}
