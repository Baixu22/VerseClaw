{"type":"item.started","item":{"id":"item_440","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"node -e \\\"\nconst fs=require('fs'),c=require('crypto'),path=require('path');\nconst root='D:/tmp/rsi-tf0604-run5/trials/tf-0289-g01-treatment-1/';\nfunction walk(d,base,out){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);const r=path.relative(base,p);if(e.isDirectory()){if(e.name==='node_modules'||e.name==='.git')continue;walk(p,base,out);}else out.push(r.split(path.sep).join('/'));}return out;}\nconst h=(p)=>{try{return c.createHash('sha256').update(fs.readFileSync(p)).digest('hex');}catch(e){return null;}};\nconst b=new Set(walk(root+'base',root+'base',[]));\nconst a=walk(root+'agent',root+'agent',[]);\nconst added=[],changed=[];\nfor(const rel of a){\n  if(rel.startsWith('.rsi/'))continue;\n  const ab=h(root+'agent/'+rel), bh=b.has(rel)?h(root+'base/'+rel):null;\n  if(bh===null)added.push(rel); else if(bh\"'!==ab)changed.push(rel);\n}\nconsole.log('\"'ADDED ('+added.length+'):');added.forEach(x=>console.log('  + '+x+'  '+h(root+'agent/'+x)));\nconsole.log('CHANGED ('+changed.length+'):');changed.forEach(x=>console.log('  ~ '+x+'  '+h(root+'agent/'+x)));\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
