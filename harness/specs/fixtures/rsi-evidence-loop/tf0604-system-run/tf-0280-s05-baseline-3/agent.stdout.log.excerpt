{"type":"item.completed","item":{"id":"item_264","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0280-s05-baseline-3\\\\agent; \"'$test = @'\"'\n// @vitest-environment node\n/**\n * S05 provider credential-use boundary ledger guard.\n *\n * Verifies the single existing credential-use policy\n * (resolveProviderCredentialUsePolicy) and pins the coverage boundary: only the\n * explicit model/provider override branch of image_generate consults it, and an\n * external/unknown provenance override may only use a host-bound provider.\n * Denial happens before any credential read and no credential value is a policy\n * input; every other credential-use path is recorded as residual in the S05\n * ledger.\n */\nimport { readFileSync } from 'node:fs';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { describe, expect, it } from 'vitest';\n\nimport {\n  createExternalProvenance,\n  createTrustedProvenance,\n  deriveProvenance,\n} from '../../shared/security/content-provenance';\nimport { resolveProviderCredentialUsePolicy } from '../../openclaw_runtime/src/agents/tools/provider-credential-use-policy';\n\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');\nconst POLICY = 'openclaw_runtime/src/agents/tools/provider-credential-use-policy.ts';\nconst TOOL = 'openclaw_runtime/src/agents/tools/image-generate-tool.ts';\nconst LEDGER = 'docs/dev/harness-gap-closure/s05-credential-use-boundary.md';\nconst POLICY_INPUTS = ['provenanceContext', 'hasExplicitModelOverride', 'requestedProvider', 'boundProviderIds'];\nconst RECEIVED_AT = '2026-08-21T00:00:00.000Z';\n\nconst external = createExternalProvenance({ sourceKind: 'web', sourceId: 'web:s05', receivedAt: RECEIVED_AT });\nconst derivedExternal = deriveProvenance({\n  sourceKind: 'tool-result',\n  sourceId: 'tool-result:s05',\n  receivedAt: RECEIVED_AT,\n  parents: [external],\n});\nconst invalidProvenance = { ...external, trustLevel: 'trusted' };\nconst trustedSystem = createTrustedProvenance({ sourceKind: 'system-generated', sourceId: 'system:s05', receivedAt: RECEIVED_AT });\nconst trustedOperator = createTrustedProvenance({ sourceKind: 'user-direct', sourceId: 'operator:s05', receivedAt: RECEIVED_AT });\n\nfunction read(repoPath: string): string {\n  return readFileSync(join(ROOT, repoPath), 'utf8');\n}\n\nfunction evaluate(overrides: Record<string, unknown> = {}) {\n  return resolveProviderCredentialUsePolicy({\n    provenanceContext: { provenance: external },\n    hasExplicitModelOverride: true,\n    requestedProvider: 'other-provider',\n    boundProviderIds: ['openai'],\n    ...overrides,\n  });\n}\n\ndescribe('S05 provider credential-use boundary ledger', () => {\n  it('denies an unbound explicit override for external/derived/missing/invalid provenance', () => {\n    for (const provenance of [external, derivedExternal, invalidProvenance, undefined]) {\n      expect(evaluate({ provenanceContext: { provenance } })).toMatchObject({\n        allowed: false,\n        restricted: true,\n      });\n    }\n  });\n\n  it('allows an explicit override that stays inside the host-bound provider scope', () => {\n    expect(evaluate({ requestedProvider: 'OPENAI' })).toMatchObject({ allowed: true, restricted: false });\n    expect(\n      evaluate({ requestedProvider: 'configured-fallback', boundProviderIds: ['openai', 'configured-fallback'] }),\n    ).toMatchObject({ allowed: true, restricted: false });\n  });\n\n  it('fails closed when an explicit override names no resolvable provider', () => {\n    expect(evaluate({ requestedProvider: undefined })).toMatchObject({ allowed: false, restricted: true });\n  });\n\n  it('does not constrain the default/fallback path or trusted system / direct operator overrides', () => {\n    expect(evaluate({ hasExplicitModelOverride: false })).toMatchObject({ allowed: true, restricted: false });\n    for (const provenance of [trustedSystem, trustedOperator]) {\n      expect(evaluate({ provenanceContext: { provenance } })).toMatchObject({ allowed: true, restricted: false });\n    }\n  });\n\n  it('keeps credential values out of the policy input and denial reason', () => {\n    const policy = read(POLICY);\n    for (const field of POLICY_INPUTS) expect(policy).toContain(field);\n    expect(policy).not.toMatch(/credentialValue|apiKey|secret|token/i);\n    const denial = evaluate({ requestedProvider: 'other-provider' });\n    expect(denial.allowed).toBe(false);\n    expect(String(denial.reason)).not.toMatch(/credential-value|sk-|apiKey|bearer/i);\n  });\n\n  it('pins the single call site: the credential gate runs before provider execution', () => {\n    const tool = read(TOOL);\n    const gate = tool.indexOf('resolveProviderCredentialUsePolicy(');\n    expect(gate).toBeGreaterThan(-1);\n    expect(tool.indexOf('hasExplicitModelOverride: true', gate)).toBeGreaterThan(gate);\n    // Denial precedes provider execution (the tool's own generateImage call).\n    expect(tool.indexOf('await generateImage(', gate)).toBeGreaterThan(gate);\n    expect(tool.indexOf('await executeImageGenerationJob(', gate)).toBeGreaterThan(gate);\n    // Only one call site in the tool; the policy is not duplicated elsewhere.\n    expect((tool.match(/resolveProviderCredentialUsePolicy\\\\(/g) ?? []).length).toBe(1);\n  });\n\n  it('records the coverage boundary and residual in the ledger doc', () => {\n    const doc = read(LEDGER);\n    expect(doc).toContain('resolveProviderCredentialUsePolicy');\n    expect(doc).toContain('image-generate-tool.ts');\n    expect(doc).toContain('hasExplicitModelOverride');\n    expect(doc).toContain('fallback');\n    expect(doc.toLowerCase()).toContain('residual');\n  });\n});\n'@\n\"'$path = Join-Path (Get-Location) '\"'tests/unit/provider-credential-use-boundary-ledger.test.ts'\n[System.IO.File]::WriteAllText(\"'$path, ($test -replace \"`r`n\",\"`n\"), (New-Object System.Text.UTF8Encoding($false)))\nnode ./node_modules/vitest/vitest.mjs run tests/unit/provider-credential-use-boundary-ledger.test.ts --maxWorkers=1 --reporter=verbose 2>&1 | Select-Object -Last 20'","aggregated_output":"⎯⎯⎯⎯⎯⎯⎯ Failed Tests 1 ⎯⎯⎯⎯⎯⎯⎯\r\n\r\n FAIL  tests/unit/provider-credential-use-boundary-ledger.test.ts > S05 provider credential-use boundary ledger > pins the single call site: the credential gate runs before provider execution\r\nAssertionError: expected -1 to be greater than 33043\r\n ❯ tests/unit/provider-credential-use-boundary-ledger.test.ts:100:56\r\n     98|     expect(tool.indexOf('hasExplicitModelOverride: true', gate)).toBeG…\r\n     99|     // Denial precedes provider execution (the tool's own generateImag…\r\n    100|     expect(tool.indexOf('await generateImage(', gate)).toBeGreaterThan…\r\n       |                                                        ^\r\n    101|     expect(tool.indexOf('await executeImageGenerationJob(', gate)).toB…\r\n    102|     // Only one call site in the tool; the policy is not duplicated el…\r\n\r\n⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯[1/1]⎯\r\n\r\n\r\n Test Files  1 failed (1)\r\n      Tests  1 failed | 6 passed (7)\r\n   Start at  06:38:52\r\n   Duration  463ms (transform 77ms, setup 142ms, import 41ms, tests 8ms, environment 0ms)\r\n\r\n","exit_code":1,"status":"failed"}}
