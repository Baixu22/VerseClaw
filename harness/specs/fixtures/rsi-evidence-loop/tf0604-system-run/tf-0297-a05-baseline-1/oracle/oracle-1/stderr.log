+   replanOnResume(input: ContextBudgetPlannerInput): ContextBudgetPlan {
+     const supersedesPlanId = this.lastPlan?.planId;
+     this.resumeReplanCount += 1;
+     const plan = this.build(input, {
+       replannedOnResume: true,
+       ...(supersedesPlanId ? { supersedesPlanId } : {}),
+     });
+     this.remember(plan);
+     return plan;
+   }
+
+   /** Record a real compaction call-site outcome against the A5 counters. */
+   recordCompressionOutcome(params: {
+     plan: ContextBudgetPlan;
+     tokensBefore: number;
+     actualTier?: CompressionTier;
+   }): A5PlanOutcome {
+     const expectedTier = expectedTierForPlan(params.plan, params.tokensBefore);
+     const actualTier = params.actualTier ?? expectedTier;
+     const adopted = actualTier === expectedTier;
+     const budgetExceeded = params.tokensBefore > params.plan.totalBudgetTokens;
+     if (adopted) {
+       deprecationCounters.incrementA5PlanAdopted(1);
+     } else {
+       deprecationCounters.incrementA5PlanIgnored(1);
+     }
+     if (budgetExceeded) {
+       deprecationCounters.incrementA5BudgetExceeded(1);
+     }
+     return { adopted, ignored: !adopted, budgetExceeded, expectedTier, actualTier };
+   }
