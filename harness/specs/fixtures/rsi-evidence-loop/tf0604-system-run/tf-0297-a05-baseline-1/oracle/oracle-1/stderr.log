+ /**
+  * Hand an A5 plan to the A2 scheduler. Started waves stay immutable: the
+  * scheduler rejects a re-plan of a wave whose workers were already spawned, so
+  * the plan applies to the next plannable wave only (criterion 3.9).
+  */
+ export function queuePlanToWave(
+   plan: ContextBudgetPlan,
+   scheduler: Pick<ResourceAwareWaveScheduler, "rePlan">,
+ ): WaveQueueResult {
+   const result = scheduler.rePlan({
+     appliesToWave: plan.appliesToWave,
+     maxWorkers: plan.proposedMaxWorkers,
+   });
+   if (result.accepted) {
+     return {
+       accepted: true,
+       appliesToWave: plan.appliesToWave,
+       proposedMaxWorkers: plan.proposedMaxWorkers,
+     };
+   }
+   return { accepted: false, appliesToWave: plan.appliesToWave, reason: result.reason };
+ }
+
+ /** First wave at or after `fromWave` that has not started yet. */
+ export function nextPlannableWave(
+   waves: ReadonlyArray<{ wave: number; status: string }>,
+   fromWave: number,
+ ): number | undefined {
+   const candidate = waves
+     .filter((wave) => wave.wave >= fromWave && wave.status === "planned")
+     .sort((a, b) => a.wave - b.wave)[0];
