+ export type ContextBudgetPlannerOptions = {
+   mode?: ContextBudgetMode;
+   now?: () => number;
+ };
+
+ /**
+  * Turn-scoped A5 planner facade. It keeps only in-memory diagnostics (rolling
+  * plan history) and owns no durable task truth.
+  */
+ export class ContextBudgetPlanner {
+   private readonly mode: ContextBudgetMode;
+   private readonly now: () => number;
+   private sequence = 0;
+   private resumeReplanCount = 0;
+   private lastPlan: ContextBudgetPlan | undefined;
+   private readonly history: ContextBudgetPlan[] = [];
+
+   constructor(options: ContextBudgetPlannerOptions = {}) {
+     this.mode = options.mode ?? "shadow";
+     this.now = options.now ?? Date.now;
