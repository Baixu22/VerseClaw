{"type":"item.completed","item":{"id":"item_398","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"& \\\"C:\\\\Program Files\\\\Git\\\\bin\\\\bash.exe\\\" -c 'cd \\\"/d/tmp/rsi-tf0604-run5/trials/tf-0293-a01-baseline-3/agent\\\" && sed -n \\\"1,60p\\\" tests/unit/a01-a1-gate-coverage.test.ts'\"","aggregated_output":"// @vitest-environment node\n/**\n * A01 / TF-0293 — A1 Layered Execution Isolation pilot gate re-verification.\n *\n * This is an *executable coverage guard* for the A1 graduation gate declared in\n * `harness/specs/tasks/a1-layered-isolation-pilot.md`. It does NOT redefine any\n * threshold: the `< 5%` fallback rate, the `<= 200ms` p99 budget, the\n * `declaredPathViolationCount` tracking requirement, and the `degrade_to_legacy`\n * response are the original gate values, re-read from the spec and re-driven\n * against the current candidate modules.\n *\n * The gate's declared `requiredTests` previously listed five files that do not\n * exist on this candidate and omitted the counter test that DOES exist\n * (`openclaw_runtime/src/observability/deprecation-counters.test.ts`). The spec\n * drift is corrected by declaring that counter test, and this guard fails if the\n * declaration is removed again (see \"spec drift guard\" below).\n */\nimport { existsSync, readFileSync } from 'node:fs';\nimport { join } from 'node:path';\n\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\n\nimport { parseFrontmatter } from '../../harness/src/specs.mjs';\nimport { deprecationCounters } from '../../openclaw_runtime/src/observability/deprecation-counters.js';\nimport {\n  ObservabilityTraceRecorder,\n} from '../../openclaw_runtime/src/observability/trace-recorder.js';\nimport {\n  ShadowWriteEventRecorder,\n  detectUndeclaredWrites,\n} from '../../openclaw_runtime/src/agents/sessions/extensions/shadow-write-event-recorder.js';\nimport { collectDeclaredWritePaths } from '../../openclaw_runtime/src/agents/sessions/extensions/policy-light-snapshotter.js';\nimport {\n  assertWriteRiskProfileForTool,\n  validateWriteRiskProfile,\n} from '../../openclaw_runtime/src/shared/tool-registration.js';\n\nconst ROOT = process.cwd();\nconst A1_SPEC = 'harness/specs/tasks/a1-layered-isolation-pilot.md';\nconst COUNTER_TEST = 'openclaw_runtime/src/observability/deprecation-counters.test.ts';\n\n/** The six built-in write-capable tools the gate names. */\nconst BUILTIN_WRITE_TOOLS = [\n  'openclaw_runtime/src/agents/sessions/tools/write.ts',\n  'openclaw_runtime/src/agents/sessions/tools/edit.ts',\n  'openclaw_runtime/src/agents/sessions/tools/bash.ts',\n  'openclaw_runtime/src/agents/apply-patch.ts',\n  'openclaw_runtime/src/agents/bash-tools.exec.ts',\n  'openclaw_runtime/src/agents/bash-tools.process.ts',\n];\n\nfunction readRepo(relative: string): string {\n  return readFileSync(join(ROOT, relative), 'utf8');\n}\n\nfunction specData() {\n  return parseFrontmatter(readRepo(A1_SPEC)).data as Record<string, unknown>;\n}\n\n/** Drive a 100-turn session and return the A1 fallback rate. */\n","exit_code":0,"status":"completed"}}
