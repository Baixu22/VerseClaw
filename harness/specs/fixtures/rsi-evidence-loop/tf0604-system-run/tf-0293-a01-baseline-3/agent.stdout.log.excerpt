{"type":"item.completed","item":{"id":"item_404","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"& \\\"C:\\\\Program Files\\\\Git\\\\bin\\\\bash.exe\\\" -c 'cd \\\"/d/tmp/rsi-tf0604-run5/trials/tf-0293-a01-baseline-3/agent\\\" && sed -n \\\"60,180p\\\" tests/unit/a01-a1-gate-coverage.test.ts'\"","aggregated_output":"/** Drive a 100-turn session and return the A1 fallback rate. */\nfunction runTurns(fallback: number, success: number): number {\n  deprecationCounters.reset();\n  deprecationCounters.incrementA1LegacyFallback(fallback);\n  deprecationCounters.incrementA1ShadowSuccess(success);\n  const total = fallback + success;\n  return fallback / total;\n}\n\ndescribe('A01: A1 pilot gate — original thresholds re-driven, not redefined', () => {\n  beforeEach(() => deprecationCounters.reset());\n  afterEach(() => deprecationCounters.reset());\n\n  // ---------------------------------------------------------------------\n  // Criterion 1 — legacy fallback rate < 5%\n  // ---------------------------------------------------------------------\n  it('criterion 1: >5% fallback rate is a violation; <=5% is not (threshold unchanged)', () => {\n    // 6/100 = 6.0% > 5% → violated.\n    expect(runTurns(6, 94)).toBeGreaterThan(0.05);\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(true);\n\n    // 5/100 = 5.0% — the boundary is ALLOWED (strict `>`), not a violation.\n    expect(runTurns(5, 95)).toBe(0.05);\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(false);\n\n    // 4/100 = 4.0% < 5% → not violated.\n    expect(runTurns(4, 96)).toBeLessThan(0.05);\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(false);\n  });\n\n  // ---------------------------------------------------------------------\n  // Criterion 2 — p99 <= 200ms (original budget; measured, not redefined)\n  // ---------------------------------------------------------------------\n  it('criterion 2: the isolation hot path p99 stays within the 200ms budget', () => {\n    const declaredBudgetMs = 200;\n    const samples: number[] = [];\n    const tools = [{ name: 'write', profile: { kind: 'dynamic_writes', requiresApproval: true } as const }];\n    for (let turn = 0; turn < 100; turn++) {\n      const started = performance.now();\n      collectDeclaredWritePaths(tools);\n      deprecationCounters.incrementA1ShadowSuccess();\n      samples.push(performance.now() - started);\n    }\n    samples.sort((a, b) => a - b);\n    const p99 = samples[Math.min(samples.length - 1, Math.ceil(samples.length * 0.99) - 1)];\n    expect(p99).toBeLessThanOrEqual(declaredBudgetMs);\n  });\n\n  // ---------------------------------------------------------------------\n  // Criterion 3 — declaredPathViolationCount tracked separately\n  // ---------------------------------------------------------------------\n  it('criterion 3: declaredPathViolationCount is counted and tracked independently', () => {\n    deprecationCounters.incrementA1LegacyFallback(3);\n    deprecationCounters.incrementA1ShadowSuccess(97);\n    deprecationCounters.incrementA1DeclaredPathViolation(2);\n\n    const a1 = deprecationCounters.getArea('a1');\n    expect(a1).toMatchObject({\n      legacyFallbackCount: 3,\n      shadowSuccessCount: 97,\n      declaredPathViolationCount: 2,\n    });\n    // Satisfying the rate gate does not clear (or reset) the violation counter.\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(false);\n    expect(deprecationCounters.getArea('a1').declaredPathViolationCount).toBe(2);\n  });\n\n  // ---------------------------------------------------------------------\n  // Criterion 4 — checkBudgetViolation('a1') => degrade_to_legacy\n  // ---------------------------------------------------------------------\n  it(\"criterion 4: rate > 5% returns action=degrade_to_legacy\", () => {\n    deprecationCounters.incrementA1LegacyFallback(6);\n    deprecationCounters.incrementA1ShadowSuccess(94);\n    const result = deprecationCounters.checkBudgetViolation('a1');\n    expect(result.violated).toBe(true);\n    if (result.violated) {\n      expect(result.degrade).toBe('a1_legacy_fallback_rate');\n      expect(result.action).toBe('degrade_to_legacy');\n    }\n  });\n\n  // ---------------------------------------------------------------------\n  // writeRiskProfile declaration + registration enforcement\n  // ---------------------------------------------------------------------\n  it('all six built-in write-capable tools declare both risk and writeRiskProfile', () => {\n    for (const file of BUILTIN_WRITE_TOOLS) {\n      expect(existsSync(join(ROOT, file)), `${file} must exist`).toBe(true);\n      const text = readRepo(file);\n      expect(text, `${file} declares risk`).toMatch(/\\brisk\\s*:/);\n      expect(text, `${file} declares writeRiskProfile`).toMatch(/\\bwriteRiskProfile\\s*:/);\n    }\n  });\n\n  it('registry rejects a write tool with no profile and accepts a valid one', () => {\n    expect(() => assertWriteRiskProfileForTool('write', undefined)).toThrow();\n    expect(() => assertWriteRiskProfileForTool('write', { kind: 'no_writes' })).toThrow();\n    expect(() =>\n      assertWriteRiskProfileForTool('write', { kind: 'declared_paths', writePaths: ['a.txt'] }),\n    ).not.toThrow();\n    expect(validateWriteRiskProfile({ kind: 'dynamic_writes', requiresApproval: false })).toContain(\n      'requiresApproval',\n    );\n  });\n\n  // ---------------------------------------------------------------------\n  // Trace namespace enforcement on an A1 recorder\n  // ---------------------------------------------------------------------\n  it('an a1 recorder rejects claw.a4.tool.choice and records the rejection', () => {\n    const recorder = new ObservabilityTraceRecorder(\n      { name: 'a1-pilot' },\n      { callerArea: 'a1', idFactory: (prefix) => `${prefix}_${Math.random().toString(36).slice(2, 8)}` },\n    );\n    const rejected = recorder.recordEvent('claw.a4.tool.choice', 'wrong namespace');\n    expect(rejected.type).toBe('claw.core.trace.namespace_rejected');\n    expect(rejected.attributes?.rejectedType).toBe('claw.a4.tool.choice');\n\n    // A correctly-namespaced A1 event is recorded, not rejected.\n    const accepted = recorder.recordEvent('claw.a1.tool.choice', 'ok');\n    expect(accepted.type).toBe('claw.a1.tool.choice');\n\n    const types = recorder.snapshot().events.map((event) => event.type);\n","exit_code":0,"status":"completed"}}
