if (entries.length === 0) paths.push(path);\r\n 222:     for (const [key, child] of entries) {\r\n 223:       collectWireLeafPaths(child, `${path}/${escapeJsonPointerSegment(key)}`, paths);\r\n 224:     }\r\n 225:     return;\r\n 226:   }\r\n 227:   paths.push(path);\r\n 228: }\r\n 229: \r\n 230: /** Aggregate proof that every final JSON leaf has exactly one named adapter owner. */\r\n 231: export function buildWireOwnerCensus(\r\n 232:   body: string | Uint8Array | Record<string, unknown>,\r\n 233:   adapterId: string | undefined,\r\n 234: ): WireOwnerCensus {\r\n 235:   const paths: string[] = [];\r\n 236:   collectWireLeafPaths(parseWireBody(body), '', paths);\r\n 237:   const uniquePaths = new Set(paths);\r\n 238:   const normalizedAdapterId = adapterId?.trim() ?? '';\r\n 239:   const ownerRecords = [...uniquePaths]\r\n 240:     .toSorted()\r\n 241:     .map((fieldPath) => ({ fieldPath, ownerClass: 'adapter', ownerId: normalizedAdapterId }));\r\n 242:   const digest = digestStable(ownerRecords);\r\n 243:   return {\r\n 244:     fieldCount: paths.length,\r\n 245:     unknownCount: normalizedAdapterId ? 0 : paths.length,\r\n 246:     duplicateCount: paths.length - uniquePaths.size,\r\n 247:     proofRef: `owner-census:v0:${paths.length}:${digest}`,\r\n 248:   };\r\n 249: }\r\n 250: \r\n 251: function callIndex(input: ShadowReceiptCallContext): ReceiptCallIndex {\r\n 252:   return {\r\n 253:     attemptIndex: input.attemptIndex ?? 0,\r\n 254:     modelCallIndex: input.modelCallIndex ?? 0,\r\n 255:     wireAttemptIndex: input.wireAttemptIndex ?? 0,\r\n 256:   };\r\n 257: }\r\n 258: \r\n 259: function identity(input: ShadowReceiptCallContext, runtimeMode: RuntimeReceiptRuntimeMode): ReceiptIdentity {\r\n 260:   return {\r\n 261:     sessionKey: input.sessionKey,\r\n 262:     runId: input.runId,\r\n 263:     traceId: input.traceId,\r\n 264:     providerId: input.providerId ?? input.adapterId,\r\n 265:     adapterId: input.adapterId,\r\n 266:     transformIds: input.transformIds,\r\n 267:     runtimeMode,\r\n 268:   };\r\n 269: }\r\n 270: \r\n 271: function shadowStore(options: ShadowReceiptOptions): Pick<ReceiptStore, 'put'> {\r\n 272:   return options.receiptStore ?? (options.database ? new ReceiptStore(options.database) : new ReceiptStore());\r\n 273: }\r\n 274: \r\n 275: /**\r\n 276:  * R5-3: resolve the wire-side correlation from the same source the\r\n 277:  * ContextReceipt used — the sealed bundle digest persisted as the v1\r\n 278:  * ContextReceipt correlation_digest of the same run and model call. The seal\r\n 279:  * plan registry only carries CompilePlan and rc03-seal-hook.ts is read-only\r\n 280:  * for this batch, so the receipt store is the single production join source.\r\n 281:  * Observational: a miss or failure leaves correlationDigest unset and the\r\n 282:  * emit boundary falls back to the identity-derived digest.\r\n 283:  */\r\n 284: export function resolveRc03WireCorrelationDigest(\r\n 285:   options: ShadowReceiptOptions,\r\n 286:   plan: { runId?: string; callIndex: { modelCallIndex: number } },\r\n 287: ): string | undefined {\r\n 288:   const runId = options.runId ?? plan.runId;\r\n 289:   if (!runId || options.receiptStore) return undefined;\r\n 290:   try {\r\n 291:     const store = options.database ? new ReceiptStore(options.database) : new ReceiptStore();\r\n 292:     const rows = store.list({\r\n 293:       kind: 'context',\r\n 294:       runId,\r\n 295:       modelCallIndex: plan.callIndex.modelCallIndex,\r\n 296:       limit: 16,\r\n 297:     });\r\n 298:     const v1 = rows.find((row) => row.version === '1' && typeof row.correlation_digest === 'string' && row.correlation_digest);\r\n 299:     return v1?.correlation_digest ?? undefined;\r\n 300:   } catch {\r\n 301:     return undefined;\r\n 302:   }\r\n 303: }\r\n 304: \r\n 305: function isEnabled(options: ShadowReceiptOptions): boolean {\r\n 306:   if (options.enabled !== undefined) return options.enabled === true;\r\n 307:   const value = process.env.OPENCLAW_RC02_SHADOW_CENSUS?.trim().toLowerCase();\r\n 308:   return value === '1' || value === 'true' || value === 'yes' || value === 'on';\r\n 309: }\r\n 310: \r\n 311: /** Report the bounded capability contract for source and npm runtime paths. */\r\n 312: export function resolveShadowCensusCapability(options: ShadowReceiptOptions = {}): ShadowCensusCapability {\r\n 313:   const sourceRuntime = options.sourceRuntime !== false;\r\n 314:   const enabled = isEnabled(options);\r\n 315:   const acceptanceReady = shadowFailureCount === 0;\r\n 316:   return {\r\n 317:     runtimeMode: sourceRuntime ? 'source' : 'npm',\r\n 318:     degraded: !sourceRuntime,\r\n 319:     degradedReason: sourceRuntime ? null : 'npm-fallback-does-not-provide-source-receipt-coverage',\r\n 320:     receiptCoverage: sourceRuntime && enabled && acceptanceReady ? 1 : 0,\r\n 321:     readiness: sourceRuntime && enabled && acceptanceReady,\r\n 322:   };\r\n 323: }\r\n 324: \r\n 325: function runtimeMode(options: ShadowReceiptOptions): RuntimeReceiptRuntimeMode {\r\n 326:   return options.sourceRuntime === false ? 'npm' : 'source';\r\n 327: }\r\n 328: \r\n 329: function correlationDigest(input: ShadowReceiptCallContext): string {\r\n 330:   // R5-3: receipt correlation digests hash through the RC-08B correlation\r\n 331:   // module so both stay on one source; the segment projection stays the\r\n 332:   // receipt call identity (byte-identical to the previous local hasher).\r\n 333:   return digestStableJson({\r\n 334:     provider: input.providerId ?? input.adapterId ?? 'unknown',\r\n 335:     model: input.modelId ?? null,\r\n 336:     sessionKey: input.sessionKey ?? null,\r\n 337:     runId: input.runId ?? null,\r\n 338:     traceId: input.traceId ?? null,\r\n 339:     attempt: input.attemptIndex ?? 0,\r\n 340:     modelCall: input.modelCallIndex ?? 0,\r\n","exit_code":0,"status":"completed"}}
