lIndex : undefined),\r\n 407:     wireAttemptIndex:\r\n 408:       input.wireAttemptIndex ??\r\n 409:       attached.wireAttemptIndex ??\r\n 410:       (typeof rawOptions.wireAttemptIndex === 'number' ? rawOptions.wireAttemptIndex : undefined),\r\n 411:   };\r\n 412:   const active = isEnabled(attached);\r\n 413:   if (!active) {\r\n 414:     return {\r\n 415:       active: false,\r\n 416:       options: { ...attached, ...call, enabled: false },\r\n 417:       receipt: {\r\n 418:         active: false,\r\n 419:         receipt: null,\r\n 420:         failed: false,\r\n 421:         correlationDigest: null,\r\n 422:         logicalDigest: null,\r\n 423:       },\r\n 424:     };\r\n 425:   }\r\n 426:   if (attached.correlationDigest && attached.logicalDigest) {\r\n 427:     return {\r\n 428:       active,\r\n 429:       options: { ...attached, ...call, enabled: active },\r\n 430:       receipt: {\r\n 431:         active: true,\r\n 432:         receipt: null,\r\n 433:         failed: false,\r\n 434:         correlationDigest: attached.correlationDigest,\r\n 435:         logicalDigest: attached.logicalDigest,\r\n 436:       },\r\n 437:     };\r\n 438:   }\r\n 439:   const receipt = emitShadowContextReceipt(logicalContext, call, { ...attached, enabled: true });\r\n 440:   if (!receipt.active) {\r\n 441:     throw new Error('active shadow model call did not produce an active context receipt result');\r\n 442:   }\r\n 443:   return {\r\n 444:     active: true,\r\n 445:     options: {\r\n 446:       ...attached,\r\n 447:       ...call,\r\n 448:       enabled: true,\r\n 449:       correlationDigest: receipt.correlationDigest,\r\n 450:       logicalDigest: receipt.logicalDigest,\r\n 451:     },\r\n 452:     receipt,\r\n 453:   };\r\n 454: }\r\n 455: \r\n 456: export function attachShadowReceiptOptions<T extends object>(options: T | undefined, shadow: ShadowReceiptOptions): T & { [RC02_SHADOW_OPTIONS]: ShadowReceiptOptions } {\r\n 457:   return { ...(options ?? {}), [RC02_SHADOW_OPTIONS]: shadow } as T & { [RC02_SHADOW_OPTIONS]: ShadowReceiptOptions };\r\n 458: }\r\n 459: \r\n 460: /** Emit the logical receipt before provider projection. No raw context is stored. */\r\n 461: export function emitShadowContextReceipt(\r\n 462:   logicalContext: unknown,\r\n 463:   input: ShadowReceiptCallContext,\r\n 464:   options: ShadowReceiptOptions = {},\r\n 465: ): ShadowContextEmitResult {\r\n 466:   if (!isEnabled(options)) {\r\n 467:     return {\r\n 468:       active: false,\r\n 469:       receipt: null,\r\n 470:       failed: false,\r\n 471:       correlationDigest: null,\r\n 472:       logicalDigest: null,\r\n 473:     };\r\n 474:   }\r\n 475:   const logicalDigest = digestStable(logicalContext);\r\n 476:   const correlation = options.correlationDigest ?? correlationDigest(input);\r\n 477: \r\n 478:   const receiptIdentity = identity(input, runtimeMode(options));\r\n 479:   let receipt: PutReceiptResult | null;\r\n 480:   try {\r\n 481:     receipt = shadowStore(options).put({\r\n 482:       idempotencyKey: `ctx:v0:${correlation}`,\r\n 483:       kind: 'shadow_context',\r\n 484:       version: SHADOW_CONTEXT_RECEIPT_VERSION,\r\n 485:       identity: receiptIdentity,\r\n 486:       callIndex: callIndex(input),\r\n 487:       content: { logicalDigest, correlationDigest: correlation },\r\n 488:     });\r\n 489:   } catch {\r\n 490:     recordShadowCensusFailure('context-write', 'receipt-store-write-failed');\r\n 491:     return { active: true, receipt: null, failed: true, correlationDigest: correlation, logicalDigest };\r\n 492:   }\r\n 493:   const failed = !receipt.ok;\r\n 494:   if (failed) recordShadowCensusFailure('context-write', 'receipt-content-conflict');\r\n 495:   return { active: true, receipt, failed, correlationDigest: correlation, logicalDigest };\r\n 496: }\r\n 497: \r\n 498: /** Emit the final wire receipt at the guarded request-body boundary. */\r\n 499: export function emitShadowWireReceipt(\r\n 500:   body: string | Uint8Array | Record<string, unknown>,\r\n 501:   input: ShadowReceiptCallContext,\r\n 502:   options: ShadowReceiptOptions = {},\r\n 503: ): ShadowWireEmitResult {\r\n 504:   if (!isEnabled(options)) return { receipt: null, failed: false };\r\n 505:   const correlation = options.correlationDigest ?? correlationDigest(input);\r\n 506:   const wireDigest = wireBodyDigest(body);\r\n 507:   let ownerCensus: WireOwnerCensus;\r\n 508:   try {\r\n 509:     // Owner coverage requires a named transport adapter. A provider id is not\r\n 510:     // sufficient evidence because it does not identify the serializer/finalizer.\r\n 511:     ownerCensus = buildWireOwnerCensus(body, input.adapterId);\r\n 512:   } catch {\r\n 513:     recordShadowCensusFailure('wire-owner', 'final-wire-body-invalid');\r\n 514:     return { receipt: null, failed: true };\r\n 515:   }\r\n 516:   if (ownerCensus.unknownCount !== 0 || ownerCensus.duplicateCount !== 0) {\r\n 517:     recordShadowCensusFailure('wire-owner', 'wire-owner-incomplete');\r\n 518:     return { receipt: null, failed: true };\r\n 519:   }\r\n 520:   const receiptIdentity = identity(input, runtimeMode(options));\r\n 521:   let receipt: PutReceiptResult | null;\r\n 522:   try {\r\n 523:     receipt = shadowStore(options).put({\r\n 524:       idempotencyKey: `wire:v0:${correlation}:${input.wireAttemptIndex ?? 0}`,\r\n 525:       kind: 'shadow_wire',\r\n 526:       version: SHADOW_WIRE_RECEIPT_VERSION,\r\n 527:       identity: receiptIdentity,\r\n 528:       callIndex: callIndex(input),\r\n 529:       content: {\r\n 530:         logicalDigest: options.logicalDigest,\r\n 531:         wireDigest,\r\n 532:         correlationDigest: correlation,\r\n 533:         selected: [\r\n 534:           ownerCensus.proofRef,\r\n 535:           ...(options.requestEnvelopeRef ? [options.requestEnvelopeRef] : []),\r\n 536:         ],\r\n 537:       },\r\n 538:     });\r\n 539:   } catch {\r\n 540:     recordShadowCensusFailure('wire-write', 'receipt-store-write-failed');\r\n 541:     return { receipt: null, failed: true };\r\n 542:   }\r\n 543:   const failed = !receipt.ok;\r\n 544:   if (failed) recordShadowCensusFailure('wire-write', 'receipt-content-conflict');\r\n 545:   return { receipt, failed };\r\n 546: }\r\n 547: \r\n 548: /** Compatibility helper for narrow unit tests; production uses the two phases. */\r\n 549: export function emitShadowCensus(\r\n 550:   body: Record<string, unknown>,\r\n 551:   input: ShadowReceiptCallContext,\r\n 552:   options: ShadowReceiptOptions = {},\r\n 553: ): ShadowCensusEmitResult {\r\n 554:   const context = emitShadowContextReceipt(body, input, options);\r\n 555:   if (!context.active) {\r\n 556:     return { contextReceipt: null, wireReceipt: null, failed: false };\r\n 557:   }\r\n 558:   const wire = emitShadowWireReceipt(body, input, {\r\n 559:     ...options,\r\n 560:     correlationDigest: context.correlationDigest,\r\n 561:     logicalDigest: context.logicalDigest,\r\n 562:   });\r\n 563:   return { contextReceipt: context.receipt, wireReceipt: wire.receipt, failed: context.failed || wire.failed };\r\n 564: }\r\n 565: \r\n 566: /** RC-03 WireReceipt/v1 at the guarded boundary. The receipt is bound to the\r\n 567:  *  sealed plan's identity and the final serialized body digest; registered\r\n 568:  *  non-semantic transport transform ids ride on the identity. Observational\r\n 569:  *  only: write failures record census diagnostics and never change send bytes. */\r\n 570: export function emitRc03WireReceipt(\r\n 571:   body: string | Uint8Array | Record<string, unknown>,\r\n 572:   options: ShadowReceiptOptions,\r\n 573:   input: { providerId: string; adapterId: string; modelId?: string; wireAttemptIndex: number },\r\n 574: ): PutReceiptResult | null {\r\n 575:   const plan = options.rc03Plan;\r\n 576:   if (!plan) return null;\r\n 577:   const wireDigest = wireBodyDigest(body);\r\n 578:   const correlation = options.correlationDigest ?? correlationDigest({\r\n 579:     providerId: input.providerId,\r\n 580:     adapterId: input.adapterId,\r\n 581:     modelId: input.modelId,\r\n 582:     sessionKey: options.sessionKey,\r\n 583:     runId: options.runId,\r\n 584:     traceId: options.traceId,\r\n 585:     attemptIndex: options.attemptIndex,\r\n 586:     modelCallIndex: options.modelCallIndex,\r\n 587:     wireAttemptIndex: input.wireAttemptIndex,\r\n 588:   });\r\n 589:   const identity: ReceiptIdentity = {\r\n 590:     sessionKey: options.sessionKey,\r\n 591:     runId: options.runId,\r\n 592:     traceId: options.traceId,\r\n 593:     providerId: input.providerId,\r\n 594:     adapterId: input.adapterId,\r\n 595:     transformIds: plan.postSealTransformIds,\r\n 596:     runtimeMode: runtimeMode(options),\r\n 597:   };\r\n 598:   let receipt: PutReceiptResult | null;\r\n 599:   try {\r\n 600:     receipt = shadowStore(options).put({\r\n 601:       idempotencyKey: `wire:v1:${plan.planId}:${correlation}:${input.wireAttemptIndex}`,\r\n 602:       kind: 'wire',\r\n 603:       version: '1',\r\n 604:       identity,\r\n 605:       callIndex: {\r\n 606:         attemptIndex: options.attemptIndex ?? plan.callIndex.attemptIndex,\r\n 607:         modelCallIndex: options.modelCallIndex ?? plan.callIndex.modelCallIndex,\r\n 608:         wireAttemptIndex: input.wireAttemptIndex,\r\n 609:       },\r\n 610:       content: {\r\n 611:         logicalDigest: options.logicalDigest,\r\n 612:         wireDigest,\r\n 613:         correlationDigest: correlation,\r\n 614:         ...(options.requestEnvelopeRef ? { selected: [options.requestEnvelopeRef] } : {}),\r\n 615:       },\r\n 616:     });\r\n 617:   } catch {\r\n 618:     recordShadowCensusFailure('wire-write', 'receipt-store-write-failed');\r\n 619:     return null;\r\n 620:   }\r\n 621:   if (!receipt.ok) {\r\n 622:     recordShadowCensusFailure('wire-write', 'receipt-content-conflict');\r\n 623:   }\r\n 624:   return receipt;\r\n 625: }\r\n","exit_code":0,"status":"completed"}}
