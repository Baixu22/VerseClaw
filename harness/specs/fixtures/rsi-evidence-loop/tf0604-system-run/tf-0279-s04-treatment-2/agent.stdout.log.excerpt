{"type":"item.started","item":{"id":"item_115","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0279-s04-baseline-1\\\\agent; Get-Content tests/unit/browser-effect-boundary-ledger.test.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_115","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0279-s04-baseline-1\\\\agent; Get-Content tests/unit/browser-effect-boundary-ledger.test.ts\"","aggregated_output":"/**\r\n * S04 browser-effect boundary ledger guard.\r\n *\r\n * The browser-effect sink already carries one narrow gate\r\n * (openclaw_runtime/src/agents/tools/agent-browser-external-access-policy.ts)\r\n * wired by openclaw_runtime/src/agents/tools/agent-browser-tool.ts. This guard\r\n * pins *which* actions actually reach which gate, so coverage cannot be\r\n * silently widened or quietly overstated:\r\n *\r\n *   - connection-mode gate: evaluated for every action; external/unknown\r\n *     provenance cannot select auto-connect / cdp / external-profile.\r\n *   - session-ownership gate: evaluated ONLY for click / type; external/unknown\r\n *     provenance must land on a Main-reported managed session.\r\n *\r\n * evaluate / command / close are side-effect actions that are NOT gated by the\r\n * session-ownership check. They are asserted here as residual, not as covered.\r\n */\r\nimport { readFileSync } from 'node:fs';\r\nimport { dirname, join, resolve } from 'node:path';\r\nimport { fileURLToPath } from 'node:url';\r\nimport { describe, expect, it } from 'vitest';\r\n\r\nimport {\r\n  createExternalProvenance,\r\n  createTrustedProvenance,\r\n  deriveProvenance,\r\n  isExternalOrUnknownProvenance,\r\n  provenanceStatus,\r\n  type ContentProvenanceContext,\r\n} from '../../shared/security/content-provenance';\r\nimport {\r\n  resolveAgentBrowserExternalAccessPolicy,\r\n  resolveAgentBrowserSessionEffectPolicy,\r\n  shouldPreflightAgentBrowserSessionEffect,\r\n} from '../../openclaw_runtime/src/agents/tools/agent-browser-external-access-policy';\r\nimport { createAgentBrowserTool } from '../../openclaw_runtime/src/agents/tools/agent-browser-tool';\r\n\r\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');\r\nconst TOOL_SOURCE = 'openclaw_runtime/src/agents/tools/agent-browser-tool.ts';\r\nconst POLICY_SOURCE = 'openclaw_runtime/src/agents/tools/agent-browser-external-access-policy.ts';\r\n\r\nconst RECEIVED_AT = '2026-10-13T00:00:00.000Z';\r\n\r\n/** external (web) provenance: untrusted + containsExternalUntrustedContent. */\r\nconst EXTERNAL: ContentProvenanceContext = {\r\n  provenance: createExternalProvenance({\r\n    sourceKind: 'web',\r\n    sourceId: 'web:s04',\r\n    receivedAt: RECEIVED_AT,\r\n  }),\r\n};\r\n/** derived-untrusted provenance: inherits external-ness from parents. */\r\nconst DERIVED: ContentProvenanceContext = {\r\n  provenance: deriveProvenance({\r\n    sourceKind: 'tool-result',\r\n    sourceId: 'tool-result:s04',\r\n    receivedAt: RECEIVED_AT,\r\n    parents: [EXTERNAL.provenance],\r\n  }),\r\n};\r\n/** no provenance value at all -> status \"missing\". */\r\nconst MISSING: ContentProvenanceContext = { provenance: undefined };\r\n/** structurally invalid provenance -> status \"missing\" (reason invalid). */\r\nconst INVALID: ContentProvenanceContext = {\r\n  provenance: { schema: 'content-provenance.v1', not: 'a provenance' },\r\n};\r\n/** trusted system-generated provenance. */\r\nconst TRUSTED_SYSTEM: ContentProvenanceContext = {\r\n  provenance: createTrustedProvenance({\r\n    sourceKind: 'system-generated',\r\n    sourceId: 'system:s04',\r\n    receivedAt: RECEIVED_AT,\r\n  }),\r\n};\r\n/** direct operator provenance. */\r\nconst DIRECT_OPERATOR: ContentProvenanceContext = {\r\n  provenance: createTrustedProvenance({\r\n    sourceKind: 'user-direct',\r\n    sourceId: 'user:s04',\r\n    receivedAt: RECEIVED_AT,\r\n  }),\r\n};\r\n\r\nconst RESTRICTED: Record<string, ContentProvenanceContext> = {\r\n  external: EXTERNAL,\r\n  derived: DERIVED,\r\n  missing: MISSING,\r\n  invalid: INVALID,\r\n};\r\nconst UNRESTRICTED: Record<string, ContentProvenanceContext> = {\r\n  trustedSystem: TRUSTED_SYSTEM,\r\n  directOperator: DIRECT_OPERATOR,\r\n};\r\n\r\nconst EXTERNAL_MODES = ['auto-connect', 'cdp', 'external-profile'];\r\nconst SESSION_EFFECT_ACTIONS = ['click', 'type'] as const;\r\n\r\nfunction read(repoPath: string): string {\r\n  return readFileSync(join(ROOT, repoPath), 'utf8');\r\n}\r\n\r\n/** Actions that the tool actually routes through the session-ownership gate. */\r\nfunction sessionOwnershipGateActions(toolSource: string): string[] {\r\n  const match = toolSource.match(/if \\(([^)]*)\\)\\s*\\{\\s*await assertSessionEffectAllowed\\(/);\r\n  if (!match) return [];\r\n  return [...match[1].matchAll(/\"([^\"]+)\"/g)].map((entry) => entry[1]);\r\n}\r\n\r\ndescribe('S04 connection-mode gate (agent_browser)', () => {\r\n  it('classifies external, derived-untrusted, missing and invalid as external-or-unknown', () => {\r\n    for (const [name, context] of Object.entries(RESTRICTED)) {\r\n      expect(isExternalOrUnknownProvenance(provenanceStatus(context.provenance)), name).toBe(true);\r\n    }\r\n    for (const [name, context] of Object.entries(UNRESTRICTED)) {\r\n      expect(isExternalOrUnknownProvenance(provenanceStatus(context.provenance)), name).toBe(false);\r\n    }\r\n  });\r\n\r\n  it('denies every external connection mode for external/unknown provenance', () => {\r\n    for (const [name, context] of Object.entries(RESTRICTED)) {\r\n      for (const mode of EXTERNAL_MODES) {\r\n        const result = resolveAgentBrowserExternalAccessPolicy({\r\n          provenanceContext: context,\r\n          connectionMode: mode,\r\n        });\r\n        expect(result.allowed, `${name}/${mode} must be denied`).toBe(false);\r\n        expect(result.restricted).toBe(true);\r\n        expect(result.reason).toMatch(/external or unknown provenance/);\r\n      }\r\n    }\r\n  });\r\n\r\n  it('allows the managed connection mode for external/unknown provenance', () => {\r\n    for (const [name, context] of Object.entries(RESTRICTED)) {\r\n      const result = resolveAgentBrowserExternalAccessPolicy({\r\n        provenanceContext: context,\r\n        connectionMode: 'managed',\r\n      });\r\n      expect(result.allowed, `${name}/managed must stay allowed`).toBe(true);\r\n      expect(result.restricted).toBe(false);\r\n    }\r\n  });\r\n\r\n  it('leaves trusted system and direct operator provenance unrestricted', () => {\r\n    for (const [name, context] of Object.entries(UNRESTRICTED)) {\r\n      for (const mode of [...EXTERNAL_MODES, 'managed']) {\r\n        const result = resolveAgentBrowserExternalAccessPolicy({\r\n          provenanceContext: context,\r\n          connectionMode: mode,\r\n        });\r\n        expect(result.allowed, `${name}/${mode} must stay allowed`).toBe(true);\r\n        expect(result.restricted).toBe(false);\r\n      }\r\n    }\r\n  });\r\n});\r\n\r\ndescribe('S04 session-ownership gate (agent_browser click/type)', () => {\r\n  it('preflights only external/unknown provenance', () => {\r\n    for (const context of Object.values(RESTRICTED)) {\r\n      expect(shouldPreflightAgentBrowserSessionEffect(context)).toBe(true);\r\n    }\r\n    for (const context of Object.values(UNRESTRICTED)) {\r\n      expect(shouldPreflightAgentBrowserSessionEffect(context)).toBe(false);\r\n    }\r\n  });\r\n\r\n  it('requires a Main-reported managed session for external/unknown provenance', () => {\r\n    for (const action of SESSION_EFFECT_ACTIONS) {\r\n      for (const [name, context] of Object.entries(RESTRICTED)) {\r\n        const managed = resolveAgentBrowserSessionEffectPolicy({\r\n          provenanceContext: context,\r\n          sessionConnectionMode: 'managed',\r\n          action,\r\n        });\r\n        expect(managed.allowed, `${name}/${action}/managed must be allowed`).toBe(true);\r\n\r\n        for (const mode of [...EXTERNAL_MODES, undefined]) {\r\n          const denied = resolveAgentBrowserSessionEffectPolicy({\r\n            provenanceContext: context,\r\n            sessionConnectionMode: mode,\r\n            action,\r\n          });\r\n          expect(denied.allowed, `${name}/${action}/${String(mode)} must be denied`).toBe(false);\r\n          expect(denied.reason).toMatch(/verified managed browser session/);\r\n        }\r\n      }\r\n    }\r\n  });\r\n\r\n  it('does not constrain trusted system or direct operator provenance', () => {\r\n    for (const action of SESSION_EFFECT_ACTIONS) {\r\n      for (const [name, context] of Object.entries(UNRESTRICTED)) {\r\n        for (const mode of [...EXTERNAL_MODES, 'managed', undefined]) {\r\n          const result = resolveAgentBrowserSessionEffectPolicy({\r\n            provenanceContext: context,\r\n            sessionConnectionMode: mode,\r\n            action,\r\n          });\r\n          expect(result.allowed, `${name}/${action}/${String(mode)} must stay allowed`).toBe(true);\r\n        }\r\n      }\r\n    }\r\n  });\r\n});\r\n\r\ndescribe('S04 per-action coverage ledger', () => {\r\n  const toolSource = read(TOOL_SOURCE);\r\n\r\n  it('evaluates the connection-mode gate before dispatching any action', () => {\r\n    const gateIndex = toolSource.indexOf('resolveAgentBrowserExternalAccessPolicy(');\r\n    const dispatchIndex = toolSource.indexOf('await options.invoke!(');\r\n    expect(gateIndex).toBeGreaterThan(-1);\r\n    expect(dispatchIndex).toBeGreaterThan(-1);\r\n    expect(gateIndex).toBeLessThan(dispatchIndex);\r\n    expect(toolSource).toContain('connectionMode: payload.connectionMode');\r\n  });\r\n\r\n  it('routes exactly click and type through the session-ownership gate', () => {\r\n    expect(sessionOwnershipGateActions(toolSource)).toEqual(['click', 'type']);\r\n    expect(toolSource).toContain('assertSessionEffectAllowed(');\r\n    expect(toolSource).toContain('shouldPreflightAgentBrowserSessionEffect');\r\n  });\r\n\r\n  it('keeps the read-only and non-session actions on the connection-mode gate only', () => {\r\n    const gateActions = new Set(sessionOwnershipGateActions(toolSource));\r\n    for (const action of ['navigate', 'status', 'waitForSelector', 'screenshot', 'getConsoleMessages']) {\r\n      expect(gateActions.has(action), `${action} must not use the session-ownership gate`).toBe(false);\r\n    }\r\n  });\r\n\r\n  it('records evaluate, command and close as residual (side-effect, not session-gated)', () => {\r\n    const gateActions = new Set(sessionOwnershipGateActions(toolSource));\r\n    for (const action of ['evaluate', 'command', 'close']) {\r\n      // The action still exists and is still routed ...\r\n      expect(toolSource, `${action} must still be a supported action`).toContain(`case \"${action}\":`);\r\n      // ... but it is deliberately NOT behind the session-ownership gate.\r\n      expect(gateActions.has(action), `${action} must stay residual`).toBe(false);\r\n    }\r\n  });\r\n\r\n  it('exposes a connection mode only for open and command', () => {\r\n    const payload = toolSource.slice(\r\n      toolSource.indexOf('function buildPayload'),\r\n      toolSource.indexOf('function asRecord'),\r\n    );\r\n    const openBlock = payload.slice(payload.indexOf('case \"open\":'), payload.indexOf('case \"status\":'));\r\n    const commandBlock = payload.slice(payload.indexOf('case \"command\":'));\r\n    expect(openBlock).toContain('\"connectionMode\"');\r\n    expect(commandBlock).toContain('\"connectionMode\"');\r\n    // Session-scoped actions build payloads from a fixed key list, so they never\r\n    // request an external connection mode themselves.\r\n    for (const action of ['click', 'type', 'navigate', 'evaluate']) {\r\n      const start = payload.indexOf(`case \"${action}\":`);\r\n      const next = payload.indexOf('case \"', start + 6);\r\n      const block = payload.slice(start, next === -1 ? undefined : next);\r\n      expect(block, `${action} must not request connectionMode`).not.toContain('\"connectionMode\"');\r\n    }\r\n  });\r\n});\r\n\r\ndescribe('S04 single boundary and unchanged guards', () => {\r\n  it('reuses the single existing browser-effect policy module', () => {\r\n    const policySource = read(POLICY_SOURCE);\r\n    expect(policySource).toContain('export function resolveAgentBrowserExternalAccessPolicy');\r\n    expect(policySource).toContain('export function resolveAgentBrowserSessionEffectPolicy');\r\n    // The tool consumes the policy; it does not define a second gate.\r\n    expect(read(TOOL_SOURCE)).toContain('agent-browser-external-access-policy');\r\n    expect(createAgentBrowserTool).toBeTypeOf('function');\r\n  });\r\n\r\n  it('does not weaken the SSRF / private-network / browser kill-switch config', () => {\r\n    const browserTypes = read('openclaw_runtime/src/config/types.browser.ts');\r\n    expect(browserTypes).toContain('dangerouslyAllowPrivateNetwork');\r\n    expect(browserTypes).toContain('hostnameAllowlist');\r\n    expect(browserTypes).toContain('allowedHostnames');\r\n    expect(browserTypes).toMatch(/enabled\\?: boolean/);\r\n    expect(browserTypes).toContain('evaluateEnabled');\r\n  });\r\n\r\n  it('keeps the Main-owned allowExternalBrowser acknowledgement for non-managed modes', () => {\r\n    const service = read('electron/services/agent-browser-service.ts');\r\n    expect(service).toContain('allowExternalBrowser !== true');\r\n  });\r\n});\r\n","exit_code":0,"status":"completed"}}
