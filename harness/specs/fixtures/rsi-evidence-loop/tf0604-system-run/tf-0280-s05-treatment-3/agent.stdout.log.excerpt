{"type":"item.completed","item":{"id":"item_282","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Get-Content tests/unit/provider-credential-use-boundary-ledger.test.ts -Raw'","aggregated_output":"// @vitest-environment node\n/**\n * S05 credential-use boundary ledger guard.\n *\n * Verifies the existing provider-override credential-use policy and pins the\n * coverage boundary: the gate lives only on the explicit `model` override branch\n * of `image_generate` and rejects before any provider credential is resolved.\n * The other credential-use paths are recorded as residual in the S05 ledger, so\n * wiring one into this gate forces a ledger update instead of a silent\n * over-claim.\n */\nimport { readdirSync, readFileSync, statSync } from 'node:fs';\nimport { dirname, join, relative, resolve, sep } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { describe, expect, it } from 'vitest';\n\nimport {\n  createExternalProvenance,\n  createTrustedProvenance,\n  deriveProvenance,\n} from '../../shared/security/content-provenance';\nimport { resolveProviderCredentialUsePolicy } from '../../openclaw_runtime/src/agents/tools/provider-credential-use-policy';\n\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');\nconst POLICY = 'openclaw_runtime/src/agents/tools/provider-credential-use-policy.ts';\nconst TOOL = 'openclaw_runtime/src/agents/tools/image-generate-tool.ts';\nconst LEDGER = 'docs/dev/harness-gap-closure/s05-credential-use-boundary.md';\nconst RUNTIME_SRC = 'openclaw_runtime/src';\n/** Import specifier that names the one credential-use policy module. */\nconst POLICY_IMPORT_MARKER = 'provider-credential-use-policy';\n\n/** Credential-use paths NOT wired to the provider-override gate (S05 residual). */\nconst RESIDUAL_CREDENTIAL_USE = [\n  'openclaw_runtime/src/agents/tools/image-tool.ts',\n  'openclaw_runtime/src/agents/tools/video-generate-tool.ts',\n  'openclaw_runtime/src/agents/tools/music-generate-tool.ts',\n  'openclaw_runtime/src/agents/tools/pdf-tool.ts',\n  'openclaw_runtime/src/agents/tools/sessions-spawn-tool.ts',\n  'openclaw_runtime/src/agents/tools/web-search-provider-credentials.ts',\n  'openclaw_runtime/src/plugins/runtime/runtime-model-auth.runtime.ts',\n  'openclaw_runtime/src/llm/env-api-keys.ts',\n  'openclaw_runtime/src/media-generation/runtime-shared.ts',\n];\n\nconst external = createExternalProvenance({ sourceKind: 'web', sourceId: 'web:s05', receivedAt: '2026-08-21T00:00:00.000Z' });\nconst derivedExternal = deriveProvenance({ sourceKind: 'tool-result', sourceId: 'tool-result:s05', receivedAt: '2026-08-21T00:00:00.000Z', parents: [external] });\nconst trustedSystem = createTrustedProvenance({ sourceKind: 'system-generated', sourceId: 'system:s05', receivedAt: '2026-08-21T00:00:00.000Z' });\nconst directOperator = createTrustedProvenance({ sourceKind: 'user-direct', sourceId: 'operator:s05', receivedAt: '2026-08-21T00:00:00.000Z' });\n\nconst BOUND = ['openai/image-v1', 'fal/image-v1'];\nconst UNBOUND_CREDENTIAL_PROVIDER = 'anthropic/image-v9';\n\n/** external / derived-untrusted / missing / invalid provenance shapes. */\nconst UNTRUSTED_CONTEXTS = [\n  { provenance: external },\n  { provenance: derivedExternal },\n  undefined,\n  { provenance: { nope: 1 } },\n];\n\nfunction read(repoPath: string): string {\n  return readFileSync(join(ROOT, repoPath), 'utf8');\n}\n\n/** Modules under openclaw_runtime/src that import the credential-use policy. */\nfunction collectPolicyImporters(): string[] {\n  const found: string[] = [];\n  const walk = (absoluteDir: string): void => {\n    for (const entry of readdirSync(absoluteDir, { withFileTypes: true })) {\n      const absolute = join(absoluteDir, entry.name);\n      if (entry.isDirectory()) {\n        if (entry.name === 'node_modules' || entry.name === '__snapshots__') continue;\n        walk(absolute);\n        continue;\n      }\n      if (!entry.name.endsWith('.ts') || entry.name.includes('.test.')) continue;\n      if (readFileSync(absolute, 'utf8').includes(POLICY_IMPORT_MARKER)) {\n        found.push(relative(ROOT, absolute).split(sep).join('/'));\n      }\n    }\n  };\n  walk(join(ROOT, RUNTIME_SRC));\n  return found.sort();\n}\n\ndescribe('S05 credential-use boundary ledger', () => {\n  it('denies external/derived-untrusted/missing/invalid an explicit override outside the bound scope', () => {\n    for (const provenanceContext of UNTRUSTED_CONTEXTS) {\n      expect(\n        resolveProviderCredentialUsePolicy({\n          provenanceContext,\n          hasExplicitModelOverride: true,\n          requestedProvider: UNBOUND_CREDENTIAL_PROVIDER,\n          boundProviderIds: BOUND,\n        }),\n      ).toMatchObject({ allowed: false, restricted: true });\n    }\n  });\n\n  it('allows an external override that stays inside the host-bound provider scope', () => {\n    for (const provenanceContext of UNTRUSTED_CONTEXTS) {\n      expect(\n        resolveProviderCredentialUsePolicy({\n          provenanceContext,\n          hasExplicitModelOverride: true,\n          requestedProvider: 'openai/image-v1',\n          boundProviderIds: BOUND,\n        }),\n      ).toMatchObject({ allowed: true, restricted: false });\n    }\n  });\n\n  it('preserves trusted-system and direct-operator override semantics, even outside the scope', () => {\n    for (const provenance of [trustedSystem, directOperator]) {\n      expect(\n        resolveProviderCredentialUsePolicy({\n          provenanceContext: { provenance },\n          hasExplicitModelOverride: true,\n          requestedProvider: UNBOUND_CREDENTIAL_PROVIDER,\n          boundProviderIds: BOUND,\n        }),\n      ).toMatchObject({ allowed: true, restricted: false });\n    }\n  });\n\n  it('does not gate the default/fallback path (no explicit override)', () => {\n    for (const provenanceContext of UNTRUSTED_CONTEXTS) {\n      expect(\n        resolveProviderCredentialUsePolicy({\n          provenanceContext,\n          hasExplicitModelOverride: false,\n          requestedProvider: UNBOUND_CREDENTIAL_PROVIDER,\n          boundProviderIds: BOUND,\n        }),\n      ).toMatchObject({ allowed: true, restricted: false });\n    }\n  });\n\n  it('normalizes provider ids so case/whitespace cannot bypass the bound scope', () => {\n    expect(\n      resolveProviderCredentialUsePolicy({\n        provenanceContext: { provenance: external },\n        hasExplicitModelOverride: true,\n        requestedProvider: '  OpenAI/IMAGE-V1  ',\n        boundProviderIds: BOUND,\n      }),\n    ).toMatchObject({ allowed: true });\n  });\n\n  it('reports a fixed denial reason and never receives or reports credential values', () => {\n    const denial = resolveProviderCredentialUsePolicy({\n      provenanceContext: { provenance: external },\n      hasExplicitModelOverride: true,\n      requestedProvider: UNBOUND_CREDENTIAL_PROVIDER,\n      boundProviderIds: BOUND,\n    });\n    expect(denial.allowed).toBe(false);\n    expect(typeof denial.reason).toBe('string');\n    // The reason is fixed policy text, not a credential echo.\n    expect(denial.reason).not.toContain(UNBOUND_CREDENTIAL_PROVIDER);\n    expect(denial.reason).not.toMatch(/sk-|api[_-]?key|token|bearer|password/i);\n\n    // The policy source neither reads nor names credential material.\n    const policy = read(POLICY);\n    expect(policy).not.toMatch(/api[_-]?key|apiKey|secret|authProfile|authStore|bearer|password/i);\n    expect(policy).toMatch(/Credential values never/);\n  });\n\n  it('pins the wiring: gate only on the image_generate explicit override branch, before any credential resolution', () => {\n    const tool = read(TOOL);\n    expect(tool).toMatch(/resolveProviderCredentialUsePolicy\\(/);\n    // Single call site, guarded by the explicit `model` override branch.\n    expect(tool.split('resolveProviderCredentialUsePolicy(').length - 1).toBe(1);\n    const overrideBranch = tool.indexOf('if (model !== undefined)');\n    const gateIndex = tool.indexOf('resolveProviderCredentialUsePolicy(');\n    expect(overrideBranch).toBeGreaterThan(-1);\n    expect(gateIndex).toBeGreaterThan(overrideBranch);\n    // The decision runs before credential-bearing config resolution, before\n    // the generate execution path is entered, and before the provider is picked.\n    expect(gateIndex).toBeLessThan(tool.indexOf('applyImageGenerationModelConfigDefaults('));\n    expect(gateIndex).toBeLessThan(tool.indexOf('readStringParam(params, \"prompt\"'));\n    expect(gateIndex).toBeLessThan(tool.indexOf('resolveSelectedImageGenerationProvider({', gateIndex));\n    expect(gateIndex).toBeLessThan(tool.lastIndexOf('executeImageGenerationJob('));\n    // The override gate flags an explicit override and reads only host-bound provider ids.\n    expect(tool).toMatch(/hasExplicitModelOverride: true/);\n    expect(tool).toMatch(/boundProviderIds:/);\n  });\n\n  it('keeps the credential-use policy as the single strategy (only one production importer)', () => {\n    expect(collectPolicyImporters()).toEqual([TOOL]);\n  });\n\n  it('pins every residual credential-use path so wiring one forces a ledger update', () => {\n    for (const file of RESIDUAL_CREDENTIAL_USE) {\n      expect(statSync(join(ROOT, file), { throwIfNoEntry: false })?.isFile(), file).toBe(true);\n      expect(\n        read(file).includes(POLICY_IMPORT_MARKER),\n        `${file} now imports the credential-use gate - update ${LEDGER}`,\n      ).toBe(false);\n    }\n  });\n\n  it('records coverage and residual in the ledger doc', () => {\n    const doc = read(LEDGER);\n    expect(doc.toLowerCase()).toContain('residual');\n    expect(doc).toContain('resolveProviderCredentialUsePolicy');\n    expect(doc).toContain('image_generate');\n    expect(doc).toContain('credential-use');\n    for (const file of RESIDUAL_CREDENTIAL_USE) expect(doc).toContain(file);\n  });\n});\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_283","type":"reasoning","text":"One concern: `expect(denial.reason).not.toMatch(/sk-|api.../)` — the reason is \"Image generation provider override denied: external or unknown provenance may only use the configured image-generation provider scope.\" No \"sk-\" substring there. Good.\n\nAlso `policy` file check: does the policy file contain the substring \"secret\"? Let me check: the policy file imports from content-provenance. No \"secret\". But wait - it has the word... let me double check the whole file for those tokens. Already did earlier: no matches. Good.\n\nBut my test asserts `policy` does not match /api[_-]?key|apiKey|secret|.../i. Earlier Select-String on that file returned nothing for `apiKey|secret|password|bearer|sk-`. Good.\n\nNow one more: the `generateImage(` from line 744 — I removed that. Good.\n\nLet me also confirm `tool.indexOf('readStringParam(params, \"prompt\"')` exists. Yes line 975.\n\nI'm confident. Let me also double-check the doc claims match reality: \"the only production caller\" - test verifies importer set equals [image-generate-tool.ts]. Good.\n\nNow, let me reconsider the acceptance.json candidate commit/tree. The task baseCommit is ae9ea9162c105f734566f5a696d55b5eae5071df. Since there's no .git, I put tree \"not-recorded-no-git-checkout\". That's honest.\n\nLet me finalize and report. Also should double check: does the S02 sink ledger reference credential-use already; is there a drift-guard requiring S05 spec registration? The sensitive-sink-residual-ledger test checks the s02 doc contains every sink kind. Fine.\n\nOne more consideration: my new spec's `requiredTests` includes tests/unit/sensitive-sink-residual-ledger.test.ts and sensitive-sink-enforcement-drift — those exist. And image-generate-provenance-wiring.test.ts exists. Good.\n\nNow the task says \"run relevant existing checks that do not install dependencies\". I ran: harness context, harness validate (structural), ledger guard offline replica, credential scan (repo patterns), SHA256SUMS readback, spec lifecycle (pre-existing failures). Good.\n\nLet me confirm the final SHA256SUMS is consistent after all edits (I regenerated after the acceptance.json edit; the doc and spec unchanged since). Let me re-verify once more to be safe, since I did not modify after generating.\n\nActually I regenerated sums AFTER the credentialScan edit. No edits since. Good — readback already returned True.\n\nLet me produce the final structured result.\n\nWait — one thing: acceptance.json contains the hash of itself? No, S05-SHA256SUMS covers the 4 files but not itself (matching S03/S04 convention where SHA256SUMS is excluded from its own listing). Good.\n\nLet me also double check that I should verify the claim \"rejects before reading any provider credentials\". The gate is in the `if (model !== undefined)` block which runs before `effectiveCfg`, provider selection and execution. Provider credential lookup happens in generateImage/executeImageGenerationJob. Good — statement is accurate.\n\nFinal answer.\n\nActually, let me reconsider one acceptance criterion: \"不新建第二套凭据策略\" (no second credential strategy). My test asserts only one importer of the policy module. That's a reasonable pin. Good.\n\nAlso \"不改默认 provider、fallback 或凭据存储\" — I didn't touch product code at all. Good.\n\nLet me run the offline ledger guard replica once more since it's the key evidence, to include in report. Already passed. \n\nLet me finalize."}}
