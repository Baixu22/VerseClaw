---------------------------------------------\r\n// Cross-area composition facades (A5 x A2 x A6)\r\n//\r\n// `docs/runtime-design/area-composition-spec.md` assigns A5 three composition\r\n// duties that no single area module owns on its own:\r\n//\r\n//   - Pair 3 (A5 + A2): the A5 budget plan is injected before the wave\r\n//     scheduler starts; a started wave is immutable, so a plan can only change\r\n//     the *next* wave (`appliesToWave`).\r\n//   - Pair 5 (A5 + A6): after a resume, A5 re-runs `ContextBudgetPlanner`.\r\n//     A budget read back from the checkpoint is stale and must never be reused.\r\n//   - Stage 3 criterion 3.6: pause -> resume -> planner re-executes, not stale.\r\n//\r\n// This module is the composition facade for those duties. It is deliberately\r\n// thin and read-only towards the production ladder:\r\n//   - `ContextBudgetPlanner` only READS `compression-planner.ts` thresholds via\r\n//     `resolveTierThresholds` (earlier-only clamp, production defaults as the\r\n//     backstop). It never replaces the five-tier ladder, never mutates\r\n//     `CompressionArtifact`, and never blocks a turn on estimation failure.\r\n//   - Wave changes always go through `ResourceAwareWaveScheduler.rePlan`, which\r\n//     already rejects started/completed waves (criterion 3.9).\r\n//   - A5 budget breaches are read from the existing deprecation registry\r\n//     (`degrade_to_default_budget`), not re-implemented here.\r\n//\r\n// See: docs/runtime-design/area-composition-spec.md (Pair 3 / Pair 5)\r\n// See: docs/runtime-design/development-manual.md (criterion 3.6, A5 module CAN/MUST NOT)\r\n// See: docs/runtime-design/area-5-adaptive-context-budget.md (ContextBudgetPlanner)\r\n// ---------------------------------------------------------------------------\r\n\r\nimport {\r\n  resolveTierThresholds,\r\n  type TierSchedule,\r\n} from \"../../../packages/agent-core/src/harness/compaction/compression-planner.js\";\r\nimport {\r\n  deprecationCounters,\r\n  type BudgetViolationResult,\r\n} from \"../../observability/deprecation-counters.js\";\r\nimport type {\r\n  RePlanResult,\r\n  ResourceAwareWaveScheduler,\r\n} from \"../resource-aware-wave-scheduler.js\";\r\n\r\n/** Plan posture. `shadow` records the plan without changing prompt assembly. */\r\nexport type ContextBudgetMode = \"shadow\" | \"advisory\" | \"active\";\r\n\r\nexport type ContextTaskKind =\r\n  | \"locate\"\r\n  | \"explain\"\r\n  | \"edit\"\r\n  | \"refactor\"\r\n  | \"test\"\r\n  | \"review\"\r\n  | \"long_task\"\r\n  | \"unknown\";\r\n\r\n/** Reserved token slices of the model window (sums to `totalBudgetTokens`). */\r\nexport type ContextBudgetReserved = {\r\n  systemAndRules: number;\r\n  recentConversation: number;\r\n  providerContext: number;\r\n  toolOutput: number;\r\n  verification: number;\r\n  recoveryProjection: number;\r\n  emergencyHeadroom: number;\r\n};\r\n\r\n/** Token positions of the reactive pressure ladder, derived (read-only) from\r\n * `compression-planner.ts` thresholds. */\r\nexport type ContextPressureSchedule = {\r\n  microCompactAt: number;\r\n  tokenPruneAt: number;\r\n  semanticHandoffAt: number;\r\n  emergencyCollapseAt: number;\r\n};\r\n\r\nexport type ContextBudgetEvidenceRef = { type: string; ref: string; label?: string };\r\n\r\nexport type ContextBudgetPlan = {\r\n  version: 1;\r\n  mode: ContextBudgetMode;\r\n  taskKind: ContextTaskKind;\r\n  totalBudgetTokens: number;\r\n  reserved: ContextBudgetReserved;\r\n  pressureSchedule: ContextPressureSchedule;\r\n  providerBudgets: Record<string, number>;\r\n  evidenceRefs: ContextBudgetEvidenceRef[];\r\n  /** A2 pairing: the plan takes effect from this wave onward. Absent when the\r\n   * planner has no wave to address. */\r\n  appliesToWave?: number;\r\n  /** Worker cap this plan asks A2 to use for the next wave. */\r\n  suggestedMaxWorkers: number;\r\n  /** Monotonic planner generation. A resume always advances it. */\r\n  generation: number;\r\n  /** True only for a plan produced by `replanOnResume`. */\r\n  resumedFromCheckpoint: boolean;\r\n  /** True when the A5 registry asked for `degrade_to_default_budget`. */\r\n  degraded: boolean;\r\n};\r\n\r\nexport type TaskComplexityEstimate = {\r\n  taskKind: ContextTaskKind;\r\n  complexity: \"small\" | \"medium\" | \"large\" | \"uncertain\";\r\n  risk: \"low\" | \"medium\" | \"high\";\r\n  expectedToolOutputTokens: number;\r\n  requiresVerificationBudget: boolean;\r\n  reasons: string[];\r\n};\r\n\r\nexport type ContextBudgetPlanInput = {\r\n  sessionId?: string;\r\n  roleId?: string;\r\n  prompt: string;\r\n  modelContextWindow?: number;\r\n  tokenBudget?: number;\r\n  currentTokenCount?: number;\r\n  availableProviders?: ReadonlyArray<{ id: string; priority: number; shadowOnly?: boolean }>;\r\n  compressionArtifactQuality?: { score: number; level: \"good\" | \"warn\" | \"bad\" };\r\n  /** Explicit worker cap for the next wave. Defaults to the task-kind table. */\r\n  workerCap?: number;\r\n  /** Explicit target wave. Defaults to the scheduler's next planned wave. */\r\n","exit_code":0,"status":"completed"}}
