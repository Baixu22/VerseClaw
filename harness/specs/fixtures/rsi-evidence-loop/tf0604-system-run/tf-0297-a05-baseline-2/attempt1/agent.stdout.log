{"type":"item.completed","item":{"id":"item_233","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command '$g = \"D:'\"\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0293-a01-baseline-1\\\"; Test-Path \\\"\"'$g'\"\\\\grader\\\\tests\\\\unit\\\\a01-a1-gate-coverage.test.ts\\\"; Write-Output \\\"=== grader guard file ===\\\"; Get-Content \\\"\"'$g'\"\\\\grader\\\\tests\\\\unit\\\\a01-a1-gate-coverage.test.ts\\\" -Raw | Select-Object -First 60; Write-Output \\\"=== agent guard file ===\\\"; Get-Content \\\"\"'$g'\"\\\\agent\\\\tests\\\\unit\\\\a01-a1-gate-coverage.test.ts\\\" -Raw -ErrorAction SilentlyContinue | Select-Object -First 60\"","aggregated_output":"True\r\n=== grader guard file ===\r\n// @vitest-environment node\n// A01: the A1 graduation gate must be verifiable from the current candidate.\nimport { readFileSync } from \"node:fs\";\nimport { dirname, join, resolve } from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { describe, expect, it } from \"vitest\";\n\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n\nfunction read(p: string) {\n  return readFileSync(join(ROOT, p), \"utf8\");\n}\n\ndescribe(\"A01 A1 isolation pilot gate coverage\", () => {\n  it(\"keeps the A1 spec's requiredTests wired to the criterion-1/3/4 counter tests\", () => {\n    const spec = read(\"harness/specs/tasks/a1-layered-isolation-pilot.md\");\n    expect(spec).toContain(\"tests/unit/deprecation-counters.test.ts\");\n    expect(spec).toContain(\"openclaw_runtime/src/observability/deprecation-counters.test.ts\");\n    // The original graduation thresholds must not be redefined.\n    expect(spec).toContain(\"legacyFallbackCount / (legacyFallbackCount + shadowSuccessCount) < 0.05\");\n    expect(spec).toContain(\"degrade_to_legacy\");\n    expect(spec).toContain(\"p99 ≤ 200ms\");\n  });\n\n  it(\"keeps the counter test asserting the 5% budget and the degrade_to_legacy response\", () => {\n    const counterTest = read(\"tests/unit/deprecation-counters.test.ts\");\n    expect(counterTest).toContain(\"degrade_to_legacy\");\n    expect(counterTest).toContain(\"legacyFallbackCount\");\n    expect(counterTest).toContain(\"declaredPathViolationCount\");\n    // Strictly greater than 5% trips; <= 5% does not.\n    expect(counterTest).toMatch(/rate\\s*>?\\s*5%/i);\n  });\n\n  it(\"keeps the write-risk and namespace criteria covered by their tests\", () => {\n    const toolReg = read(\"tests/unit/tool-registration.test.ts\");\n    expect(toolReg).toContain(\"writeRiskProfile\");\n    const namespace = read(\"tests/unit/trace-namespace-enforcement.test.ts\");\n    expect(namespace).toContain(\"claw.a4.tool.choice\");\n    const perf = read(\"tests/unit/performance-budgets.test.ts\");\n    expect(perf).toContain(\"p99\");\n  });\n});\r\n=== agent guard file ===\r\n// @vitest-environment node\n//\n// A01: re-verification of the A1 Layered Execution Isolation controlled pilot\n// gate on the current candidate. Each of the four graduation criteria in\n// `harness/specs/tasks/a1-layered-isolation-pilot.md` is mapped to executable\n// evidence WITHOUT redefining any threshold:\n//\n//   1. legacy fallback rate < 5%       -> deprecation-counters (5% boundary)\n//   2. isolation hot path p99 <= 200ms -> measured hot-path p99 vs frozen budget\n//   3. declaredPathViolationCount      -> counted separately and tracked\n//   4. checkBudgetViolation('a1')      -> action=degrade_to_legacy when rate > 5%\n//\n// It also covers the writeRiskProfile declaration gate (tool-registration /\n// built-in tools / plugin registry) and the trace namespace rejection\n// (`claw.a4.tool.choice` on an a1 recorder), and it is the coverage guard for\n// the spec drift fix: the A1 pilot spec's `requiredTests` originally omitted\n// the counter test, so this file must be listed there, while the original\n// `acceptance:` threshold bytes stay unchanged.\nimport { readFileSync } from 'node:fs';\nimport { join } from 'node:path';\n\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\n\nimport {\n  deprecationCounters,\n  type A1DeprecationCounters,\n} from '../../openclaw_runtime/src/observability/deprecation-counters.js';\nimport {\n  MissingWriteRiskProfileError,\n  assertWriteRiskProfileForTool,\n} from '../../openclaw_runtime/src/shared/tool-registration.js';\nimport { detectUndeclaredWrites } from '../../openclaw_runtime/src/agents/sessions/extensions/shadow-write-event-recorder.js';\nimport { collectDeclaredWritePaths } from '../../openclaw_runtime/src/agents/sessions/extensions/policy-light-snapshotter.js';\nimport { validateEventNamespace } from '../../openclaw_runtime/src/observability/namespace-governance.js';\nimport { createObservabilityTraceRecorder } from '../../openclaw_runtime/src/observability/trace-recorder.js';\nimport { parseFrontmatter } from '../../harness/src/specs.mjs';\n\nconst REPO_ROOT = process.cwd();\nconst A1_PILOT_SPEC = 'harness/specs/tasks/a1-layered-isolation-pilot.md';\n\n// Frozen gates copied verbatim from the A1 spec (criteria 1 and 4.5). They are\n// asserted, never redefined, so a weakened threshold fails this test.\nconst A1_FALLBACK_RATE_BUDGET = 0.05;\nconst A1_P99_BUDGET_MS = 200;\n\nfunction repoText(relativePath: string): string {\n  return readFileSync(join(REPO_ROOT, relativePath), 'utf8');\n}\n\nfunction rateOf(counters: A1DeprecationCounters): number {\n  const total = counters.legacyFallbackCount + counters.shadowSuccessCount;\n  return total === 0 ? 0 : counters.legacyFallbackCount / total;\n}\n\nfunction p99(samples: number[]): number {\n  const sorted = [...samples].sort((left, right) => left - right);\n  const index = Math.max(0, Math.ceil(0.99 * sorted.length) - 1);\n  return sorted[Math.min(index, sorted.length - 1)];\n}\n\ndescribe('A01 A1 pilot gate - criterion 1: legacy fallback rate < 5%', () => {\n  beforeEach(() => deprecationCounters.reset());\n  afterEach(() => deprecationCounters.reset());\n\n  it('over a 100-turn session at or below 5% is not a violated budget', () => {\n    deprecationCounters.incrementA1ShadowSuccess(96);\n    deprecationCounters.incrementA1LegacyFallback(4); // 4/100 = 4% < 5%\n    const counters = deprecationCounters.snapshot().a1;\n    expect(rateOf(counters)).toBeCloseTo(0.04, 10);\n    expect(rateOf(counters)).toBeLessThan(A1_FALLBACK_RATE_BUDGET);\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(false);\n  });\n\n  it('the exact 5% boundary is allowed (strict > comparison), not violated', () => {\n    deprecationCounters.incrementA1ShadowSuccess(95);\n    deprecationCounters.incrementA1LegacyFallback(5); // exactly 5%\n    expect(rateOf(deprecationCounters.snapshot().a1)).toBeCloseTo(A1_FALLBACK_RATE_BUDGET, 10);\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(false);\n  });\n\n  it('a rate above 5% is a violated budget', () => {\n    deprecationCounters.incrementA1ShadowSuccess(94);\n    deprecationCounters.incrementA1LegacyFallback(6); // 6% > 5%\n    expect(rateOf(deprecationCounters.snapshot().a1)).toBeGreaterThan(A1_FALLBACK_RATE_BUDGET);\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(true);\n  });\n});\n\ndescribe('A01 A1 pilot gate - criterion 4: degrade_to_legacy response', () => {\n  beforeEach(() => deprecationCounters.reset());\n  afterEach(() => deprecationCounters.reset());\n\n  it('checkBudgetViolation(\"a1\") returns action=degrade_to_legacy when rate > 5%', () => {\n    deprecationCounters.incrementA1ShadowSuccess(90);\n    deprecationCounters.incrementA1LegacyFallback(10); // 10% > 5%\n    const result = deprecationCounters.checkBudgetViolation('a1');\n    expect(result.violated).toBe(true);\n    if (result.violated) {\n      expect(result.degrade).toBe('a1_legacy_fallback_rate');\n      expect(result.action).toBe('degrade_to_legacy');\n    }\n  });\n\n  it('does not degrade below the budget and treats \"no data\" as not-a-violation', () => {\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(false); // total === 0\n    deprecationCounters.incrementA1ShadowSuccess(999);\n    deprecationCounters.incrementA1LegacyFallback(1); // < 5%\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(false);\n  });\n});\n\ndescribe('A01 A1 pilot gate - criterion 3: declaredPathViolationCount tracked separately', () => {\n  beforeEach(() => deprecationCounters.reset());\n  afterEach(() => deprecationCounters.reset());\n\n  it('counts declared-path violations independently of the fallback counters', () => {\n    deprecationCounters.incrementA1ShadowSuccess(98);\n    deprecationCounters.incrementA1LegacyFallback(2);\n    deprecationCounters.incrementA1DeclaredPathViolation(3);\n    expect(deprecationCounters.snapshot().a1).toEqual({\n      legacyFallbackCount: 2,\n      shadowSuccessCount: 98,\n      declaredPathViolationCount: 3,\n    });\n    // Violations are tracked on their own axis and do not feed the fallback budget.\n    expect(deprecationCounters.checkBudgetViolation('a1').violated).toBe(false);\n  });\n\n  it('exposes a per-session trend that can be read across snapshots', () => {\n    deprecationCounters.incrementA1DeclaredPathViolation(5);\n    const session1 = deprecationCounters.snapshot().a1.declaredPathViolationCount;\n    deprecationCounters.incrementA1DeclaredPathViolation(2);\n    const session2 = deprecationCounters.snapshot().a1.declaredPathViolationCount;\n    deprecationCounters.incrementA1DeclaredPathViolation(1);\n    const session3 = deprecationCounters.snapshot().a1.declaredPathViolationCount;\n    expect([session1, session2, session3]).toEqual([5, 7, 8]);\n  });\n});\n\ndescribe('A01 A1 pilot gate - criterion 2: isolation hot path p99 <= 200ms', () => {\n  beforeEach(() => deprecationCounters.reset());\n  afterEach(() => deprecationCounters.reset());\n\n  it('keeps the measured p99 of the isolation hot path within the frozen budget', () => {\n    const tools = Array.from({ length: 25 }, (_, index) => ({\n      name: `tool-${index}`,\n      profile: { kind: 'declared_paths' as const, writePaths: [`out-${index}.txt`] },\n    }));\n    const declaredPaths = ['out-0.txt'];\n    const actualPaths = ['out-0.txt', 'leak.txt'];\n\n    const durations: number[] = [];\n    for (let turn = 0; turn < 200; turn += 1) {\n      const startedAt = performance.now();\n      collectDeclaredWritePaths(tools);\n      detectUndeclaredWrites(declaredPaths, actualPaths);\n      deprecationCounters.incrementA1ShadowSuccess();\n      durations.push(performance.now() - startedAt);\n    }\n\n    const measuredP99 = p99(durations);\n    expect(measuredP99).toBeLessThanOrEqual(A1_P99_BUDGET_MS);\n    expect(A1_P99_BUDGET_MS).toBe(200); // numeric budget is unchanged\n  });\n});\n\ndescribe('A01 A1 pilot gate - writeRiskProfile declaration coverage', () => {\n  it('rejects an undeclared write-capable tool and accepts a declared profile', () => {\n    expect(() => assertWriteRiskProfileForTool('write', undefined)).toThrow(MissingWriteRiskProfileError);\n    expect(() =>\n      assertWriteRiskProfileForTool('write', { kind: 'declared_paths', writePaths: ['a.txt'] }),\n    ).not.toThrow();\n    expect(() =>\n      assertWriteRiskProfileForTool('destructive', { kind: 'dynamic_writes', requiresApproval: true }),\n    ).not.toThrow();\n  });\n\n  it('all six built-in write-capable tools declare risk + writeRiskProfile', () => {\n    const builtIns = [\n      'openclaw_runtime/src/agents/sessions/tools/write.ts',\n      'openclaw_runtime/src/agents/sessions/tools/edit.ts',\n      'openclaw_runtime/src/agents/sessions/tools/bash.ts',\n      'openclaw_runtime/src/agents/apply-patch.ts',\n      'openclaw_runtime/src/agents/bash-tools.exec.ts',\n      'openclaw_runtime/src/agents/bash-tools.process.ts',\n    ];\n    for (const file of builtIns) {\n      const text = repoText(file);\n      expect(text, file).toMatch(/risk:\\s*\"(?:write|destructive)\"/u);\n      expect(text, file).toContain('writeRiskProfile:');\n    }\n  });\n\n  it('the plugin registry enforces assertWriteRiskProfileForTool on registration', () => {\n    expect(repoText('openclaw_runtime/src/plugins/registry.ts')).toContain('assertWriteRiskProfileForTool(');\n  });\n});\n\ndescribe('A01 A1 pilot gate - trace namespace rejection', () => {\n  it('rejects `claw.a4.tool.choice` emitted from an a1 recorder', () => {\n    expect(validateEventNamespace('claw.a4.tool.choice', 'a1')).not.toBeNull();\n    const recorder = createObservabilityTraceRecorder({ name: 'a1-trace' }, { callerArea: 'a1' });\n    const event = recorder.recordEvent('claw.a4.tool.choice', 'Choice');\n    expect(event.type).toBe('claw.core.trace.namespace_rejected');\n    expect(event.attributes?.rejectedType).toBe('claw.a4.tool.choice');\n    expect(recorder.recordEvent('claw.a1.tool.choice', 'Choice').type).toBe('claw.a1.tool.choice');\n  });\n});\n\ndescribe('A01 spec requiredTests coverage guard (drift fix)', () => {\n  it('lists this counter gate test and keeps the original thresholds byte-identical', () => {\n    const specText = repoText(A1_PILOT_SPEC);\n    const { data } = parseFrontmatter(specText);\n    const requiredTests = data.requiredTests as string[];\n    // Drift fix: the counter test was missing from requiredTests; it must be present.\n    expect(requiredTests).toContain('tests/unit/a01-a1-gate-coverage.test.ts');\n    // The fix is additive - the original gate entries are preserved.\n    for (const original of [\n      'tests/unit/tool-registration.test.ts',\n      'tests/unit/policy-light-snapshotter.test.ts',\n      'tests/unit/shadow-write-event-recorder.test.ts',\n      'tests/unit/trace-namespace-enforcement.test.ts',\n      'tests/unit/performance-budgets.test.ts',\n    ]) {\n      expect(requiredTests).toContain(original);\n    }\n    // Original acceptance threshold bytes are unchanged.\n    expect(specText).toContain('- A1 deprecation counter `legacyFallbackCount` rate < 5% over 100-turn session');\n    expect(specText).toContain('- A1 p99 ≤ 200ms (criterion 4.5)');\n    expect(specText).toContain('- Budget violation response `degrade_to_legacy` triggers when fallback rate > 5%');\n  });\n});\r\n\r\n","exit_code":0,"status":"completed"}}
