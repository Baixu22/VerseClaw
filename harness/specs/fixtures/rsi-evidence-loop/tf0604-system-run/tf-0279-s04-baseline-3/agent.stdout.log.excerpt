{"type":"item.completed","item":{"id":"item_353","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0279-s04-baseline-3\\\\agent; Get-Content tests/unit/browser-effect-boundary-ledger.test.ts | Select-Object -Skip 44 -First 90\"","aggregated_output":"/** Actions that only pass the connection-mode gate (no session-ownership gate). */\r\nconst MODE_GATE_ONLY_ACTIONS = [\r\n  'navigate',\r\n  'status',\r\n  'waitForSelector',\r\n  'screenshot',\r\n  'getConsoleMessages',\r\n] as const;\r\n/** Side-effect-ish actions deliberately NOT wired to the session-ownership gate. */\r\nconst SESSION_RESIDUAL_ACTIONS = ['evaluate', 'command', 'close'] as const;\r\n\r\nconst EXTERNAL_MODES = ['auto-connect', 'cdp', 'external-profile'] as const;\r\n\r\nfunction read(repoPath: string): string {\r\n  return readFileSync(join(ROOT, repoPath), 'utf8');\r\n}\r\n\r\nconst GATED_SOURCES: ReadonlyArray<readonly [string, { provenance: unknown }]> = [\r\n  ['external', { provenance: createExternalProvenance({ sourceKind: 'web', sourceId: 'web:s04' }) }],\r\n  [\r\n    'derived-untrusted',\r\n    {\r\n      provenance: deriveProvenance({\r\n        sourceKind: 'tool-result',\r\n        sourceId: 'tool-result:s04',\r\n        parents: [],\r\n      }),\r\n    },\r\n  ],\r\n  ['missing', { provenance: undefined }],\r\n  ['invalid', { provenance: { schema: 'content-provenance.v0' } }],\r\n];\r\n\r\nconst TRUSTED_SOURCES: ReadonlyArray<readonly [string, { provenance: unknown }]> = [\r\n  [\r\n    'trusted-system',\r\n    { provenance: createTrustedProvenance({ sourceKind: 'system-generated', sourceId: 'system:s04' }) },\r\n  ],\r\n  [\r\n    'direct-operator',\r\n    { provenance: createTrustedProvenance({ sourceKind: 'user-direct', sourceId: 'user-direct:s04' }) },\r\n  ],\r\n];\r\n\r\ndescribe('S04 browser-effect provenance boundary ledger', () => {\r\n  it('denies external connection modes for external/derived/missing/invalid provenance', () => {\r\n    for (const [label, context] of GATED_SOURCES) {\r\n      for (const mode of EXTERNAL_MODES) {\r\n        const result = resolveAgentBrowserExternalAccessPolicy({\r\n          provenanceContext: context,\r\n          connectionMode: mode,\r\n        });\r\n        expect(result.allowed, `${label} may not select ${mode}`).toBe(false);\r\n        expect(result.restricted, `${label} + ${mode} is restricted`).toBe(true);\r\n        expect(result.reason ?? '').toMatch(/external or unknown provenance/i);\r\n      }\r\n    }\r\n  });\r\n\r\n  it('keeps the managed connection mode available to gated sources', () => {\r\n    for (const [label, context] of GATED_SOURCES) {\r\n      const managed = resolveAgentBrowserExternalAccessPolicy({\r\n        provenanceContext: context,\r\n        connectionMode: 'managed',\r\n      });\r\n      expect(managed.allowed, `${label} + managed stays allowed`).toBe(true);\r\n\r\n      const absent = resolveAgentBrowserExternalAccessPolicy({ provenanceContext: context });\r\n      expect(absent.allowed, `${label} without a mode stays allowed`).toBe(true);\r\n    }\r\n  });\r\n\r\n  it('does not restrict trusted system or direct operator external modes', () => {\r\n    for (const [label, context] of TRUSTED_SOURCES) {\r\n      for (const mode of [...EXTERNAL_MODES, 'managed'] as const) {\r\n        const result = resolveAgentBrowserExternalAccessPolicy({\r\n          provenanceContext: context,\r\n          connectionMode: mode,\r\n        });\r\n        expect(result.allowed, `${label} keeps ${mode}`).toBe(true);\r\n        expect(result.restricted, `${label} + ${mode} is unrestricted`).toBe(false);\r\n      }\r\n    }\r\n  });\r\n\r\n  it('requires a Main-owned managed session for click/type under gated provenance', () => {\r\n    for (const [label, context] of GATED_SOURCES) {\r\n      expect(\r\n        shouldPreflightAgentBrowserSessionEffect(context),\r\n        `${label} must preflight`,\r\n","exit_code":0,"status":"completed"}}
