{"type":"item.completed","item":{"id":"item_333","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Get-Content tests/unit/provider-credential-use-boundary-ledger.test.ts -Raw'","aggregated_output":"// @vitest-environment node\n/**\n * S05 image provider credential-use boundary ledger guard.\n *\n * Verifies the existing provider-credential-use policy on the image_generate\n * explicit-override branch and pins the boundary: the gate only fires for an\n * explicit model override from external/unknown provenance whose requested\n * provider escapes the host-bound image provider scope. The denial happens\n * before any provider credential read, and neither the policy input nor the\n * denial reason carries a credential value. Remaining credential-use surfaces\n * are pinned as residual in the S05 ledger.\n */\nimport { readFileSync, statSync } from 'node:fs';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { describe, expect, it } from 'vitest';\n\nimport {\n  createExternalProvenance,\n  createTrustedProvenance,\n  deriveProvenance,\n} from '../../shared/security/content-provenance';\nimport { resolveProviderCredentialUsePolicy } from '../../openclaw_runtime/src/agents/tools/provider-credential-use-policy';\n\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');\nconst TOOL = 'openclaw_runtime/src/agents/tools/image-generate-tool.ts';\nconst POLICY = 'openclaw_runtime/src/agents/tools/provider-credential-use-policy.ts';\nconst LEDGER = 'docs/dev/harness-gap-closure/s05-credential-use-boundary.md';\n\n/** Credential-use egress surfaces still outside the shared provenance gate. */\nconst RESIDUAL_CREDENTIAL_SURFACES = [\n  'openclaw_runtime/src/agents/tools/web-search-provider-credentials.ts',\n  'openclaw_runtime/src/image-generation/openai-compatible-image-provider.ts',\n  'openclaw_runtime/src/media-understanding/image.ts',\n  'openclaw_runtime/src/media-understanding/runner.entries.ts',\n  'openclaw_runtime/src/agents/model-auth.ts',\n  'openclaw_runtime/src/plugin-sdk/provider-auth-runtime.ts',\n  'openclaw_runtime/src/plugin-sdk/image-generation-core.auth.runtime.ts',\n];\n\nconst GATE_RE = /isExternalOrUnknownProvenance|resolveProviderCredentialUsePolicy/;\nconst CREDENTIAL_VALUE_RE = /apiKey|process\\.env|\\bAuthorization\\b|\\bBearer\\b|secret|credentialValue/;\n\nconst external = createExternalProvenance({ sourceKind: 'web', sourceId: 'web:s05', receivedAt: '2026-08-21T00:00:00.000Z' });\nconst derivedExternal = deriveProvenance({ sourceKind: 'tool-result', sourceId: 'tool-result:s05', receivedAt: '2026-08-21T00:00:00.000Z', parents: [external] });\nconst trustedSystem = createTrustedProvenance({ sourceKind: 'system-generated', sourceId: 'system:s05' });\nconst operator = createTrustedProvenance({ sourceKind: 'user-direct', sourceId: 'operator:s05' });\nconst INVALID_PROVENANCE = { schema: 'content-provenance.v1', sourceKind: 'web' };\nconst EXTERNAL_OR_UNKNOWN = [external, derivedExternal, undefined, INVALID_PROVENANCE] as const;\nconst TRUSTED = [trustedSystem, operator] as const;\nconst BOUND_PROVIDERS = ['openai'];\n\nfunction read(repoPath: string): string {\n  return readFileSync(join(ROOT, repoPath), 'utf8');\n}\n\ndescribe('S05 image provider credential-use boundary ledger', () => {\n  it('lets an explicit override stay inside the bound provider scope for external/unknown provenance', () => {\n    for (const provenance of EXTERNAL_OR_UNKNOWN) {\n      expect(\n        resolveProviderCredentialUsePolicy({\n          provenanceContext: { provenance },\n          hasExplicitModelOverride: true,\n          requestedProvider: 'openai',\n          boundProviderIds: BOUND_PROVIDERS,\n        }),\n      ).toMatchObject({ allowed: true, restricted: false });\n    }\n  });\n\n  it('denies an explicit override that switches outside the bound provider scope for external/unknown provenance', () => {\n    for (const provenance of EXTERNAL_OR_UNKNOWN) {\n      expect(\n        resolveProviderCredentialUsePolicy({\n          provenanceContext: { provenance },\n          hasExplicitModelOverride: true,\n          requestedProvider: 'other-vendor',\n          boundProviderIds: BOUND_PROVIDERS,\n        }),\n      ).toMatchObject({ allowed: false, restricted: true });\n    }\n  });\n\n  it('keeps trusted system / direct operator override semantics unchanged', () => {\n    for (const provenance of TRUSTED) {\n      for (const requestedProvider of ['openai', 'other-vendor']) {\n        expect(\n          resolveProviderCredentialUsePolicy({\n            provenanceContext: { provenance },\n            hasExplicitModelOverride: true,\n            requestedProvider,\n            boundProviderIds: BOUND_PROVIDERS,\n          }),\n        ).toMatchObject({ allowed: true, restricted: false });\n      }\n    }\n  });\n\n  it('does not gate the default / fallback path taken without an explicit override', () => {\n    for (const provenance of EXTERNAL_OR_UNKNOWN) {\n      expect(\n        resolveProviderCredentialUsePolicy({\n          provenanceContext: { provenance },\n          hasExplicitModelOverride: false,\n          requestedProvider: 'other-vendor',\n          boundProviderIds: BOUND_PROVIDERS,\n        }),\n      ).toMatchObject({ allowed: true, restricted: false });\n    }\n  });\n\n  it('normalizes the requested provider before comparing against the bound scope', () => {\n    expect(\n      resolveProviderCredentialUsePolicy({\n        provenanceContext: { provenance: external },\n        hasExplicitModelOverride: true,\n        requestedProvider: '  OPENAI  ',\n        boundProviderIds: BOUND_PROVIDERS,\n      }),\n    ).toMatchObject({ allowed: true, restricted: false });\n  });\n\n  it('never receives or reports a credential value', () => {\n    expect(CREDENTIAL_VALUE_RE.test(read(POLICY))).toBe(false);\n    const denial = resolveProviderCredentialUsePolicy({\n      provenanceContext: { provenance: external },\n      hasExplicitModelOverride: true,\n      requestedProvider: 'other-vendor',\n      boundProviderIds: BOUND_PROVIDERS,\n    });\n    expect(CREDENTIAL_VALUE_RE.test(denial.reason ?? '')).toBe(false);\n    // The policy input type carries only provenance + provider ids, never a value.\n    const inputType = read(POLICY).match(/export type ProviderCredentialUsePolicyInput = \\{[\\s\\S]*?\\};/)?.[0] ?? '';\n    expect(inputType).toContain('hasExplicitModelOverride');\n    expect(CREDENTIAL_VALUE_RE.test(inputType)).toBe(false);\n  });\n\n  it('pins the wiring: the gate runs on the explicit-override branch before provider execution', () => {\n    const tool = read(TOOL);\n    const overrideBranch = tool.indexOf('if (model !== undefined)');\n    const gateIndex = tool.indexOf('resolveProviderCredentialUsePolicy(');\n    const providerRunIndex = tool.indexOf('executeImageGenerationJob({');\n    expect(overrideBranch).toBeGreaterThanOrEqual(0);\n    expect(gateIndex).toBeGreaterThan(overrideBranch);\n    expect(providerRunIndex).toBeGreaterThan(gateIndex);\n    // No credential read happens in the tool module itself.\n    expect(CREDENTIAL_VALUE_RE.test(tool)).toBe(false);\n  });\n\n  it('pins the residual credential-use surfaces so wiring one forces a ledger update', () => {\n    for (const file of RESIDUAL_CREDENTIAL_SURFACES) {\n      expect(statSync(join(ROOT, file), { throwIfNoEntry: false })?.isFile(), file).toBe(true);\n      expect(GATE_RE.test(read(file)), `${file} now consults the provenance gate - update ${LEDGER}`).toBe(false);\n    }\n  });\n\n  it('records the covered and residual surfaces in the ledger doc without over-claiming', () => {\n    const doc = read(LEDGER);\n    expect(doc).toContain('provider-credential-use-policy.ts');\n    for (const file of RESIDUAL_CREDENTIAL_SURFACES) {\n      expect(doc).toContain(file.replace('openclaw_runtime/src/', ''));\n    }\n    expect(doc.toLowerCase()).toContain('residual');\n    // The ledger must not claim whole-network enforcement.\n    expect(doc).toContain('不是');\n  });\n});\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_334","type":"reasoning","text":"One consideration: the ledger doc references residual surfaces using shortened paths (e.g. `agents/tools/web-search-provider-credentials.ts`). The test asserts `doc.toContain(file.replace('openclaw_runtime/src/',''))`. Let me confirm each entry in the doc is present in that shortened form. Earlier I used the full path in the doc as backtick-wrapped full path... Let me re-check: in the doc, I wrote `openclaw_runtime/src/agents/tools/web-search-provider-credentials.ts`. Since `replace` only strips the prefix for the search string, and the doc contains the full path, `doc.includes('agents/tools/web-search-provider-credentials.ts')` is true because the full string contains the substring. Good — the offline check confirmed `ok`.\n\nBut careful: the doc lists them wrapped in backticks with the full path — the substring match works. Confirmed earlier all \"ok\".\n\nNow let me also double check the inserted text in the doc for `media-understanding/image.ts` etc. Yes, confirmed ok earlier.\n\nLet me view the final doc and spec."}}
