{"type":"item.completed","item":{"id":"item_309","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Get-Content openclaw_runtime/src/runtime-core/verifier-completion-verdict.ts | Select-Object -First 90 | ForEach-Object -Begin {$i=1} -Process { \"$i`: $_\"; $i++ }'","aggregated_output":"1: /**\r\n2:  * S07: give the evidence verifier a bounded, revocable completion-verdict entry.\r\n3:  *\r\n4:  * This is not a second verifier authority layer. It reuses\r\n5:  * `evaluateEvidenceVerifier` (the canonical contract/taxonomy owner) and only\r\n6:  * maps that report into a terminal verdict for tasks inside an explicit scope:\r\n7:  *\r\n8:  * - Bounded: a task id outside `scope.taskIds` yields `out-of-scope` and never a\r\n9:  *   state transition.\r\n10:  * - Single transition: only `approved` maps to the one `node -> done`\r\n11:  *   transition; every other verdict leaves the node untouched.\r\n12:  * - Digest-only: the record keeps `taskId`/`verdict`/`evidenceDigest`/\r\n13:  *   `findingCodes`/`priorStatus` and never the raw evidence payload.\r\n14:  * - Revocable: `approved` records `priorStatus`, so a revoke returns\r\n15:  *   `from: \"done\"` back to it. Non-approved verdicts have nothing to revoke.\r\n16:  * - Capability-bounded: the record grants no publish, product-lock, or release\r\n17:  *   authority (`grantsPublish`/`grantsProductLock` are always `false`).\r\n18:  */\r\n19: import { createHash } from \"node:crypto\";\r\n20: import {\r\n21:   evaluateEvidenceVerifier,\r\n22:   type EvidenceVerifierDecision,\r\n23:   type EvidenceVerifierPolicy,\r\n24:   type EvidenceVerifierReport,\r\n25: } from \"./evidence-verifier.js\";\r\n26: \r\n27: export const VERIFIER_COMPLETION_VERDICT_SCHEMA_VERSION = 1 as const;\r\n28: \r\n29: /** The node status a completion verdict moves a node to. */\r\n30: export const VERIFIER_COMPLETION_DONE_STATUS = \"done\" as const;\r\n31: \r\n32: /** Terminal verdict vocabulary. Only `approved` may transition a node to done. */\r\n33: export const VERIFIER_COMPLETION_VERDICTS = [\r\n34:   \"approved\",\r\n35:   \"insufficient-evidence\",\r\n36:   \"rejected\",\r\n37:   \"out-of-scope\",\r\n38: ] as const;\r\n39: \r\n40: export type VerifierCompletionVerdictOutcome =\r\n41:   (typeof VERIFIER_COMPLETION_VERDICTS)[number];\r\n42: \r\n43: export type VerifierCompletionScope = {\r\n44:   /** Exactly the task ids this entry is authorized to judge. */\r\n45:   taskIds: readonly string[];\r\n46: };\r\n47: \r\n48: export type VerifierCompletionVerdictInput = {\r\n49:   scope: VerifierCompletionScope;\r\n50:   /** Forwarded verbatim to `evaluateEvidenceVerifier`. */\r\n51:   input: unknown;\r\n52:   policy?: EvidenceVerifierPolicy;\r\n53:   /**\r\n54:    * The node's status immediately before this verdict. Recorded on `approved`\r\n55:    * so the transition can be revoked. Defaults to `verifying`, the runtime\r\n56:    * status a task holds while its evidence is judged.\r\n57:    */\r\n58:   priorStatus?: string;\r\n59: };\r\n60: \r\n61: /**\r\n62:  * Digest-only verdict record: identifiers, the verdict, the deterministic\r\n63:  * evidence digest, the finding codes, and the prior status. Never the raw\r\n64:  * evidence refs, findings, messages, or tool payloads. The only state\r\n65:  * transition is derived by `verifierCompletionTransition`, not stored here.\r\n66:  */\r\n67: export type VerifierCompletionVerdict = {\r\n68:   taskId: string;\r\n69:   verdict: VerifierCompletionVerdictOutcome;\r\n70:   evidenceDigest: string;\r\n71:   findingCodes: string[];\r\n72:   priorStatus: string;\r\n73:   /** Capability boundary: the verdict never grants these. */\r\n74:   grantsPublish: false;\r\n75:   grantsProductLock: false;\r\n76: };\r\n77: \r\n78: /**\r\n79:  * A node status transition. `to` is typed as a plain string because the same\r\n80:  * shape carries both the forward `-> done` transition and the revoke\r\n81:  * `done -> priorStatus` restore