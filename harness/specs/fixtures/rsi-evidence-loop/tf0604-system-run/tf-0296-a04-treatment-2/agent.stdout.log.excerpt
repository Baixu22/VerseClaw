{"type":"item.completed","item":{"id":"item_485","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd \\\"D:\\\\tmp\\\\rsi-tf0604-run5\\\"; foreach(\"'$f in @('\"'_delta.cjs','_hashscan.cjs','_sums.cjs','_credscan.cjs')){ \\\"===== \"'$f =====\"; Get-Content $f -TotalCount 40 }'","aggregated_output":"===== _delta.cjs =====\r\nconst fs=require(\"fs\"),path=require(\"path\"),c=require(\"crypto\");\r\nfunction walk(dir,base,out){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,e.name);const rel=path.relative(base,p).replaceAll(\"\\\\\",\"/\");if(e.isDirectory())walk(p,base,out);else out.push(rel);}return out;}\r\nconst A=\"trials/tf-0281-s06-treatment-3/agent\";\r\nconst B=\"trials/tf-0281-s06-treatment-3/base\";\r\nconst a=new Set(walk(A,A,[]));\r\nconst b=new Set(walk(B,B,[]));\r\nconst added=[...a].filter(x=>!b.has(x)).sort();\r\nconst removed=[...b].filter(x=>!a.has(x)).sort();\r\nconst changed=[...a].filter(x=>b.has(x)&&c.createHash(\"sha256\").update(fs.readFileSync(A+\"/\"+x)).digest(\"hex\")!==c.createHash(\"sha256\").update(fs.readFileSync(B+\"/\"+x)).digest(\"hex\")).sort();\r\nconsole.log(\"ADDED (\"+added.length+\"):\");added.forEach(x=>console.log(\"  +\",x));\r\nconsole.log(\"REMOVED (\"+removed.length+\"):\");removed.forEach(x=>console.log(\"  -\",x));\r\nconsole.log(\"CHANGED (\"+changed.length+\"):\");changed.forEach(x=>console.log(\"  ~\",x));\r\n===== _hashscan.cjs =====\r\nconst fs=require(\"fs\"),path=require(\"path\"),c=require(\"crypto\");\r\nconst targets={\"614cb2499f3ec7a91c9e2680037e001ec32ebfbb5d74c8a92612c56252774750\":\"a02-a2-gate-coverage\",\"4502f116876f3270c4d9eb5929461186d8038d7f973bcec23743bcaa4e1e5079\":\"performance-budgets\",\"5e77f31913eaccffdf18b866a601c73d32183383ab3c7818444aae0df32aefa5\":\"harness-gap-a02-spec\",\"99b89c7ab9a53518eaefba20210dd23ca9f624eab0705ca0ad87d572cd6234ed\":\"a02-acceptance\"};\r\nconst names=new Set([\"a02-a2-gate-coverage.test.ts\",\"performance-budgets.test.ts\",\"harness-gap-a02-orchestration-pilot-reverify.md\",\"a02-acceptance.json\"]);\r\nfunction walk(dir,out){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,e.name);if(e.isDirectory())walk(p,out);else if(names.has(e.name))out.push(p);}return out;}\r\nconst root=\"trials\";\r\nconst files=walk(root,[]);\r\nfor(const f of files){const h=c.createHash(\"sha256\").update(fs.readFileSync(f)).digest(\"hex\");if(targets[h])console.log(\"MATCH\",targets[h],f);}\r\nconsole.log(\"scanned\",files.length);\r\n===== _sums.cjs =====\r\nconst fs=require(\"fs\"),c=require(\"crypto\");\r\nconst lines=fs.readFileSync(\"docs/dev/harness-gap-closure/S06-SHA256SUMS\",\"utf8\").trim().split(\"\\n\");\r\nlet bad=0;\r\nfor(const line of lines){\r\n  const m=line.match(/^([0-9a-f]{64})  (.+)$/);\r\n  if(!m){console.log(\"MALFORMED\",line);bad++;continue;}\r\n  const got=c.createHash(\"sha256\").update(fs.readFileSync(m[2])).digest(\"hex\");\r\n  if(got!==m[1]){console.log(\"MISMATCH\",m[2]);bad++;}\r\n  else console.log(\"OK  \",m[2]);\r\n}\r\nconsole.log(\"rows:\",lines.length,\"bad:\",bad);\r\n===== _credscan.cjs =====\r\nconst {readFileSync}=require(\"fs\");\r\nconst patterns=[\r\n [\"openai-style-key\",/\\bsk-[A-Za-z0-9_-]{12,}/gu],\r\n [\"bearer-token\",/\\bBearer\\s+[A-Za-z0-9._~+\\/-=]{8,}/gu],\r\n [\"aws-access-key-id\",/\\bAKIA[0-9A-Z]{16}\\b/gu],\r\n [\"github-token\",/\\bgh[pousr]_[A-Za-z0-9]{20,}/gu],\r\n [\"slack-token\",/\\bxox[abprs]-[A-Za-z0-9-]{10,}/gu],\r\n [\"private-key-block\",/-----BEGIN [A-Z ]*PRIVATE KEY-----/gu],\r\n [\"generic-secret-assignment\",/\\b(?:api[_-]?key|secret|password|token)\\b\\s*[:=]\\s*[\"'][^\"']{16,}[\"']/giu],\r\n];\r\nconst root=\"trials/tf-0281-s06-treatment-3/agent/\";\r\nconst files=[\r\n \"openclaw_runtime/src/runtime-core/memory-effect-receipt.ts\",\r\n \"openclaw_runtime/src/runtime-core/memory-effect-receipt.test.ts\",\r\n \"openclaw_runtime/src/runtime-core/memory-self-edit-tools.ts\",\r\n \"harness/specs/tasks/harness-gap-memory-effect-receipt.md\",\r\n \"docs/dev/harness-gap-closure/s06-memory-effect-receipt.md\",\r\n \"docs/dev/harness-gap-closure/s06-acceptance.json\",\r\n \"docs/dev/harness-gap-closure/S06-SHA256SUMS\",\r\n];\r\nlet total=0;\r\nfor(const f of files){\r\n  const text=readFileSync(root+f).toString(\"latin1\");\r\n  const hits=patterns.map(([id,p])=>[id,(text.match(new RegExp(p.source,p.flags))||[]).length]).filter(([,n])=>n>0);\r\n  for(const [id,n] of hits){ total+=n; console.log(\"HIT\",f,id,n); }\r\n}\r\nconsole.log(\"files scanned:\",files.length,\"hits:\",total);\r\n","exit_code":0,"status":"completed"}}
