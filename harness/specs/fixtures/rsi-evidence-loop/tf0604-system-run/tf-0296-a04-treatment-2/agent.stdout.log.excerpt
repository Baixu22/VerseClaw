{"type":"item.started","item":{"id":"item_220","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"@'\nconst fs=require(\\\"fs\\\"),path=require(\\\"path\\\");\nconst dir=\\\".tmpv\\\";\nfs.mkdirSync(dir,{recursive:true});\n// source copies (type-stripped at import time)\nfs.copyFileSync(\\\"openclaw_runtime/src/observability/deprecation-counters.ts\\\",path.join(dir,\\\"deprecation-counters.ts\\\"));\nfs.writeFileSync(path.join(dir,\\\"decision-quality-auditor.ts\\\"),fs.readFileSync(\\\"openclaw_runtime/src/observability/decision-quality-auditor.ts\\\",\\\"utf8\\\").replace('from \\\"./deprecation-counters.js\\\"','from \\\"./deprecation-counters.ts\\\"'));\nfs.copyFileSync(\\\"openclaw_runtime/src/observability/namespace-governance.ts\\\",path.join(dir,\\\"namespace-governance.ts\\\"));\nconst shim=\"'`\nimport util from \"node:util\";\nconst stack=[],results=[],beforeHooks=[],afterHooks=[];\nclass E{constructor(v,n=false){this.value=v;this.negate=n}get not(){return new E(this.value,!this.negate)}\n_ch(p,m){const ok=this.negate?!p:p;if(!ok)throw new Error((this.negate?\"not: \":\"\")+m)}\ntoBe(e){this._ch(Object.is(this.value,e),util.inspect(this.value)+\" toBe \"+util.inspect(e))}\ntoEqual(e){this._ch(util.isDeepStrictEqual(this.value,e),util.inspect(this.value)+\" toEqual \"+util.inspect(e))}\ntoBeNull(){this._ch(this.value===null,\"expected null\")}\ntoBeTruthy(){this._ch(Boolean(this.value),\"expected truthy\")}\ntoBeFalsy(){this._ch(!this.value,\"expected falsy\")}\ntoContain(n){this._ch(this.value!=null&&this.value.includes(n),\"expected to contain \"+util.inspect(n))}\ntoHaveLength(n){this._ch(this.value!=null&&this.value.length===n,\"expected length \"+n)}\ntoMatch(p){this._ch(new RegExp(p).test(String(this.value)),\"expected match \"+p)}\ntoBeGreaterThan(n){this._ch(this.value>n,this.value+\" > \"+n)}\ntoBeGreaterThanOrEqual(n){this._ch(this.value>=n,this.value+\" >= \"+n)}\ntoBeLessThan(n){this._ch(this.value<n,this.value+\" < \"+n)}\ntoBeLessThanOrEqual(n){this._ch(this.value<=n,this.value+\" <= \"+n)}\ntoBeCloseTo(n,d=2){this._ch(Math.abs(this.value-n)<Math.pow(10,-d)/2+1e-12,this.value+\" ~ \"+n)}}\nexport function describe(n,f){stack.push(n);try{f()}finally{stack.pop()}}\nexport function it(n,f){stack.push(n);const l=stack.join(\" > \");try{for(const h of beforeHooks)h();try{f()}finally{for(const h of afterHooks)h()}results.push([\"PASS\",l])}catch(e){results.push([\"FAIL\",l+\" :: \"+e.message])}finally{stack.pop()}}\nexport const test=it;\nexport function beforeEach(f){beforeHooks.push(f)} export function afterEach(f){afterHooks.push(f)}\nexport const beforeAll=beforeEach, afterAll=afterEach;\nexport function expect(v){return new E(v)}\nexport function summarize(){let f=0;for(const r of results){if(r[0]===\"FAIL\")f++;console.log(r.join(\"  \"))}console.log(\"[\"+f+\"] \"+ (f?\"FAIL\":\"ok\") +\" \"+(results.length-f)+\"/\"+results.length);return f}\n`;\nfs.writeFileSync(path.join(dir,\"vitest-shim.mjs\"),shim,\"utf8\");\nconst files=[[\"tests/unit/decision-quality-auditor.test.ts\",\"t-auditor.ts\"],[\"tests/unit/deep/a4-deep.test.ts\",\"t-deep.ts\"],[\"tests/unit/a04-a4-gate-coverage.test.ts\",\"t-guard.ts\"]];\nfor(const [src,out] of files){\n  let t=fs.readFileSync(src,\"utf8\");\n  t=t.replace(/from \"vitest\"/g,'\"'from \\\"./vitest-shim.mjs\\\"');\n  t=t.replace(/from \\\"(?:\\\\.\\\\.\\\\/)+openclaw_runtime\\\\/src\\\\/observability\\\\/([a-z-]+)\\\\.js\\\"/g,'from \\\"./\"'$1.ts\"'\"');\n  t=t.replace('const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), \\\"..\\\", \\\"..\\\");','const ROOT = process.cwd();');\n  t+='\\\\nimport { summarize } from \\\"./vitest-shim.mjs\\\";\\\\nprocess.exitCode = summarize() > 0 ? 1 : 0;\\\\n';\n  fs.writeFileSync(path.join(dir,out),t,\\\"utf8\\\");\n}\nconsole.log(\\\"prepared\\\");\n'@ | Set-Content -Encoding utf8 .tmpv-prep.cjs; node .tmpv-prep.cjs; Write-Output \\\"--- auditor ---\\\"; node .tmpv/t-auditor.ts 2>&1 | Select-Object -Last 2; Write-Output \\\"--- deep ---\\\"; node .tmpv/t-deep.ts 2>&1 | Select-Object -Last 2; Write-Output \\\"--- guard ---\\\"; node .tmpv/t-guard.ts 2>&1 | Select-Object -Last 8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
