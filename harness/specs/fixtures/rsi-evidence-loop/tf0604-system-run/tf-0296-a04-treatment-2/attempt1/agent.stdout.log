{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0296-a04-treatment-2\\\\agent; cat tests/unit/trace-namespace-enforcement.test.ts\"","aggregated_output":"import { describe, expect, it } from \"vitest\";\r\nimport {\r\n  ObservabilityTraceRecorder,\r\n} from \"../../openclaw_runtime/src/observability/trace-recorder.js\";\r\nimport type { ObservabilityRuntimeEvent } from \"../../openclaw_runtime/src/observability/types.js\";\r\n\r\n/**\r\n * Stage 3, criterion 3.10: Trace namespace enforced.\r\n *\r\n * When a recorder is constructed with `callerArea: 'a1'`, an event with a\r\n * wrong-namespace type (`claw.a4.tool.choice`) is rejected — i.e. it is not\r\n * stored in `trace.events` as its original type, and a\r\n * `claw.core.trace.namespace_rejected` diagnostic event is emitted instead.\r\n */\r\ndescribe(\"Stage 3 / 3.10: trace namespace enforcement\", () => {\r\n  it(\"rejects an out-of-namespace event (claw.a4.tool.choice on an a1 recorder)\", () => {\r\n    const recorder = new ObservabilityTraceRecorder(\r\n      { name: \"test-trace\" },\r\n      { callerArea: \"a1\", idFactory: (prefix) => `${prefix}_1` },\r\n    );\r\n\r\n    const result = recorder.recordEvent(\"claw.a4.tool.choice\", \"Tool Choice\");\r\n\r\n    // The returned event is the rejection diagnostic, not the original.\r\n    expect(result.type).toBe(\"claw.core.trace.namespace_rejected\");\r\n    expect(result.attributes?.rejectedType).toBe(\"claw.a4.tool.choice\");\r\n    expect(result.attributes?.rejectedName).toBe(\"Tool Choice\");\r\n    expect(result.attributes?.reason).toContain('\"claw.a4.tool.choice\"');\r\n    expect(result.attributes?.reason).toContain('\"a1\"');\r\n\r\n    const trace = recorder.snapshot();\r\n    // The original event must NOT be present.\r\n    const originalEvents = trace.events.filter((e) => e.type === \"claw.a4.tool.choice\");\r\n    expect(originalEvents).toHaveLength(0);\r\n    // The rejection diagnostic MUST be present.\r\n    const rejectedEvents = trace.events.filter((e) => e.type === \"claw.core.trace.namespace_rejected\");\r\n    expect(rejectedEvents).toHaveLength(1);\r\n  });\r\n\r\n  it(\"accepts an in-namespace event (claw.a1.tool.choice on an a1 recorder)\", () => {\r\n    const recorder = new ObservabilityTraceRecorder(\r\n      { name: \"test-trace\" },\r\n      { callerArea: \"a1\", idFactory: (prefix) => `${prefix}_1` },\r\n    );\r\n\r\n    const result = recorder.recordEvent(\"claw.a1.tool.choice\", \"Tool Choice\");\r\n\r\n    expect(result.type).toBe(\"claw.a1.tool.choice\");\r\n    expect(result.name).toBe(\"Tool Choice\");\r\n\r\n    const trace = recorder.snapshot();\r\n    const matched = trace.events.filter((e) => e.type === \"claw.a1.tool.choice\");\r\n    expect(matched).toHaveLength(1);\r\n    // No rejection diagnostic should be emitted.\r\n    const rejected = trace.events.filter((e) => e.type === \"claw.core.trace.namespace_rejected\");\r\n    expect(rejected).toHaveLength(0);\r\n  });\r\n\r\n  it(\"emits an event.recorded runtime event for the rejection\", () => {\r\n    const recorder = new ObservabilityTraceRecorder(\r\n      { name: \"test-trace\" },\r\n      { callerArea: \"core\", idFactory: (prefix) => `${prefix}_1` },\r\n    );\r\n\r\n    const received: ObservabilityRuntimeEvent[] = [];\r\n    const unsub = recorder.subscribe((e) => {\r\n      received.push(e);\r\n    });\r\n\r\n    // `core` recorder: claw.a4.tool.choice is out-of-namespace (only claw.core.* allowed).\r\n    recorder.recordEvent(\"claw.a4.tool.choice\", \"Tool Choice\");\r\n\r\n    unsub();\r\n\r\n    const recordedEvents = received.filter((e) => e.type === \"event.recorded\");\r\n    expect(recordedEvents.length).toBeGreaterThanOrEqual(1);\r\n    const last = recordedEvents[recordedEvents.length - 1];\r\n    if (last.type === \"event.recorded\") {\r\n      expect(last.event.type).toBe(\"claw.core.trace.namespace_rejected\");\r\n    }\r\n  });\r\n\r\n  it(\"allows claw.core.* events on a core recorder\", () => {\r\n    const recorder = new ObservabilityTraceRecorder(\r\n      { name: \"test-trace\" },\r\n      { callerArea: \"core\", idFactory: (prefix) => `${prefix}_1` },\r\n    );\r\n\r\n    const result = recorder.recordEvent(\"claw.core.trace.truncated\", \"Trace Truncated\");\r\n\r\n    expect(result.type).toBe(\"claw.core.trace.truncated\");\r\n    const rejected = recorder\r\n      .snapshot()\r\n      .events.filter((e) => e.type === \"claw.core.trace.namespace_rejected\");\r\n    expect(rejected).toHaveLength(0);\r\n  });\r\n\r\n  it(\"skips validation when callerArea is not set (legacy mode)\", () => {\r\n    const recorder = new ObservabilityTraceRecorder(\r\n      { name: \"test-trace\" },\r\n      { idFactory: (prefix) => `${prefix}_1` },\r\n    );\r\n\r\n    // No callerArea → no validation; any event type accepted.\r\n    const result = recorder.recordEvent(\"claw.a4.tool.choice\", \"Tool Choice\");\r\n    expect(result.type).toBe(\"claw.a4.tool.choice\");\r\n    const rejected = recorder\r\n      .snapshot()\r\n      .events.filter((e) => e.type === \"claw.core.trace.namespace_rejected\");\r\n    expect(rejected).toHaveLength(0);\r\n  });\r\n\r\n  it(\"rejects multiple out-of-namespace events independently\", () => {\r\n    const recorder = new ObservabilityTraceRecorder(\r\n      { name: \"test-trace\" },\r\n      { callerArea: \"a1\", idFactory: (prefix) => `${prefix}_${Math.random().toString(36).slice(2, 6)}` },\r\n    );\r\n\r\n    recorder.recordEvent(\"claw.a4.tool.choice\", \"A4 Choice\");\r\n    recorder.recordEvent(\"claw.a2.spawn.subagent\", \"A2 Spawn\");\r\n    recorder.recordEvent(\"claw.a1.tool.invoke\", \"A1 Invoke\");\r\n\r\n    const trace = recorder.snapshot();\r\n    const rejected = trace.events.filter((e) => e.type === \"claw.core.trace.namespace_rejected\");\r\n    const accepted = trace.events.filter((e) => e.type === \"claw.a1.tool.invoke\");\r\n\r\n    expect(rejected).toHaveLength(2);\r\n    expect(accepted).toHaveLength(1);\r\n  });\r\n\r\n  it(\"preserves spanId in the rejection diagnostic\", () => {\r\n    const recorder = new ObservabilityTraceRecorder(\r\n      { name: \"test-trace\" },\r\n      { callerArea: \"a1\", idFactory: (prefix) => `${prefix}_1` },\r\n    );\r\n\r\n    const result = recorder.recordEvent(\"claw.a4.tool.choice\", \"Tool Choice\", {\r\n      spanId: \"span_xyz\",\r\n      attributes: { detail: \"extra\" },\r\n    });\r\n\r\n    expect(result.spanId).toBe(\"span_xyz\");\r\n  });\r\n});\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0296-a04-treatment-2\\\\agent; cat openclaw_runtime/src/observability/namespace-governance.ts\"","aggregated_output":"// ---------------------------------------------------------------------------\r\n// Round 2 / Stage 3: Observability Event Namespace Governance\r\n//\r\n// Each area owns a namespace (`claw.{area}.`). Events outside an area's\r\n// namespace are rejected at recording time. This prevents cross-area event\r\n// pollution and makes traces human-readable.\r\n//\r\n// See: docs/runtime-design/development-manual.md §1.1, Stage 3 (criterion 3.10/3.13)\r\n// Mirrors: shared/types/observability.ts (renderer-side copy)\r\n// ---------------------------------------------------------------------------\r\n\r\n/** The area prefix of the observability namespace. */\r\nexport type ObservabilityAreaPrefix = \"a1\" | \"a2\" | \"a3\" | \"a4\" | \"a5\" | \"a6\" | \"core\";\r\n\r\n/** A fully-qualified event name in the `claw.{area}.{category}.{event}` format. */\r\nexport type ObservabilityEventName = `claw.${ObservabilityAreaPrefix}.${string}`;\r\n\r\n/** Retention/decay policy for an event category. */\r\nexport type ObservabilityRetentionPolicy = {\r\n  /** How long to retain spans of this category, in milliseconds. */\r\n  retentionMs: number;\r\n  /** Sampling rate when throughput exceeds `thresholdPerMinute`. */\r\n  highThroughputSamplingRate: number;\r\n  /** Spans per minute above which sampling kicks in. */\r\n  thresholdPerMinute: number;\r\n};\r\n\r\n/** Default retention policies by event category. */\r\nexport const OBSERVABILITY_RETENTION_POLICIES = {\r\n  decision: { retentionMs: 7 * 24 * 60 * 60 * 1000, highThroughputSamplingRate: 1.0, thresholdPerMinute: Infinity },\r\n  diagnostic: { retentionMs: 3 * 24 * 60 * 60 * 1000, highThroughputSamplingRate: 0.1, thresholdPerMinute: 100 },\r\n  error: { retentionMs: 30 * 24 * 60 * 60 * 1000, highThroughputSamplingRate: 1.0, thresholdPerMinute: Infinity },\r\n  shadow: { retentionMs: 7 * 24 * 60 * 60 * 1000, highThroughputSamplingRate: 0.01, thresholdPerMinute: 50 },\r\n} as const satisfies Record<string, ObservabilityRetentionPolicy>;\r\n\r\n/** Trace truncation threshold. Above this, low-priority spans are dropped. */\r\nexport const TRACE_SPAN_TRUNCATION_THRESHOLD = 200;\r\n\r\n/**\r\n * Validate that an event name is within the caller's area namespace.\r\n * Returns `null` if valid, or an error message.\r\n *\r\n * @param eventName fully-qualified event name like `claw.a1.tool.choice`\r\n * @param callerArea the area the recorder belongs to\r\n */\r\nexport function validateEventNamespace(\r\n  eventName: string,\r\n  callerArea: ObservabilityAreaPrefix,\r\n): string | null {\r\n  const prefix = `claw.${callerArea}.`;\r\n  if (eventName.startsWith(prefix)) return null;\r\n  // `core.` namespace is reserved for Mission Control and infrastructure diagnostics\r\n  // (e.g. `claw.core.trace.truncated`, `claw.core.trace.namespace_rejected`).\r\n  if (callerArea === \"core\" && eventName.startsWith(\"claw.core.\")) return null;\r\n  return `Event name \"${eventName}\" does not match caller area \"${callerArea}\" (expected prefix \"claw.${callerArea}.\")`;\r\n}\r\n\r\n/**\r\n * Determine the drop priority for a span during trace truncation.\r\n * Lower number = higher importance = kept longer.\r\n * Priority order (highest first): core > a6 > a1 > a2 > a5 > a3 > a4.\r\n * A4 spans are dropped first; A6 spans are dropped last (after core).\r\n */\r\nexport function spanDropPriority(area: ObservabilityAreaPrefix): number {\r\n  const priority: Record<ObservabilityAreaPrefix, number> = {\r\n    core: 0,\r\n    a6: 1,\r\n    a1: 2,\r\n    a2: 3,\r\n    a5: 4,\r\n    a3: 5,\r\n    a4: 6,\r\n  };\r\n  return priority[area];\r\n}\r\n","exit_code":0,"status":"completed"}}
