{"type":"item.completed","item":{"id":"item_305","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd \\\"D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0296-a04-baseline-1\\\\agent\\\\.rsi\\\\_ref\\\"; node -e \\\"const fs=require('fs');process.stdout.write(fs.readFileSync('tests__unit__a4-decision-quality-dev-tool.test.ts','utf8'))\\\"\"","aggregated_output":"import { execFileSync } from \"node:child_process\";import { mkdtempSync, readFileSync, writeFileSync } from \"node:fs\";import { tmpdir } from \"node:os\";import path from \"node:path\";import { pathToFileURL } from \"node:url\";import { describe, expect, it } from \"vitest\";const ROOT = path.resolve(__dirname, \"../..\");const RUNTIME = path.join(ROOT, \"openclaw_runtime\");const SCRIPT = path.join(ROOT, \"scripts/a4-decision-quality-audit.mts\");// `tsx` is resolved from the runtime package, matching the repo convention for// `pnpm --dir openclaw_runtime exec tsx ...` dev tools.const TSX = pathToFileURL(path.join(RUNTIME, \"node_modules/tsx/dist/loader.mjs\")).href;/** * A4 is frozen as \"offline pure functions only\": the ONLY sanctioned consumer * is an explicit dev-tool invocation. These tests exercise that CLI surface so * the dev-tool path is real and covered, without wiring A4 into any production * turn path. */describe(\"A4 decision quality offline dev-tool\", () => {  it(\"runs the sanctioned CLI selftest\", () => {    const out = execFileSync(      process.execPath,      [\"--import\", TSX, SCRIPT, \"--selftest\"],      { cwd: RUNTIME, encoding: \"utf8\" },    );    expect(out).toContain(\"selftest totalAudited=1 lowQualityCount=0\");  });  it(\"audits a records file and fails the budget when the low-quality rate exceeds 10%\", () => {    const dir = mkdtempSync(path.join(tmpdir(), \"a4-audit-\"));    const input = path.join(dir, \"records.json\");    const out = path.join(dir, \"report.json\");    const good = {      decisionId: \"good\",      reviewerAction: \"continue\",      expectedAction: \"continue\",      actionMatched: true,      contextItemsAvailable: 10,      contextItemsConsidered: 10,      decisionTick: 0,      maxTicksForDecision: 10,    };    // 4 of 5 decisions are low quality -> 80% rate, above the 10% budget.    const bad = (index: number) => ({      ...good,      decisionId: `bad-${index}`,      actionMatched: false,      expectedAction: \"continue\",      reviewerAction: \"blocked\",      contextItemsConsidered: 0,      decisionTick: 10,    });    writeFileSync(input, JSON.stringify([good, bad(1), bad(2), bad(3), bad(4)]));    let failed = false;    try {      execFileSync(        process.execPath,        [\"--import\", TSX, SCRIPT, \"--input\", input, \"--out\", out],        { cwd: RUNTIME, encoding: \"utf8\" },      );    } catch {      failed = true;    }    expect(failed).toBe(true);    const report = JSON.parse(readFileSync(out, \"utf8\"));    expect(report.totalAudited).toBe(5);    expect(report.lowQualityCount).toBe(4);    expect(report.withinBudget).toBe(false);    expect(report.invoked_via).toBe(\"explicit-dev-tool-cli\");    expect(report.production_turn_path).toBe(false);    expect(report.driven_by).toBe(\"agent\");  });  it(\"keeps A4 out of the production runtime tree\", () => {    const manual = readFileSync(path.join(ROOT, \"docs/runtime-design/development-manual.md\"), \"utf8\");    expect(manual).toContain(\"A4 is called ONLY via explicit dev-tool invocation\");  });});","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_304","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd \\\"D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0296-a04-baseline-1\\\\agent\\\\.rsi\\\\_ref\\\"; node -e \\\"const fs=require('fs');process.stdout.write(fs.readFileSync('scripts__a4-decision-quality-audit.mts','utf8'))\\\"\"","aggregated_output":"#!/usr/bin/env node/** * A4 Decision Quality — explicit offline dev-tool entry point. * * `docs/runtime-design/development-manual.md` §1.4 freezes A4 as * \"offline pure functions only\": it MUST NOT run on any production turn path * and is invoked ONLY via an explicit dev-tool invocation (CLI, test fixture, * debug panel). This script is that CLI surface: it reads a JSON array of * `DecisionRecord`s from disk, audits them with the existing * `DecisionQualityAuditor`, writes a report, and exits non-zero when the * low-quality rate breaches the 10% graduation budget. * * It does not touch the runtime turn path and never enables the pilot flag for * the app; it only exercises the same auditor the runtime would use if the * `decisionQualityPilot: 'shadow'` flag were set by an operator. * * Usage: *   pnpm --dir openclaw_runtime exec tsx ../scripts/a4-decision-quality-audit.mts --input <file.json> *   pnpm --dir openclaw_runtime exec tsx ../scripts/a4-decision-quality-audit.mts --input <file.json> --out <report.json> *   pnpm --dir openclaw_runtime exec tsx ../scripts/a4-decision-quality-audit.mts --selftest */import fs from \"node:fs\";import path from \"node:path\";import process from \"node:process\";import { fileURLToPath } from \"node:url\";import {  DecisionQualityAuditor,  isDecisionQualityAuditEnabled,  scoreDecision,  type DecisionRecord,} from \"../openclaw_runtime/src/observability/decision-quality-auditor.js\";const LOW_QUALITY_BUDGET = 0.1;function parseArgs(argv: string[]): { input: string | null; out: string | null; selftest: boolean } {  const args = { input: null as string | null, out: null as string | null, selftest: false };  for (let index = 0; index < argv.length; index += 1) {    const token = argv[index];    if (token === \"--input\") args.input = argv[index + 1] ?? null;    else if (token === \"--out\") args.out = argv[index + 1] ?? null;    else if (token === \"--selftest\") args.selftest = true;  }  return args;}function readRecords(filePath: string): DecisionRecord[] {  const raw = JSON.parse(fs.readFileSync(filePath, \"utf8\"));  const records = Array.isArray(raw) ? raw : raw?.records;  if (!Array.isArray(records)) {    throw new Error(\"input must be a JSON array of DecisionRecord objects (or { records: [...] })\");  }  return records as DecisionRecord[];}function audit(records: DecisionRecord[]) {  // The dev-tool always enables the shadow pilot for this offline run; the app  // flag stays default-off and this never runs in a production turn.  const enabled = isDecisionQualityAuditEnabled({ decisionQualityPilot: \"shadow\" });  const auditor = new DecisionQualityAuditor({ decisionQualityPilot: \"shadow\" });  const batch = auditor.auditBatch(records);  if (batch === null) throw new Error(\"A4 auditor is disabled in the dev-tool run\");  const lowQualityRate = batch.totalAudited > 0 ? batch.lowQualityCount / batch.totalAudited : 0;  return {    enabled,    totalAudited: batch.totalAudited,    lowQualityCount: batch.lowQualityCount,    lowQualityRate,    meanOverall: batch.meanOverall,    withinBudget: lowQualityRate <= LOW_QUALITY_BUDGET,    scores: batch.scores,  };}function buildSelftestRecords(): DecisionRecord[] {  return [    {      decisionId: \"selftest-good\",      reviewerAction: \"continue\",      expectedAction: \"continue\",      actionMatched: true,      contextItemsAvailable: 10,      contextItemsConsidered: 10,      decisionTick: 0,      maxTicksForDecision: 10,    },  ];}function main(): number {  const args = parseArgs(process.argv.slice(2));  if (args.selftest) {    const report = audit(buildSelftestRecords());    process.stdout.write(`[a4-decision-quality-audit] selftest totalAudited=${report.totalAudited} lowQualityCount=${report.lowQualityCount}\\n`);    return report.totalAudited === 1 && report.lowQualityCount === 0 ? 0 : 1;  }  if (!args.input) {    process.stderr.write(\"[a4-decision-quality-audit] missing --input <records.json> (or --selftest)\\n\");    return 2;  }  const inputPath = path.resolve(args.input);  const records = readRecords(inputPath);  const report = audit(records);  const payload = {    schema: \"a4-decision-quality-audit/v1\",    generatedAt: new Date().toISOString(),    actor: \"agent\",    driven_by: \"agent\",    invoked_via: \"explicit-dev-tool-cli\",    production_turn_path: false,    input: path.relative(path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\"), inputPath).split(path.sep).join(\"/\"),    budget: LOW_QUALITY_BUDGET,    ...report,  };  const outPath = args.out    ? path.resolve(args.out)    : path.resolve(\"artifacts/decision-quality-audit/report.json\");  fs.mkdirSync(path.dirname(outPath), { recursive: true });  fs.writeFileSync(outPath, `${JSON.stringify(payload, null, 2)}\\n`);  process.stdout.write(    `[a4-decision-quality-audit] audited=${report.totalAudited} lowQuality=${report.lowQualityCount} rate=${(report.lowQualityRate * 100).toFixed(2)}% withinBudget=${report.withinBudget}\\n`,  );  return report.withinBudget ? 0 : 1;}process.exit(main());","exit_code":0,"status":"completed"}}
