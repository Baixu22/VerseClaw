ot flag off, decision outcomes and the audit surface are unchanged.\nrequiredTests:\n  - tests/unit/deprecation-counters.test.ts\n  - tests/unit/performance-budgets.test.ts\n  - tests/unit/decision-quality-auditor.test.ts\n  - tests/unit/deep/a4-deep.test.ts\n  - tests/unit/trace-truncation.test.ts\nacceptance:\n  - A4 deprecation counter `lowQualityDecisions` rate ≤ 10% over audited decisions\n  - A4 budget violation response `degrade_to_audit_only` triggers when low-quality rate > 10%\n  - Per-turn cumulative latency budget respected (A4 is part of degradation order: A4→A3→A5→A1)\ndocs:\n  required: true\n---\n\n## Graduation gate\n(unchanged)\n\n## Out of scope\n(unchanged)\n\n## Re-verification note (A04, 2026-10-13)\n...\n```\n\nGood.\n\nNow the coverage test file. Model on a03:\n\n```ts\n// @vitest-environment node\n// A04: the A4 decision-quality gate must be re-verifiable from the current candidate.\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { dirname, join, resolve } from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { describe, expect, it } from \"vitest\";\n\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\nconst SPEC = \"harness/specs/tasks/a4-decision-quality-pilot.md\";\n\nfunction read(p: string) { return readFileSync(join(ROOT, p), \"utf8\"); }\nfunction requiredTests(spec: string): string[] {\n  const block = spec.match(/requiredTests:\\n((?:\\s+- .+\\n)+)/)?.[1] ?? \"\";\n  return [...block.matchAll(/^\\s+- (.+)$/gm)].map((m) => m[1].trim());\n}\n\ndescribe(\"A04 A4 decision-quality pilot gate coverage\", () => {\n  it(\"wires the audit, counter and degradation-order tests into requiredTests (no stale reference)\", () => {\n    const spec = read(SPEC);\n    const tests = requiredTests(spec);\n    expect(tests).toContain(\"tests/unit/decision-quality-auditor.test.ts\");\n    expect(tests).toContain(\"tests/unit/deprecation-counters.test.ts\");\n    expect(tests).toContain(\"tests/unit/performance-budgets.test.ts\");\n    expect(tests).toContain(\"tests/unit/deep/a4-deep.test.ts\");\n    expect(tests).toContain(\"tests/unit/trace-truncation.test.ts\");\n    for (const test of tests) {\n      expect(existsSync(join(ROOT, test)), `missing required test: ${test}`).toBe(true);\n    }\n  });\n\n  it(\"keeps each A4 criterion mapped to a current assertion at the original thresholds\", () => {\n    const spec = read(SPEC);\n    expect(spec).toContain(\"lowQualityDecisions / auditedDecisions ≤ 0.10\");\n    expect(spec).toContain(\"degrade_to_audit_only\");\n    expect(spec).toMatch(/A4→A3→A5→A1/);\n    const counters = read(\"tests/unit/deprecation-counters.test.ts\");\n    expect(counters).toContain(\"degrade_to_audit_only\");\n    expect(counters).toMatch(/A4: low-quality rate > 10%/);\n    const auditor = read(\"tests/unit/decision-quality-auditor.test.ts\");\n    expect(auditor).toContain(\"isDecisionQualityAuditEnabled\");\n    expect(auditor).toContain(\"auditBatch\");\n    expect(auditor).toContain(\"auditedDecisions\");\n    expect(auditor).toMatch(/decisionQualityPilot: 'shadow'/);\n    const deep = read(\"tests/unit/deep/a4-deep.test.ts\");\n    expect(deep).toContain(\"a4_low_quality_rate\");\n    expect(deep).toContain(\"degrade_to_audit_only\");\n    const truncation = read(\"tests/unit/trace-truncation.test.ts\");\n    expect(truncation).toContain(\"droppedAreas\");\n  });\n\n  it(\"records criteria 2 and 4 as explicit NO-GO / NOT-MEASURED residuals, not a pass\", () => {\n    const spec = read(SPEC);\n    expect(spec).toMatch(/NO-GO/);\n    expect(spec).toMatch(/NOT-MEASURED/);\n    expect(spec).toMatch(/offline|dev-tool|dev tool/i);\n    expect(spec).toMatch(/production/i);\n  });\n});\n```\n\nCareful: `spec` contains \"lowQualityDecisions / auditedDecisions ≤ 0.10\" — original text: \"**Low-quality decision rate** ≤ 10%: `lowQualityDecisions / auditedDecisions ≤ 0.10`.\" Yes contains that substring. Good.\n\n`/A4→A3→A5→A1/` — ori