SS.                                                                                                                                                                                                 \r\n//                                                                                                                                                                                                                                              \r\n// A4 is frozen as \"offline pure functions only\" (development manual §1.4): the                                                                                                                                                                 \r\n// only sanctioned consumer is an explicit dev-tool invocation. This guard pins                                                                                                                                                                 \r\n// the wired evidence, the budget action, the A4-first degradation order, and                                                                                                                                                                   \r\n// the offline-only production boundary.                                                                                                                                                                                                        \r\nimport { existsSync, readdirSync, readFileSync } from \"node:fs\";                                                                                                                                                                                \r\nimport { dirname, join, resolve } from \"node:path\";                                                                                                                                                                                             \r\nimport { fileURLToPath } from \"node:url\";                                                                                                                                                                                                       \r\nimport { describe, expect, it } from \"vitest\";                                                                                                                                                                                                  \r\n                                                                                                                                                                                                                                                \r\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");                                                                                                                                                                      \r\nconst SPEC = \"harness/specs/tasks/a4-decision-quality-pilot.md\";                                                                                                                                                                                \r\nconst REQUIRED_TESTS = [                                                                                                                                                                                                                        \r\n  \"tests/unit/decision-quality-auditor.test.ts\",                                                                                                                                                                                                \r\n  \"tests/unit/deprecation-counters.test.ts\",                                                                                                                                                                                                    \r\n  \"tests/unit/performance-budgets.test.ts\",                                                                                                                                                                                                     \r\n  \"tests/unit/deep/a4-deep.test.ts\",                                                                                                                                                                                                            \r\n  \"tests/unit/trace-truncation.test.ts\",                                                                                                                                                                                                        \r\n  \"tests/unit/a04-a4-gate-coverage.test.ts\",                                                                                                                                                                                                    \r\n  \"tests/unit/a4-decision-quality-dev-tool.test.ts\",                                                                                                                                                                                            \r\n] as const;                                                                                                                                                                                                                                     \r\n                                                                                                                                                                                                                                                \r\nfunction read(p: string): string {                                                                                                                                                                                                              \r\n  return readFileSync(join(ROOT, p), \"utf8\");                                                                                                                                                                                                   \r\n}                                                                                                                                                                                                                                               \r\n                                                                                                                                                                                                                                                \r\nfunction walk(dir: string): string[] {                                                                                                                                                                                                          \r\n  return readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {                                                                                                                                                                         \r\n    const full = join(dir, entry.name);                                                                                                                                                                                                         \r\n    if (entry.isDirectory()) return walk(full);                                                                                                                                                                                                 \r\n    return entry.isFile() && entry.name.endsWith(\".ts\") ? [full] : [];                                                                                                                                                                          \r\n  });                                                                                                                                                                                                                                           \r\n}                                                                                                                                                                                                                                               \r\n                                                                                                                                                                                                                                                \r\ndescribe(\"A04 A4 decision-quality pilot gate coverage\", () => {                                                                                                                                                                                 \r\n  it(\"keeps every A4 required test path present and wired into the archived pilot spec\", () => {                                                                                                                                                \r\n    const spec = read(SPEC);                                                                                                                                                                                                                    \r\n    for (const rel of REQUIRED_TESTS) {                                                                                                                                                                                                         \r\n      expect(spec).toContain(`- ${rel}`);                                                                                                                                                                                                       \r\n      expect(existsSync(join(ROOT, rel))).toBe(true);                                                                                                                                                                                           \r\n    }                                                                                                                                                                                                                                           \r\n    // Thresholds and the documented degradation order must survive verbatim.                                                                                                                                                                   \r\n    expect(spec).toContain(\"lowQualityDecisions / auditedDecisions ≤ 0.10\");                                                                                                                                                                    \r\n    expect(spec).toContain(\"degrade_to_audit_only\");                                                                                                                                                                                            \r\n    expect(spec).toContain(\"A4→A3→A5→A1\");                                                                                                                                                                                                      \r\n    expect(spec).toContain(\"sampling rate = 1.0\");                                                                                                                                                                                              \r\n  });                                                                                                                                                                                                                                           \r\n                                                                                                                                                                                                                                                \r\n  it(\"pins the A4 counter action and the A4-first degradation order evidence\", () => {                                                                                                                                                          \r\n    const counters = read(\"openclaw_runtime/src/observability/deprecation-counters.ts\");                                                                                                                                                        \r\n    expect(counters).toContain('action: \"degrade_to_audit_only\"');                                                                                                                                                                              \r\n    expect(counters).toMatch(/a4\\.lowQualityDecisions \\/ a4\\.auditedDecisions > 0\\.10/);                                                                                                                                                        \r\n                                                                                                                                                                                                                                                \r\n    const traceRecorder = read(\"openclaw_runtime/src/observability/trace-recorder.ts\");                                                                                                                                                         \r\n    expect(traceRecorder).toContain(\"a4 > a3 > a5 > a2 > a1 > a6 > core\");                                                                                                                                                                      \r\n                                                                                                                                                                                                                                                \r\n    const traceTest = read(\"tests/unit/trace-truncation.test.ts\");                                                                                                                                                                              \r\n    expect(traceTest).toContain(\"drops lowest-priority spans first\");                                                                                                                                                                           \r\n    expect(traceTest).toContain(\"a4, a3, a5 should be dropped\");                                                                                                                                                                                \r\n                                                                                                                                                                                                                                                \r\n    const namespace = read(\"openclaw_runtime/src/observability/namespace-governance.ts\");                                                                                                                                                       \r\n    expect(namespace).toMatch(/a4:\\s*6/);                                                                                                                                                                                                       \r\n  });                                                                                                                                                                                                                                           \r\n                                                                                                                                                                                                                                                \r\n  it(\"pins A4 as offline-only with the sanctioned dev-tool consumer wired\", () => {                                                                                                                                                             \r\n    const manual = read(\"docs/runtime-design/development-manual.md\");                                                                                                                                                                           \r\n    expect(manual).toContain(\"A4 — Decision Quality (offline pure functions only)\");                                                                                                                                                            \r\n    expect(manual).toContain(\"A4 is called ONLY via explicit dev-tool invocation\");                                                                                                                                                             \r\n                                                                                                                                                                                                                                                \r\n    // The only consumer of the auditor must be the explicit dev-tool CLI; the                                                                                                                                                                  \r\n    // runtime tree must not import it on any production turn path.                                                                                                                                                                             \r\n    const offenders = walk(join(ROOT, \"openclaw_runtime/src\"))                                                                                                                                                                                  \r\n      .filter((file) => !file.includes(\"decision-quality-auditor\"))                                                                                                                                                                             \r\n      .filter((file) => readFileSync(file, \"utf8\").includes(\"DecisionQualityAuditor\"));                                                                                                                                                         \r\n    expect(offenders).toEqual([]);                                                                                                                                                                                                              \r\n                                                                                                                                                                                                                                                \r\n    expect(existsSync(join(ROOT, \"scripts/a4-decision-quality-audit.mts\"))).toBe(true);                                                                                                                                                         \r\n    const pkg = JSON.parse(read(\"package.json\"));                                                                                                                                                                                               \r\n    expect(pkg.scripts[\"a4:decision-quality-audit\"]).toContain(\"a4-decision-quality-audit.mts\");                                                                                                                                                \r\n  });                                                                                                                                                                                                                                           \r\n                                                                                                                                                                                                                                                \r\n  it(\"records criterion 2 (production audit coverage) as a NO-GO residual, not a pass\", () => {                                                                                                                                                 \r\n    const spec = read(SPEC);                                                                                                                                                                                                                    \r\n    expect(spec).toMatch(/offline/i);                                                                                                                                                                                                           \r\n    expect(spec).toMatch(/dev-tool-only|explicit dev-tool/i);                                                                                                                                                                                   \r\n    expect(spec).toMatch(/NO-GO/);                                                                                                                                                                                                              \r\n    expect(spec).toMatch(/production (audit caller|coverage)/i);                                                                                                                                                                                \r\n  });                                                                                                                                                                                                                                           \r\n                                                                                                                                                                                                                                                \r\n  it(\"records criterion 4 cumulative latency as NOT-MEASURED / NO-GO (A4 is not on the production turn path)\", () => {                                                                                                                          \r\n    const spec = read(SPEC);                                                                                                                                                                                                                    \r\n    expect(spec).toMatch(/NOT-MEASURED/);                                                                                                                                                                                                       \r\n    expect(spec).toMatch(/per-turn cumulative latency/i);                                                                                                                                                                                       \r\n    expect(spec).toMatch(/turn path/i);                                                                                                                                                                                                         \r\n  });                                                                                                                                                                                                                                           \r\n});                                                                                                                                                                                                                                             \r\nimport { existsSync, readFileSync, readdirSync } from \"node:fs\";import path from \"node:path\";import { describe, expect, it } from \"vitest\";const ROOT = path.resolve(__dirname, \"../..\");const SPEC = \"harness/specs/tasks/a4-decision-quality-…\r\n\r\n\r\n==== tests__unit__a4-decision-quality-dev-tool.test.ts ====\r\n\r\nInputObject\r\n-----------                                                                                                                                                                                                                                     \r\nimport { execFileSync } from \"node:child_process\";                                                                                                                                                                                              \r\nimport { mkdtempSync, readFileSync, writeFileSync } from \"node:fs\";                                                                                                                                                                             \r\nimport { tmpdir } from \"node:os\";                                                                                                                                                                                                               \r\nimport path from \"node:path\";                                                                                                                                                                                                                   \r\nimport { pathToFileURL } from \"node:url\";                                                                                                                                                                                                       \r\nimport { describe, expect, it } from \"vitest\";                                                                                                                                                                                                  \r\n                                                                                                                                                                                                                                                \r\nconst ROOT = path.resolve(__dirname, \"../..\");                                                                                                                                                                                                  \r\nconst RUNTIME = path.join(ROOT, \"openclaw_runtime\");                                                                                                                                                                                            \r\nconst SCRIPT = path.join(ROOT, \"scripts/a4-decision-quality-audit.mts\");                                                                                                                                                                        \r\n                                                                                                                                                                                                                                                \r\n// `tsx` is resolved from the runtime package, matching the repo convention for                                                                                                                                                                 \r\n// `pnpm --dir openclaw_runtime exec tsx ...` dev tools.                                                                                                                                                                                        \r\nconst TSX = pathToFileURL(path.join(RUNTIME, \"node_modules/tsx/dist/loader.mjs\")).href;                                                                                                                                                         \r\n                                                                                                                                                                                                                                                \r\n/**                                                                                                                                                                                                                                             \r\n * A4 is frozen as \"offline pure functions only\": the ONLY sanctioned consumer                                                                                                                                                                  \r\n * is an explicit dev-tool invocation. These tests exercise that CLI surface so                                                                                                                                                                 \r\n * the dev-tool path is real and covered, without wiring A4 into any production                                                                                                                                                                 \r\n * turn path.                                                                                                                                                                                                                                   \r\n */                                                                                                                                                                                                                                             \r\ndescribe(\"A4 decision quality offline dev-tool\", () => {                                                                                                                                                                                        \r\n  it(\"runs the sanctioned CLI selftest\", () => {                                                                                                                                                                                                \r\n    const out = execFileSync(                                                                                                                                                                                                                   \r\n      process.execPath,                                                                                                                                                                                                                         \r\n      [\"--import\", TSX, SCRIPT, \"--selftest\"],                                                                                                                                                                                                  \r\n      { cwd: RUNTIME, encoding: \"utf8\" },                                                                                                                                                                                                       \r\n    );                                                                                                                                                                                                                                          \r\n    expect(out).toContain(\"selftest totalAudited=1 lowQualityCount=0\");                                                                                                                                                                         \r\n  });                                                                                                                                                                                                                                           \r\n                                                                                                                                                                                                                                                \r\n  it(\"audits a records file and fails the budget when the low-quality rate exceeds 10%\", () => {                                                                                                                                                \r\n    const dir = mkdtempSync(path.join(tmpdir(), \"a4-audit-\"));                                                                                                                                                                                  \r\n    const input = path.join(dir, \"records.json\");                                                                                                                                                                                               \r\n    const out = path.join(dir, \"report.json\");                                                                                                                                                                                                  \r\n    const good = {                                                                                                                                                                                                                              \r\n      decisionId: \"good\",                                                                                                                                                                                                                       \r\n      reviewerAction: \"continue\",                                                                                                                                                                                                               \r\n      expectedAction: \"continue\",                                                                                                                                                                                                               \r\n      actionMatched: true,                                                                                                                                                                                                                      \r\n      contextItemsAvailable: 10,                                                                                                                                                                                                                \r\n      contextItemsConsidered: 10,                                                                                                                                                                                                               \r\n      decisionTick: 0,                                                                                                                                                                                                                          \r\n      maxTicksForDecision: 10,                                                                                                                                                                                                                  \r\n    };                                                                                                                                                                                                                                          \r\n    // 4 of 5 decisions are low quality -> 80% rate, above the 10% budget.                                                                                                                                                                      \r\n    const bad = (index: number) => ({                                                                                                                                                                                                           \r\n      ...good,                                                                                                                                                                                                                                  \r\n      decisionId: `bad-${index}`,                                                                                                                                                                                                               \r\n      actionMatched: false,                                                                                                                                                                                                                     \r\n      expectedAction: \"continue\",                                                                                                                                                                                                               \r\n      reviewerAction: \"blocked\",                                                                                                                                                                                                                \r\n      contextItemsConsidered: 0,                                                                                                                                                                                                                \r\n      decisionTick: 10,                                                                                                                                                                                                                         \r\n    });                                                                                                                                                                                                                                         \r\n    writeFileSync(input, JSON.stringify([good, bad(1), bad(2), bad(3), bad(4)]));                                                                                                                                                               \r\n                                                                                                                                                                                                                                                \r\n    let failed = false;                                                                                                                                                                                                                         \r\n    try {                                                                                                                                                                                                                                       \r\n      execFileSync(                                                                                                                                                                                                                             \r\n        process.execPath,                                                                                                                                                                                                                       \r\n        [\"--import\", TSX, SCRIPT, \"--input\", input, \"--out\", out],                                                                                                                                                                              \r\n        { cwd: RUNTIME, encoding: \"utf8\" },                                                                                                                                                                                                     \r\n      );                                                                                                                                                                                                                                        \r\n    } catch {                                                                                                                                                                                                                                   \r\n      failed = true;                                                                                                                                                                                                                            \r\n    }                                                                                                                                                                                                                                           \r\n    expect(failed).toBe(true);                                                                                                                                                                                                                  \r\n                                                                                                                                                                                                                                                \r\n    const report = JSON.parse(readFileSync(out, \"utf8\"));                                                                                                                                                                                       \r\n    expect(report.totalAudited).toBe(5);                                                                                                                                                                                                        \r\n    expect(report.lowQualityCount).toBe(4);                                                                                                                                                                                                     \r\n    expect(report.withinBudget).toBe(false);                                                                                                                                                                                                    \r\n    expect(report.invoked_via).toBe(\"explicit-dev-tool-cli\");                                                                                                                                                                                   \r\n    expect(report.production_turn_path).toBe(false);                                                                                                                                                                                            \r\n    expect(report.driven_by).toBe(\"agent\");                                                                                                                                                                                                     \r\n  });                                                                                                                                                                                                                                           \r\n                                                                                                                                                                                                                                                \r\n  it(\"keeps A4 out of the production runtime tree\", () => {                                                                                                                                                                                     \r\n    const manual = readFileSync(path.join(ROOT, \"docs/runtime-design/development-manual.md\"), \"utf8\");                                                                                                                                          \r\n    expect(manual).toContain(\"A4 is called ONLY via explicit dev-tool invocation\");                                                                                                                                                             \r\n  });                                                                                                                                                                                                                                           \r\n});                                                                                                                                                                                                                                             \r\nimport { execFileSync } from \"node:child_process\";import { mkdtempSync, readFileSync, writeFileSync } from \"node:fs\";import { tmpdir } from \"node:os\";import path from \"node:path\";import { pathToFileURL } from \"node:url\";import { describe, …\r\n\r\n\r\n==== scripts__a4-decision-quality-audit.mts ====\r\n\r\nInputObject\r\n-----------                                                                                                                                                                                                                                     \r\n#!/usr/bin/env node                                                                                                                                                                                                                             \r\n/**                                                                                                                                                                                                                                             \r\n * A4 Decision Quality — explicit offline dev-tool entry point.                                                                                                                                                                                 \r\n *                                                                                                                                                                                                                                              \r\n * `docs/runtime-design/development-manual.md` §1.4 freezes A4 as                                                                                                                                                                               \r\n * \"offline pure functions only\": it MUST NOT run on any production turn path                                                                                                                                                                   \r\n * and is invoked ONLY via an explicit dev-tool invocation (CLI, test fixture,                                                                                                                                                                  \r\n * debug panel). This script is that CLI surface: it reads a JSON array of                                                                                                                                                                      \r\n * `DecisionRecord`s from disk, audits them with the existing                                                                                                                                                                                   \r\n * `DecisionQualityAuditor`, writes a report, and exits non-zero when the                                                                                                                                                                       \r\n * low-quality rate breaches the 10% graduation budget.                                                                                                                                                                                         \r\n *                                                                                                                                                                                                                                              \r\n * It does not touch the runtime turn path and never enables the pilot flag for                                                                                                                                                                 \r\n * the app; it only exercises the same auditor the runtime would use if the                                                                                                                                                                     \r\n * `decisionQualityPilot: 'shadow'` flag were set by an operator.                                                                                                                                                                               \r\n *                                                                                                                                                                                                                                              \r\n * Usage:                                                                                                                                                                                                                                       \r\n *   pnpm --dir openclaw_runtime exec tsx ../scripts/a4-decision-quality-audit.mts --input <file.json>                                                                                                                                          \r\n *   pnpm --dir openclaw_runtime exec tsx ../scripts/a4-decision-quality-audit.mts --input <file.json> --out <report.json>                                                                                                                      \r\n *   pnpm --dir openclaw_runtime exec tsx ../scripts/a4-decision-quality-audit.mts --selftest                                                                                                                                                   \r\n */                                                                                                                                                                                                                                             \r\nimport fs from \"node:fs\";                                                                                                                                                                                                                       \r\nimport path from \"node:path\";                                                                                                                                                                                                                   \r\nimport process from \"node:process\";                                                                                                                                                                                                             \r\nimport { fileURLToPath } from \"node:url\";                                                                                                                                                                                                       \r\nimport {                                                                                                                                                                                                                                        \r\n  DecisionQualityAuditor,                                                                                                                                                                                                                       \r\n  isDecisionQualityAuditEnabled,                                                                                                                                                                                                                \r\n  type DecisionRecord,                                                                                                                                                                                                                          \r\n} from \"../openclaw_runtime/src/observability/decision-quality-auditor.js\";                                                                                                                                                                     \r\n                                                                                                                                                                                                                                                \r\nconst LOW_QUALITY_BUDGET = 0.1;                                                                                                                                                                                                                 \r\n                                                                                                                                                                                                                                                \r\nfunction parseArgs(argv: string[]): { input: string | null; out: string | null; selftest: boolean } {                                                                                                                                           \r\n  const args = { input: null as string | null, out: null as string | null, selftest: false };                                                                                                                                                   \r\n  for (let index = 0; index < argv.length; index += 1) {                                                                                                                                                                                        \r\n    const token = argv[index];                                                                                                                                                                                                                  \r\n    if (token === \"--input\") args.input = argv[index + 1] ?? null;                                                                                                                                                                              \r\n    else if (token === \"--out\") args.out = argv[index + 1] ?? null;                                                                                                                                                                             \r\n    else if (token === \"--selftest\") args.selftest = true;                                                                                                                                                                                      \r\n  }                                                                                                                                                                                                                                             \r\n  return args;                                                                                                                                                                                                                                  \r\n}                                                                                                                                                                                                                                               \r\n                                                                                                                                                                                                                                                \r\nfunction readRecords(filePath: string): DecisionRecord[] {                                                                                                                                                                                      \r\n  const raw = JSON.parse(fs.readFileSync(filePath, \"utf8\"));                                                                                                                                                                                    \r\n  const records = Array.isArray(raw) ? raw : raw?.records;                                                                                                                                                                                      \r\n  if (!Array.isArray(records)) {                                                                                                                                                                                                                \r\n    throw new Error(\"input must be a JSON array of DecisionRecord objects (or { records: [...] })\");                                                                                                                                            \r\n  }                                                                                                                                                                                                                                             \r\n  return records as DecisionRecord[];                                                                                                                                                                                                           \r\n}                                                                                                                                                                                                                                               \r\n                                                                                                                                                                                                                                                \r\nfunction audit(records: DecisionRecord[]) {                                                                                                                                                                                                     \r\n  // The dev-tool always enables the shadow pilot for this offline run; the app                                                                                                                                                                 \r\n  // flag stays default-off and this never runs in a production turn.                                                                                                                                                                           \r\n  const enabled = isDecisionQualityAuditEnabled({ decisionQualityPilot: \"shadow\" });                                                                                                                                                            \r\n  const auditor = new DecisionQualityAuditor({ decisionQualityPilot: \"shadow\" });                                                                                                                                                               \r\n  const batch = auditor.auditBatch(records);                                                                                                                                                                                                    \r\n  if (batch === null) throw new Error(\"A4 auditor is disabled in the dev-tool run\");                                                                                                                                                            \r\n  const lowQualityRate = batch.totalAudited > 0 ? batch.lowQualityCount / batch.totalAudited : 0;                                                                                                                                               \r\n  return {                                                                                                                                                                                                                                      \r\n    enabled,                                                                                                                                                                                                                                    \r\n    totalAudited: batch.totalAudited,                                                                                                                                                                                                           \r\n    lowQualityCount: batch.lowQualityCount,                                                                                                                                                                                                     \r\n    lowQualityRate,                                                                                                                                                                                                                             \r\n    meanOverall: batch.meanOverall,                                                                                                                                                                                                             \r\n    withinBudget: lowQualityRate <= LOW_QUALITY_BUDGET,                                                                                                                                                                                         \r\n    scores: batch.scores,                                                                                                                                                                                                                       \r\n  };                                                                                                                                                                                                                                            \r\n}                                                                                                                                                                                                                                               \r\n                                                                                                                                                                                                                                                \r\nfunction buildSelftestRecords(): DecisionRecord[] {                                                                                                                                                                                             \r\n  return [                                                                                                                                                                                                                                      \r\n    {                                                                                                                                                                                                                                           \r\n      decisionId: \"selftest-good\",                                                                                                                                                                                                              \r\n      reviewerAction: \"continue\",                                                                                                                                                                                                               \r\n      expectedAction: \"continue\",                                                                                                                                                                                                               \r\n      actionMatched: true,                                                                                                                                                                                                                      \r\n      contextItemsAvailable: 10,                                                                                                                                                                                                                \r\n      contextItemsConsidered: 10,                                                                                                                                                                                                               \r\n      decisionTick: 0,                                                                                                                                                                                                                          \r\n      maxTicksForDecision: 10,                                                                                                                                                                                                                  \r\n    },                                                                                                                                                                                                                                          \r\n  ];                                                                                                                                                                                                                                            \r\n}                                                                                                                                                                                                                                               \r\n                                                                                                                                                                                                                                                \r\nfunction main(): number {                                                                                                                                                                                                                       \r\n  const args = parseArgs(process.argv.slice(2));                                                                                                                                                                                                \r\n  if (args.selftest) {                                                                                                                                                                                                                          \r\n    const report = audit(buildSelftestRecords());                                                                                                                                                                                               \r\n    process.stdout.write(`[a4-decision-quality-audit] selftest totalAudited=${report.totalAudited} lowQualityCount=${report.lowQualityCount}\\n`);                                                                                               \r\n    return report.totalAudited === 1 && report.lowQualityCount === 0 ? 0 : 1;                                                                                                                                                                   \r\n  }                                                                                                                                                                                                                                             \r\n  if (!args.input) {                                                                                                                                                                                                                            \r\n    process.stderr.write(\"[a4-decision-quality-audit] missing --input <records.json> (or --selftest)\\n\");                                                                                                                                       \r\n    return 2;                                                                                                                                                                                                                                   \r\n  }                                                                                                                                                                                                                                             \r\n  const inputPath = path.resolve(args.input);                                                                                                                                                                                                   \r\n  const records = readRecords(inputPath);                                                                                                                                                                                                       \r\n  const report = audit(records);                                                                                                                                                                                                                \r\n  const payload = {                                                                                                                                                                                                                             \r\n    schema: \"a4-decision-quality-audit/v1\",                                                                                                                                                                                                     \r\n    generatedAt: new Date().toISOString(),                                                                                                                                                                                                      \r\n    actor: \"agent\",                                                                                                                                                                                                                             \r\n    driven_by: \"agent\",                                                                                                                                                                                                                         \r\n    invoked_via: \"explicit-dev-tool-cli\",                                                                                                                                                                                                       \r\n    production_turn_path: false,                                                                                                                                                                                                                \r\n    input: path.relative(path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\"), inputPath).split(path.sep).join(\"/\"),                                                                                                                \r\n    budget: LOW_QUALITY_BUDGET,                                                                                                                                                                                                                 \r\n    ...report,                                                                                                                                                                                                                                  \r\n  };                                                                                                                                                                                                                                            \r\n  const outPath = args.out                                                                                                                                                                                                                      \r\n    ? path.resolve(args.out)                                                                                                                                                                                                                    \r\n    : path.resolve(\"artifacts/decision-quality-audit/report.json\");                                                                                                                                                                             \r\n  fs.mkdirSync(path.dirname(outPath), { recursive: true });                                                                                                                                                                                     \r\n  fs.writeFileSync(outPath, `${JSON.stringify(payload, null, 2)}\\n`);                                                                                                                                                                           \r\n  process.stdout.write(                                                                                                                                                                                                                         \r\n    `[a4-decision-quality-audit] audited=${report.totalAudited} lowQuality=${report.lowQualityCount} rate=${(report.lowQualityRate * 100).toFixed(2)}% withinBudget=${report.withinBudget}\\n`,                                                  \r\n  );                                                                                                                                                                                                                                            \r\n  return report.withinBudget ? 0 : 1;                                                                                                                                                                                                           \r\n}                                                                                                                                                                                                                                               \r\n                                                                                                                                                                                                                                                \r\nprocess.exit(main());                                                                                                                                                                                                                           \r\n#!/usr/bin/env node/** * A4 Decision Quality — explicit offline dev-tool entry point. * * `docs/runtime-design/development-manual.md` §1.4 freezes A4 as * \"offline pure functions only\": it MUST NOT run on any production turn path * and is …\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
