{"type":"item.started","item":{"id":"item_429","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"@'\nconst fs = require(\\\"fs\\\"), c = require(\\\"crypto\\\");\nconst ROOT = \\\"D:/tmp/rsi-tf0604-run5/trials/tf-0296-a04-baseline-3/agent/\\\";\nconst read = (p) => fs.readFileSync(ROOT + p, \\\"utf8\\\");\nconst checks = [];\nconst ok = (n, v) => checks.push([v ? \\\"ok\\\" : \\\"FAIL\\\", n]);\n\nok(\\\"spec has lifecycleStatus archived\\\", read(\\\"harness/specs/tasks/a4-decision-quality-pilot.md\\\").startsWith(\\\"---\\\\nlifecycleStatus: archived\\\"));\nconst req = (spec) => [...(spec.match(/requiredTests:\\\\n((?:\\\\s+- .+\\\\n)+)/)?.[1] ?? \\\"\\\").matchAll(/\"'^'\"\\\\s+- (.+)\"'$/gm)].map((m) => m[1].trim());\nconst a4 = read(\"harness/specs/tasks/a4-decision-quality-pilot.md\");\nok(\"a4 requiredTests includes 5 tests\", req(a4).length === 5);\nok(\"a4 requiredTests has auditor\", req(a4).includes(\"tests/unit/decision-quality-auditor.test.ts\"));\nok(\"a4 requiredTests has trace-truncation\", req(a4).includes(\"tests/unit/trace-truncation.test.ts\"));\nok(\"a4 spec keeps <=0.10 threshold\", a4.includes(\"≤ 0.10\"));\nok(\"a4 spec has NO-GO residual\", /NO-GO/.test(a4) && /NOT-MEASURED/.test(a4));\n\nconst rv = read(\"harness/specs/tasks/harness-gap-a04-decision-quality-pilot-reverify.md\");\nok(\"reverify spec lifecycle completed\", /lifecycleStatus: completed/.test(rv));\nok(\"reverify spec id\", /id: harness-gap-a04-decision-quality-pilot-reverify/.test(rv));\nok(\"reverify requiredTests has guard\", req(rv).includes(\"tests/unit/a04-a4-gate-coverage.test.ts\"));\n\nconst acc = JSON.parse(read(\"docs/dev/harness-gap-closure/a04-acceptance.json\"));\nok(\"acceptance status NO-GO\", acc.decision.status === \"NO-GO\");\nok(\"acceptance driven_by agent\", acc.driven_by === \"agent\");\nok(\"acceptance realHuman false\", acc.scope.realHuman === false);\nok(\"acceptance no-go residual on criterion2