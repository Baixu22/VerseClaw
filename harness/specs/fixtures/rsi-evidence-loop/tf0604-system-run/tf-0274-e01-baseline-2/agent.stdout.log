{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Write-Output '=== tests/unit/contract-check.test.ts ==='; Get-Content tests/unit/contract-check.test.ts -TotalCount 40; Write-Output '=== vitest.config.ts ==='; Get-Content vitest.config.ts -Raw; Write-Output '=== harness spec test ==='; Get-Content tests/unit/harness-specs.test.ts -TotalCount 60\"","aggregated_output":"=== tests/unit/contract-check.test.ts ===\r\n// @vitest-environment node\r\n\r\nimport { describe, expect, it } from 'vitest';\r\nimport {\r\n  collectContractIssues,\r\n  parseContractActions,\r\n  parseFacadeActions,\r\n  parseRegistryScenarioIds,\r\n} from '../../scripts/contract-check.mjs';\r\n\r\nconst contractText = `\r\nexport type HostApiContract = {\r\n  agentDev: {\r\n    status: () => AgentDevStatusResult;\r\n    seedState: (payload?: AgentDevSeedStatePayload) => AgentDevSeedStateResult;\r\n  };\r\n};\r\n`;\r\n\r\nconst hostApiText = `\r\nexport const hostApi = {\r\n  agentDev: {\r\n    status: () => invokeHost('agentDev', 'status'),\r\n    seedState: (input) => invokeHost('agentDev', 'seedState', input),\r\n  },\r\n};\r\n`;\r\n\r\nconst ipcHandlersText = `\r\n  const services: HostServiceRegistry = {\r\n    agentDev: createAgentDevApi({ gatewayManager }),\r\n  };\r\n`;\r\n\r\nconst agentDevApiText = `\r\nimport { isAgentDevScenarioId } from '@shared/agent-dev/scenarios';\r\nexport function createAgentDevApi() {\r\n  return {\r\n    status: () => ({}),\r\n    seedState: async (payload) => {\r\n=== vitest.config.ts ===\r\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport { resolve, join } from 'path';\nimport { cpus } from 'os';\nimport { readFileSync, existsSync, statSync, realpathSync } from 'fs';\nimport type { Plugin } from 'vite';\n\nconst RUNTIME_ROOT = resolve(__dirname, 'openclaw_runtime');\n\n/**\n * Resolve a tsconfig path-mapping target against RUNTIME_ROOT, mirroring the\n * esbuild build script's resolveFile (handles .ts extension + dir->index).\n */\nfunction resolveAliasFile(targetRel: string): string | null {\n  const target = join(RUNTIME_ROOT, targetRel);\n  if (existsSync(target)) {\n    try {\n      if (statSync(target).isDirectory()) {\n        const indexTs = join(target, 'index.ts');\n        return existsSync(indexTs) ? indexTs : null;\n      }\n    } catch {\n      /* fall through */\n    }\n    return target;\n  }\n  const withTs = target + '.ts';\n  if (existsSync(withTs)) return withTs;\n  const withIndex = join(target, 'index.ts');\n  if (existsSync(withIndex)) return withIndex;\n  return null;\n}\n\n/**\n * Load `compilerOptions.paths` from openclaw_runtime/tsconfig.json and expose\n * them as a Vite plugin that resolves @openclaw/* and openclaw/* package\n * aliases the SAME way esbuild does (scripts/build-openclaw-runtime.mjs).\n *\n * A custom resolveId hook is used (rather than resolve.alias) because Vite's\n * alias substring matching mis-orders overlapping exact + wildcard entries\n * (e.g. \"@openclaw/x\" exact vs \"@openclaw/x/*\" wildcard). The hook walks the\n * tsconfig entries in declaration order, exact-first per prefix, which matches\n * the build's resolveTsAlias exactly.\n *\n * Without this, importing runtime modules that pull in @openclaw/* deps fails\n * with \"Failed to resolve import @openclaw/...\".\n */\nfunction runtimePathAliasPlugin(): Plugin {\n  const tsconfigPath = join(RUNTIME_ROOT, 'tsconfig.json');\n  const exact = new Map<string, string>();\n  const wildcards: Array<{ prefix: string; target: string }> = [];\n  try {\n    const tsconfig = JSON.parse(readFileSync(tsconfigPath, 'utf8'));\n    const paths: Record<string, string[]> = tsconfig.compilerOptions?.paths ?? {};\n    for (const [aliasKey, targets] of Object.entries(paths)) {\n      const target = targets?.[0];\n      if (!target) continue;\n      if (aliasKey.endsWith('/*')) {\n        wildcards.push({ prefix: aliasKey.slice(0, -2), target });\n      } else {\n        exact.set(aliasKey, target);\n      }\n    }\n  } catch {\n    // Runtime tsconfig missing - plugin is a no-op.\n  }\n\n  function resolveImport(importPath: string, _importer: string | undefined): string | null {\n    // Only rewrite @openclaw/* and openclaw/* bare specifiers.\n    if (!importPath.startsWith('@openclaw/') && !importPath.startsWith('openclaw/')) {\n      return null;\n    }\n    // Exact match first.\n    if (exact.has(importPath)) {\n      return resolveAliasFile(exact.get(importPath)!);\n    }\n    // Wildcard match (longest-prefix-first to avoid premature matches).\n    for (const { prefix, target } of wildcards) {\n      if (importPath === prefix) {\n        const file = resolveAliasFile(target.replace(/\\*/g, 'index'));\n        if (file) return file;\n      } else if (importPath.startsWith(prefix + '/')) {\n        const rest = importPath.slice(prefix.length + 1);\n        const file = resolveAliasFile(target.replace(/\\*/g, rest));\n        if (file) return file;\n      }\n    }\n    return null;\n  }\n\n  return {\n    name: 'openclaw-runtime-path-aliases',\n    enforce: 'pre',\n    resolveId(source, importer) {\n      const resolved = resolveImport(source, importer);\n      if (resolved) return resolved;\n      // Vite needs relative import paths (./foo.js) inside the runtime tree to\n      // resolve normally - return null to defer to the default resolver.\n      return null;\n    },\n  };\n}\n\n/** Strip #! shebangs so SSR evaluation of CLI .mjs scripts does not throw SyntaxError. */\nfunction stripShebangPlugin(): Plugin {\n  return {\n    name: 'strip-shebang-for-ssr',\n    enforce: 'pre',\n    transform(code, id) {\n      if (!code.startsWith('#!')) return null;\n      if (!id.includes('scripts') && !id.endsWith('.mjs') && !id.endsWith('.js')) return null;\n      return {\n        code: code.replace(/^#![^\\r\\n]*(?:\\r?\\n)?/, ''),\n        map: null,\n      };\n    },\n  };\n}\n\n// Full suite on Windows can thrash under high fan-out (transform/import dominate).\n// Cap workers and raise timeouts so real work finishes without load-induced flakes.\nconst cpuCount = cpus()?.length ?? 4;\nconst maxWorkers = process.env.VITEST_MAX_WORKERS\n  ? Number(process.env.VITEST_MAX_WORKERS)\n  : Math.max(1, Math.min(4, Math.floor(cpuCount / 2)));\n\nexport default defineConfig({\n  plugins: [react(), runtimePathAliasPlugin(), stripShebangPlugin()],\n  server: {\n    fs: {\n      // The workspace can be reached through two paths: the junction\n      // (C:\\Users\\27933\\Desktop\\clawx\\ClawX) and the real directory\n      // (D:\\ClawX). Vite realpath-resolves setup files, so when tests start\n      // from the junction the /@fs/ requests carry the D: path and get\n      // rejected by the default allow list (\"Cannot find module\n      // '/@fs/D:/ClawX/tests/setup.ts'\"). Allow both spellings.\n      allow: [__dirname, realpathSync(__dirname)],\n    },\n  },\n  test: {\n    passWithNoTests: false,\n    globals: true,\n    environment: 'jsdom',\n    setupFiles: ['./tests/setup.ts'],\n    include: ['tests/unit/**/*.{test,spec}.{ts,tsx}', 'tests/integration/**/*.{test,spec}.{ts,tsx}'],\n    testTimeout: 30_000,\n    hookTimeout: 30_000,\n    maxWorkers,\n    execArgv: ['--expose-gc'],\n    coverage: {\n      reporter: ['text', 'json', 'html'],\n      exclude: ['node_modules/', 'tests/'],\n    },\n  },\n  resolve: {\n    alias: {\n      '@': resolve(__dirname, 'src'),\n      '@electron': resolve(__dirname, 'electron'),\n      '@shared': resolve(__dirname, 'shared'),\n      '@openclaw/runtime-redaction': resolve(__dirname, 'openclaw_runtime/src/logging/redact.ts'),\n      '@openclaw/provider-request-auth': resolve(__dirname, 'openclaw_runtime/src/agents/provider-request-auth.ts'),\n      rastermill: resolve(__dirname, 'tests/fixtures/rastermill.ts'),\n    },\n  },\n});\n\r\n=== harness spec test ===\r\nimport { execFileSync, spawnSync } from 'node:child_process';\r\nimport { cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\r\nimport { tmpdir } from 'node:os';\r\nimport { join } from 'node:path';\r\n\r\nimport { describe, expect, it } from 'vitest';\r\n\r\nimport {\r\n  isGatewayBackendCommunicationTask,\r\n  isPluginLifecycleTask,\r\n  isTaskSpec,\r\n  loadGuideSpecs,\r\n  loadLayerSpecs,\r\n  parseFrontmatter,\r\n  pathMatchesAny,\r\n} from '../../harness/src/specs.mjs';\r\nimport { buildContext } from '../../harness/src/context.mjs';\r\nimport {\r\n  scanBackendCommunicationBoundary,\r\n  scanBackendCommunicationBoundaryText,\r\n  touchesCommunicationPath,\r\n  classifyChangedPathOwnership,\r\n  validateChangedPathOwnership,\r\n  validateGatewayTaskSpec,\r\n  validatePluginLifecycleTaskSpec,\r\n} from '../../harness/src/rules.mjs';\r\n\r\ndescribe('harness specs', () => {\r\n  it('parses Markdown frontmatter with arrays and nested docs', () => {\r\n    const spec = parseFrontmatter(`---\r\nid: example\r\nrequiredProfiles:\r\n  - fast\r\n  - comms\r\ndocs:\r\n  required: false\r\n---\r\n\r\nBody`);\r\n\r\n    expect(spec.data.id).toBe('example');\r\n    expect(spec.data.requiredProfiles).toEqual(['fast', 'comms']);\r\n    expect(spec.data.docs).toEqual({ required: false });\r\n  });\r\n\r\n  it('matches repository glob paths', () => {\r\n    expect(pathMatchesAny('src/stores/chat/history-actions.ts', ['src/stores/chat/**'])).toBe(true);\r\n    expect(pathMatchesAny('src/lib/host-api.ts', ['src/lib/host-api.ts'])).toBe(true);\r\n    expect(pathMatchesAny('src/pages/Chat/index.tsx', ['electron/gateway/**'])).toBe(false);\r\n  });\r\n\r\n  it('loads guide and layer specs from the harness spec library', async () => {\r\n    const guides = await loadGuideSpecs();\r\n    const layers = await loadLayerSpecs();\r\n\r\n    expect(guides.map((spec: { data: { id: string } }) => spec.data.id)).toEqual(\r\n      expect.arrayContaining(['agent-harness-routing', 'spec-update']),\r\n    );\r\n    expect(layers.map((spec: { data: { id: string } }) => spec.data.id)).toEqual(\r\n      expect.arrayContaining(['electron-main', 'harness', 'openclaw-runtime', 'plugins', 'renderer']),\r\n","exit_code":0,"status":"completed"}}
