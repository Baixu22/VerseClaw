\"line\": 2,\r\n      \"anchor\": \"id: a6-long-running-persistence-pilot\"\r\n    }\r\n  },\r\n  \"slots\": [\r\n    {\r\n      \"id\": \"HG01\",\r\n      \"topic\": \"上下文压力下的焦虑式提前收尾\",\r\n      \"owner\": \"L02\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"loop\",\r\n        \"handoff\"\r\n      ],\r\n      \"observation\": \"已有任务循环remaining/checkpoint与交接产物；不能从名称推断上下文压力下的提前成功已被抑制。\",\r\n      \"decision\": \"保留控制器，L02补预算耗尽与未完成事项连续性反例。\"\r\n    },\r\n    {\r\n      \"id\": \"HG02\",\r\n      \"topic\": \"调用速率级断路器\",\r\n      \"owner\": \"L05\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"tokenBudget\",\r\n        \"providerFetch\"\r\n      ],\r\n      \"observation\": \"已有token预算和guarded fetch；token累计预算不是单位时间调用速率。\",\r\n      \"decision\": \"L05只为已验证的单run/provider请求边界加可注入速率状态机，不改默认。\"\r\n    },\r\n    {\r\n      \"id\": \"HG03\",\r\n      \"topic\": \"pass^k可靠性聚合\",\r\n      \"owner\": \"E01\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"unverified\",\r\n      \"sourceRefs\": [\r\n        \"benefitScan\",\r\n        \"ablationPhase4\"\r\n      ],\r\n      \"observation\": \"benefit-eval实际是源码/选择器覆盖启发式报告；未提供固定k次原始case聚合。\",\r\n      \"decision\": \"E01新增窄可靠性聚合并复用case资产，不能把现有脚本报告改名为pass^k。\"\r\n    },\r\n    {\r\n      \"id\": \"HG04\",\r\n      \"topic\": \"可归因的组件消融\",\r\n      \"owner\": \"E02\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"ablationEmbedding\",\r\n        \"ablationFusion\",\r\n        \"ablationPhase4\",\r\n        \"benefitScan\"\r\n      ],\r\n      \"observation\": \"已有embedding/fusion/记忆类型局部消融；不具备跨层配对candidate/model/seed与请求成本联合证据。\",\r\n      \"decision\": \"E02复用现有memory检索/淘汰入口，先验证开关实际生效；不另建平台。\"\r\n    },\r\n    {\r\n      \"id\": \"HG05\",\r\n      \"topic\": \"flake率阈值\",\r\n      \"owner\": \"E01\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"unverified\",\r\n      \"sourceRefs\": [\r\n        \"pilotHistory\",\r\n        \"benefitScan\"\r\n      ],\r\n      \"observation\": \"旧深测报告保留过首次失败；不能由重跑绿灯推导flake率或规定门限。\",\r\n      \"decision\": \"E01逐case保留首次失败、固定重跑与不完整样本。\"\r\n    },\r\n    {\r\n      \"id\": \"HG06\",\r\n      \"topic\": \"交接深度约束\",\r\n      \"owner\": \"L02\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"handoff\",\r\n        \"loop\"\r\n      ],\r\n      \"observation\": \"handoff有输出上限/超时且默认off；不能替代root/parent/depth转交上限证据。\",\r\n      \"decision\": \"L02只补交接链深度和循环反例，保持既有默认off。\"\r\n    },\r\n    {\r\n      \"id\": \"HG07\",\r\n      \"topic\": \"热点文件写入归属\",\r\n      \"owner\": \"L06\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"existing-narrow\",\r\n      \"sourceRefs\": [\r\n        \"lease\",\r\n        \"symbolLease\",\r\n        \"tools\"\r\n      ],\r\n      \"observation\": \"write/edit/apply_patch已有可选SymbolLease guard，冲突先抛错且finally释放，agent-tools已有调用。\",\r\n      \"decision\": \"L06先复验双owner/旧租约/路径身份，不新增锁服务；只补证实的旁路。\"\r\n    },\r\n    {\r\n      \"id\": \"HG08\",\r\n      \"topic\": \"规范僵化 ossification\",\r\n      \"owner\": \"G02\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"unverified\",\r\n      \"sourceRefs\": [\r\n        \"harnessRules\",\r\n        \"agentEntry\"\r\n      ],\r\n      \"observation\": \"Harness有规则与范围门；规范是否陈旧需逐引用/反例审计，不能由文档数量判断。\",\r\n      \"decision\": \"G02只改有断链或语义漂移证据的规范。\"\r\n    },\r\n    {\r\n      \"id\": \"HG09\",\r\n      \"topic\": \"doc-gardening\",\r\n      \"owner\": \"G02\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"harnessRules\",\r\n        \"promote\"\r\n      ],\r\n      \"observation\": \"已有显式校验/推广脚本；尚未证实文档维护反馈闭环。\",\r\n      \"decision\": \"G02沿用显式命令，不创建定时机器人或自动删除。\"\r\n    },\r\n    {\r\n      \"id\": \"HG10\",\r\n      \"topic\": \"错误即受控修复指引\",\r\n      \"owner\": \"G01\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"error\",\r\n        \"steer\"\r\n      ],\r\n      \"observation\": \"SymbolLeaseHeldError已有冲突原因与建议，steer hook缺失返回false；尚非跨错误码统一修复合同。\",\r\n      \"decision\": \"G01只覆盖新增错误的typed nextAction，原授权检查不可绕过。\"\r\n    },\r\n    {\r\n      \"id\": \"HG11\",\r\n      \"topic\": \"周窗口trace转eval\",\r\n      \"owner\": \"G03\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"promote\",\r\n        \"scenarioRegistry\"\r\n      ],\r\n      \"observation\": \"promoteScenario已有schema、重名与敏感数据拒绝；不是最近7天trace归因/去重入口。\",\r\n      \"decision\": \"G03在现有推广器前加显式批处理与oracle隔离，不复制场景注册表。\"\r\n    },\r\n    {\r\n      \"id\": \"HG12\",\r\n      \"topic\": \"运行中steering\",\r\n      \"owner\": \"L03\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"steer\",\r\n        \"steerQueue\",\r\n        \"loop\"\r\n      ],\r\n      \"observation\": \"已有子agent steer运行替换、completion租约和取消循环；不能等同于revision化operator steering。\",\r\n      \"decision\": \"L03复用现有控制消息和取消状态机，补乱序revision/权限竞争。\"\r\n    },\r\n    {\r\n      \"id\": \"HG13\",\r\n      \"topic\": \"持久化挂件/恢复检查点\",\r\n      \"owner\": \"L04\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"checkpoint\",\r\n        \"resumeShadow\",\r\n        \"ledger\"\r\n      ],\r\n      \"observation\": \"已有checkpoint serializer与持久resume shadow；挂件尚不能被解释为新插件/后台常驻。\",\r\n      \"decision\": \"L04仅将附件引用与既有checkpoint恢复链闭合。\"\r\n    },\r\n    {\r\n      \"id\": \"HG14\",\r\n      \"topic\": \"轨迹采样\",\r\n      \"owner\": \"O02\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"traceRecorder\",\r\n        \"traceMetrics\"\r\n      ],\r\n      \"observation\": \"已有trace/span与按优先级截断；截断不等于固定seed采样、必留错误和到期保留合同。\",\r\n      \"decision\": \"O02补确定性采样/丢弃计数，正文和凭据不进新证据。\"\r\n    },\r\n    {\r\n      \"id\": \"HG15\",\r\n      \"topic\": \"Provider内容Guard拒绝路径\",\r\n      \"owner\": \"S01\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"envelope\",\r\n        \"providerFetch\"\r\n      ],\r\n      \"observation\": \"buildStage1RequestEnvelope失败只记census诊断，guarded provider request继续；SSRF是独立网络边界。\"\r\n,\r\n      \"decision\": \"S01锁定一个可注入opt-in适配器，验证内容拒绝时provider命中0；不全局激活。\"\r\n    },\r\n    {\r\n      \"id\": \"HG16\",\r\n      \"topic\": \"敏感sink覆盖闭环\",\r\n      \"owner\": \"S02\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"existing-narrow\",\r\n      \"sourceRefs\": [\r\n        \"provenance\",\r\n        \"outbound\",\r\n        \"messageAction\",\r\n        \"secretRead\",\r\n        \"messageTool\",\r\n        \"externalWrite\",\r\n        \"browserPolicy\",\r\n        \"credentialPolicy\"\r\n      ],\r\n      \"observation\": \"总表仍classification-only不代表全部出口无拦截：message、secret、外写、browser、image override已有\r\n窄策略。\",\r\n      \"decision\": \"S02汇总现有command/message/secret正反回归，S03/S04/S05只补可达旁路。\"\r\n    },\r\n    {\r\n      \"id\": \"HG17\",\r\n      \"topic\": \"approvalPromptRate消费者\",\r\n      \"owner\": \"O01\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"counter\",\r\n        \"tier\",\r\n        \"tools\",\r\n        \"metricsCatalog\",\r\n        \"devApi\"\r\n      ],\r\n      \"observation\": \"rate分母为tier分类计数；零样本返回0。计数发生在tool.execute前，并不证明审批UI确实出现。限定调用链\r\n未找到生产rates消费者。\",\r\n      \"decision\": \"O01先明确分类事件/缺测语义，再接窗口告警与清除；不自动放宽审批。\"\r\n    },\r\n    {\r\n      \"id\": \"HG18\",\r\n      \"topic\": \"memory写入Effect边界\",\r\n      \"owner\": \"S06\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"memoryEdit\",\r\n        \"memoryStore\",\r\n        \"effect\"\r\n      ],\r\n      \"observation\": \"memory自编辑有实际store/persistence写入；EffectReceipt本身是追加幂等关联，不是写入authority。两者\r\n接通不能由类型存在推定。\",\r\n      \"decision\": \"S06复验实际写入口与receipt一致性，只扩展已有domain journal。\"\r\n    },\r\n    {\r\n      \"id\": \"HG19\",\r\n      \"topic\": \"verifier完成裁决权限\",\r\n      \"owner\": \"S07\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": [\r\n        \"verifier\",\r\n        \"verifierShadow\",\r\n        \"loop\"\r\n      ],\r\n      \"observation\": \"EvidenceVerifier可产completed判断，但code-task gate为would_allow/would_block shadow；不能直接授予\r\n终结authority。\",\r\n      \"decision\": \"S07仅受控隔离入口与候选digest绑定；无产品授权不打开生产完成裁决。\"\r\n    },\r\n    {\r\n      \"id\": \"HG20\",\r\n      \"topic\": \"正向放行锚点\",\r\n      \"owner\": \"E01\",\r\n      \"sourceStatus\": \"summary-reconstructed\",\r\n      \"originalText\": null,\r\n      \"assessment\": \"partial\",\r\n      \"sourceRefs\": 