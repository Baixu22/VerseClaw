t { mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';\r\nimport { tmpdir } from 'node:os';\r\nimport { join } from 'node:path';\r\n\r\nimport { afterEach, describe, expect, it } from 'vitest';\r\n\r\nimport {\r\n  validateTf0009AgentSurrogateCharter,\r\n  validateTf0009AgentSurrogateReport,\r\n  canCloseTf0009,\r\n  verifyTf0009ClosureEvidence,\r\n} from '../../scripts/lib/tf0009-agent-surrogate.mjs';\r\n\r\nconst root = process.cwd();\r\nconst tempRoots: string[] = [];\r\nafterEach(() => { for (const directory of tempRoots.splice(0)) rmSync(directory, { recursive: true, force: true }); });\r\n\r\nfunction readJson(relativePath: string) {\r\n  return JSON.parse(readFileSync(join(root, relativePath), 'utf8')) as Record<string, unknown>;\r\n}\r\n\r\ndescribe('TF-0009 agent-surrogate evidence tier', () => {\r\n  const charter = readJson('artifacts/first-product-preview/TF-0009/agent-surrogate-charter.json');\r\n  const report = readJson('artifacts/first-product-preview/TF-0009/agent-surrogate-report.json');\r\n\r\n  it('keeps the charter bounded below human/live/product authority', () => {\r\n    expect(validateTf0009AgentSurrogateCharter(charter)).toEqual({ ok: true, errors: [] });\r\n  });\r\n\r\n  it('records 10 agent runs per profile while human counts remain zero', () => {\r\n    expect(validateTf0009AgentSurrogateReport(report)).toEqual({ ok: true, errors: [] });\r\n  });\r\n\r\n  it('keeps historical v1 evidence valid without granting current closure authority', () => {\r\n    const historical = readJson('artifacts/first-product-preview/TF-0009/historical-20260729/agent-surrogate-report.json');\r\n    expect(validateTf0009AgentSurrogateReport(historical).ok).toBe(true);\r\n    expect(canCloseTf0009(historical)).toBe(false);\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_85","type":"reasoning","text":"Now I have a good understanding. Let me look at the o02-acceptance.json structure fully to model the e01-acceptance.json, and the harness-gap-approval-rate spec to model my task spec.\n\nLet me look at the approval-rate spec and also check the runtime-core typecheck scripts referenced.\n\nLet me now form the plan. The deliverable:\n\n1. `scripts/lib/reliability-aggregation.mjs` + `.d.mts` — pure deterministic aggregation library:\n   - inputs: fixture cases with k trials per case, trial outcome (pass/fail/incomplete reasons: missing/timeout/crash/skip), first-attempt outcome, retry outcome, anchor type (positive/negative).\n   - outputs: report with raw denominator, pass^k (all k pass), pass@k (at least one pass), flake (first trial fail then fixed rerun success), incomplete count, gate + reasons.\n   - Pre-registered k, minCases, flake threshold come from fixture.\n   - Safety must-test: 0 skip/0 flake.\n   - positive must all pass, negative must all reject → gate fail if violated.\n   - case count < design gate (k=3, >=20) → gate=insufficient-sample.\n2. `shared/agent-dev/reliability-fixture.json` — deterministic oracle fixture with k=3, >=20 cases, positives/negatives, first-trial failures with retry success, plus incomplete cases (missing/timeout/crash/skip).\n3. `tests/unit/agent-dev-reliability-aggregation.test.ts` — node-env unit tests asserting the library behavior against fixture.\n4. `harness/specs/tasks/harness-gap-reliability-aggregation.md` — task spec with frontmatter.\n5. `harness/specs/rules/reliability-aggregation-boundary.md` — rule spec.\n6. `docs/dev/harness-gap-closure/e01-reliability-aggregation.md` — doc.\n7. `docs/dev/harness-gap-closure/e01-acceptance.json` — acceptance record.\n8. `docs/dev/harness-gap-closure/E01-SHA256SUMS` — checksums.\n9. Wire into `scripts/agent-dev-benefit-eval.mjs` — reuse existing benefit report; add reliability section reading the fixture + lib, and output aggregated metrics.\n\nAlso need to add new files to `scripts/repository-artifacts.json` retainedFiles? The O02 spec touched it. Let me check whether new files need to be registered there. The test `repo:evidence:check` likely validates. But since I can't run those checks without deps, I should still keep consistency. Let me check what repository-artifacts check does.\n\nLet me look at the scripts that validate repository artifacts.\n\nActually, let me focus. The instruction: \"run relevant existing checks that do not install dependencies\". So pure-Node checks. Let me find which checks are pure-Node:\n- `node scripts/check-spec-lifecycle.mjs`\n- `node scripts/verify-evidence-sha256sums.mjs` (only for dirs with INTEGRITY.json — harness-gap-closure may not have INTEGRITY.json; let me check)\n- `node scripts/check-no-bom.mjs`\n- harness CLI `list` (works without git)\n- harness validate with --no-diff? It errored on diff base. Let me check if --no-diff avoids git.\n\nLet me check git.mjs to see if --no-diff skips.\n\nAlso `scripts/verify-evidence-sha256sums.mjs` walks `docs/dev/harness-gap-closure` for `SHA256SUMS` files that have a sibling `INTEGRITY.json`. For E01-SHA256SUMS, there's no INTEGRITY.json currently, but I could add the check for it. Actually the verification only checks manifests with INTEGRITY.json present. Hmm — O02-SHA256SUMS doesn't have INTEGRITY.json either? Let me check.\n\nLet me examine. Also check `scripts/check-no-bom.mjs`, `scripts/repo-evidence` etc.\n\nLet me look at git.mjs and the no-diff behavior."}}
