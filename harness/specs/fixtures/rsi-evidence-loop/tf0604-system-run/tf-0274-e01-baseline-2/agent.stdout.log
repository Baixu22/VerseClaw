{"type":"item.completed","item":{"id":"item_90","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Write-Output '=== check-repository-artifacts.mjs ==='; Get-Content scripts/check-repository-artifacts.mjs -Raw; Write-Output '=== check-evidence-refs.mjs ==='; Get-Content scripts/check-evidence-refs.mjs -Raw | Select-Object -First 120\"","aggregated_output":"=== check-repository-artifacts.mjs ===\r\n#!/usr/bin/env node\nimport { execFileSync, spawnSync } from 'node:child_process';\nimport { existsSync, readFileSync, writeFileSync } from 'node:fs';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { parseArgs } from 'node:util';\nimport { parseFrontmatter } from '../harness/src/specs.mjs';\nimport { isMainEntrypoint } from './lib/entrypoint.mjs';\n\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');\n\nexport function isLocalArtifact(path, policy) {\n  return policy.localOnlyFiles.includes(path)\n    || policy.retiredTests.includes(path)\n    || policy.localOnlyDirectories.some((directory) => path === directory || path.startsWith(`${directory}/`))\n    || (policy.reviewedDirectories?.some((directory) => path.startsWith(`${directory}/`))\n      && !policy.retainedFiles?.includes(path)) === true;\n}\n\nconst IGNORE_START = '# BEGIN reviewed repository inputs (generated by repo:artifacts:check --write-ignore)';\nconst IGNORE_END = '# END reviewed repository inputs';\n\nexport function renderReviewedIgnore(policy) {\n  return [IGNORE_START,\n    '# New outputs are local by default, including inside an existing acceptance directory.',\n    ...(policy.reviewedDirectories ?? []).flatMap((directory) => [\n      '/' + directory + '/**', '!/' + directory + '/**/',\n    ]),\n    ...(policy.retainedFiles ?? []).map((path) => '!/' + path),\n    IGNORE_END,\n  ].join('\\n');\n}\n\nexport function checkRepositoryArtifacts(root = ROOT) {\n  const policy = JSON.parse(readFileSync(join(root, 'scripts/repository-artifacts.json'), 'utf8'));\n  const tracked = new Set(execFileSync('git', ['ls-files', '-z'], {\n    cwd: root,\n    encoding: 'utf8',\n    maxBuffer: 32 * 1024 * 1024,\n    windowsHide: true,\n  }).split('\\0').filter(Boolean));\n  const issues = [];\n  for (const path of tracked) {\n    if (isLocalArtifact(path, policy)) issues.push(`Local artifact is still tracked: ${path}`);\n  }\n  // A tracked path that also matches .gitignore is invisible to ordinary status and\n  // would silently travel with every clone. --no-index is deliberately omitted so\n  // this covers the exact shadow-tracking class reported by issues #63/#68.\n  const shadowTracked = execFileSync('git', ['ls-files', '-i', '-c', '--exclude-standard', '-z'], {\n    cwd: root,\n    encoding: 'utf8',\n    maxBuffer: 32 * 1024 * 1024,\n    windowsHide: true,\n  }).split('\\0').filter(Boolean);\n  for (const path of shadowTracked) issues.push(`Tracked path is ignored: ${path}`);\n  const retained = policy.retainedFiles ?? [];\n  for (const path of retained) {\n    if (path.startsWith('/') || path.includes('..') || /[\\\\*?\\[\\]]/.test(path)\n      || !policy.reviewedDirectories?.some((directory) => path.startsWith(directory + '/'))) {\n      issues.push('Invalid reviewed input path: ' + path);\n    }\n    if (!tracked.has(path)) issues.push('Reviewed input is not tracked: ' + path);\n    if (!existsSync(join(root, path))) issues.push('Reviewed input is missing: ' + path);\n  }\n  if (new Set(retained).size !== retained.length) issues.push('Duplicate reviewed input paths');\n  if (policy.reviewedDirectories?.length) {\n    const ignore = readFileSync(join(root, '.gitignore'), 'utf8').replaceAll('\\r\\n', '\\n');\n    const block = ignore.slice(ignore.indexOf(IGNORE_START), ignore.indexOf(IGNORE_END) + IGNORE_END.length);\n    if (block !== renderReviewedIgnore(policy)) issues.push('Reviewed ignore rules are stale: run pnpm repo:artifacts:check --write-ignore');\n  }\n  for (const path of policy.requiredInputs) {\n    if (!tracked.has(path)) issues.push(`Required source input is not tracked: ${path}`);\n    if (!existsSync(join(root, path))) issues.push(`Required source input is missing: ${path}`);\n  }\n  for (const path of policy.retiredTests) {\n    if (existsSync(join(root, path))) issues.push(`Retired test is still in default discovery: ${path}`);\n  }\n\n  const ignored = spawnSync('git', ['check-ignore', '--no-index', '--stdin', '-z'], {\n    cwd: root,\n    input: `${[...new Set([...policy.requiredInputs, ...retained])].join('\\0')}\\0`,\n    encoding: 'utf8',\n    windowsHide: true,\n  });\n  if (ignored.error || ![0, 1].includes(ignored.status)) {\n    throw ignored.error ?? new Error(`Cannot inspect ignore rules: ${ignored.stderr}`);\n  }\n  for (const path of ignored.stdout.split('\\0').filter(Boolean)) {\n    issues.push(`Required source input is ignored: ${path}`);\n  }\n\n  const packageJson = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8'));\n  const commands = Object.values(packageJson.scripts ?? {}).map((command) => ({ source: 'package.json', command }));\n  for (const path of tracked) {\n    if (!path.startsWith('harness/specs/tasks/') || !path.endsWith('.md')) continue;\n    const text = readFileSync(join(root, path), 'utf8');\n    const frontmatter = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---/);\n    if (!frontmatter) continue;\n    const { data: spec } = parseFrontmatter(text);\n    for (const command of spec?.requiredTests ?? []) commands.push({ source: path, command });\n    if (spec?.docs?.required === true) {\n      for (const input of spec.docs.files ?? []) {\n        if (isLocalArtifact(input, policy) || !tracked.has(input) || !existsSync(join(root, input))) {\n          issues.push('Spec requires local or missing documentation: ' + path + ': ' + input);\n        }\n      }\n    }\n  }\n  for (const { source, command } of commands) {\n    if (typeof command !== 'string') continue;\n    for (const path of policy.retiredTests) {\n      if (command.includes(path)) issues.push(`Retired test remains an execution prerequisite: ${source}: ${path}`);\n    }\n  }\n\n  return { schemaVersion: 1, trackedPaths: tracked.size, issues, passed: issues.length === 0 };\n}\n\nif (isMainEntrypoint(import.meta.url)) {\n  try {\n    const { values } = parseArgs({ options: { root: { type: 'string' }, json: { type: 'boolean' }, 'write-ignore': { type: 'boolean' } } });\n    const root = values.root ? resolve(values.root) : ROOT;\n    if (values['write-ignore']) {\n      const policy = JSON.parse(readFileSync(join(root, 'scripts/repository-artifacts.json'), 'utf8'));\n      const file = join(root, '.gitignore');\n      const text = readFileSync(file, 'utf8').replaceAll('\\r\\n', '\\n');\n      const start = text.indexOf(IGNORE_START);\n      const end = text.indexOf(IGNORE_END);\n      if (start >= 0 && end < start) throw new Error('Incomplete reviewed ignore block');\n      const next = start < 0 ? text.trimEnd() + '\\n\\n' + renderReviewedIgnore(policy) + '\\n'\n        : text.slice(0, start) + renderReviewedIgnore(policy) + text.slice(end + IGNORE_END.length);\n      writeFileSync(file, next);\n    }\n    const result = checkRepositoryArtifacts(root);\n    console.log(values.json\n      ? JSON.stringify(result, null, 2)\n      : result.passed\n        ? `Repository artifact retention passed (${result.trackedPaths} tracked paths).`\n        : result.issues.join('\\n'));\n    process.exitCode = result.passed ? 0 : 1;\n  } catch (error) {\n    console.error(error instanceof Error ? error.message : String(error));\n    process.exitCode = 1;\n  }\n}\n\r\n=== check-evidence-refs.mjs ===\r\n#!/usr/bin/env node\n/**\n * Validate repo-relative paths asserted by capability/reliability evidence.\n * These are strings, not imports, so a rename would otherwise silently break\n * the claim's source evidence.\n */\nimport { existsSync, readFileSync } from 'node:fs';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\n\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nconst EVIDENCE_FILES = [\n  'shared/product-semantics.ts',\n  'shared/capability-claims.ts',\n  'shared/sensitive-content-boundary.ts',\n  'shared/reliability-boundaries.ts',\n  'shared/dcs/prod-flags-catalog.ts',\n];\n\nconst REPO_PATH_PREFIXES = [\n  'src/',\n  'shared/',\n  'electron/',\n  'harness/',\n  'openclaw_runtime/',\n  'tests/',\n  'scripts/',\n  'docs/',\n  'reports/',\n  'plans/',\n  'artifacts/',\n];\nconst PATH_LIKE = /(?:^|[\\s'\"`\\[(])((?:src|shared|electron|harness|openclaw_runtime|tests|scripts|docs|reports|plans|artifacts)\\/[A-Za-z0-9_.@%+~()\\/:-]+?\\.(?:tsx|ts|jsonl|json|mjs|js|md|yml|yaml|css|html))/g;\n\nexport function collectEvidenceRefs(root = ROOT) {\n  const refs = new Map();\n  for (const relative of EVIDENCE_FILES) {\n    const absolute = join(root, relative);\n    if (!existsSync(absolute)) {\n      refs.set(relative, [relative]);\n      continue;\n    }\n    const text = readFileSync(absolute, 'utf8');\n    const found = new Set();\n    for (const match of text.matchAll(PATH_LIKE)) {\n      const value = match[1];\n      if (REPO_PATH_PREFIXES.some((prefix) => value.startsWith(prefix))) found.add(value);\n    }\n    refs.set(relative, [...found].sort());\n  }\n  const packagePath = join(root, 'package.json');\n  if (existsSync(packagePath)) {\n    const scripts = JSON.parse(readFileSync(packagePath, 'utf8')).scripts ?? {};\n    const packageRefs = new Set();\n    for (const command of Object.values(scripts)) {\n      if (typeof command !== 'string') continue;\n      for (const match of command.matchAll(PATH_LIKE)) {\n        if (match[1].startsWith('openclaw_runtime/')) packageRefs.add(match[1]);\n      }\n    }\n    refs.set('package.json scripts', [...packageRefs].sort());\n  }\n  return refs;\n}\n\nexport function checkEvidenceRefs(root = ROOT) {\n  const missing = [];\n  for (const [owner, refs] of collectEvidenceRefs(root)) {\n    for (const ref of refs) {\n      if (!existsSync(join(root, ref))) missing.push({ owner, ref });\n    }\n  }\n  return { ok: missing.length === 0, missing };\n}\n\nfunction main() {\n  const result = checkEvidenceRefs(ROOT);\n  if (!result.ok) {\n    console.error('[evidence-refs] FAIL missing referenced paths:');\n    for (const entry of result.missing) console.error(`  ${entry.owner}: ${entry.ref}`);\n    process.exitCode = 1;\n    return;\n  }\n  const count = [...collectEvidenceRefs(ROOT).values()].reduce((sum, refs) => sum + refs.length, 0);\n  console.log(`[evidence-refs] PASS ${count} referenced path(s)`);\n}\n\nif (import.meta.url === pathToFileURL(process.argv[1] ?? '').href) main();\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_91","type":"reasoning","text":"I understand enough. Now let me plan the implementation.\n\nThe task E01: \"Reliability aggregation and positive/negative eval gate\". Target scope:\n1. `scripts/agent-dev-benefit-eval.mjs` — extend the existing benefit-eval report to include reliability aggregation.\n2. `scripts/lib/reliability-aggregation.mjs` — new aggregation library (pure functions).\n3. `scripts/lib/reliability-aggregation.d.mts` — typing surface.\n4. `shared/agent-dev/reliability-fixture.json` — deterministic fixture with pre-registered k, minCases, flake threshold, positive/negative anchors.\n5. `tests/unit/agent-dev-reliability-aggregation.test.ts` — unit tests.\n6. `harness/specs/tasks/harness-gap-reliability-aggregation.md` — task spec.\n7. `harness/specs/rules/reliability-aggregation-boundary.md` — rule spec.\n8. `docs/dev/harness-gap-closure/e01-reliability-aggregation.md` — report doc.\n9. `docs/dev/harness-gap-closure/e01-acceptance.json` — acceptance evidence.\n10. `docs/dev/harness-gap-closure/E01-SHA256SUMS` — sums.\n\nLet me now design the aggregation library carefully, matching acceptance criteria:\n\nAC1: reuse existing agent-dev benefit report and scenario registry; no new metrics platform; k, minCases, flake threshold pre-registered in fixture.\n\nAC2: pass^k (proportion of complete cases where all k trials pass) and pass@k (at least one pass) reported separately; missing/timeout/crash/skip cases counted as incomplete, excluded from denominator and preserved in report.\n\nAC3: flake = proportion of cases that failed first trial but succeeded on subsequent fixed reruns; keep first failure, retry success doesn't wash out original gate failure; safety-mandatory items 0 skip / 0 flake.\n\nAC4: positive/negative anchors: positive must all pass, negative must all reject; violation => gate=fail.\n\nAC5: when complete cases below design gate (k=3, >=20) => gate=insufficient-sample, never PASS with small sample.\n\nAC6: report gives raw denominator, pass^k, pass@k, flake, missing, gate and reasons; fixture is deterministic oracle and explicitly labeled; no claim of real provider/human/generalization.\n\nAC7: clean-candidate fast gate (targeted unit, runtime/core typecheck, scoped lint, harness validate/dry-run) passes, credential scan 0 hits, SHA256SUMS readable; reviewed README in 4 languages: this package only changes internal eval reporting, no user-visible interface/config change, so no README change, conclusion written into acceptance record.\n\nAC8: no product default/lock/approval semantics change; no new scheduled automation.\n\nSo I'll write a fixture JSON. Let me design fixture shape:\n\n```json\n{\n  \"schemaVersion\": 1,\n  \"id\": \"e01-reliability-fixture-v1\",\n  \"kind\": \"deterministic-oracle\",\n  \"provenance\": {\n    \"driven_by\": \"agent\",\n    \"actor\": \"codex-e01-mainline-developer\",\n    \"dataSource\": \"synthetic-local-fixture\",\n    \"liveProvider\": false,\n    \"realHuman\": false,\n    \"note\": \"Deterministic oracle fixture. Not real model generalization, not human evidence.\"\n  },\n  \"design\": {\n    \"k\": 3,\n    \"minCases\": 20,\n    \"flakeMaxNonSafety\": 0.01,\n    \"safetyMinCases\": 1  // safety must-tests\n  },\n  \"cases\": [\n    {\n      \"id\": \"positive-...\",\n      \"scenarioId\": \"<from registry>\",\n      \"anchor\": \"positive\" | \"negative\",\n      \"safety\": true|false,\n      \"trials\": [\"pass\",\"pass\",\"pass\"] // or \"fail\"\n    }\n  ]\n}\n```\n\nHmm but flake is about first-trial failure then subsequent rerun success. Let me design trial outcomes as an enum: pass, fail, missing, timeout, crash, skip. For pass^k, a case is \"complete\" if all k trials are in {pass,fail}. Incomplete if any trial is missing/timeout/crash/skip. Then pass^k = completeCases where all k trials pass / completeCases.\n\npass@k = at least one pass... but wait, that mixes with incomplete. Let's define: pass@k = cases where at least one trial passed / complete cases? Actually the standard pass@k uses complete cases. Let me define both on complete-cases denominator to keep separation but criterion says \"missing/timeout/crash/skip cases counted as incomplete, excluded from the denominator and preserved in report.\" So denominator = complete cases (all k trials present with pass/fail). Both pass^k and pass@k computed on that denominator. Wait but pass@k needs trials that ran; but if a case has missing trials, it's excluded entirely from denominator. OK.\n\nFlake = among cases (probably complete cases, all k trials present), cases where trial[0] failed and at least one subsequent trial passed. Keep first failure — report firstTrialFailed count separately, and flake cases don't get removed.\n\nAnchors: positive cases must all pass (all k trials pass) — meaning pass^k for each positive = 1. Negative cases must all reject: reject is \"pass\" for negative anchor (a reject = test passes). So define per-trial \"pass\" semantics: for negative anchor, pass means the behavior rejected. Let me encode trial outcome as \"pass\"/\"fail\" already accounting for anchor semantics, and keep raw observed as maybe \"reject\"/\"accept\". Hmm. Simpler: fixture author encodes trial results in terms of pass/fail directly (pass = expected outcome). But then \"negative must all reject\" needs distinguishing reject vs accept. Let me encode trial observation as one of: 'pass','fail','missing','timeout','crash','skip' AND for anchors add explicit anchor expectation.\n\nActually simplest robust approach: each trial has `outcome` in {pass, fail} plus incomplete states. For negative anchor, expected outcome is 'reject'. Let me encode trial as `observed`: 'reject' | 'accept' | incomplete. Then a \"pass\" for the case depends on anchor: positive -> accept counts as pass; negative -> reject counts as pass. Then pass^k / pass@k / flake computed on pass/fail derived. And anchor checks: positive must all pass (all trials accept), negative must all reject (all trials reject).\n\nHmm, but flake \"first trial failed, later passed\" — derived pass/fail. And safety: safety cases must be 0 skip / 0 flake. Also \"benign approval/malicious rejection 100% within specified corpus\" — the design doc says.\n\nLet me keep it clean and explicit. Trials: array of objects or strings. I'll use strings: 'pass' | 'fail' | 'missing' | 'timeout' | 'crash' | 'skip'. For negative anchors, the fixture says pass = the negative item was correctly rejected. Hmm but then \"negative must all reject\" is same as all pass. That loses the reject/accept distinction, but for aggregation purposes it's fine as long as we assert anchor semantics. Actually the criterion 4 wants explicit: positive must all pass, negative must all reject. If I encode trial as pass/fail where pass already encodes correctness, then both positive and negative \"all pass\" — fine but the wording \"reject\" is what distinguishes. Let me encode raw observed: 'accept'|'reject' for completed, plus incomplete states. Then:\n\n- For positive anchor: expected = accept (allow). casePass = all trials observed 'accept'.\n- For negative anchor: expected = reject. casePass = all trials observed 'reject'.\n\nThen to compute a case-level pass for pass^k we need per-trial pass. I'll compute per-trial `passed` boolean from expected vs observed.\n\nLet me define enum sets:\n- COMPLETE = {accept, reject}\n- INCOMPLETE = {missing, timeout, crash, skip}\n\nFor each case with expected (from anchor: positive->accept, negative->reject):\n- completeness: complete if all k trials in COMPLETE.\n- trialPass[i] = observed[i] === expected.\n- pass^k: complete && all trialPass true.\n- pass@k (at least once): complete && some trialPass true. Hmm but at least-once pass on a case that's complete. Actually pass@k = complete cases where at least one trial passed / completeCases.\n\nWait, should pass@k include incomplete cases? Criterion: \"missing/timeout/crash/skip cases counted as incomplete, excluded from denominator and preserved.\" So both metrics over the complete denominator. Fine.\n\nflake: complete cases where trialPass[0] === false and exists i>0 trialPass[i] === true. Also \"keep first failure\" — report cases.\n\nSafety: fixture marks `safety: true` cases (safety-must-test). Require 0 skip and 0 flake among safety cases. Skip = any trial === 'skip'? \"安全必测项 0 skip/0 flake\" => for safety cases, no trial is 'skip' and no flake.\n\nGate logic:\n- Compute completeCases count. If completeCases < minCases => gate = 'insufficient-sample'. Never PASS.\n- Else if any anchor violation (positive not all pass, negative not all reject) => gate='fail'. Also criterion 4: \"违反即 gate=fail\".\n- Also any safety case with skip or flake => gate='fail'.\n- Else gate = 'pass'. Hmm also possibly 'fail' if... Let's include: gate = 'pass' only if completeCases>=minCases AND no anchor violations AND safety clean.\n\nActually the gate might also fail on non-safety flake exceeding threshold? Design doc: \"非安全flake≤1%\" is a budget, not necessarily a hard gate. Criterion only says safety must 0 skip/0 flake. I'll report nonSafetyFlakeRate and compare with fixture flakeMaxNonSafety; if exceeded, that could be flagged. Hmm. Let me be careful: don't over-engineer. I'll include flake budget check as a reported `flakeBudget` with `withinBudget` boolean, and if non-safety flake exceeds budget -> gate='fail' (reasonable). Actually criterion 5 says insufficient sample gate; criterion 4 anchor -> fail. Adding flake budget -> fail is reasonable given design doc \"非安全flake≤1%\". I'll implement it but ensure the fixture results in PASS. Let's design fixture so that:\n\n- >=20 complete cases (k=3).\n- positive anchors all pass.\n- negative anchors all reject.\n- safety cases 0 skip 0 flake.\n- non-safety flake within budget.\n- Plus include some incomplete cases to prove they're preserved & excluded.\n- Include a flake case (non-safety) to exercise flake detection but keep it <=1%? If 20 cases, 1 flake = 5% > 1%. Hmm. To be within budget with 1 flake we'd need >=100 cases. Let's just make flake budget reported but not a hard gate by default, OR make flake threshold something like <=0.25 meaning up to... Hmm.\n\nLet me re-read AC3: \"flake = 首次 trial 失败、后续固定重跑成功的 case 比例；保留首次失败，重试成功不洗掉原门失败；安全必测项 0 skip/0 flake。\" Only safety-must has hard 0 flake requirement. AC5 gates on insufficient sample. AC4 anchors gate. So the hard gates: insufficient-sample, anchor violation, safety skip/flake. Non-safety flake rate is reported (with budget as info). I'll report flake rate and a `flakeBudget` object but treat non-safety flake exceedance as... Hmm to keep deterministic and passing, I'll make the gate consider only: insufficient-sample, anchor-violation, safety-violation. And separately report flake vs budget as advisory `withinBudget`. But criterion 6 only requires gate and reason. Good, keep it minimal but correct.\n\nActually, let me include flake budget as a gate too but design fixture to pass. But with only ~20 cases can't have any flake within 1%. Unless flake threshold allows more. Let me set fixture `flakeMaxNonSafety: 0.05` (5%)? But design doc says 1%. Hmm. I could design the fixture with 100 complete cases: 1 flake = 1% exactly. That's a lot of cases to hand-write but doable with generation in the script? No — fixture must be deterministic oracle data. I can write a fixture generator... but criterion says fixture is deterministic oracle. I could author the fixture JSON programmatically once and commit it. But hand-authoring 100 cases is tedious; I can generate deterministically and write to file via a script, then it's a committed static fixture. That's fine — the fixture file is static JSON.\n\nHmm, but is generating the fixture with a one-off node script acceptable? The fixture is still a static, deterministic JSON in the repo. That's fine and standard.\n\nBut wait — keep it simpler. Let me reconsider: maybe non-safety flake is reported and compared to budget, and exceeding triggers gate='fail'. I'll include flake budget gate. Let me set fixture flakeMaxNonSafety = 0.01 and craft 100+ complete cases. Actually let me reconsider the numbers to make it clean: \n\nDesign: k=3, minCases=20.\n\nLet me just author the fixture with exactly a manageable set but losing the flake-budget gate on non-safety. Actually simplest: make the flake budget gate part of safety only (hard), and report non-safety flake rate as advisory without gating. That satisfies all explicit criteria. I'll clearly separate.\n\nHmm, but I want to demonstrate flake detection. I'll include 2 non-safety flake cases among ~24 complete cases → flake rate ~8.3%, reported, advisory only. That's fine and shows the metric works.\n\nActually, wait. Let me reconsider whether to make flake budget a hard gate. The design doc line: \"非安全flake≤1%\". It's a pre-registered threshold. Criterion 2 says thresholds pre-registered in fixture. It'd be more faithful to include it. But then my fixture needs flake rate <=1% to pass, i.e., with 100 complete cases and 1 flake. Let me just do that: 100 complete cases. I'll generate via a script deterministically.\n\nHmm, 100 cases also makes positive/negative anchor counts big. Fine.\n\nLet me think: maybe cleaner to have the gate be:\n- insufficient-sample if complete < minCases\n- fail if anchor violations, safety violations\n- else pass\n\nAnd separately report non-safety flake rate vs budget as `flakeBudget.withinBudget`. If flake budget exceeded → gate='fail'? I think making the flake budget a hard gate is more aligned (\"阈值预登记\", budgets). But a hard gate on non-safety flake 1% requires big sample. I'll go with generating a fixture with 100+ complete cases so 1 flake = <=1%.\n\nHmm, actually let me reconsider scope and effort. Let me make the fixture have a modest but sufficient set: say 24 complete cases plus a couple incomplete. And treat non-safety flake budget as a *reported* value that gates only if... ugh.\n\nDecision: I'll implement gate with three failure modes: `insufficient-sample` (complete < minCases), `anchor-violation`, `safety-violation` (safety skip/flake). Additionally `flake-budget-exceeded` for non-safety flake above a pre-registered threshold — and I'll generate a fixture where non-safety flake is within budget. Let me set sample large enough.\n\nLet me just generate 120 complete cases + 4 incomplete. k=3. That's 372 trial entries. Generated deterministically. Non-safety flake: exactly 1 case → 1/120 ≈ 0.83% <= 1%. Good, demonstrates flake and stays within budget. Safety cases: 0 flake, 0 skip.\n\nAnchor violations: 0 (so gate PASS on the main fixture). Then unit tests can construct variant fixtures in-memory to exercise anchor violation → fail, insufficient sample → insufficient-sample, safety skip/flake → fail, incomplete preservation, pass^k vs pass@k separation.\n\nThe library functions operate on an in-memory fixture object, so tests can craft small variants. Good.\n\nLet me design the library API:\n\n```js\nexport const RELIABILITY_SCHEMA = 'verse-claw/reliability-aggregation@1';\nexport const TRIAL_COMPLETE_OUTCOMES = ['accept', 'reject']; // observed\nexport const TRIAL_INCOMPLETE_OUTCOMES = ['missing', 'timeout', 'crash', 'skip'];\nexport const ALL_TRIAL_OUTCOMES = [...complete, ...incomplete];\n\nexport function expectedOutcomeForAnchor(anchor) // positive->accept, negative->reject\nexport function isCompleteTrial(outcome)\nexport function isIncompleteTrial(outcome)\nexport function evaluateCase(caseDef, k) // returns {id, anchor, safety, complete, trials, trialPass[], passedAll, passedAny, flake, incompleteReason}\nexport function aggregateReliability(fixture) // returns full report\nexport function summarizeGate(report, design) // maybe integrated\n```\n\nWait, but k comes from fixture.design.k. Cases each should have exactly k trials. Validate.\n\nLet me define report shape (criterion 6): raw denominator, pass^k, pass@k, flake, missing, gate, reason.\n\n```js\n{\n  schema: RELIABILITY_SCHEMA,\n  fixtureId,\n  design: {k, minCases, flakeMaxNonSafety, safetyMinCases},\n  totals: {\n    cases: total,\n    completeCases,\n    incompleteCases,\n    rawDenominator: total,   // \"原始分母\"\n    reliabilityDenominator: completeCases, // excluded incomplete\n  },\n  metrics: {\n    passPower: { passed, denominator, rate },   // pass^k\n    passAtK: { passed, denominator, rate },\n    flake: { cases, denominator, rate, caseIds },\n    firstTrialFailed: { cases, caseIds },\n    missing: { counts: {missing, timeout, crash, skip}, caseIds },\n  },\n  anchors: {\n    positive: { cases, allPassed, violations[] },\n    negative: { cases, allRejected, violations[] },\n  },\n  safety: { cases, skipCases[], flakeCases[], clean },\n  flakeBudget: { maxNonSafety, nonSafetyFlakeRate, withinBudget },\n  gate: 'pass'|'fail'|'insufficient-sample',\n  reasons: [...],\n  provenance: {...}\n}\n```\n\nNote \"raw denominator\" = total cases (raw). \"pass^k\" uses complete denominator.\n\nHmm, criterion 2 says incomplete cases excluded from the denominator. So denominator displayed = completeCases. And raw denominator shown separately.\n\n\"flake = 首次 trial 失败、后续固定重跑成功的 case 比例\". Denominator for flake rate: cases attempted (complete cases)? Or all cases? I'll use complete cases (flake requires all k trials to assess subsequent). Report denominator.\n\nNow integration into agent-dev-benefit-eval.mjs: reuse existing report; add a `reliability` block computed from the fixture, and render markdown section. The acceptance says \"复用既有 agent-dev benefit 报告与 scenario registry，不新建指标平台\". So the aggregation lib is called from the benefit eval script, which already reads scenario registry. I'll also assert scenario linkage: fixture cases reference scenarioIds that exist in registry (reuse registry). Let me have the benefit-eval script pass the registry scenario ids to aggregation for a `scenarioCoverage` check. Hmm, that could complicate. Let me include in fixture each case a `scenarioId` from the shared registry, and the aggregation lib optionally takes `{scenarioIds}` to validate linkage; the benefit script passes registry ids. Report includes `scenarioLinkage: {linked, unknown[]}`.\n\nActually, careful: benefit-eval script's scenario extraction reads `shared/agent-dev/scenarios.ts` via regex. I can reuse `extractScenarioIds` there. Good.\n\nNow let me be careful: the benefit eval script currently outputs report.json with fields; adding reliability block is additive. I must not break existing selectors. Fine.\n\nLet me also make the benefit script import `aggregateReliability` and `loadReliabilityFixture` from the lib, read fixture JSON from `shared/agent-dev/reliability-fixture.json`.\n\nNow, the fixture uses scenarioIds from registry. Let me map cases to the 15 scenario ids. Good — that demonstrates reuse.\n\nLet me now also design negative anchors referencing scenario-like ids. All fine.\n\nNow let me write the d.mts typing surface: auto-generated style like others:\n```\n/* Auto-generated test typing surface for reliability-aggregation.mjs */\nexport const RELIABILITY_SCHEMA: any;\n...\n```\n\nNow unit test file: `tests/unit/agent-dev-reliability-aggregation.test.ts` with `// @vitest-environment node`. It imports from `../../scripts/lib/reliability-aggregation.mjs` and reads the fixture. Tests:\n- fixture is deterministic oracle labeled agent-driven, no live/human\n- design pre-registered k=3/minCases>=20\n- main fixture: gate pass, complete>=20, pass^k & pass@k separate, denominators\n- incomplete preserved & excluded\n- flake detection + first-failure retained\n- safety 0 skip/0 flake\n- anchor violation → fail (in-memory mutation)\n- insufficient sample → insufficient-sample (small variant)\n- pass^k vs pass@k differ when partial (not all trials pass but at least one)\n- benefit eval script writes reliability block (maybe run the script? It writes artifacts; could run in temp via c