{"type":"item.completed","item":{"id":"item_150","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\system32\\\\bash.exe\" -lc \"sed -n '1,120p' src/lib/error-message.ts; echo '--- user-error excerpt ---'; sed -n '1,70p' src/lib/user-error.ts\"","aggregated_output":"import i18n from '@/i18n';\nimport { sanitizeUiErrorText } from '@shared/privacy/ui-error-sanitize';\nimport {\n  AppError,\n  getErrorRecovery,\n  normalizeAppError,\n  type AppErrorCode,\n} from './error-model';\n\nexport { AppError } from './error-model';\n\n/**\n * Recovery affordance offered next to the message.\n *\n * `retry_now` is deliberately rare: a timeout may already have produced an\n * upstream side effect (`verify_then_retry`), a rate limit or overloaded\n * provider needs waiting first (`wait_then_retry`), and refusal/balance classes\n * never recover by retrying at all — they need an account or credential change.\n */\nexport type ErrorActionKind =\n  | 'retry_now'\n  | 'wait_then_retry'\n  | 'verify_then_retry'\n  | 'fix_credentials'\n  | 'top_up_balance'\n  | 'choose_another_model'\n  | 'start_new_session'\n  | 'review_settings'\n  | 'restart_service'\n  | 'none';\n\nexport type AppErrorCopy = {\n  /** `common` namespace key for \"what happened\". */\n  messageKey: string;\n  /** `common` namespace key for \"whose problem\". */\n  responsibilityKey: string;\n  /** `common` namespace key for \"what to do next\". */\n  nextStepKey: string;\n  action: ErrorActionKind;\n  /** Derived from the canonical recovery table; kept for existing consumers. */\n  retryable: boolean;\n};\n\n/**\n * Stable key scheme for every class: `common:errors.<slug>.{what,responsibility,nextStep}`.\n * Slugs are the lower-case class name; all four locales must carry all three keys.\n */\nfunction errorCopyKeys(slug: string): Pick<AppErrorCopy, 'messageKey' | 'responsibilityKey' | 'nextStepKey'> {\n  return {\n    messageKey: `common:errors.${slug}.what`,\n    responsibilityKey: `common:errors.${slug}.responsibility`,\n    nextStepKey: `common:errors.${slug}.nextStep`,\n  };\n}\n\nconst ERROR_COPY: Record<AppErrorCode, Omit<AppErrorCopy, 'retryable'>> = {\n  AUTH_INVALID: { ...errorCopyKeys('auth_invalid'), action: 'fix_credentials' },\n  AUTH_PERMANENT: { ...errorCopyKeys('auth_permanent'), action: 'fix_credentials' },\n  TIMEOUT: { ...errorCopyKeys('timeout'), action: 'verify_then_retry' },\n  RATE_LIMIT: { ...errorCopyKeys('rate_limit'), action: 'wait_then_retry' },\n  PERMISSION: { ...errorCopyKeys('permission'), action: 'review_settings' },\n  CHANNEL_UNAVAILABLE: { ...errorCopyKeys('channel_unavailable'), action: 'restart_service' },\n  CONVERSATION_STATE: { ...errorCopyKeys('conversation_state'), action: 'start_new_session' },\n  NETWORK: { ...errorCopyKeys('network'), action: 'retry_now' },\n  CONFIG: { ...errorCopyKeys('config'), action: 'review_settings' },\n  GATEWAY: { ...errorCopyKeys('gateway'), action: 'restart_service' },\n  BILLING: { ...errorCopyKeys('billing'), action: 'top_up_balance' },\n  OVERLOADED: { ...errorCopyKeys('overloaded'), action: 'wait_then_retry' },\n  MODEL_NOT_FOUND: { ...errorCopyKeys('model_not_found'), action: 'choose_another_model' },\n  UNKNOWN: { ...errorCopyKeys('unknown'), action: 'none' },\n};\n\nexport function getErrorCopy(code: AppErrorCode): AppErrorCopy {\n  return { ...ERROR_COPY[code], retryable: getErrorRecovery(code).retryable };\n}\n\n/**\n * Retryability is owned by the recovery table, not duplicated here. The copy\n * layer only chooses the affordance that matches that contract.\n */\nexport function isErrorRetryable(code: AppErrorCode): boolean {\n  return getErrorRecovery(code).retryable;\n}\n\n/**\n * Localized \"what happened\" line. Resolved through the existing renderer\n * i18next instance so it follows the active language (issue #120).\n */\nexport function toUserMessage(error: unknown): string {\n  const appError = error instanceof AppError ? error : normalizeAppError(error);\n\n  if (appError.code !== 'UNKNOWN') {\n    return i18n.t(getErrorCopy(appError.code).messageKey);\n  }\n\n  // R2: the UNKNOWN branch must stay inside the sanitize boundary —\n  // raw backend messages may carry paths, stack frames or secret shapes.\n  const redacted = appError.message ? sanitizeUiErrorText(appError.message) : '';\n  return redacted || i18n.t(getErrorCopy('UNKNOWN').messageKey);\n}\n--- user-error excerpt ---\n/**\n * R2: unified renderer error exit.\n *\n * Three-layer separation (maturity report §错误反馈与隐私):\n *  1. user copy   — localized \"what happened / whose problem / what next\",\n *                   never stack frames or secret shapes;\n *  2. errorId     — short reference the user can copy into a report;\n *  3. dev log     — the raw AppError goes to the console keyed by errorId.\n *\n * All copy comes from the shared `common` i18n catalogue; nothing here is a\n * hardcoded display string (issue #120).\n */\nimport { toast } from 'sonner';\nimport i18n from '@/i18n';\nimport { normalizeAppError, type AppErrorCode } from './error-model';\nimport { getErrorCopy, isErrorRetryable, toUserMessage, type ErrorActionKind } from './error-message';\nimport { sanitizeUiErrorText } from '@shared/privacy/ui-error-sanitize';\n\nlet errorIdSeq = 0;\n\nexport function makeErrorId(): string {\n  errorIdSeq += 1;\n  return `err-${Date.now().toString(36)}-${errorIdSeq.toString(36)}-${Math.random().toString(36).slice(2, 6)}`;\n}\n\nexport type UserErrorDetails = {\n  /** Safe, localized user-facing message (\"what happened\"). */\n  message: string;\n  /** Copyable reference for reports; keys the raw error in the dev console. */\n  errorId: string;\n  code: AppErrorCode;\n  /** True when retrying the same action is meaningful with no other change. */\n  retryable: boolean;\n  /** Which recovery affordance the UI should offer for this class. */\n  action: ErrorActionKind;\n  /** i18n keys, so callers and tests can assert without pinning prose. */\n  messageKey: string;\n  /** Localized \"whose problem\". */\n  responsibility: string;\n  responsibilityKey: string;\n  /** Localized \"what to do next\". */\n  nextStep: string;\n  nextStepKey: string;\n};\n\nexport function describeUserError(error: unknown, options: { log?: boolean } = {}): UserErrorDetails {\n  const appError = normalizeAppError(error);\n  const copy = getErrorCopy(appError.code);\n  const message = sanitizeUiErrorText(toUserMessage(appError));\n  const errorId = appError.requestId ?? makeErrorId();\n  if (options.log !== false) {\n    // Dev log keeps the full classified error; the UI only ever sees message + id.\n    console.error(`[user-error ${errorId}]`, appError);\n  }\n  return {\n    message,\n    errorId,\n    code: appError.code,\n    retryable: isErrorRetryable(appError.code),\n    action: copy.action,\n    messageKey: copy.messageKey,\n    responsibility: i18n.t(copy.responsibilityKey),\n    responsibilityKey: copy.responsibilityKey,\n    nextStep: i18n.t(copy.nextStepKey),\n    nextStepKey: copy.nextStepKey,\n  };\n}\n\n/** One-liner safe message for i18n interpolation sites. */\nexport function errorMessageFrom(error: unknown): string {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_151","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\system32\\\\bash.exe\" -lc \"sed -n '1,130p' tests/unit/error-recovery-next-action.test.ts\"","aggregated_output":"import { describe, expect, it } from 'vitest';\n\nimport {\n  APP_ERROR_CODES,\n  AppError,\n  ERROR_NEXT_ACTION_KINDS,\n  ERROR_RECOVERY,\n  getErrorRecovery,\n  normalizeAppError,\n  type AppErrorCode,\n} from '@/lib/error-model';\nimport { getErrorCopy } from '@/lib/error-message';\n\nconst SELF_RETRY_CODES: AppErrorCode[] = [\n  'TIMEOUT',\n  'RATE_LIMIT',\n  'CHANNEL_UNAVAILABLE',\n  'NETWORK',\n  'GATEWAY',\n  'OVERLOADED',\n];\n\nconst FORBIDDEN_ACTION_KEYS = [\n  'command',\n  'script',\n  'shell',\n  'exec',\n  'argv',\n  'cmd',\n  'run',\n  'path',\n  'url',\n  'env',\n];\n\ndescribe('error recovery nextAction contract', () => {\n  it('has exactly one stable recovery row for every AppErrorCode', () => {\n    expect(Object.keys(ERROR_RECOVERY).sort()).toEqual([...APP_ERROR_CODES].sort());\n    for (const code of APP_ERROR_CODES) {\n      const recovery = getErrorRecovery(code);\n      expect(recovery, code).toBeDefined();\n      expect(['self-retry', 'user-action-required'], code).toContain(recovery.scope);\n      expect(typeof recovery.retryable, code).toBe('boolean');\n    }\n  });\n\n  it('makes only self-retry classes retryable with exactly { kind: retry }', () => {\n    for (const code of APP_ERROR_CODES) {\n      const recovery = getErrorRecovery(code);\n      if (recovery.scope === 'self-retry') {\n        expect(SELF_RETRY_CODES, code).toContain(code);\n        expect(recovery.retryable, code).toBe(true);\n        expect(recovery.action, code).toEqual({ kind: 'retry' });\n      } else {\n        expect(SELF_RETRY_CODES, code).not.toContain(code);\n        expect(recovery.retryable, code).toBe(false);\n        expect(recovery.action?.kind, code).not.toBe('retry');\n      }\n    }\n  });\n\n  it(\"gives every non-retryable class an explicit non-retry user action\", () => {\n    for (const code of APP_ERROR_CODES) {\n      const recovery = getErrorRecovery(code);\n      if (recovery.retryable) continue;\n      expect(recovery.scope, code).toBe(\"user-action-required\");\n      if (code !== \"UNKNOWN\") {\n        expect(recovery.action, code).toBeDefined();\n        expect(recovery.action?.kind, code).not.toBe(\"retry\");\n      }\n    }\n  });\n\n  it('covers every self-retry class and no other class', () => {\n    const retryable = APP_ERROR_CODES.filter((code) => getErrorRecovery(code).retryable);\n    expect(retryable.sort()).toEqual([...SELF_RETRY_CODES].sort());\n  });\n\n  it('allows only the fixed verb set and bounded kind/target keys', () => {\n    for (const code of APP_ERROR_CODES) {\n      const action = getErrorRecovery(code).action;\n      if (!action) continue;\n      expect(ERROR_NEXT_ACTION_KINDS, code).toContain(action.kind);\n      expect(Object.keys(action).sort(), code).toEqual(\n        action.target === undefined ? ['kind'] : ['kind', 'target'],\n      );\n      expect(typeof action.kind, code).toBe('string');\n      if (action.target !== undefined) {\n        expect(typeof action.target, code).toBe('string');\n        expect(action.target.length, code).toBeGreaterThan(0);\n        expect(action.target.length, code).toBeLessThanOrEqual(80);\n      }\n    }\n  });\n\n  it('never carries executable fields or shell-shaped values', () => {\n    for (const code of APP_ERROR_CODES) {\n      const action = getErrorRecovery(code).action;\n      if (!action) continue;\n      for (const key of Object.keys(action)) {\n        expect(FORBIDDEN_ACTION_KEYS, code + '.' + key).not.toContain(key.toLowerCase());\n      }\n      const serialized = JSON.stringify(action).toLowerCase();\n      for (const token of ['command', 'script', 'shell', 'exec', 'argv', 'bash', 'powershell', 'spawn', ';', '&', '|', '$', '<', '>']) {\n        expect(serialized, code + ':' + token).not.toContain(token);\n      }\n    }\n  });\n\n  it('exposes retryable and nextAction on every AppError instance', () => {\n    for (const code of APP_ERROR_CODES) {\n      const error = new AppError(code, 'boom');\n      const recovery = getErrorRecovery(code);\n      expect(error.retryable, code).toBe(recovery.retryable);\n      expect(error.nextAction, code).toEqual(recovery.action);\n    }\n  });\n\n  it('keeps UNKNOWN without an action so callers expose the original error', () => {\n    expect(getErrorRecovery('UNKNOWN')).toEqual({\n      retryable: false,\n      scope: 'user-action-required',\n    });\n    const error = new AppError('UNKNOWN', 'raw backend detail');\n    expect(error.nextAction).toBeUndefined();\n    expect(error.retryable).toBe(false);\n  });\n\n  it('preserves the recovery contract through normalization', () => {\n    const normalized = normalizeAppError(Object.assign(new Error('timed out'), { code: 'TIMEOUT' }));\n","exit_code":0,"status":"completed"}}
