{"type":"item.started","item":{"id":"item_320","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"node -e \\\"\nconst fs=require('fs');\nconst p='docs/dev/harness-gap-closure/e02-acceptance.json';\nconst t=fs.readFileSync(p,'utf8').replace(/\\\\r\\\\n/g,'\\\\n');\nfs.writeFileSync(p,t);\nconst a=JSON.parse(t);\nconst r=require('./artifacts/paired-ablation/report.json');\nconst ok = a.observed.treatment.successRate===r.conditions.treatment.successRate\n  && a.observed.baseline.successRate===r.conditions.baseline.successRate\n  && a.observed.effect.meanPairedDifference===r.effect.meanDifference\n  && a.observed.effect.ci95.lower===r.effect.ci95.lower\n  && a.observed.effect.ci95.upper===r.effect.ci95.upper\n  && a.observed.treatment.misblocks===r.conditions.treatment.misblocks\n  && a.observed.baseline.misblocks===r.conditions.baseline.misblocks\n  && a.observed.treatment.safetyViolations===r.conditions.treatment.safetyViolations\n  && a.observed.baseline.safetyViolations===r.conditions.baseline.safetyViolations\n  && a.observed.treatment.tokensProxyMean===r.conditions.treatment.tokensProxy.mean\n  && a.observed.baseline.tokensProxyMean===r.conditions.baseline.tokensProxy.mean\n  && a.decision.verdict===r.decision.verdict\n  && a.activation.differingCaseCount===r.activation.differingCaseCount;\nconsole.log('acceptance JSON matches the run report:', ok);\nconst ratio = (r.conditions.treatment.tokensProxy.mean/r.conditions.baseline.tokensProxy.mean).toFixed(3);\nconsole.log('tokens ratio', ratio, '| misblock delta', r.conditions.treatment.misblocks-r.conditions.baseline.misblocks, '| passK delta', (r.conditions.treatment.passK-r.conditions.baseline.passK).toFixed(3));\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
