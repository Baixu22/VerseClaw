{"type":"item.completed","item":{"id":"item_94","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Get-Content harness/src/specs.mjs -TotalCount 160; Write-Output \"--- cli ---\"; Get-Content harness/src/cli.mjs -TotalCount 80'","aggregated_output":"import { readFile, readdir } from 'node:fs/promises';\r\nimport path from 'node:path';\r\nimport { fileURLToPath } from 'node:url';\r\n\r\nexport const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..');\r\nexport const SPEC_ROOT = path.join(ROOT, 'harness', 'specs');\r\n\r\nfunction parseScalar(value) {\r\n  const trimmed = value.trim();\r\n  if (trimmed === 'true') return true;\r\n  if (trimmed === 'false') return false;\r\n  if (trimmed === 'null') return null;\r\n  if ((trimmed.startsWith('\"') && trimmed.endsWith('\"')) || (trimmed.startsWith(\"'\") && trimmed.endsWith(\"'\"))) {\r\n    return trimmed.slice(1, -1);\r\n  }\r\n  return trimmed;\r\n}\r\n\r\nexport function parseFrontmatter(markdown) {\r\n  const match = markdown.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\r\n  if (!match) {\r\n    throw new Error('Spec must start with Markdown frontmatter');\r\n  }\r\n\r\n  const data = {};\r\n  let currentKey = null;\r\n  let nestedKey = null;\r\n\r\n  for (const rawLine of match[1].split('\\n')) {\r\n    if (!rawLine.trim() || rawLine.trimStart().startsWith('#')) continue;\r\n    const indent = rawLine.match(/^ */)?.[0].length ?? 0;\r\n    const line = rawLine.trim();\r\n\r\n    if (indent === 0) {\r\n      const keyMatch = line.match(/^([A-Za-z0-9_-]+):(.*)$/);\r\n      if (!keyMatch) continue;\r\n      const [, key, rawValue] = keyMatch;\r\n      currentKey = key;\r\n      nestedKey = null;\r\n      data[key] = rawValue.trim() ? parseScalar(rawValue) : [];\r\n      continue;\r\n    }\r\n\r\n    if (indent === 2 && line.startsWith('- ')) {\r\n      if (!currentKey) continue;\r\n      if (!Array.isArray(data[currentKey])) data[currentKey] = [];\r\n      data[currentKey].push(parseScalar(line.slice(2)));\r\n      continue;\r\n    }\r\n\r\n    if (indent === 2) {\r\n      const keyMatch = line.match(/^([A-Za-z0-9_-]+):(.*)$/);\r\n      if (!keyMatch || !currentKey) continue;\r\n      const [, key, rawValue] = keyMatch;\r\n      if (!data[currentKey] || Array.isArray(data[currentKey])) data[currentKey] = {};\r\n      nestedKey = key;\r\n      data[currentKey][key] = rawValue.trim() ? parseScalar(rawValue) : [];\r\n      continue;\r\n    }\r\n\r\n    if (indent === 4 && line.startsWith('- ') && currentKey && nestedKey) {\r\n      if (!data[currentKey] || Array.isArray(data[currentKey])) data[currentKey] = {};\r\n      if (!Array.isArray(data[currentKey][nestedKey])) data[currentKey][nestedKey] = [];\r\n      data[currentKey][nestedKey].push(parseScalar(line.slice(2)));\r\n    }\r\n  }\r\n\r\n  return {\r\n    data,\r\n    body: markdown.slice(match[0].length).trim(),\r\n  };\r\n}\r\n\r\nexport async function loadSpec(specPath) {\r\n  const fullPath = path.resolve(ROOT, specPath);\r\n  const markdown = await readFile(fullPath, 'utf8');\r\n  return {\r\n    path: path.relative(ROOT, fullPath),\r\n    ...parseFrontmatter(markdown),\r\n  };\r\n}\r\n\r\nasync function listMarkdownFiles(dir) {\r\n  try {\r\n    const entries = await readdir(dir, { withFileTypes: true });\r\n    return entries\r\n      .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\r\n      .map((entry) => path.join(dir, entry.name))\r\n      .sort();\r\n  } catch {\r\n    return [];\r\n  }\r\n}\r\n\r\nasync function listMarkdownFilesRecursive(dir) {\r\n  try {\r\n    const entries = (await readdir(dir, { withFileTypes: true }))\r\n      .sort((a, b) => a.name.localeCompare(b.name));\r\n    const files = [];\r\n    for (const entry of entries) {\r\n      const fullPath = path.join(dir, entry.name);\r\n      if (entry.isDirectory()) {\r\n        files.push(...await listMarkdownFilesRecursive(fullPath));\r\n      } else if (entry.isFile() && entry.name.endsWith('.md')) {\r\n        files.push(fullPath);\r\n      }\r\n    }\r\n    return files.sort();\r\n  } catch {\r\n    return [];\r\n  }\r\n}\r\n\r\nexport async function loadScenarioSpecs() {\r\n  const files = await listMarkdownFiles(path.join(SPEC_ROOT, 'scenarios'));\r\n  const specs = [];\r\n  for (const file of files) {\r\n    const spec = await loadSpec(path.relative(ROOT, file));\r\n    specs.push(spec);\r\n  }\r\n  return specs;\r\n}\r\n\r\nexport async function loadRuleSpecs() {\r\n  const files = await listMarkdownFiles(path.join(SPEC_ROOT, 'rules'));\r\n  const specs = [];\r\n  for (const file of files) {\r\n    const spec = await loadSpec(path.relative(ROOT, file));\r\n    specs.push(spec);\r\n  }\r\n  return specs;\r\n}\r\n\r\nexport async function loadGuideSpecs() {\r\n  const files = await listMarkdownFilesRecursive(path.join(SPEC_ROOT, 'guides'));\r\n  const specs = [];\r\n  for (const file of files) {\r\n    const spec = await loadSpec(path.relative(ROOT, file));\r\n    specs.push(spec);\r\n  }\r\n  return specs;\r\n}\r\n\r\nexport async function loadLayerSpecs() {\r\n  const files = await listMarkdownFilesRecursive(path.join(SPEC_ROOT, 'layers'));\r\n  const specs = [];\r\n  for (const file of files) {\r\n    const spec = await loadSpec(path.relative(ROOT, file));\r\n    specs.push(spec);\r\n  }\r\n  return specs;\r\n}\r\n\r\nexport function toArray(value) {\r\n  if (Array.isArray(value)) return value;\r\n  if (value == null || value === '') return [];\r\n  return [value];\r\n}\r\n\r\n// Task identity comes from the spec's location, not from a `scenario:` key.\r\n--- cli ---\r\n#!/usr/bin/env node\r\nimport process from 'node:process';\r\nimport { buildContext, formatContext } from './context.mjs';\r\nimport { getChangedFiles, resolveDefaultDiffBase, resolveDiffBase } from './git.mjs';\r\nimport { PROFILES, selectSteps } from './profiles.mjs';\r\nimport { writeReport } from './report.mjs';\r\nimport { runStep } from './runner.mjs';\r\nimport {\r\n  isGatewayBackendCommunicationTask,\r\n  isPluginLifecycleTask,\r\n  loadGuideSpecs,\r\n  loadLayerSpecs,\r\n  loadRuleSpecs,\r\n  loadScenarioSpecs,\r\n  loadSpec,\r\n  toArray,\r\n} from './specs.mjs';\r\nimport {\r\n  scanBackendCommunicationBoundary,\r\n  touchesCommunicationPath,\r\n  classifyChangedPathOwnership,\r\n  validateChangedPathOwnership,\r\n  validateGatewayTaskSpec,\r\n  validatePluginLifecycleTaskSpec,\r\n  validateSpecPortability,\r\n} from './rules.mjs';\r\n\r\nfunction parseArgs(argv) {\r\n  const args = { _: [] };\r\n  for (let i = 0; i < argv.length; i += 1) {\r\n    const arg = argv[i];\r\n    if (arg === '--') continue;\r\n    if (!arg.startsWith('--')) {\r\n      args._.push(arg);\r\n      continue;\r\n    }\r\n    const key = arg.slice(2);\r\n    const next = argv[i + 1];\r\n    if (!next || next.startsWith('--')) {\r\n      args[key] = true;\r\n      continue;\r\n    }\r\n    args[key] = next;\r\n    i += 1;\r\n  }\r\n  return args;\r\n}\r\n\r\nfunction printUsage() {\r\n  console.log([\r\n    'Usage:',\r\n    '  pnpm harness list',\r\n    '  pnpm harness validate --spec <path> [--since origin/main] [--no-diff]',\r\n    '  pnpm harness explain --spec <path> [--since origin/main]',\r\n    '  pnpm harness context --spec <path> [--json]',\r\n    '  pnpm harness run --spec <path> [--since origin/main] [--dry-run] [--continue-on-error]',\r\n  ].join('\\n'));\r\n}\r\n\r\nasync function findScenario(id) {\r\n  const scenarios = await loadScenarioSpecs();\r\n  return scenarios.find((scenario) => scenario.data.id === id);\r\n}\r\n\r\nasync function list() {\r\n  const scenarios = await loadScenarioSpecs();\r\n  const rules = await loadRuleSpecs();\r\n  const guides = await loadGuideSpecs();\r\n  const layers = await loadLayerSpecs();\r\n  console.log('Profiles:');\r\n  for (const profile of Object.keys(PROFILES)) console.log(`- ${profile}`);\r\n  console.log('\\nScenario specs:');\r\n  for (const spec of scenarios) console.log(`- ${spec.data.id}: ${spec.path}`);\r\n  console.log('\\nRule specs:');\r\n  for (const spec of rules) console.log(`- ${spec.data.id}: ${spec.path}`);\r\n  console.log('\\nGuide specs:');\r\n  for (const spec of guides) console.log(`- ${spec.data.id}: ${spec.path}`);\r\n  console.log('\\nLayer specs:');\r\n  for (const spec of layers) console.log(`- ${spec.data.id}: ${spec.path}`);\r\n}\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_95","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Get-Content harness/specs/scenarios/agent-dev-composable-scenarios.md -Raw; Write-Output \"--- rule example ---\"; Get-Content harness/specs/rules/trace-cost-sampling-boundary.md -Raw'","aggregated_output":"---\nid: agent-dev-composable-scenarios\ntitle: Agent Dev Composable Scenarios\ntype: scenario\nrequiredRules:\n  - contract-first-boundary\n  - agent-dev-conformance-evidence\npathPatterns:\n  - shared/agent-dev/**\n  - src/lib/agent-dev.ts\n  - scripts/agent-dev-workbench.mjs\n---\n\n# Agent Dev Composable Scenarios\n\n## Purpose\n\nAgent-authored features should be reproducible through composable `devScenario` seeds instead of scattered hardcoded fixtures.\n\n## Flow\n\n1. Scenario ids are declared in `shared/agent-dev/scenarios.ts`.\n2. Renderer dev mode parses `?devScenario=a+b` through `shared/agent-dev/scenario-composer.ts`.\n3. Later scenario seeds override earlier state slices.\n4. Query parameters other than `devScenario` become override metadata.\n5. Workbench reads the same shared registry.\n\n## Validation\n\n- `pnpm test tests/unit/agent-dev-scenario-composer.test.ts`\n- `pnpm agent-dev:workbench`\n\r\n--- rule example ---\r\n---\nid: trace-cost-sampling-boundary\ntitle: Request cost and sampling remain observable bounded evidence\ntype: ai-coding-rule\nseverity: error\n---\n\n- Use the existing trusted diagnostic producer and diagnostics-otel export owner; no second exporter, usage service or persistent store.\n- Opt in with the existing diagnostic flag surface; leave absent/disabled behavior, billing and frozen defaults unchanged.\n- Join host request and attempt identities; hash identifying strings with a domain. Link tools via existing tool-call identity and effects via native trace parentage, never fabricate a receipt.\n- Consume terminal structured usage once; missing/invalid/aborted data and unknown prices are not healthy zero. Version the rate snapshot and identify currency and units.\n- Count the population before sampling; distinguish duplicates, missing links, unknown cost, sampled-out records, expiry and capacity/export loss.\n- Error/blocked/recovery records bypass probabilistic drops, not finite resource limits. Keep all queues/maps bounded and report unavoidable retention loss.\n- Sanitize by a fixed projection; no raw prompt, tool bodies, credentials or identifying strings in new exports.\n- Observer failure never changes stream/tool outcome, retry/approval or product locks.\n\r\n","exit_code":0,"status":"completed"}}
