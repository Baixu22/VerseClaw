{"type":"item.completed","item":{"id":"item_452","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Get-Content -LiteralPath openclaw_runtime/src/runtime-core/verifier-completion-verdict.ts | Select-Object -Skip 210 -First 70'","aggregated_output":"    return buildResult({\r\n      record: {\r\n        taskId,\r\n        verdict: \"out-of-scope\",\r\n        evidenceDigest,\r\n        findingCodes: [],\r\n        priorStatus: null,\r\n        grantsPublish: false,\r\n        grantsProductLock: false,\r\n      },\r\n      verifierDecision: null,\r\n      transitioned: false,\r\n      transition: null,\r\n      diagnosticCodes,\r\n    });\r\n  }\r\n\r\n  const report = evaluateEvidenceVerifier(input, options.policy);\r\n  const verdict = mapVerifierDecisionToCompletionVerdict(report.decision);\r\n\r\n  if (verdict !== \"approved\") {\r\n    if (\r\n      report.findings.some((finding) => finding.code === \"invalid_verifier_input\")\r\n    ) {\r\n      diagnosticCodes.push(\"invalid_verifier_input\");\r\n    }\r\n    return buildResult({\r\n      record: {\r\n        taskId: report.taskId,\r\n        verdict,\r\n        evidenceDigest,\r\n        findingCodes: report.findings.map((finding) => finding.code),\r\n        // Non-approved verdicts carry no revocable content.\r\n        priorStatus: null,\r\n        grantsPublish: false,\r\n        grantsProductLock: false,\r\n      },\r\n      verifierDecision: report.decision,\r\n      transitioned: false,\r\n      transition: null,\r\n      diagnosticCodes,\r\n    });\r\n  }\r\n\r\n  // `approved` is the only verdict that transitions, and it fails closed when\r\n  // no prior status was recorded (an unrevocable transition is not taken).\r\n  const transition: VerifierCompletionVerdictTransition | null =\r\n    priorStatus === null\r\n      ? null\r\n      : { from: priorStatus, to: VERIFIER_COMPLETION_APPROVED_STATUS };\r\n  diagnosticCodes.push(\r\n    transition === null ? \"missing_prior_status\" : \"state_transition_recorded\",\r\n  );\r\n\r\n  return buildResult({\r\n    record: {\r\n      taskId: report.taskId,\r\n      verdict,\r\n      evidenceDigest,\r\n      findingCodes: report.findings.map((finding) => finding.code),\r\n      priorStatus,\r\n      grantsPublish: false,\r\n      grantsProductLock: false,\r\n    },\r\n    verifierDecision: report.decision,\r\n    transitioned: transition !== null,\r\n    transition,\r\n    diagnosticCodes,\r\n  });\r\n}\r\n","exit_code":0,"status":"completed"}}
