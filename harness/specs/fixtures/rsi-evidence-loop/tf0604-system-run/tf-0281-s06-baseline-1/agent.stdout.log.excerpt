{"type":"item.started","item":{"id":"item_363","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0281-s06-baseline-1; node -e \\\"\nconst fs=require('fs'),c=require('crypto');\nfunction walk(root,rel='',out=[]){for(const e of fs.readdirSync(root+'/'+rel,{withFileTypes:true})){if(e.name==='node_modules')continue;const r=rel?rel+'/'+e.name:e.name;if(e.isDirectory())walk(root,r,out);else out.push(r);}return out;}\nconst base=new Set(walk('base'));\nconst agent=walk('agent').filter(p=>\"'!p.startsWith('\"'.rsi/'));\nconsole.log('ADDED:'); agent.filter(p=>\"'!base.has(p)).forEach(p=>console.log('\"'  +',p));\nconsole.log('CHANGED:'); agent.filter(p=>base.has(p)&&c.createHash('sha256').update(fs.readFileSync('base/'+p)).digest('hex')\"'!==c.createHash('\"'sha256').update(fs.readFileSync('agent/'+p)).digest('hex')).forEach(p=>console.log('  ~',p));\nconsole.log('REMOVED:'); [...base].filter(p=>\"'!agent.includes(p)).forEach(p=>console.log('\"'  -',p));\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
