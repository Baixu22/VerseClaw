{"type":"item.started","item":{"id":"item_147","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command '$patch = @'\"'\nimport { createHash } from 'node:crypto';\nimport { readFileSync, writeFileSync } from 'node:fs';\nconst path = 'docs/dev/harness-gap-closure/e01-acceptance.json';\nconst record = JSON.parse(readFileSync(path, 'utf8'));\nrecord.scopeBoundary = {\n  filesLeftUntouched: ['scripts/repository-artifacts.json', '.gitignore'],\n  reason: 'The E01 packet scope lists only the internal evaluation report files (reducer, types, fixture, report entry, unit spec, task/rule spec and closed-loop docs). Because of that the retained-file inventory and the generated ignore block were deliberately not edited, even though the two new documentation files live under docs/dev/harness-gap-closure.',\n  implication: 'A tracked docs file that is not listed in retainedFiles would be reported by pnpm repo:artifacts:check as an unlisted/local artifact; that check needs a git index and is out of this packet gate, so it is left to the packet that owns the inventory change.',\n};\nwriteFileSync(path, \"'`${JSON.stringify(record, null, 2)}'\"\\\\n\"'`, '\"'utf8');\n\nconst files = [\n  'docs/dev/harness-gap-closure/e01-acceptance.json',\n  'docs/dev/harness-gap-closure/e01-reliability-aggregation.md',\n  'harness/specs/rules/reliability-aggregation-boundary.md',\n  'harness/specs/tasks/harness-gap-reliability-aggregation.md',\n  'scripts/agent-dev-benefit-eval.mjs',\n  'scripts/lib/reliability-aggregation.d.mts',\n  'scripts/lib/reliability-aggregation.mjs',\n  'shared/agent-dev/reliability-fixture.json',\n  'tests/unit/agent-dev-reliability-aggregation.test.ts',\n].sort();\nconst lines = files.map((file) => \"'`${createHash('\"'sha256').update(readFileSync(file)).digest('hex')}  \"'${file}`);\nwriteFileSync('\"'docs/dev/harness-gap-closure/E01-SHA256SUMS', lines.join('\\\\n') + '\\\\n', 'utf8');\nconsole.log('patched + manifest regenerated:', lines.length, 'entries');\n'@\n\"'$pp = Join-Path $env:TEMP '\"'patch-e01.mjs'\n[System.IO.File]::WriteAllText(\"'$pp, $patch, (New-Object System.Text.UTF8Encoding($false)))\nnode $pp\nnode (Join-Path $env:TEMP '\"'verify-e01-sums.mjs')\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
