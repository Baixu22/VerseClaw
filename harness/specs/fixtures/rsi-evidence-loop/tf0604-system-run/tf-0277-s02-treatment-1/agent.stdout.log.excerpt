",\r\n      \"exitCode\": 0,\r\n      \"files\": 1,\r\n      \"tests\": 3,\r\n      \"failed\": 0\r\n    },\r\n    \"guardRegression\": {\r\n      \"command\": \"openclaw_runtime: run-vitest src/agents/shadow-census.test.ts src/agents/stage1-request-envelope.test.ts\",\r\n      \"exitCode\": 0,\r\n      \"files\": 2,\r\n      \"tests\": 15,\r\n      \"failed\": 0\r\n    },\r\n    \"typecheckCore\": {\r\n      \"command\": \"openclaw_runtime: pnpm run tsgo:core\",\r\n      \"exitCode\": 0\r\n    },\r\n    \"lintTouched\": {\r\n      \"command\": \"openclaw_runtime: node scripts/run-oxlint.mjs src/agents/shadow-census.ts src/agents/provider-transport-fetch.ts src/agents/rc02-envelope-reject.test.ts\",\r\n      \"exitCode\": 0,\r\n      \"warnings\": 1,\r\n      \"warningNote\": \"pre-existing unicorn(no-useless-fallback-in-spread) on untouched line attachShadowReceiptOptions\"\r\n    },\r\n    \"harnessValidate\": {\r\n      \"command\": \"pnpm harness validate --spec harness/specs/tasks/harness-gap-envelope-reject.md\",\r\n      \"exitCode\": 0,\r\n      \"result\": \"Spec is valid\"\r\n    },\r\n    \"harnessDryRun\": {\r\n      \"command\": \"pnpm harness run --spec harness/specs/tasks/harness-gap-envelope-reject.md --dry-run\",\r\n      \"exitCode\": 0,\r\n      \"result\": \"pass\"\r\n    },\r\n    \"commsReplay\": {\r\n      \"command\": \"pnpm run comms:replay\",\r\n      \"exitCode\": 0\r\n    },\r\n    \"commsCompare\": {\r\n      \"command\": \"pnpm run comms:compare\",\r\n      \"exitCode\": 0,\r\n      \"result\": \"all PASS, deltas 0.00%\"\r\n    }\r\n  },\r\n  \"behavior\": {\r\n    \"default\": \"rejectInvalidEnvelope unset -> resolveEnvelopeRejectEnabled()=false -> observational, request sent, bytes unchanged\",\r\n    \"reject\": \"RC-02 shadow active + reject enabled + envelope !ok -> digest-only wire receipt written first, then ProviderEnvelopeRejectedError thrown before fetchWithSsrFGuard -> 0 provider fetch calls\",\r\n    \"order\": \"receipt-before-refusal is guaranteed because the throw is placed after the existing emitShadowWireReceipt and before fetchWithSsrFGuard\"\r\n  },\r\n  \"independentVerification\": {\r\n    \"executed\": true,\r\n    \"kind\": \"revert-and-rerun baseline comparison\",\r\n    \"detail\": \"The rc02-shadow-census.acceptance.test.ts 'embedded runner' case was shown to time out (30s) both with S01 applied and with S01 reverted to clean origin/main, proving the failure is a pre-existing environment/perf residual, not an S01 regression. No separate second-agent verifier role was run.\",\r\n    \"separateVerifierAgent\": false\r\n  },\r\n  \"acceptanceCriteria\": [\r\n    {\r\n      \"id\": \"reuse-boundary\",\r\n      \"status\": \"pass\",\r\n      \"note\": \"Reuses the RC-02 shadow boundary and the existing digest-only shadow_wire receipt; no new store/registry/router.\"\r\n    },\r\n    {\r\n      \"id\": \"opt-in-default-off\",\r\n      \"status\": \"pass\",\r\n      \"note\": \"resolveEnvelopeRejectEnabled defaults false; explicit false and unset env keep the observational path byte-identical.\"\r\n    },\r\n    {\r\n      \"id\": \"reject-before-wire\",\r\n      \"status\": \"pass\",\r\n      \"note\": \"Invalid envelope refused before fetchWithSsrFGuard; measured provider fetch calls = 0 and a typed ProviderEnvelopeRejectedError is raised.\"\r\n    },\r\n    {\r\n      \"id\": \"digest-only\",\r\n      \"status\": \"pass\",\r\n      \"note\": \"The pre-existing digest-only wire receipt is written before the refusal; no raw prompt/body/headers are persisted.\"\r\n    },\r\n    {\r\n      \"id\": \"no-network-rule-change\",\r\n      \"status\": \"pass\",\r\n      \"note\": \"SSRF, timeout, proxy, redirect and outbound-budget rules are untouched.\"\r\n    },\r\n    {\r\n      \"id\": \"clean-candidate-gates\",\r\n      \"status\": \"pass\",\r\n      \"note\": \"S01 tests 3/3, guard regression 15/15, tsgo:core 0, scoped lint 0, harness validate/dry-run pass, comms replay/compare 0