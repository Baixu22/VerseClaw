{"type":"item.completed","item":{"id":"item_165","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0285-l03-baseline-2\\\\agent; @'\n/**\n * L03 acceptance: safely accept in-run revision/cancel (steering).\n *\n * Verifies the receive boundary of the steering queue:\n *  - lease: pending/suspended completions become in_progress + steeringLeaseId\n *    and produce a merged prompt that carries the result text.\n *  - ack: only the matching lease ack applies; a foreign lease cannot hijack;\n *    a repeated ack is a no-op (0 updates, no duplicate injection).\n *  - release: a released lease returns to pending, is taken over exactly once\n *    by the next lease, and can no longer be acked.\n *  - terminal: delivered/failed/discarded completions never re-enter the\n *    pending list and are never leased.\n *  - restart: a stale in_progress lease (>5min) is re-leased so completions\n *    are not stranded.\n *  - isolation: completions for another requesterSessionKey never steer the\n *    current session.\n */\nimport { describe, expect, it } from \\\"vitest\\\";\nimport {\n  ackLeasedAgentSteeringItemsFromSubagentRuns,\n  leasePendingAgentSteeringItemsFromSubagentRuns,\n  listPendingAgentSteeringItemsFromSubagentRuns,\n  releaseLeasedAgentSteeringItemsFromSubagentRuns,\n} from \\\"./agent-steering-queue.js\\\";\nimport type {\n  SubagentCompletionDeliveryState,\n  SubagentRunRecord,\n} from \\\"./subagent-registry.types.js\\\";\n\nconst STALE_LEASE_MS = 5 * 60 * 1000;\n\nconst REQUESTER = \\\"agent:main:abc\\\";\n\nfunction runRecord(params: {\n  runId: string;\n  requesterSessionKey?: string;\n  resultText?: string;\n  status?: SubagentCompletionDeliveryState[\\\"status\\\"];\n  steeringLeaseId?: string;\n  steeringLeasedAt?: number;\n  cleanupHandled?: boolean;\n  suspendedAt?: number;\n  discardedAt?: number;\n}): SubagentRunRecord {\n  const requesterSessionKey = params.requesterSessionKey ?? REQUESTER;\n  const resultText = params.resultText ?? \"'`${params.runId} completed work`;\n  return {\n    runId: params.runId,\n    childSessionKey: `child:${params.runId}`,\n    requesterSessionKey,\n    requesterDisplayKey: requesterSessionKey,\n    task: `${params.runId} task`,\n    cleanup: \"keep\",\n    label: params.runId,\n    createdAt: 1,\n    startedAt: 1,\n    endedAt: 2,\n    outcome: { status: \"ok\" },\n    expectsCompletionMessage: true,\n    cleanupHandled: params.cleanupHandled,\n    completion: { required: true, resultText },\n    delivery: {\n      status: params.status ?? \"pending\",\n      createdAt: 1,\n      payload: {\n        requesterSessionKey,\n        requesterDisplayKey: requesterSessionKey,\n        childSessionKey: `child:${params.runId}`,\n        childRunId: params.runId,\n        task: `${params.runId} task`,\n        label: params.runId,\n        endedAt: 2,\n        outcome: { status: \"ok\" },\n        expectsCompletionMessage: true,\n        frozenResultText: resultText,\n      },\n      ...(params.steeringLeaseId ? { steeringLeaseId: params.steeringLeaseId } : {}),\n      ...(typeof params.steeringLeasedAt === \"number\"\n        ? { steeringLeasedAt: params.steeringLeasedAt }\n        : {}),\n      ...(typeof params.suspendedAt === \"number\" ? { suspendedAt: params.suspendedAt } : {}),\n      ...(typeof params.discardedAt === \"number\" ? { discardedAt: params.discardedAt } : {}),\n    },\n  };\n}\n\nfunction runsOf(...records: SubagentRunRecord[]): Map<string, SubagentRunRecord> {\n  return new Map(records.map((record) => [record.runId, record]));\n}\n\ndescribe(\"L03 in-run steering receive boundary\", () => {\n  it(\"leases pending and suspended completions, marking them in_progress with the lease id and a merged prompt carrying the result\", () => {\n    const runs = runsOf(\n      runRecord({ runId: \"run_pending\", resultText: \"PENDING_RESULT_TEXT\" }),\n      runRecord({ runId: \"run_suspended\", status: \"suspended\", suspendedAt: 5, resultText: \"SUSPENDED_RESULT_TEXT\" }),\n    );\n\n    const batch = leasePendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      leaseId: \"lease_1\",\n      now: 100,\n    });\n\n    expect(batch).toBeDefined();\n    expect(batch!.runIds.sort()).toEqual([\"run_pending\", \"run_suspended\"]);\n    expect(batch!.prompt).toContain(\"PENDING_RESULT_TEXT\");\n    expect(batch!.prompt).toContain(\"SUSPENDED_RESULT_TEXT\");\n    for (const runId of batch!.runIds) {\n      const delivery = runs.get(runId)!.delivery!;\n      expect(delivery.status).toBe(\"in_progress\");\n      expect(delivery.steeringLeaseId).toBe(\"lease_1\");\n      expect(delivery.steeringLeasedAt).toBe(100);\n    }\n  });\n\n  it(\"re-leases nothing for an already-leased item (no duplicate injection) and rejects a foreign-lease ack\", () => {\n    const runs = runsOf(runRecord({ runId: \"run_1\" }));\n    const first = leasePendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      leaseId: \"lease_owner\",\n      now: 100,\n    });\n    expect(first).toBeDefined();\n\n    // Re-leasing the same queue while the item is in_progress yields nothing.\n    const second = leasePendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      leaseId: \"lease_other\",\n      now: 101,\n    });\n    expect(second).toBeUndefined();\n\n    // A foreign lease id cannot hijack the ack.\n    const hijack = ackLeasedAgentSteeringItemsFromSubagentRuns({\n      runs,\n      runIds: [\"run_1\"],\n      leaseId: \"lease_other\",\n      now: 102,\n    });\n    expect(hijack).toBe(0);\n    expect(runs.get(\"run_1\")!.delivery!.status).toBe(\"in_progress\");\n    expect(runs.get(\"run_1\")!.delivery!.steeringLeaseId).toBe(\"lease_owner\");\n  });\n\n  it(\"acknowledges the matching lease once and treats a repeat ack as a no-op\", () => {\n    const runs = runsOf(runRecord({ runId: \"run_1\" }));\n    leasePendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      leaseId: \"lease_1\",\n      now: 100,\n    });\n\n    const acked = ackLeasedAgentSteeringItemsFromSubagentRuns({\n      runs,\n      runIds: [\"run_1\"],\n      leaseId: \"lease_1\",\n      now: 200,\n    });\n    expect(acked).toBe(1);\n    const delivery = runs.get(\"run_1\")!.delivery!;\n    expect(delivery.status).toBe(\"delivered\");\n    expect(delivery.steeringLeaseId).toBeUndefined();\n    expect(delivery.deliveredAt).toBe(200);\n\n    // Repeating the ack must not update anything (no duplicate injection).\n    const repeated = ackLeasedAgentSteeringItemsFromSubagentRuns({\n      runs,\n      runIds: [\"run_1\"],\n      leaseId: \"lease_1\",\n      now: 300,\n    });\n    expect(repeated).toBe(0);\n    expect(runs.get(\"run_1\")!.delivery!.deliveredAt).toBe(200);\n  });\n\n  it(\"returns a released lease to pending so the next lease takes it over exactly once, and blocks late acks\", () => {\n    const runs = runsOf(runRecord({ runId: \"run_1\" }));\n    leasePendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      leaseId: \"lease_failed\",\n      now: 100,\n    });\n\n    const released = releaseLeasedAgentSteeringItemsFromSubagentRuns({\n      runs,\n      runIds: [\"run_1\"],\n      leaseId: \"lease_failed\",\n      error: \"requester turn failed\",\n    });\n    expect(released).toBe(1);\n    expect(runs.get(\"run_1\")!.delivery!.status).toBe(\"pending\");\n    expect(runs.get(\"run_1\")!.delivery!.steeringLeaseId).toBeUndefined();\n\n    // The released lease can no longer ack.\n    const lateAck = ackLeasedAgentSteeringItemsFromSubagentRuns({\n      runs,\n      runIds: [\"run_1\"],\n      leaseId: \"lease_failed\",\n      now: 150,\n    });\n    expect(lateAck).toBe(0);\n\n    // The next lease takes over exactly once.\n    const takeover = leasePendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      leaseId: \"lease_retry\",\n      now: 200,\n    });\n    expect(takeover!.runIds).toEqual([\"run_1\"]);\n    expect(runs.get(\"run_1\")!.delivery!.steeringLeaseId).toBe(\"lease_retry\");\n    expect(\n      leasePendingAgentSteeringItemsFromSubagentRuns({\n        runs,\n        requesterSessionKey: REQUESTER,\n        leaseId: \"lease_third\",\n        now: 201,\n      }),\n    ).toBeUndefined();\n  });\n\n  it(\"keeps terminal completions out of the pending list and never leases them\", () => {\n    const runs = runsOf(\n      runRecord({ runId: \"run_delivered\", status: \"delivered\" }),\n      runRecord({ runId: \"run_failed\", status: \"failed\" }),\n      runRecord({ runId: \"run_discarded\", status: \"discarded\", discardedAt: 5 }),\n    );\n\n    const pending = listPendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      now: 100,\n    });\n    expect(pending).toHaveLength(0);\n\n    const batch = leasePendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      leaseId: \"lease_1\",\n      now: 100,\n    });\n    expect(batch).toBeUndefined();\n  });\n\n  it(\"re-leases a stale in_progress lease so a restarted requester turn can take over\", () => {\n    const runs = runsOf(\n      runRecord({\n        runId: \"run_stale\",\n        status: \"in_progress\",\n        steeringLeaseId: \"lease_stale\",\n        steeringLeasedAt: 1,\n        cleanupHandled: true,\n      }),\n    );\n\n    const now = 1 + STALE_LEASE_MS + 1;\n    const pending = listPendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      now,\n    });\n    expect(pending.map((item) => item.runId)).toEqual([\"run_stale\"]);\n\n    const takeover = leasePendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      leaseId: \"lease_restart\",\n      now,\n    });\n    expect(takeover!.runIds).toEqual([\"run_stale\"]);\n    const delivery = runs.get(\"run_stale\")!.delivery!;\n    expect(delivery.status).toBe(\"in_progress\");\n    expect(delivery.steeringLeaseId).toBe(\"lease_restart\");\n    expect(delivery.steeringLeasedAt).toBe(now);\n  });\n\n  it(\"does not steer completions that belong to a different requester session\", () => {\n    const runs = runsOf(\n      runRecord({ runId: \"run_mine\" }),\n      runRecord({ runId: \"run_theirs\", requesterSessionKey: \"agent:other:xyz\" }),\n    );\n\n    const pending = listPendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      now: 100,\n    });\n    expect(pending.map((item) => item.runId)).toEqual([\"run_mine\"]);\n\n    const batch = leasePendingAgentSteeringItemsFromSubagentRuns({\n      runs,\n      requesterSessionKey: REQUESTER,\n      leaseId: \"lease_1\",\n      now: 100,\n    });\n    expect(batch!.runIds).toEqual([\"run_mine\"]);\n    expect(runs.get(\"run_theirs\")!.delivery!.status).toBe(\"pending\");\n    expect(runs.get(\"run_theirs\")!.delivery!.steeringLeaseId).toBeUndefined();\n  });\n});\n'\"'@ | Set-Content -Encoding utf8 openclaw_runtime/src/agents/agent-steering-queue.l03.test.ts; (Get-Item openclaw_runtime/src/agents/agent-steering-queue.l03.test.ts).Length\"","aggregated_output":"10472\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_166","type":"reasoning","text":"Note the L03 test uses `.js` import extension relative to the same dir. Other tests in that dir (e.g. resource-leases.test.ts) import \"./resource-leases.js\". Good.\n\nNow run the test.\n\nAlso check: the `now` for stale lease: `isStaleLease` requires `now - steeringLeasedAt > STALE_MS`. 1 + STALE + 1 - 1 = STALE+1 > STALE. Good.\n\nBut wait: in `listPendingAgentSteeringItemsFromSubagentRuns`, for stale lease items with cleanupHandled === true, the staleLease bypasses the cleanupHandled skip. Good.\n\nLet's run."}}
