{"type":"item.completed","item":{"id":"item_470","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command 'Get-Content tests/unit/error-recovery-next-action.test.ts -Raw'","aggregated_output":"import { describe, expect, it } from 'vitest';\n\nimport {\n  APP_ERROR_CODES,\n  AppError,\n  ERROR_RECOVERY_ACTION_KINDS,\n  ERROR_RECOVERY_TABLE,\n  recoveryActionForAppErrorCode,\n} from '../../src/lib/error-model';\n\n/**\n * The only recovery verbs an error may carry, copied literally so the\n * production vocabulary cannot widen without this test failing.\n */\nconst FIXED_VERBS = [\n  'retry',\n  'reauthenticate',\n  'reconfigure',\n  'open-settings',\n  'contact-support',\n] as const;\n\n/** Fields that would turn a bounded action back into an executable command. */\nconst EXECUTABLE_FIELDS = ['command', 'cmd', 'script', 'shell', 'exec', 'executable', 'argv', 'program'];\n\ndescribe('error recovery table', () => {\n  it('gives every AppErrorCode exactly one recovery entry', () => {\n    expect([...APP_ERROR_CODES].sort()).toEqual([...new Set(APP_ERROR_CODES)].sort());\n    expect(Object.keys(ERROR_RECOVERY_TABLE).sort()).toEqual([...APP_ERROR_CODES].sort());\n  });\n\n  it('declares retryable and scope on every entry', () => {\n    for (const code of APP_ERROR_CODES) {\n      const entry = ERROR_RECOVERY_TABLE[code];\n      expect(entry, `${code} must have a recovery entry`).toBeTruthy();\n      expect(typeof entry.retryable, `${code}.retryable`).toBe('boolean');\n      expect(['self-retry', 'user-action-required'], `${code}.scope`).toContain(entry.scope);\n    }\n  });\n\n  it('pins the action vocabulary to the five fixed verbs', () => {\n    expect([...ERROR_RECOVERY_ACTION_KINDS]).toEqual([...FIXED_VERBS]);\n    for (const code of APP_ERROR_CODES) {\n      const action = ERROR_RECOVERY_TABLE[code].action;\n      if (!action) continue;\n      expect([...FIXED_VERBS], `${code}.action.kind`).toContain(action.kind);\n    }\n  });\n\n  it('ties retryable to self-retry and to a bare retry action', () => {\n    for (const code of APP_ERROR_CODES) {\n      const entry = ERROR_RECOVERY_TABLE[code];\n      if (entry.retryable) {\n        expect(entry.scope, `${code} retryable implies self-retry`).toBe('self-retry');\n        expect(entry.action, `${code} retryable implies exactly a retry action`).toEqual({ kind: 'retry' });\n      } else {\n        expect(entry.scope, `${code} must not be auto-retried`).toBe('user-action-required');\n        expect(entry.action?.kind, `${code} must not claim a retry`).not.toBe('retry');\n      }\n    }\n  });\n\n  it('keeps every action bounded and non-executable', () => {\n    for (const code of APP_ERROR_CODES) {\n      const action = ERROR_RECOVERY_TABLE[code].action as Record<string, unknown> | undefined;\n      if (!action) continue;\n      for (const key of Object.keys(action)) {\n        expect(['kind', 'target'], `${code}.action key`).toContain(key);\n      }\n      for (const field of EXECUTABLE_FIELDS) {\n        expect(Object.keys(action), `${code}.action must not carry ${field}`).not.toContain(field);\n      }\n      if (action.target !== undefined) {\n        expect(typeof action.target, `${code}.action.target`).toBe('string');\n        expect(action.target as string, `${code}.action.target must stay bounded`).toMatch(/^[a-z][a-z0-9-]*$/);\n      }\n    }\n  });\n\n  it('leaves UNKNOWN without an action so the raw error is surfaced', () => {\n    expect(ERROR_RECOVERY_TABLE.UNKNOWN.retryable).toBe(false);\n    expect(ERROR_RECOVERY_TABLE.UNKNOWN.action).toBeUndefined();\n    expect(recoveryActionForAppErrorCode('UNKNOWN')).toBeUndefined();\n  });\n});\n\ndescribe('AppError carries the recovery decision', () => {\n  it('mirrors the table on every instance', () => {\n    for (const code of APP_ERROR_CODES) {\n      const error = new AppError(code, 'fixture failure');\n      expect(error.retryable, `${code}.retryable`).toBe(ERROR_RECOVERY_TABLE[code].retryable);\n      expect(error.nextAction, `${code}.nextAction`).toEqual(ERROR_RECOVERY_TABLE[code].action);\n    }\n  });\n\n  it('exposes retry only for the self-retry classes', () => {\n    const retryable = new AppError('TIMEOUT', 'upstream timed out');\n    expect(retryable.retryable).toBe(true);\n    expect(retryable.nextAction).toEqual({ kind: 'retry' });\n\n    const actionRequired = new AppError('PERMISSION', 'denied');\n    expect(actionRequired.retryable).toBe(false);\n    expect(actionRequired.nextAction).toEqual({ kind: 'open-settings', target: 'permissions' });\n  });\n\n  it('surfaces an unrecoverable error without fabricating a repair', () => {\n    const error = new AppError('UNKNOWN', 'no classifier matched');\n\n    expect(error.code).toBe('UNKNOWN');\n    expect(error.retryable).toBe(false);\n    expect(error.nextAction).toBeUndefined();\n    expect(JSON.stringify(error)).not.toMatch(/command|script|shell|exec|argv|program/i);\n  });\n});\n\r\n","exit_code":0,"status":"completed"}}
