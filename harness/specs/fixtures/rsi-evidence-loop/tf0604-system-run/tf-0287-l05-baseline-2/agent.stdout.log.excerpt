daryFailures = await scanBackendCommunicationBoundary(scanFiles);\n  failures.push(...boundaryFailures);\n  steps.push({\n    profile: 'rules',\n    name: 'Backend communication boundary scan',\n    status: boundaryFailures.length === 0 ? 'pass' : 'fail',\n    exitCode: boundaryFailures.length === 0 ? 0 : 1,\n    durationMs: 0,\n  });\n\n  const selectedSteps = selectSteps(profiles);\n  if (failures.length === 0) {\n    for (const step of selectedSteps) {\n      if (options.dryRun) {\n        steps.push({ ...step, status: 'skipped', exitCode: 0, durationMs: 0 });\n        continue;\n      }\n      const result = await runStep(step);\n      steps.push(result);\n      if (result.status !== 'pass') {\n        failures.push(`${step.name} failed with exit code ${result.exitCode}`);\n        if (!options.continueOnError) break;\n      }\n    }\n  } else {\n    for (const step of selectedSteps) {\n      steps.push({ ...step, status: 'blocked', exitCode: 1, durationMs: 0 });\n    }\n  }\n\n  const report = {\n    specPath: validation.spec.path,\n    scenario: validation.spec.data.scenario ?? validation.spec.data.id,\n    taskType: validation.spec.data.taskType ?? validation.spec.data.type ?? null,\n    startedAt,\n    finishedAt: new Date().toISOString(),\n    changedFiles: validation.changedFiles,\n    residualPaths: validation.ownership.residual,\n    ownership: {\n      checked: validation.ownership.checked,\n      covered: validation.ownership.covered,\n      residual: validation.ownership.residual,\n      uncovered: validation.ownership.uncovered,\n    },\n    selectedProfiles: profiles,\n    steps,\n    failures,\n    result: failures.length === 0\n      ? (validation.ownership.residual.length > 0 ? 'pass_with_residual' : 'pass')\n      : 'fail',\n  };\n  const paths = await writeReport(report);\n  console.log(`Harness report: ${paths.markdownPath}`);\n  console.log(`Harness result: ${report.result}`);\n  if (report.residualPaths.length > 0) {\n    console.log(`RESIDUAL: residualPaths=${report.residualPaths.join(', ')}`);\n    if (report.result === 'pass_with_residual') console.log('PASS WITH RESIDUAL');\n  }\n  if (failures.length > 0) {\n    console.error(failures.map((failure) => `- ${failure}`).join('\\n'));\n    return 1;\n  }\n  return 0;\n}\n\nasync function context(specPath, options = {}) {\n  const result = await buildContext(specPath);\n  if (options.json) {\n    console.log(JSON.stringify({\n      task: result.task,\n      scenarios: result.scenarios,\n      rules: result.rules,\n      guides: result.guides,\n      layers: result.layers,\n      missingScenarios: result.missingScenarios,\n      missingRules: result.missingRules,\n      readOrder: result.readOrder,\n    }, null, 2));\n  } else {\n    console.log(formatContext(result));\n  }\n\n  return result.missingScenarios.length === 0 && result.missingRules.length === 0 ? 0 : 1;\n}\n\nasync function main() {\n  const args = parseArgs(process.argv.slice(2));\n  const command = args._[0];\n  if (!command || args.help) {\n    printUsage();\n    return 0;\n  }\n\n  if (command === 'list') {\n    await list();\n    return 0;\n  }\n\n  if (!args.spec) {\n    printUsage();\n    return 1;\n  }\n\n  if (command === 'validate') {\n    const result = await validate(args.spec, {\n      since: args.since,\n      noDiff: Boolean(args['no-diff']),\n    });\n    if (result.ownership.residual.length > 0) {\n      console.log(`RESIDUAL: residualPaths=${result.ownership.residual.join(', ')}`);\n      if (result.failures.length === 0) console.log('PASS WITH RESIDUAL');\n    }\n    if (result.failures.length > 0) {\n      console.error(result.failures.map((failure) => `- ${failure}`).join('\\n'));\n      return 1;\n    }\n    // An empty diff is a pass, but never a silent one: say what was compared so a\n    // green run is not mistaken for a validated change set.\n    if (result.diffBase && result.changedFiles.length === 0) {\n      console.log(`NOTE: no changed files since ${result.diffBase}; the changed-path ownership gate had nothing to check.`);\n    }\n    console.log(`Spec is valid: ${result.spec.path}`);\n    return 0;\n  }\n\n  if (command === 'explain') {\n    return await explain(args.spec, { since: args.since });\n  }\n\n  if (command === 'context') {\n    return await context(args.spec, { json: Boolean(args.json) });\n  }\n\n  if (command === 'run') {\n    return await run(args.spec, {\n      since: args.since,\n      dryRun: Boolean(args['dry-run']),\n      continueOnError: Boolean(args['continue-on-error']),\n    });\n  }\n\n  printUsage();\n  return 1;\n}\n\nmain().then((exitCode) => {\n  process.exitCode = exitCode;\n}).catch((error) => {\n  console.error(error);\n  process.exitCode = 1;\n});\n\r\n","exit_code":0,"status":"completed"}}
