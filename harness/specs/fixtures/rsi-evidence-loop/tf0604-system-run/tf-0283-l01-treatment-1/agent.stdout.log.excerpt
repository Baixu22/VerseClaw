{"type":"item.started","item":{"id":"item_292","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"cd D:\\\\tmp\\\\rsi-tf0604-run5\\\\trials\\\\tf-0283-l01-treatment-1\\\\agent; node -e \\\"\nconst fs=require('fs'),path=require('path');\nconst root=process.cwd();\nconst p=path.resolve('node_modules');\nif (p.startsWith(root+path.sep)) { const st=fs.lstatSync(p); console.log('type', st.isSymbolicLink()?'link':'dir', 'isJunction', st.isSymbolicLink()); fs.rmSync(p,{force:true}); }\nconsole.log('node_modules exists:', fs.existsSync(p));\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
