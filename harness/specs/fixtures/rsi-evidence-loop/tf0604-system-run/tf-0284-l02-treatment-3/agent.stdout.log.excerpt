{"type":"item.completed","item":{"id":"item_178","type":"command_execution","command":"\"D:\\\\software\\\\PowerShell\\\\pwsh-7.6.6\\\\pwsh.exe\" -Command \"Get-Content D:\\\\tmp\\\\vitest-loader.mjs -Raw; Write-Output \\\"=== runner ===\\\"; Get-Content D:\\\\tmp\\\\vitest-runner.mjs -Raw; Write-Output \\\"=== shim pkg? ===\\\"; Get-ChildItem D:\\\\tmp -Filter \\\"package.json\\\" -ErrorAction SilentlyContinue | Select-Object Name\"","aggregated_output":"import { pathToFileURL } from 'node:url';\nconst shim = pathToFileURL(process.env.VITEST_SHIM).href;\nexport async function resolve(specifier, context, nextResolve) {\n  if (specifier === 'vitest') return { url: shim, shortCircuit: true };\n  return nextResolve(specifier, context);\n}\n\r\n=== runner ===\r\nimport { register } from 'node:module';\nimport { pathToFileURL } from 'node:url';\nregister(pathToFileURL(process.env.VITEST_LOADER).href);\nawait import(pathToFileURL(process.env.TEST_FILE).href);\nconst { report } = await import(pathToFileURL(process.env.VITEST_SHIM).href);\nconst r = report();\nconsole.log('passed=' + r.passed + ' failed=' + r.failed);\nfor (const f of r.failures) console.log('FAIL ' + f);\nprocess.exitCode = r.failed === 0 ? 0 : 1;\n\r\n=== shim pkg? ===\r\n","exit_code":0,"status":"completed"}}
