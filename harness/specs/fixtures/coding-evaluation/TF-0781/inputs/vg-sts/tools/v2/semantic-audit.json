      ]
    },
    "plan": {
      "added": [
        "content_identity",
        "environment_identity",
        "expected_environment_identity",
        "expected_execution_identity",
        "full_comparison",
        "policy_identity"
      ],
      "removed": [],
      "now_required": [
        "content_identity",
        "policy_identity"
      ],
      "no_longer_required": [],
      "extra_top_level_keys": [
        "$defs"
      ]
    },
    "result": {
      "added": [
        "content_identity",
        "environment_identity",
        "execution_identity",
        "isolated_process",
        "observations"
      ],
      "removed": [],
      "now_required": [
        "content_identity",
        "execution_identity"
      ],
      "no_longer_required": [
        "not_executed"
      ],
      "extra_top_level_keys": [
        "$defs"
      ]
    },
    "refusal": {
      "added": [
        "content_confirmed",
        "content_identity",
        "refusal_kind",
        "unconfirmed"
      ],
      "removed": [],
      "now_required": [
        "content_confirmed",
        "refusal_kind"
      ],
      "no_longer_required": [
        "refusal_code"
      ],
      "extra_top_level_keys": []
    }
  },
  "reachability": [],
  "registered_rules": [
    "R1-protocol-is-2.0",
    "R2-label-is-not-identity",
    "R3-manifest-covers-config-and-data",
    "R4-digest-carries-algorithm",
    "R5-exclusion-policy-is-versioned",
    "R6-full-only-when-content-confirmed",
    "R7-unconfirmed-must-be-listed",
    "R8-plan-carries-its-own-identity",
    "R9-invalid-or-unconfirmed-cannot-be-valid",
    "R10-order-is-permutation-of-selected",
    "R11-cross-document-binding",
    "R12-environment-identity-must-match-plan"
  ],
  "read_by_rule": {
