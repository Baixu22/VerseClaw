{
  "contract": "vg-sts",
  "protocol_version": "1.1",
  "product": "smart-test-sorter",
  "product_version": "0.1.0",
  "produced_by": "STS:TF-0026",
  "consumer": "VG:TF-0168",
  "source_commit": null,
  "version_policy": "digests-authoritative",
  "source_note": "版本口径：以下方 digests 为唯一权威内容口径（29 条 = README 1 + schema 4 + valid 9 + invalid 10 + pairs 5；v1.0 时为 18 条）。契约文件由 STS 单独提交 contracts/ 目录引入；该提交 oid 作便利指针在交接回信中给出，但 manifest 无法自引用其所在提交的 hash（manifest 亦不在自身 digests 内），故 source_commit 置 null 并显式声明 digests 口径。",
  "objects": ["candidate_request", "test_plan", "execution_result", "plan_refusal"],
  "transport": {
    "encoding": "utf-8-json-file",
    "note": "首版用 UTF-8 JSON 文件（request/plan/result/refusal 各一个文件）；机器 JSON 与人类日志分离。",
    "request_entry": {
      "argv": ["python", "-m", "smart_sorter.contracts", "validate", "<file>", "--as", "request|plan|result|refusal"],
      "bind_argv": ["python", "-m", "smart_sorter.contracts", "bind", "--request", "<req>", "--plan", "<plan>", "--result", "<result?>"],
      "note": "校验入口。候选请求→计划生成入口由 STS:TF-0027 交付（本节点只固定契约与校验）。bind 子命令做跨文档绑定核对（错候选）。",
      "stdout": "机器可读结论 JSON：{ok, kind, errors}",
      "stderr": "人类日志",
      "exit_codes": { "0": "通过", "2": "用法或输入错误", "3": "校验失败" }
    },
    "interpreter_selection": "由宿主(VG)显式指定解释器/模块入口，不依赖开发机隐式 PATH。"
  },
  "compatibility": {
    "supported_protocol_versions": ["1.0", "1.1"],
    "unknown_version_policy": "拒绝，不静默猜测兼容；破坏性字段/语义变化必须升级 protocol_version 并更新双方样例。1.0→1.1 为向后兼容放宽/新增，1.0 文档在 1.1 校验器下仍合法。",
    "v1_1_changes": [
      "risk.hints[].symbol 由必填改为可选（path 仍必填）",
      "新增 plan_refusal 对象（无法规划带内回执）",
      "candidate 模式必须给 candidate_tree_oid/candidate_commit_oid 之一且不带 worktree_content_digest",
      "execution_result: completeness=complete ⇒ not_executed 为空",
      "test_plan.risk_decisions[].symbol 改可选，symbol/path 至少给一个",
      "新增 validate_binding / bind 子命令做跨文档绑定核对"
    ]
  },
