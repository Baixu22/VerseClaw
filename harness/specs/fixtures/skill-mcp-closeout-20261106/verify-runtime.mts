import { readFile,writeFile,mkdir,mkdtemp } from 'node:fs/promises';
import { pathToFileURL, fileURLToPath } from 'node:url';
import path from 'node:path';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('../../../../',import.meta.url));
const outputPath=process.argv[2];if(!outputPath)throw Error('Pass output JSON path');
const temp=await mkdtemp(path.join((await import('node:os')).tmpdir(),'skill-runtime-closeout-'));
process.env.VERSE_CLAW_USER_DATA_DIR=path.join(temp,'app');process.env.OPENCLAW_CONFIG_DIR=path.join(temp,'runtime');
const skillRoot=path.join(temp,'app','verse-claw-skills');await mkdir(path.join(skillRoot,'sync-probe'),{recursive:true});await mkdir(process.env.OPENCLAW_CONFIG_DIR,{recursive:true});
await writeFile(path.join(skillRoot,'sync-probe','SKILL.md'),'---\nname: sync-probe\ndescription: Check runtime Skill configuration\n---\n');
await writeFile(path.join(temp,'app','verse-claw-skills.json'),JSON.stringify({entries:{'sync-probe':{enabled:false}}}));
const main=await import(pathToFileURL(path.join(root,'electron/utils/skill-config.ts')).href);
await main.syncSkillsToRuntimeConfig();
const configPath=path.join(temp,'runtime','openclaw.json');
const cfg=async()=>JSON.parse(await readFile(configPath,'utf8'));
const runtime=await import(pathToFileURL(path.join(root,'openclaw_runtime/src/skills/loading/workspace.ts')).href);
const workspace=path.join(temp,'workspace');await mkdir(workspace,{recursive:true});
const view=async()=>runtime.buildWorkspaceSkillSnapshot(workspace,{config:await cfg(),bundledSkillsDir:path.join(temp,'empty'),managedSkillsDir:path.join(temp,'empty-managed')});
assert(!(await view()).skills.some(s=>s.name==='sync-probe'));
assert((await main.updateSkillConfig('sync-probe',{enabled:true})).success);assert((await view()).skills.some(s=>s.name==='sync-probe'));
assert((await main.updateSkillConfig('sync-probe',{enabled:false})).success);assert(!(await view()).skills.some(s=>s.name==='sync-probe'));
assert((await main.removeSkillConfig('sync-probe')).success);assert.equal((await cfg()).skills.entries['sync-probe'],undefined);
await main.getAllSkillConfigs();assert.equal((await cfg()).skills.entries['sync-probe'],undefined);
const record={driven_by:'agent',actor:'codex-skill-mcp-closeout',scope:'real Main config and runtime loader, isolated disk',migration:true,managedDiscovery:true,enabledVisible:true,disabledHidden:true,removedNotResurrected:true,configPath};await writeFile(outputPath,JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify(record));
