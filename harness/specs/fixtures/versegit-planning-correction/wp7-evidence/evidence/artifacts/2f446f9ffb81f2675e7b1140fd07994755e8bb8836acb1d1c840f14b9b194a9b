    {
      "entries": [
        "change.materialize",
        "land",
        "report"
      ],
      "evidence": [
        "crates/vg-cli/tests/jj_managed_candidate.rs",
        "crates/vg-cli/tests/jj_closed_loop.rs",
        "crates/vg-cli/tests/land_concurrency.rs"
      ],
      "id": "candidate.land",
      "status": "verified"
    },
    {
      "entries": [
        "git.fetch",
        "git.push",
        "gerrit.upload"
      ],
      "evidence": [
        "crates/vg-cli/tests/jj_git_ref_sync.rs",
        "crates/vg-cli/tests/jj_gerrit_upload.rs"
      ],
      "id": "external.publish",
      "status": "controlled"
