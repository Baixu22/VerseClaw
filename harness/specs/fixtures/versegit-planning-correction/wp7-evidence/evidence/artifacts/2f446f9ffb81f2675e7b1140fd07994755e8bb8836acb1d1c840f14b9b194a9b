  "safety": {
    "default_enable": false,
    "evidence_land_present": true,
    "managed_opt_in": true,
    "strict_admission_present": true
  },
  "schema": "versegit.capabilities/v1",
  "verdict": {
    "dimensions": [
      "candidate",
      "execution",
      "evidence",
      "freshness",
      "risk",
      "trial"
    ],
    "note": "六维各自独立呈现；admitted 是它们的合取，selected 不覆盖全集",
    "read_surface": {
      "observed_channels": [
        "read",
        "grep",
        "glob",
        "write",
        "edit"
      ],
      "unobserved_channels": [
        "bash",
        "other-mcp",
        "network",
        "direct-fs"
      ]
    },
    "schema": "versegit.verdict/v1",
    "single_green_light": false
  },
  "workflows": [
    {
      "entries": [
        "workspace.init",
        "workspace.root",
        "doctor"
      ],
      "evidence": [
        "crates/vg-cli/tests/jj_workspace_lifecycle.rs",
        "crates/vg-cli/tests/jj_public_surface.rs"
      ],
      "id": "workspace",
      "status": "verified"
    },
    {
      "entries": [
        "change.new",
        "change.file",
        "change.describe",
        "change.snapshot",
        "change.diffedit"
      ],
      "evidence": [
        "crates/vg-cli/tests/jj_change_lifecycle.rs",
        "crates/vg-cli/tests/jj_diffedit.rs"
      ],
      "id": "change.edit",
      "status": "verified"
    },
    {
      "entries": [
        "change.log",
        "op.restore",
        "op.undo"
      ],
      "evidence": [
        "crates/vg-cli/tests/jj_operation_restore.rs",
        "crates/vg-cli/tests/jj_op_undo_redo.rs",
        "crates/vg-cli/tests/jj_backup_restore.rs"
      ],
      "id": "history.recover",
      "status": "verified"
    },
    {
      "entries": [
        "verify.status",
        "verdict",
        "basis.status"
      ],
      "evidence": [
        "crates/vg-cli/tests/jj_managed_plan.rs",
        "crates/vg-cli/tests/jj_evidence_land.rs",
        "crates/vg-cli/tests/jj_verdict.rs"
      ],
      "id": "validation.admit",
      "status": "verified"
