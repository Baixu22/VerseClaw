{
  "compat": {
    "git_only": "preserved",
    "next": "preserved",
    "package_names": [
      "smart-test-sorter",
      "smart_sorter"
    ],
    "sts_protocols": [
      "1.1",
      "2.0"
    ]
  },
  "mcp_tools": [
    "vg_capabilities",
    "verdict",
    "integration_status",
    "who_touches",
    "explain_conflict",
    "declare_intent",
    "basis_status",
    "basis_watermark"
  ],
