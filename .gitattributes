# VerseShell process-lifecycle patch is content-addressed by the committed
# manifest (provenance.build_input.diff_sha256 / compliance checksum) and
# verified by tests/unit/uas-05-verseshell-process-lifecycle.test.ts and
# tests/unit/verseshell-manifest.test.ts. It must be checked out byte-identical
# to the blob on every platform; core.autocrlf=true would otherwise smudge it
# to CRLF on fresh worktrees and break the recorded SHA-256.
resources/verseshell/patches/uas-05-process-lifecycle.patch -text

# RC-00 acceptance reconstructs VerseShell in a detached worktree on Windows where
# core.autocrlf=true would smudge these ordered patch files from LF to CRLF,
# breaking the byte-size / SHA-256 check in scripts/verseshell-bundle.mjs
# (root cause of the provision-verseshell-resources gate fail recorded in
# artifacts/unblock-pack/tf0020-h01-nogo.md). Pin all ordered patches to LF bytes
# on every checkout.
resources/verseshell/patches/*.patch -text

# RC-01 acceptance uses this generated inventory as a candidate-bound input.
# Keep the JSON byte-stable across Windows and POSIX checkouts so rerunning its
# deterministic generator cannot create an EOL-only worktree mutation.
artifacts/runtime-authority-convergence/rc-01/baseline.json -text

# Static-integrity generated artifacts are byte-compared by the runtime check
# guards (npm shrinkwrap guard, tool display, host env policy). core.autocrlf
# would smudge them to CRLF in fresh detached acceptance worktrees and make the
# byte comparison fail, so pin them to the committed LF bytes like the other
# content-addressed generated files above.
openclaw_runtime/npm-shrinkwrap.json -text
openclaw_runtime/extensions/*/npm-shrinkwrap.json -text
openclaw_runtime/apps/shared/OpenClawKit/Sources/OpenClawKit/Resources/tool-display.json -text
openclaw_runtime/apps/macos/Sources/OpenClaw/HostEnvSecurityPolicy.generated.swift -text
