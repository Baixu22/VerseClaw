@@ -0,0 +1,24 @@
+const fs = require("fs");
+const files = [
+  "openclaw_runtime/src/context-engine/dcs-canary-c1.ts",
+  "openclaw_runtime/src/context-engine/dcs-graduation-decision.ts",
+  "openclaw_runtime/src/context-engine/dcs-corpus-schema.ts",
+  "openclaw_runtime/src/context-engine/dcs-corpus-synthetic.ts",
+  "openclaw_runtime/src/context-engine/dcs-corpus-schema.test.ts",
+  "openclaw_runtime/src/context-engine/dcs-corpus-synthetic.test.ts",
+  "openclaw_runtime/src/context-engine/dcs-graduation-decision.test.ts",
+  "openclaw_runtime/src/context-engine/dcs-canary-c1.test.ts",
+];
+for (const f of files) {
+  let c = fs.readFileSync(f, "utf8");
+  const o = c;
+  c = c.replace(/[^\x09\x0A\x0D\x20-\x7E]/g, "-");
+  // collapse accidental multi-dash from multi-byte replacements
+  c = c.replace(/-{2,}/g, "-");
+  if (c !== o) {
+    fs.writeFileSync(f, c);
+    console.log("fixed", f);
+  } else {
+    console.log("ok", f);
+  }
+}
