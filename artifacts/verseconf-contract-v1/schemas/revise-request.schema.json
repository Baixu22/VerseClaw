{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clawx:structured-artifact-revise:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "baseRevision", "changes"],
  "properties": {
    "artifactId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "baseRevision": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "changes": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/change" } }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "string", "maxLength": 4096 },
        { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object", "maxProperties": 128,
          "propertyNames": { "maxLength": 256 },
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "expected": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "absent" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "value" }, "value": { "$ref": "#/$defs/jsonValue" } }
        }
      ]
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "recordId", "fieldPath", "expected", "value"],
      "properties": {
        "op": { "const": "setField" },
        "recordId": { "type": "string", "pattern": "^rec-[a-z0-9-]{1,48}$" },
        "fieldPath": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": { "enum": ["finding", "evidenceState", "evidenceRefs", "limitations", "notes"] }
        },
        "expected": { "$ref": "#/$defs/expected" },
        "value": { "$ref": "#/$defs/jsonValue" }
      }
    }
  }
}
