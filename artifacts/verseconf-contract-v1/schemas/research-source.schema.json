{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clawx:research-comparison:v1",
  "title": "Research comparison source, bounded consumer contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "sources", "records"],
  "properties": {
    "schemaVersion": { "const": "research-comparison/v1" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": { "$ref": "#/$defs/source" }
    },
    "records": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^src-[a-z0-9-]{1,48}$" },
    "recordId": { "type": "string", "pattern": "^rec-[a-z0-9-]{1,48}$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "locator", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "locator": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject", "finding", "evidenceState", "evidenceRefs", "limitations"],
      "properties": {
        "id": { "$ref": "#/$defs/recordId" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "finding": { "type": "string", "maxLength": 4096 },
        "evidenceState": { "enum": ["unlinked", "linked"] },
        "evidenceRefs": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        },
        "limitations": { "type": ["string", "null"], "maxLength": 4096 },
        "notes": { "type": ["string", "null"], "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": { "properties": { "evidenceState": { "const": "linked" } }, "required": ["evidenceState"] },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } },
          "else": { "properties": { "evidenceRefs": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
