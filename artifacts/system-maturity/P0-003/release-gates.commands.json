{
  "loop": "release",
  "commands": [
    "node scripts/audit-baseline-check.mjs",
    "node scripts/validate-system-maturity-plan.mjs",
    "node scripts/validate-test-gates.mjs",
    "pnpm contract:check",
    "pnpm run typecheck",
    "pnpm run harness:ci",
    "pnpm agent-dev:deep-test",
    "pnpm run test:e2e:agent-dev-quality",
    "pnpm run release:validate"
  ]
}
