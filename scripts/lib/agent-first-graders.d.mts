export type GraderVerdict = 'pass' | 'fail' | 'unknown';
export type GraderResult = { graderVersion: string; verdict: GraderVerdict; reason: string; evidenceKind?: string; receiptsValid?: boolean; counts?: Record<string, number>; votes?: GraderVerdict[]; grades?: GraderResult[] };
export type GraderTask = { id: string; oracle: { commandLine: string; commandLines?: string[]; expectedSkips?: number; expectedTestCount?: number | null } };
export type ExecutionRecord = { producerRole: string; taskId: string; commandLine: string; taskDigest: string; sourceInputsVerified: boolean; testsMutated?: boolean; exitCode: number | null; timedOut?: boolean; claims?: { realHuman?: boolean }; subjectReportsOwnSuccess?: boolean; counts?: { passed: number; failed: number; skipped: number; total: number } };
export type TraceEvidence = { observedBy: string; taskId: string; runId: string; events: Array<{ kind: string; authorized?: boolean; approvalBypassed?: boolean; crossTrialLeak?: boolean; graderModified?: boolean; realHuman?: boolean; actorRole?: string }> };
export type RubricSample = { id?: string; facts: unknown; explanation: string | null; expected?: GraderVerdict };
export type RubricConfig = { model: string; votes: number; temperature: number; maxTokens: number; promptVersion?: string; promptDigest?: string };
export type RubricReceipt = { driven_by: string; actor: string; sampleId: string; vote: number; requestedModel: string; status: number | null; requestSha256: string; responseSha256: string; request?: unknown; response: { id?: string; model?: string; content?: Array<{ type: string; text?: string }> } | null };
export const GRADER_VERSION: string;
export const VERDICTS: GraderVerdict[];
export const RUBRIC_SYSTEM_PROMPT: string;
export function graderDigest(value: unknown): string;
export function gradeExecutionRecord(task: GraderTask, record: ExecutionRecord | null, stdout: string, stderr?: string): GraderResult;
export function gradeExecutionCalibration(task: GraderTask, record: ExecutionRecord | null, stdout: string, stderr?: string): GraderResult;
export function gradeExecutionArtifact(task: GraderTask, directory: string, attestation?: { receiptSha256: string; stdoutSha256: string; stderrSha256: string }): GraderResult;
export function gradeTaskExecutions(task: GraderTask, executions: Array<{ record: ExecutionRecord; stdout: string; stderr: string }>): GraderResult;
export function runTaskOracles(task: GraderTask & { oracle: GraderTask['oracle'] & { commandLines: string[]; testPaths: string[]; inputDigests: Record<string, string> } }, root: string, outputRoot?: string, options?: { commandLines?: string[]; authorityRoot?: string }): { directory: string; executions: Array<{ record: ExecutionRecord; stdout: string; stderr: string; artifactDirectory: string; attestation: { receiptSha256: string; stdoutSha256: string; stderrSha256: string } }>; verdict: GraderResult; trace: TraceEvidence };
export function gradeTraceEvidence(trace: TraceEvidence | null): GraderResult;
export function gradeTraceCalibration(trace: TraceEvidence | null): GraderResult;
export function buildRubricRequest(sample: RubricSample, config: RubricConfig): Record<string, unknown>;
export function gradeRubricReceipts(sample: RubricSample, receipts: RubricReceipt[], config: RubricConfig): GraderResult;
export function combineGraderVerdicts(deterministic: Pick<GraderResult, 'verdict'>, trace: Pick<GraderResult, 'verdict'>, rubric: Pick<GraderResult, 'verdict'>): GraderResult;
export function classifyZeroPassTrials(trials: Array<{ verdict: GraderVerdict; failureClass?: string }>, referenceVerified: boolean, gradersCalibrated: boolean): { classification: string; investigate: boolean };
