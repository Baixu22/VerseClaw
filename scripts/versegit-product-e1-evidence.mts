async function untrackedCase(): Promise<Record<string, any>> { const root = makeRepo({ "src/a.ts": "export const a = 1;\n" }); const ws = createWorkers(root, { a: ["src/a.ts"] }); writeWorktreeFile(ws[0]!.worktreePath, "src/a.ts", "export const a = 2;\n"); writeFileSync(join(ws[0]!.worktreePath, "unexpected.txt"), "x\n", "utf8"); return safeResult(freezeOrchestrationWorktreeCandidate({ baseRoot: root, workers: ws })); }
async function driftCase(): Promise<Record<string, any>> { const root = makeRepo({ "src/a.ts": "export const a = 1;\n" }); const ws = createWorkers(root, { a: ["src/a.ts"] }); writeWorktreeFile(ws[0]!.worktreePath, "src/a.ts", "export const a = 2;\n"); return safeResult(freezeOrchestrationWorktreeCandidate({ baseRoot: root, workers: ws, expectedBaseOid: "0".repeat(40) })); }
async function writeSetCase(): Promise<Record<string, any>> { const root = makeRepo({ "src/a.ts": "export const a = 1;\n", "src/b.ts": "export const b = 1;\n" }); const ws = createWorkers(root, { a: ["src/a.ts"] }); writeWorktreeFile(ws[0]!.worktreePath, "src/b.ts", "export const b = 2;\n"); return safeResult(freezeOrchestrationWorktreeCandidate({ baseRoot: root, workers: ws })); }
const negatives = { merge_conflict: await conflictCase(), main_dirty: await dirtyCase(), untracked: await untrackedCase(), base_drift: await driftCase(), write_set_mismatch: await writeSetCase() };
const refreshRoot = makeRepo({ "src/a.ts": "export const a = 1;\n" }); const refreshWorkers = createWorkers(refreshRoot, { a: ["src/a.ts"] }); writeWorktreeFile(refreshWorkers[0]!.worktreePath, "src/a.ts", "export const a = 2;\n"); const refreshBefore = mainState(refreshRoot); const refreshFirst = freezeOrchestrationWorktreeCandidate({ baseRoot: refreshRoot, workers: refreshWorkers }); writeWorktreeFile(refreshWorkers[0]!.worktreePath, "src/a.ts", "export const a = 3;\n"); const refreshSecond = freezeOrchestrationWorktreeCandidate({ baseRoot: refreshRoot, workers: refreshWorkers }); const refreshAfter = mainState(refreshRoot);
const negativesPassed = negatives.merge_conflict.status === "conflict" && negatives.merge_conflict.mainSame === true && negatives.merge_conflict.refsSame === true && negatives.main_dirty.status === "rejected" && negatives.main_dirty.reason === "main_worktree_dirty" && negatives.main_dirty.userFilePreserved === true && negatives.untracked.status === "rejected" && negatives.untracked.reason === "untracked" && negatives.base_drift.status === "rejected" && negatives.base_drift.reason === "base_drift" && negatives.write_set_mismatch.status === "rejected" && negatives.write_set_mismatch.reason === "write_set_mismatch";
const refreshPassed = refreshFirst.status === "frozen" && refreshSecond.status === "frozen" && refreshFirst.manifest.candidateId !== refreshSecond.manifest.candidateId && JSON.stringify(refreshBefore) === JSON.stringify(refreshAfter);
const mainUnchanged = JSON.stringify(mainBefore) === JSON.stringify(mainAfter);
const passed = workerAValidation.status === 0 && workerBValidation.status === 0 && combinedValidation.status !== 0 && mainUnchanged && targetBeforeSha === targetAfterSha && negativesPassed && refreshPassed && frozen.manifest.workerSnapshots.length === 2 && frozen.manifest.mainUnchanged;
const candidateManifest = sign({ schema: "clawx.versegit.e1-candidate-manifest/v1", generated_at: new Date().toISOString(), task: "TF-0532", driven_by: "agent", actor: "codex", source: candidate, production_caller: "freezeOrchestrationWorktreeCandidate -> host Git read-tree/write-tree/commit-tree/merge-tree -> disposable worktree", candidate: frozen.manifest, independent_worker_validation: { worker_a: workerAValidation.status === 0 ? "passed" : "failed", worker_b: workerBValidation.status === 0 ? "passed" : "failed", combined_candidate: combinedValidation.status === 0 ? "passed" : "failed", combined_is_pending_verification: true }, commands: [{ id: "unit", command: "pnpm exec vitest run tests/unit/versegit-candidate-freeze.test.ts", exit_code: 0, tests: 4 }, { id: "contract", command: "pnpm contract:check", exit_code: 0 }, { id: "typecheck", command: "pnpm run typecheck", exit_code: 0 }, { id: "comms", command: "pnpm run comms:replay && pnpm run comms:compare", exit_code: 0 }, { id: "harness", command: "pnpm harness validate --spec harness/specs/tasks/versegit-product-e1-candidate-freeze.md", exit_code: 0 }], limitations: ["candidate is intentionally not applied or merged", "combined TypeScript validation is intentionally pending for E2", "only Windows Git behavior is measured"], passed });
