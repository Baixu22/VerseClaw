function tscProject(cwd: string) { return spawnSync(process.execPath, [join(ROOT, "node_modules", "typescript", "bin", "tsc"), "-p", "tsconfig.json", "--pretty", "false"], { cwd, encoding: "utf8", windowsHide: true, timeout: 30_000 }); }
