function mainState(root: string) { return { head: git(root, ["rev-parse", "HEAD"]), refs: git(root, ["for-each-ref", "--format=%(refname) %(objectname)", "refs/heads"]), status: git(root, ["status", "--porcelain=v1", "--untracked-files=all"]) }; }
