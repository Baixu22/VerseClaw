const mainAfter = mainState(base); const targetAfterSha = sha(readFileSync(join(base, "src/producer.ts")));

async function conflictCase(): Promise<Record<string, any>> { const root = makeRepo({ "src/shared.ts": "export const value = 'base';\n" }); const ws = createWorkers(root, { a: ["src/shared.ts"], b: ["src/shared.ts"] }); writeWorktreeFile(ws[0]!.worktreePath, "src/shared.ts", "export const value = 'a';\n"); writeWorktreeFile(ws[1]!.worktreePath, "src/shared.ts", "export const value = 'b';\n"); return safeResult(freezeOrchestrationWorktreeCandidate({ baseRoot: root, workers: ws })); }
