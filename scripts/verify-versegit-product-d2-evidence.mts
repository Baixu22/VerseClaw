#!/usr/bin/env node
import { createHash } from "node:crypto";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const OUT = "harness/specs/fixtures/versegit-product-integration/d2";
const PATHS = { input: `${OUT}/paired-input-manifest.json`, results: `${OUT}/paired-results.json`, behavior: `${OUT}/behavior-evidence.json`, independent: `${OUT}/independent-review.json`, sums: `${OUT}/SHA256SUMS` };
function sha(value: string | Uint8Array): string { return createHash("sha256").update(value).digest("hex"); }
function stable(value: unknown): unknown { if (Array.isArray(value)) return value.map(stable); if (value && typeof value === "object") return Object.fromEntries(Object.keys(value as Record<string, unknown>).sort().map((key) => [key, stable((value as Record<string, unknown>)[key])])); return value; }
function digest(document: Record<string, any>): string { return sha(JSON.stringify(stable({ ...document, generated_at: undefined, digest: undefined }))); }
function readJson(path: string): Record<string, any> { return JSON.parse(readFileSync(resolve(ROOT, path), "utf8")); }
function leaks(value: unknown): number { return (JSON.stringify(value).match(/[A-Za-z]:[\\/]/gu) ?? []).length; }
function buildReview(generatedAt: string): Record<string, any> {
  const input = readJson(PATHS.input), results = readJson(PATHS.results), behavior = readJson(PATHS.behavior); const checks: Array<{id:string;passed:boolean;issues:string[]}> = [];
  const inputIssues: string[] = []; if (input.passed !== true) inputIssues.push("input manifest is not passed"); if (input.digest !== digest(input)) inputIssues.push("input manifest digest is not reproducible"); if (leaks(input) > 0) inputIssues.push("input manifest contains an absolute path"); if (!input.input_hashes?.api || !input.input_hashes?.consumer || !input.input_hashes?.tsconfig || !input.base_commit) inputIssues.push("paired inputs are incomplete"); if (input.execution_class?.external_model_provider !== false || input.execution_class?.real_human !== false) inputIssues.push("simulation class is dishonest"); checks.push({id:"paired-input-manifest",passed:inputIssues.length===0,issues:inputIssues});
  const resultIssues: string[] = []; if (results.passed !== true) resultIssues.push("paired results are not passed"); if (results.digest !== digest(results)) resultIssues.push("paired results digest is not reproducible"); if (leaks(results) > 0) resultIssues.push("paired results contain an absolute path"); if (results.summary?.behavior_shift_count !== 3 || results.summary?.positive_trials !== 3 || results.summary?.negative_trials !== 2 || results.summary?.negative_false_positive_count !== 0 || results.summary?.stable_normalized_outcomes !== true) resultIssues.push("paired summary does not satisfy the stability gate"); if ((results.trials ?? []).filter((trial: Record<string,any>) => trial.kind === "positive").some((trial: Record<string,any>) => trial.off.validation_status !== "failed" || trial.on.validation_status !== "passed" || trial.on.reread_count < 1 || trial.on.rework_count < 1)) resultIssues.push("positive pair did not demonstrate rework"); if ((results.trials ?? []).filter((trial: Record<string,any>) => trial.kind === "negative").some((trial: Record<string,any>) => trial.on.feedback_delivered || trial.on.validation_status !== "passed")) resultIssues.push("negative pair produced a false positive"); checks.push({id:"paired-results",passed:resultIssues.length===0,issues:resultIssues});
  const behaviorIssues: string[] = []; if (behavior.passed !== true) behaviorIssues.push("behavior evidence is not passed"); if (behavior.digest !== digest(behavior)) behaviorIssues.push("behavior evidence digest is not reproducible"); if (leaks(behavior) > 0) behaviorIssues.push("behavior evidence contains an absolute path"); if (behavior.comparison?.behavior_shift_count !== 3 || behavior.comparison?.negative_false_positive_count !== 0 || behavior.comparison?.stable_normalized_outcomes !== true) behaviorIssues.push("behavior-shift claim is not supported"); if (behavior.interpretation?.transcript_presence_alone_claimed_behavior_shift !== false || behavior.interpretation?.failure_was_actual_tsc !== true || behavior.interpretation?.off_on_inputs_identical !== true) behaviorIssues.push("behavior interpretation is overstated"); if (!Array.isArray(behavior.unmeasured) || behavior.unmeasured.length === 0) behaviorIssues.push("unmeasured boundaries are missing"); checks.push({id:"behavior-evidence",passed:behaviorIssues.length===0,issues:behaviorIssues});
  const source = input.source; if (results.source?.commit !== source?.commit || behavior.source?.commit !== source?.commit) checks.push({id:"source-identity",passed:false,issues:["evidence source identities differ"]});
  const passed=checks.every((check)=>check.passed); return {schema:"clawx.versegit.d2-independent-review/v1",generated_at:generatedAt,task:"TF-0531",driven_by:"agent",actor:"codex",reviewer_role:"independent-d2-verifier-process",status:passed?"passed":"failed",checks,evidence_digests:Object.fromEntries([PATHS.input,PATHS.results,PATHS.behavior].map((path)=>[path,sha(readFileSync(resolve(ROOT,path)))])),boundaries:{real_human_evidence:false,external_model_provider_claimed:false,default_off:true,m4_authorized:false,host_authority:"unchanged"},passed,digest:""};
}
function sign(document: Record<string, any>): Record<string, any> { const next={...document}; delete next.digest; next.digest=digest(next); return next; }
function writeSums(): void { const paths=[PATHS.input,PATHS.results,PATHS.behavior,PATHS.independent]; const body=paths.map((path)=>`${sha(readFileSync(resolve(ROOT,path)))}  ${path}`).sort().join("\n"); writeFileSync(resolve(ROOT,PATHS.sums),`${body}\n`,"utf8"); }
function checkSums(): string[] { const issues:string[]=[]; const expected=new Set([PATHS.input,PATHS.results,PATHS.behavior,PATHS.independent]); const lines=readFileSync(resolve(ROOT,PATHS.sums),"utf8").trim().split(/\r?\n/u).filter(Boolean); for(const line of lines){const match=/^([a-f0-9]{64})  (.+)$/u.exec(line);if(!match){issues.push("malformed SHA256SUMS line");continue;}const[,expectedDigest,path]=match;if(!expected.has(path)){issues.push(`unexpected SHA256SUMS path: ${path}`);continue;}expected.delete(path);if(sha(readFileSync(resolve(ROOT,path)))!==expectedDigest)issues.push(`SHA256SUMS mismatch: ${path}`);}if(expected.size>0)issues.push(`SHA256SUMS missing: ${[...expected].join(", ")}`);return issues; }
function main(): void { const checkMode=process.argv.includes("--check"); if(![PATHS.input,PATHS.results,PATHS.behavior].every((path)=>existsSync(resolve(ROOT,path))))throw new Error("D2 evidence inputs are incomplete"); if(checkMode){const review=readJson(PATHS.independent);const rebuilt=sign(buildReview(review.generated_at));const issues=[...(review.digest===digest(review)?[]:["independent review digest is not reproducible"]),...(rebuilt.digest===review.digest?[]:["independent review result drifted"]),...checkSums()];if(review.status!=="passed"||review.passed!==true)issues.push("independent review did not pass");if(issues.length>0)throw new Error(issues.join("; "));console.log("[versegit-d2-review] CHECK OK");return;}const review=sign(buildReview(new Date().toISOString()));writeFileSync(resolve(ROOT,PATHS.independent),`${JSON.stringify(review,null,2)}\n`,"utf8");writeSums();if(review.passed!==true)throw new Error(JSON.stringify(review.checks));console.log("[versegit-d2-review] WRITE OK"); }
try{main();}catch(error){console.error(`[versegit-d2-review] FAIL: ${String((error as Error)?.stack ?? error)}`);process.exitCode=1;}
