#!/usr/bin/env node
import { createHash } from "node:crypto";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
const ROOT=resolve(dirname(fileURLToPath(import.meta.url)),".."); const OUT="harness/specs/fixtures/versegit-product-integration/e1";
const PATHS={manifest:`${OUT}/candidate-manifest.json`,negative:`${OUT}/candidate-negative.json`,target:`${OUT}/target-before-after.json`,independent:`${OUT}/independent-review.json`,sums:`${OUT}/SHA256SUMS`};
function sha(v:string|Uint8Array){return createHash("sha256").update(v).digest("hex");} function stable(v:unknown):unknown{if(Array.isArray(v))return v.map(stable);if(v&&typeof v==="object")return Object.fromEntries(Object.keys(v as Record<string,unknown>).sort().map(k=>[k,stable((v as Record<string,unknown>)[k])]));return v;} function digest(d:Record<string,any>){return sha(JSON.stringify(stable({...d,generated_at:undefined,digest:undefined})));} function readJson(p:string):Record<string,any>{return JSON.parse(readFileSync(resolve(ROOT,p),"utf8"));} function leaks(v:unknown){return (JSON.stringify(v).match(/[A-Za-z]:[\\/]/gu)??[]).length;}
function buildReview(generatedAt:string):Record<string,any>{const manifest=readJson(PATHS.manifest),negative=readJson(PATHS.negative),target=readJson(PATHS.target);const checks:Array<{id:string;passed:boolean;issues:string[]}>=[];
 const mi:string[]=[];if(manifest.passed!==true)mi.push("candidate manifest is not passed");if(manifest.digest!==digest(manifest))mi.push("candidate digest is not reproducible");if(leaks(manifest)>0)mi.push("candidate manifest contains absolute path");if(manifest.candidate?.workerSnapshots?.length!==2)mi.push("candidate does not contain two snapshots");if(!manifest.candidate?.candidateCommitOid||!manifest.candidate?.candidateTreeOid||!manifest.candidate?.inputDigest)mi.push("candidate identity is incomplete");if(manifest.independent_worker_validation?.worker_a!=="passed"||manifest.independent_worker_validation?.worker_b!=="passed"||manifest.independent_worker_validation?.combined_candidate!=="failed")mi.push("worker/combined validation boundary is not recorded");checks.push({id:"candidate-manifest",passed:mi.length===0,issues:mi});
 const ni:string[]=[];if(negative.passed!==true)ni.push("negative evidence not passed");if(negative.digest!==digest(negative))ni.push("negative digest not reproducible");if(leaks(negative)>0)ni.push("negative evidence contains absolute path");const cases=negative.cases??{};if(cases.merge_conflict?.status!=="conflict"||cases.main_dirty?.reason!=="main_worktree_dirty"||cases.untracked?.reason!=="untracked"||cases.base_drift?.reason!=="base_drift"||cases.write_set_mismatch?.reason!=="write_set_mismatch")ni.push("required candidate rejection matrix is incomplete");if(cases.merge_conflict?.mainSame!==true||cases.merge_conflict?.refsSame!==true)ni.push("conflict mutated main or refs");checks.push({id:"candidate-negative",passed:ni.length===0,issues:ni});
 const ti:string[]=[];if(target.passed!==true)ti.push("target evidence not passed");if(target.digest!==digest(target))ti.push("target digest not reproducible");if(leaks(target)>0)ti.push("target evidence contains absolute path");if(target.main_unchanged!==true||target.refs_unchanged!==true||target.merge_performed!==false)ti.push("candidate freeze touched target or main");if(target.candidate_status!=="frozen"||target.refresh_created_new_candidate!==true)ti.push("candidate refresh result is missing");checks.push({id:"target-before-after",passed:ti.length===0,issues:ti});
 const source=manifest.source;if(negative.source?.commit!==source?.commit||target.source?.commit!==source?.commit)checks.push({id:"source-identity",passed:false,issues:["source identities differ"]});const passed=checks.every(c=>c.passed);return {schema:"clawx.versegit.e1-independent-review/v1",generated_at:generatedAt,task:"TF-0532",driven_by:"agent",actor:"codex",reviewer_role:"independent-e1-verifier-process",status:passed?"passed":"failed",checks,evidence_digests:Object.fromEntries([PATHS.manifest,PATHS.negative,PATHS.target].map(p=>[p,sha(readFileSync(resolve(ROOT,p)))])),boundaries:{real_human_evidence:false,default_off:true,m4_authorized:false,host_authority:"unchanged",merge_performed:false},passed,digest:""};}
function sign(d:Record<string,any>){const n={...d};delete n.digest;n.digest=digest(n);return n;} function writeSums(){const paths=[PATHS.manifest,PATHS.negative,PATHS.target,PATHS.independent];writeFileSync(resolve(ROOT,PATHS.sums),`${paths.map(p=>`${sha(readFileSync(resolve(ROOT,p)))}  ${p}`).sort().join("\n")}\n`,"utf8");} function checkSums():string[]{const issues:string[]=[];const expected=new Set([PATHS.manifest,PATHS.negative,PATHS.target,PATHS.independent]);const lines=readFileSync(resolve(ROOT,PATHS.sums),"utf8").trim().split(/\r?\n/u).filter(Boolean);for(const line of lines){const m=/^([a-f0-9]{64})  (.+)$/u.exec(line);if(!m){issues.push("malformed SHA256SUMS line");continue;}const[,h,p]=m;if(!expected.has(p)){issues.push(`unexpected SHA256SUMS path: ${p}`);continue;}expected.delete(p);if(sha(readFileSync(resolve(ROOT,p)))!==h)issues.push(`SHA256SUMS mismatch: ${p}`);}if(expected.size>0)issues.push(`SHA256SUMS missing: ${[...expected].join(", ")}`);return issues;}
function main(){const check=process.argv.includes("--check");if(![PATHS.manifest,PATHS.negative,PATHS.target].every(p=>existsSync(resolve(ROOT,p))))throw new Error("E1 evidence inputs incomplete");if(check){const r=readJson(PATHS.independent);const rebuilt=sign(buildReview(r.generated_at));const issues=[...(r.digest===digest(r)?[]:["independent review digest not reproducible"]),...(rebuilt.digest===r.digest?[]:["independent review result drifted"]),...checkSums()];if(r.status!=="passed"||r.passed!==true)issues.push("independent review did not pass");if(issues.length>0)throw new Error(issues.join("; "));console.log("[versegit-e1-review] CHECK OK");return;}const r=sign(buildReview(new Date().toISOString()));writeFileSync(resolve(ROOT,PATHS.independent),`${JSON.stringify(r,null,2)}\n`,"utf8");writeSums();if(r.passed!==true)throw new Error(JSON.stringify(r.checks));console.log("[versegit-e1-review] WRITE OK");}
try{main();}catch(e){console.error(`[versegit-e1-review] FAIL: ${String((e as Error)?.stack??e)}`);process.exitCode=1;}
