+        match self {
+            Self::Standard(child) => child
+                .try_wait()
+                .map(|status| status.map(ExitStatusValue::from)),
+            #[cfg(windows)]
+            Self::Pty(process) => process.try_wait(),
+        }
+        .map_err(Into::into)
+    }
