@@ -0,0 +1,173 @@
+//! Typed lifecycle operations for VerseShell-owned local processes.
+
+use crate::operation::OperationSpec;
+use serde_json::{json, Value};
+
+pub fn specs() -> Vec<OperationSpec> {
+    vec![
+        OperationSpec {
+            name: "process.start",
+            mcp_name: "process_start",
+            description: "Start an approved argv process owned by this runtime and return its scoped lifecycle identity.",
+            effect: "process.spawn",
+            capability: "shell.exec",
+            input_schema: start_schema,
+            handler: crate::process_lifecycle::execute_start,
+        },
+        OperationSpec {
+            name: "process.poll",
+            mcp_name: "process_poll",
+            description: "Read bounded process output from a monotonic byte cursor and observe lifecycle state.",
+            effect: "process.read",
+            capability: "shell.exec",
+            input_schema: poll_schema,
+            handler: crate::process_lifecycle::execute_poll,
+        },
+        OperationSpec {
+            name: "process.write",
+            mcp_name: "process_write",
+            description: "Write bounded input or EOF to an owned pipe or PTY process.",
+            effect: "process.write",
+            capability: "shell.exec",
+            input_schema: write_schema,
+            handler: crate::process_lifecycle::execute_write,
+        },
+        OperationSpec {
+            name: "process.kill",
+            mcp_name: "process_kill",
+            description: "Idempotently terminate an owned process tree and observe the converged state.",
+            effect: "process.kill",
+            capability: "shell.exec",
+            input_schema: kill_schema,
+            handler: crate::process_lifecycle::execute_kill,
+        },
+        OperationSpec {
+            name: "process.list",
+            mcp_name: "process_list",
+            description: "List lifecycle records scoped to one runtime, agent, session, and workspace.",
+            effect: "process.read",
+            capability: "shell.exec",
+            input_schema: list_schema,
+            handler: crate::process_lifecycle::execute_list,
+        },
+    ]
+}
+
+fn owner_properties() -> Value {
+    json!({
+        "process_id": {"type": "string"},
+        "runtime_id": {"type": "string"},
+        "agent_id": {"type": "string"},
+        "session_id": {"type": "string"}
+    })
+}
+
+fn start_schema() -> Value {
+    json!({
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["argv", "agent_id", "session_id"],
+        "properties": {
+            "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
+            "cwd": {"type": "string", "default": "."},
+            "agent_id": {"type": "string"},
+            "session_id": {"type": "string"},
+            "env": {"type": "object", "additionalProperties": {"type": "string"}},
+            "stdin_mode": {"type": "string", "enum": ["null", "pipe"], "default": "null"},
+            "stdin": {"type": "string"},
+            "stdin_encoding": {"type": "string", "enum": ["utf8", "base64"], "default": "utf8"},
+            "stdin_eof": {"type": "boolean", "default": false},
+            "pty": {"type": "boolean", "default": false},
+            "cols": {"type": "integer", "minimum": 1, "default": 120},
+            "rows": {"type": "integer", "minimum": 1, "default": 30},
+            "timeout_ms": {"type": "integer", "minimum": 0},
+            "max_output_bytes": {"type": "integer", "minimum": 1, "default": 67108864},
+            "max_memory_mb": {"type": "integer", "minimum": 1},
+            "max_processes": {"type": "integer", "minimum": 1},
+            "wait_ms": {"type": "integer", "minimum": 0, "default": 0}
+        }
+    })
+}
+
+fn poll_schema() -> Value {
+    let mut properties = owner_properties();
+    let object = properties
+        .as_object_mut()
+        .expect("owner properties are an object");
+    object.insert(
+        "cursor".into(),
+        json!({"type": "integer", "minimum": 0, "default": 0}),
+    );
+    object.insert(
+        "max_bytes".into(),
+        json!({"type": "integer", "minimum": 1, "default": 65536}),
+    );
+    object.insert(
+        "wait_ms".into(),
+        json!({"type": "integer", "minimum": 0, "default": 0}),
+    );
+    json!({
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["process_id", "runtime_id", "agent_id", "session_id"],
+        "properties": properties
+    })
+}
+
+fn write_schema() -> Value {
+    let mut properties = owner_properties();
+    let object = properties
+        .as_object_mut()
+        .expect("owner properties are an object");
+    object.insert("data".into(), json!({"type": "string", "default": ""}));
+    object.insert(
+        "encoding".into(),
+        json!({"type": "string", "enum": ["utf8", "base64"], "default": "utf8"}),
+    );
+    object.insert(
+        "submit".into(),
+        json!({"type": "boolean", "default": false}),
+    );
+    object.insert("eof".into(), json!({"type": "boolean", "default": false}));
+    json!({
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["process_id", "runtime_id", "agent_id", "session_id"],
+        "properties": properties
+    })
+}
+
+fn kill_schema() -> Value {
+    let mut properties = owner_properties();
+    let object = properties
+        .as_object_mut()
+        .expect("owner properties are an object");
+    object.insert(
+        "reason".into(),
+        json!({"type": "string", "default": "manual_cancel"}),
+    );
+    object.insert(
+        "wait_ms".into(),
+        json!({"type": "integer", "minimum": 0, "default": 2000}),
+    );
+    json!({
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["process_id", "runtime_id", "agent_id", "session_id"],
+        "properties": properties
+    })
+}
+
+fn list_schema() -> Value {
+    json!({
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["runtime_id", "agent_id", "session_id"],
+        "properties": {
+            "runtime_id": {"type": "string"},
+            "agent_id": {"type": "string"},
+            "session_id": {"type": "string"},
+            "include_terminal": {"type": "boolean", "default": false}
+        }
+    })
+}
diff --git a/src/process_command.rs b/src/process_command.rs
new file mode 100644
index 0000000..5d6bf68
--- /dev/null
+++ b/src/process_command.rs
@@ -0,0 +1,248 @@
+//! Approved argv and environment resolution shared by synchronous and lifecycle execution.
+
+use anyhow::{anyhow, Context, Result};
+use std::collections::BTreeMap;
+use std::ffi::{OsStr, OsString};
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+#[derive(Debug, Clone)]
+pub struct ResolvedProcessCommand {
+    pub executable: PathBuf,
+    pub args: Vec<String>,
+    #[cfg(windows)]
+    pub windows_raw_arg: Option<String>,
+    pub audited_executable: PathBuf,
+    pub interpreter: Option<PathBuf>,
+}
+
+pub fn resolve_process_command(
+    argv: &[String],
+    cwd: &Path,
+    env: Option<&BTreeMap<String, String>>,
+) -> Result<ResolvedProcessCommand> {
+    let program = argv
+        .first()
+        .filter(|value| !value.is_empty())
+        .ok_or_else(|| anyhow!("E_EXEC_BAD_ARG: argv must contain a program"))?;
+    if program.contains('\0') || argv.iter().any(|arg| arg.contains(['\r', '\n', '\0'])) {
+        return Err(anyhow!(
+            "E_EXEC_BAD_ARG: argv contains a forbidden control character"
+        ));
+    }
+
+    let resolved = resolve_executable(program, cwd, env)?;
+    #[cfg(windows)]
+    if is_batch_script(&resolved) {
+        let interpreter = resolve_cmd(env)?;
+        let command_line = batch_command_line(&windows_process_path(&resolved), &argv[1..])?;
+        return Ok(ResolvedProcessCommand {
+            executable: interpreter.clone(),
+            args: vec!["/D".into(), "/S".into(), "/C".into()],
+            windows_raw_arg: Some(command_line),
+            audited_executable: resolved,
+            interpreter: Some(interpreter),
+        });
+    }
+
+    Ok(ResolvedProcessCommand {
+        executable: resolved.clone(),
+        args: argv[1..].to_vec(),
+        #[cfg(windows)]
+        windows_raw_arg: None,
+        audited_executable: resolved,
+        interpreter: None,
+    })
+}
+
+#[cfg(windows)]
+pub(crate) fn windows_process_path(path: &Path) -> PathBuf {
+    let value = path.to_string_lossy();
+    if let Some(rest) = value.strip_prefix(r"\\?\UNC\") {
+        PathBuf::from(format!(r"\\{rest}"))
+    } else if let Some(rest) = value.strip_prefix(r"\\?\") {
+        PathBuf::from(rest)
+    } else {
+        path.to_path_buf()
+    }
+}
+
+pub fn configure_command_environment(
+    command: &mut Command,
+    env: Option<&BTreeMap<String, String>>,
+) {
+    if let Some(env) = env {
+        command.env_clear();
+        command.envs(env);
+    }
+}
+
+fn resolve_executable(
+    program: &str,
+    cwd: &Path,
+    env: Option<&BTreeMap<String, String>>,
+) -> Result<PathBuf> {
+    let input = Path::new(program);
+    if input.is_absolute() || has_path_separator(program) {
+        let candidate = if input.is_absolute() {
+            input.to_path_buf()
+        } else {
+            cwd.join(input)
+        };
+        return resolve_candidate(candidate, env)
+            .with_context(|| format!("E_EXEC_NOT_FOUND: executable '{program}' was not found"));
+    }
+
+    let path_value = env_value(env, "PATH")
+        .map(OsString::from)
+        .or_else(|| std::env::var_os("PATH"))
+        .unwrap_or_default();
+    for directory in std::env::split_paths(&path_value) {
+        if let Ok(candidate) = resolve_candidate(directory.join(program), env) {
+            return Ok(candidate);
+        }
+    }
+    Err(anyhow!(
+        "E_EXEC_NOT_FOUND: executable '{}' was not found on PATH",
+        program
+    ))
+}
+
+fn resolve_candidate(
+    candidate: PathBuf,
+    env: Option<&BTreeMap<String, String>>,
+) -> Result<PathBuf> {
+    if candidate.is_file() {
+        return canonical_identity(candidate);
+    }
+    #[cfg(windows)]
+    if candidate.extension().is_none() {
+        for extension in windows_extensions(env) {
+            let mut value = candidate.as_os_str().to_os_string();
+            value.push(extension);
+            let with_extension = PathBuf::from(value);
+            if with_extension.is_file() {
+                return canonical_identity(with_extension);
+            }
+        }
+    }
+    Err(anyhow!("candidate is not an executable file"))
+}
+
+fn canonical_identity(path: PathBuf) -> Result<PathBuf> {
+    path.canonicalize()
+        .with_context(|| format!("failed to canonicalize executable '{}'", path.display()))
+}
+
+fn has_path_separator(value: &str) -> bool {
+    value.contains('/') || value.contains('\\')
+}
+
+fn env_value<'a>(env: Option<&'a BTreeMap<String, String>>, key: &str) -> Option<&'a str> {
+    env?.iter()
+        .find(|(name, _)| name.eq_ignore_ascii_case(key))
+        .map(|(_, value)| value.as_str())
+}
+
+#[cfg(windows)]
+fn windows_extensions(env: Option<&BTreeMap<String, String>>) -> Vec<String> {
+    let value = env_value(env, "PATHEXT")
+        .map(str::to_owned)
+        .or_else(|| std::env::var("PATHEXT").ok())
+        .unwrap_or_else(|| ".COM;.EXE;.BAT;.CMD".into());
+    value
+        .split(';')
+        .filter_map(|extension| {
+            let extension = extension.trim();
+            if extension.is_empty() {
+                None
+            } else if extension.starts_with('.') {
+                Some(extension.to_ascii_lowercase())
+            } else {
+                Some(format!(".{extension}").to_ascii_lowercase())
+            }
+        })
+        .collect()
+}
+
+#[cfg(windows)]
+fn is_batch_script(path: &Path) -> bool {
+    path.extension()
+        .and_then(OsStr::to_str)
+        .is_some_and(|extension| matches!(extension.to_ascii_lowercase().as_str(), "cmd" | "bat"))
+}
+
+#[cfg(windows)]
+fn resolve_cmd(env: Option<&BTreeMap<String, String>>) -> Result<PathBuf> {
+    if let Some(comspec) = env_value(env, "ComSpec") {
+        let candidate = PathBuf::from(comspec);
+        if candidate.is_file() {
+            return canonical_identity(candidate);
+        }
+    }
+    let system_root = env_value(env, "SystemRoot")
+        .map(str::to_owned)
+        .or_else(|| std::env::var("SystemRoot").ok())
+        .ok_or_else(|| {
+            anyhow!("E_EXEC_NOT_FOUND: SystemRoot is unavailable for batch execution")
+        })?;
+    resolve_candidate(
+        PathBuf::from(system_root).join("System32").join("cmd.exe"),
+        env,
+    )
+}
+
+#[cfg(windows)]
+fn batch_command_line(script: &Path, args: &[String]) -> Result<String> {
+    if args.iter().any(|arg| arg.contains(['%', '!'])) {
+        return Err(anyhow!(
+            "E_EXEC_BAD_ARG: percent and delayed-expansion tokens are not accepted for batch argv"
+        ));
+    }
+    let mut tokens = Vec::with_capacity(args.len() + 1);
+    tokens.push(quote_cmd_token(&script.to_string_lossy()));
+    tokens.extend(args.iter().map(|arg| quote_cmd_token(arg)));
+    Ok(format!("\"{}\"", tokens.join(" ")))
+}
+
+#[cfg(windows)]
+fn quote_cmd_token(value: &str) -> String {
+    let escaped = value.replace('"', "\"\"");
+    format!("\"{escaped}\"")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rejects_control_characters_before_resolution() {
+        let result = resolve_process_command(&["tool\nname".into()], Path::new("."), None);
+        assert!(result
+            .unwrap_err()
+            .to_string()
+            .contains("forbidden control"));
+    }
+
+    #[cfg(windows)]
+    #[test]
+    fn resolves_pathext_case_insensitively() {
+        let root =
+            std::env::temp_dir().join(format!("verseshell-resolve-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir_all(&root).unwrap();
+        let executable = root.join("sample.CMD");
+        std::fs::write(&executable, "@echo ok\r\n").unwrap();
+        let env = BTreeMap::from([
+            ("Path".into(), root.to_string_lossy().to_string()),
+            ("PathExt".into(), ".EXE;.CMD".into()),
+            ("SystemRoot".into(), std::env::var("SystemRoot").unwrap()),
+        ]);
+        let resolved = resolve_process_command(&["sample".into()], &root, Some(&env)).unwrap();
+        assert_eq!(
+            resolved.audited_executable,
+            executable.canonicalize().unwrap()
+        );
+        assert!(resolved.interpreter.is_some());
+        let _ = std::fs::remove_dir_all(root);
+    }
+}
