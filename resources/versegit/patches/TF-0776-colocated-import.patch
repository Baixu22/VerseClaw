+#[test]
+fn workspace_import_honors_global_ignores_and_retries_after_incomplete_snapshot() {
+    use serde_json::Value;
+    use std::process::{Command, Stdio};
+
+    let temp = tempfile::tempdir().unwrap();
+    let repo = temp.path().join("repo");
+    std::fs::create_dir_all(&repo).unwrap();
+    let global_ignore = temp.path().join("global-ignore");
+    let global_config = temp.path().join("global.gitconfig");
+    std::fs::write(&global_ignore, "global.secret\n").unwrap();
+    let global_ignore_value = global_ignore.to_string_lossy().replace('\\', "/");
+    std::fs::write(
+        &global_config,
+        format!("[core]\n\texcludesFile = \"{global_ignore_value}\"\n"),
+    )
+    .unwrap();
+
+    let git = |args: &[&str]| {
+        let output = Command::new("git")
+            .args(args)
+            .current_dir(&repo)
+            .env("GIT_CONFIG_GLOBAL", &global_config)
+            .env("GIT_CONFIG_NOSYSTEM", "1")
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "git {args:?}: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        String::from_utf8_lossy(&output.stdout).to_string()
+    };
+    assert_eq!(git(&["init", "-q", "-b", "main"]), "");
+    assert_eq!(git(&["config", "user.name", "VG Import"]), "");
+    assert_eq!(
+        git(&["config", "user.email", "vg-import@example.invalid"]),
+        ""
+    );
+    assert_eq!(git(&["config", "core.ignoreCase", "true"]), "");
+    std::fs::write(repo.join("tracked.txt"), "base\n").unwrap();
+    std::fs::create_dir(repo.join(".VG")).unwrap();
+    std::fs::write(repo.join(".VG/private.txt"), "committed private bytes\n").unwrap();
+    std::fs::write(
+        repo.join("removed-secret.txt"),
+        "committed removable bytes\n",
+    )
+    .unwrap();
+    let tracked_large = std::fs::File::create(repo.join("large-tracked.bin")).unwrap();
+    tracked_large.set_len(16 * 1024 * 1024 + 1).unwrap();
+    assert_eq!(
+        git(&[
+            "add",
+            "tracked.txt",
+            ".VG/private.txt",
+            "removed-secret.txt",
+            "large-tracked.bin"
+        ]),
+        ""
+    );
+    assert_eq!(git(&["commit", "-q", "-m", "base"]), "");
+
+    std::fs::write(
+        repo.join(".gitignore"),
+        ".VG/\nforced.txt\nremoved-secret.txt\nlarge-tracked.bin\n",
+    )
+    .unwrap();
+    assert!(git(&["rm", "--cached", ".VG/private.txt"]).contains("private.txt"));
+    assert!(git(&["rm", "--cached", "removed-secret.txt"]).contains("removed-secret.txt"));
+    std::fs::write(repo.join("forced.txt"), "force-added selected bytes\n").unwrap();
+    assert_eq!(git(&["add", "-f", "forced.txt"]), "");
+    std::fs::create_dir_all(repo.join("caller/nested")).unwrap();
+    #[cfg(unix)]
+    {
+        use std::ffi::OsString;
+        use std::os::unix::ffi::OsStringExt;
+        std::fs::create_dir(repo.join("sub")).unwrap();
+        std::fs::write(repo.join("sub/keep.txt"), "selected non-UTF-8 sibling\n").unwrap();
+        let ignored_name = OsString::from_vec(b"bad\xff.tmp".to_vec());
+        std::fs::write(
+            repo.join("sub").join(ignored_name),
+            "ignored invalid path\n",
+        )
+        .unwrap();
+        std::fs::create_dir(repo.join(".Jj")).unwrap();
+        let reserved_name = OsString::from_vec(b"hidden\xff.tmp".to_vec());
+        std::fs::write(
+            repo.join(".Jj").join(reserved_name),
+            "reserved invalid path\n",
+        )
+        .unwrap();
+        std::fs::write(
+            repo.join(".gitignore"),
+            ".VG/\nforced.txt\nremoved-secret.txt\nlarge-tracked.bin\nsub/*.tmp\n",
+        )
+        .unwrap();
+    }
+    std::fs::rename(repo.join("tracked.txt"), repo.join("TRACKED.TXT")).unwrap();
+    std::fs::rename(
+        repo.join("large-tracked.bin"),
+        repo.join("LARGE-TRACKED.bin"),
+    )
+    .unwrap();
+    std::fs::write(repo.join("TRACKED.TXT"), "user dirty retry bytes\n").unwrap();
+    std::fs::write(repo.join("global.secret"), "global ignore canary\n").unwrap();
+    std::fs::write(repo.join("GLOBAL.SECRET"), "case-folded ignore canary\n").unwrap();
+    std::fs::write(
+        repo.join(".VG/private.txt"),
+        "dirty inherited private bytes\n",
+    )
+    .unwrap();
+    std::fs::write(repo.join(".VG/internal.txt"), "reserved internal bytes\n").unwrap();
+    std::fs::write(repo.join("removed-secret.txt"), "dirty removed secret\n").unwrap();
+    assert!(!git(&["ls-files", "--cached"])
+        .lines()
+        .any(|path| path == "removed-secret.txt"));
+    assert!(!git(&["ls-files", "--others", "--exclude-standard"])
