+        .any(|path| path == "removed-secret.txt"));
+    let ignored_oids = [
+        "global.secret",
+        "GLOBAL.SECRET",
+        ".VG/private.txt",
+        ".VG/internal.txt",
+        "removed-secret.txt",
+    ]
+    .into_iter()
+    .map(|path| (path, git(&["hash-object", path]).trim().to_string()))
+    .collect::<Vec<_>>();
+    let large = std::fs::File::create(repo.join("large.bin")).unwrap();
+    large.set_len(16 * 1024 * 1024 + 1).unwrap();
+
+    let run_from = |cwd: &Path, args: &[&str]| {
+        let output = Command::new(env!("CARGO_BIN_EXE_vg"))
