+        &["workspace", "import", "--root", &repo_s, "--json"],
+    );
+    assert_eq!(code, Some(0), "{out} / {err}");
+    let imported: Value = serde_json::from_str(out.trim()).unwrap();
+    assert_eq!(imported["command"], "workspace.import", "{imported}");
+    assert!(repo.join(".jj").exists());
