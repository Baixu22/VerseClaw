+/// Resolve Git's index spelling to the one physical spelling when Git declares
+/// the checkout case-insensitive. Exact names win; ambiguous case aliases and
+/// selected paths through parent directory links are refused.
+fn reconcile_case_insensitive_path(root: &Path, relative: &Path) -> Result<PathBuf, JjError> {
+    let mut current = root.to_path_buf();
+    let mut resolved = PathBuf::new();
+    let mut components = relative.components().peekable();
+    while let Some(component) = components.next() {
+        let Component::Normal(name) = component else {
+            return Ok(relative.to_path_buf());
+        };
+        let Ok(entries) = fs::read_dir(&current) else {
+            return Ok(relative.to_path_buf());
+        };
+        let entries = entries.filter_map(Result::ok).collect::<Vec<_>>();
+        let chosen = if let Some(entry) = entries
+            .iter()
+            .find(|entry| entry.file_name().as_os_str() == name)
+        {
+            entry.file_name()
+        } else {
+            let wanted = name.to_string_lossy();
+            let mut matches = entries.iter().filter(|entry| {
+                entry
+                    .file_name()
+                    .to_string_lossy()
+                    .eq_ignore_ascii_case(&wanted)
+            });
+            let Some(first) = matches.next() else {
+                return Ok(relative.to_path_buf());
+            };
+            if matches.next().is_some() {
+                return Err(JjError::WriteRefused(format!(
+                    "workspace import refused an ambiguous case-insensitive path: {}",
+                    relative.display()
+                )));
+            }
+            first.file_name()
+        };
+        if components.peek().is_some() {
+            let candidate = current.join(&chosen);
+            if fs::symlink_metadata(&candidate)
+                .map(|metadata| metadata.file_type().is_symlink())
+                .unwrap_or(false)
+            {
+                return Err(JjError::WriteRefused(format!(
+                    "workspace import refused a selected path through a directory link: {}",
+                    relative.display()
+                )));
+            }
+        }
+        resolved.push(&chosen);
+        current.push(&chosen);
+    }
