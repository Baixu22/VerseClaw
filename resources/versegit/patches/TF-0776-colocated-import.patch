+            .env("GIT_INDEX_FILE", temp.path().join("decoy-index"))
+            .env("GIT_COMMON_DIR", temp.path().join("decoy-common-dir"))
+            .env("GIT_NAMESPACE", "decoy-namespace")
+            .env_remove("VG_SESSION_ID")
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .output()
+            .unwrap();
+        (
+            String::from_utf8_lossy(&output.stdout).to_string(),
+            String::from_utf8_lossy(&output.stderr).to_string(),
+            output.status.code(),
+        )
+    };
+    let run = |args: &[&str]| run_from(temp.path(), args);
