{
  "schema": "ContractCheckFixture/v1",
  "id": "flat-ipc-removal-plan-missing",
  "rule": "flat-ipc/removal-plan-missing",
  "expect": "[flat-ipc/removal-plan-missing] 'gateway:status' is migrate but declares no removalPlan",
  "description": "A migrated channel that lost its removal plan, so the compatibility exception has no exit path.",
  "mutations": [
    {
      "file": "scripts/contract-check-flat-ipc.json",
      "find": "      \"channel\": \"gateway:status\",\n      \"typedModule\": \"gateway\",\n      \"typedAction\": \"status\",\n      \"preload\": \"allowlisted\",\n      \"disposition\": \"retired\",",
      "replace": "      \"channel\": \"gateway:status\",\n      \"typedModule\": \"gateway\",\n      \"typedAction\": \"status\",\n      \"preload\": \"allowlisted\",\n      \"disposition\": \"migrate\","
    },
    {
      "file": "scripts/contract-check-flat-ipc.json",
      "find": "\"removalPlan\": \"Consumers migrated (TF-0650, 2026-11-02). Remaining step (A5 / TF-0651): retire handler + allowlist entry.\"",
      "replace": "\"removalPlan\": \"\""
    },
    {
      "file": "electron/main/ipc-handlers.ts",
      "append": "\nipcMain.handle('gateway:status', () => undefined);\n"
    },
    {
      "file": "electron/preload/index.ts",
      "append": "\nconst validChannels = ['gateway:status'];\n"
    }
  ]
}
